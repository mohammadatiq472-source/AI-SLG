	if _main_map_frontline_marker_start_context.is_empty():
		_main_map_frontline_marker_start_context = context.duplicate(true)
		_record_last_action("main_map_frontline/start/%d_%d" % [int(context.get("cellX", 0)), int(context.get("cellY", 0))], "selected")
		_update_runtime_label("frontline start selected")
		_refresh_main_map_cell_action_panel()
		return
	var start_context: Dictionary = _main_map_frontline_marker_start_context.duplicate(true)
	var start_cell: Dictionary = _build_main_map_frontline_marker_cell(start_context)
	var end_cell: Dictionary = _build_main_map_frontline_marker_cell(context)
	if int(start_cell.get("x", -1)) == int(end_cell.get("x", -1)) and int(start_cell.get("y", -1)) == int(end_cell.get("y", -1)):
		_update_runtime_label("frontline end must be another cell")
		_refresh_main_map_cell_action_panel()
		return
	var result: Dictionary = await _execute_main_map_frontline_marker_action(start_context, context, "player")
	if bool(result.get("ok", false)):
		_main_map_frontline_marker_start_context = {}
	_refresh_main_map_cell_action_panel()

