func _run_mainline_visual_smoke_player_history_timeline_recovery_host_navigation() -> Dictionary:
	var host := _resolve_mainline_visual_smoke_panel_root("player_history")
	if host == null:
		return {"attempted": true, "ok": false, "reason": "player_history_panel_missing"}
	var panel_node := _find_mainline_visual_smoke_visible_node_with_method(host, "run_timeline_recovery_action_smoke")
	if panel_node == null:
		return {"attempted": true, "ok": false, "reason": "player_history_timeline_recovery_method_missing"}
	var before_count := _player_history_timeline_recovery_host_count
	var result_variant: Variant = panel_node.call("run_timeline_recovery_action_smoke")
	if not (result_variant is Dictionary):
		return {"attempted": true, "ok": false, "reason": "player_history_timeline_recovery_result_invalid"}
	await get_tree().process_frame
	await get_tree().process_frame
	var result := (result_variant as Dictionary).duplicate(true)
	var host_count := _player_history_timeline_recovery_host_count - before_count
	var opened_summary := _read_mainline_visual_smoke_player_history_summary()
	result["attempted"] = true
	result["ok"] = bool(result.get("ok", false)) \
		and host_count > 0 \
		and _player_history_timeline_recovery_host_surface.strip_edges() != "" \
		and _player_history_timeline_recovery_host_surface != "player_history" \
		and _player_history_timeline_recovery_host_feedback.strip_edges() != "" \
		and (
			_player_history_timeline_recovery_host_surface != "dedicated_replay"
			or (
				_player_history_timeline_recovery_surface_opened
				and bool(opened_summary.get("dedicatedReplayScreenOpen", false))
				and (
					(
						bool(opened_summary.get("timelineRecoveryReplayIdentityResolved", false))
						and bool(opened_summary.get("replayFrameLoaded", false))
					)
					or bool(opened_summary.get("replayUnavailableCopyVisible", false))
				)
			)
		)
	result["timelineRecoveryHostNavigationToken"] = PLAYER_HISTORY_TIMELINE_RECOVERY_HOST_NAV_TOKEN
	result["timelineRecoveryHostNavigationCount"] = _player_history_timeline_recovery_host_count
	result["timelineRecoveryHostNavigationDelta"] = host_count
	result["timelineRecoveryHostNavigationKind"] = _player_history_timeline_recovery_host_kind
	result["timelineRecoveryHostNavigationSurface"] = _player_history_timeline_recovery_host_surface
	result["timelineRecoveryHostNavigationFeedback"] = _player_history_timeline_recovery_host_feedback
	result["timelineRecoverySurfaceOpenCount"] = _player_history_timeline_recovery_surface_open_count
	result["timelineRecoverySurfaceOpened"] = _player_history_timeline_recovery_surface_opened
	result["timelineRecoverySurfaceOpenReason"] = _player_history_timeline_recovery_surface_open_reason
	result["timelineRecoveryOpenedSummary"] = opened_summary
	return result

func _press_mainline_visual_smoke_player_history_panel_open(panel_id: String) -> Dictionary:
	if panel_id != "player_history" or _active_panel_id != "player_history":
		_open_overlay_panel_with_page("player_history")
		await get_tree().process_frame
		await get_tree().process_frame
	await get_tree().create_timer(0.75).timeout
	var summary := _read_mainline_visual_smoke_player_history_summary()
	var player_history_summary_poll_count := 0
	while player_history_summary_poll_count < 10:
		if (
			int(summary.get("saveSlotCount", 0)) > 0
			or int(summary.get("historyCardCount", 0)) > 0
			or int(summary.get("replayFrameCount", 0)) > 0
			or int(summary.get("timelineCardCount", 0)) > 1
		):
			break
		player_history_summary_poll_count += 1
		await get_tree().create_timer(0.25).timeout
		summary = _read_mainline_visual_smoke_player_history_summary()
	var replay_interaction_smoke := {"attempted": false, "ok": true, "reason": "replay_frames_not_present"}
	if int(summary.get("replayFrameCount", 0)) > 0:
		replay_interaction_smoke = _run_mainline_visual_smoke_player_history_replay_interaction()
		await get_tree().process_frame
		summary = _read_mainline_visual_smoke_player_history_summary()
	var save_restore_feedback_smoke := {"attempted": false, "ok": true, "reason": "save_slots_not_present"}
	if int(summary.get("saveSlotCount", 0)) > 0:
		save_restore_feedback_smoke = _run_mainline_visual_smoke_player_history_save_restore_feedback()
		await get_tree().process_frame
		summary = _read_mainline_visual_smoke_player_history_summary()
	var timeline_recovery_host_navigation_smoke := {"attempted": false, "ok": true, "reason": "timeline_recovery_actions_not_present"}
	if int(summary.get("timelineRecoveryActionCount", 0)) > 0:
		timeline_recovery_host_navigation_smoke = await _run_mainline_visual_smoke_player_history_timeline_recovery_host_navigation()
		await get_tree().process_frame
		summary = _read_mainline_visual_smoke_player_history_summary()
	var layout_summary := _read_mainline_visual_smoke_overlay_panel_layout_summary("player_history")
	var real_buttons: Array = []
	var raw_buttons: Variant = summary.get("realButtonNodeNames", [])
	if raw_buttons is Array:
		real_buttons = raw_buttons as Array
	var ok := (
		_active_panel_id == "player_history"
		and bool(summary.get("ok", false))
		and bool(layout_summary.get("layoutOk", false))
		and str(summary.get("surfaceContract", "")) == "player_history_panel_v1"
		and str(summary.get("styleOwner", "")) == "PlayerHistoryPanel"
		and str(summary.get("motionToken", "")) == "player_history_timeline_card_entry_motion_v1"
		and str(summary.get("replayInspectionToken", "")) == "player_history_replay_action_frame_inspection_v1"
		and (
			int(summary.get("replayFrameCount", 0)) <= 0
			or (
				str(summary.get("replayInteractionMotionToken", "")) == "player_history_replay_interaction_motion_v1"
				and bool(replay_interaction_smoke.get("ok", false))
				and bool(summary.get("replayPaused", false))
				and int(summary.get("replayInteractionFeedbackCount", 0)) >= 3
			)
		)
		and str(summary.get("saveRestoreFeedbackToken", "")) == "player_history_save_restore_feedback_v1"
		and str(summary.get("timelineRecoveryHostNavigationToken", "")) == PLAYER_HISTORY_TIMELINE_RECOVERY_HOST_NAV_TOKEN
		and (
			int(summary.get("timelineRecoveryActionCount", 0)) <= 0
			or (
				bool(timeline_recovery_host_navigation_smoke.get("ok", false))
				and int(summary.get("timelineRecoveryHostNavigationCount", 0)) > 0
				and str(summary.get("timelineRecoveryHostNavigationKind", "")).strip_edges() != ""
				and str(summary.get("timelineRecoveryHostNavigationSurface", "")).strip_edges() != ""
				and str(summary.get("timelineRecoveryHostNavigationSurface", "")) != "player_history"
				and str(summary.get("timelineRecoveryHostNavigationFeedback", "")).strip_edges() != ""
				and bool(summary.get("timelineRecoverySurfaceOpened", false))
				and bool(summary.get("dedicatedReplayScreenOpen", false))
				and (
					(
						bool(summary.get("timelineRecoveryReplayIdentityResolved", false))
						and str(summary.get("timelineRecoverySurfaceOpenReason", "")) == "dedicated_replay_identity_opened"
						and bool(summary.get("replayFrameLoaded", false))
					)
					or (
						str(summary.get("timelineRecoverySurfaceOpenReason", "")) == "dedicated_replay_unavailable_opened"
						and bool(summary.get("replayUnavailableCopyVisible", false))
					)
				)
			)
		)
		and (
			int(summary.get("saveSlotCount", 0)) <= 0
			or (
				bool(save_restore_feedback_smoke.get("ok", false))
				and bool(summary.get("saveRestorePrepared", false))
				and str(summary.get("saveRestoreSelectedSlotLabel", "")).strip_edges() != ""
				and str(summary.get("saveRestoreSelectedSavedAtLabel", "")).strip_edges() != ""
				and str(summary.get("saveRestoreSelectedRiskLabel", "")).strip_edges() != ""
				and str(summary.get("saveRestoreSelectedPreviewLabel", "")).strip_edges() != ""
			)
		)
		and summary.has("controlNodeNames")
		and summary.has("restoreFeedbackCount")
		and (
			int(summary.get("timelineCardCount", 0)) > 0
			or int(summary.get("saveSlotCount", 0)) > 0
			or int(summary.get("historyCardCount", 0)) > 0
			or int(summary.get("replayFrameCount", 0)) > 0
		)
	)
	return {
		"attempted": true,
		"ok": ok,
		"clicked": false,
		"reason": "player_history_panel_opened" if ok else "player_history_panel_open_contract_failed",
		"activePanelId": _active_panel_id,
		"expectedPanelId": "player_history",
		"pageContentOk": bool(summary.get("ok", false)),
		"pageContentSummary": summary,
		"playerHistorySummaryPollCount": player_history_summary_poll_count,
		"replayInteractionSmoke": replay_interaction_smoke,
		"saveRestoreFeedbackSmoke": save_restore_feedback_smoke,
		"timelineRecoveryHostNavigationSmoke": timeline_recovery_host_navigation_smoke,
		"overlayPanelLayoutOk": bool(layout_summary.get("layoutOk", false)),
		"overlayPanelLayout": layout_summary,
	}

