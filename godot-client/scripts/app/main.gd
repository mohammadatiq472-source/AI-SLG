func _on_snapshot_overlay_page_action_requested(page_id: String, action_id: String) -> void:
	if _is_coordinate_jump_tile_action(action_id):
		await _execute_coordinate_jump(_build_coordinate_jump_payload_from_tile_action(action_id))
		return
	if _active_panel_id == "alliance" and action_id.strip_edges() == "war_room_live_refresh_poll":
		await _on_alliance_war_room_live_refresh_requested(page_id, action_id)
		return
	if _active_panel_id == "alliance" and action_id.strip_edges().begins_with("war_room_ui_state_save::"):
		await _on_alliance_war_room_ui_state_save_requested(page_id, action_id)
		return
	if _active_panel_id == "alliance" and action_id.strip_edges() == "found_nation_submit":
		await _on_alliance_nation_found_submit_requested(page_id)
		return
	if _active_panel_id == "alliance" and action_id.strip_edges() == "empire_upgrade_submit":
		await _on_alliance_nation_empire_upgrade_submit_requested(page_id)
		return
	if _active_panel_id == "alliance" and action_id.strip_edges() == "nation_capital_migration_submit":
		await _on_alliance_nation_capital_migration_submit_requested(page_id)
		return
	if _active_panel_id == "alliance" and page_id.strip_edges() == "nation/midgame" and action_id.strip_edges() == "open_tianxia_luoyang_target":
		_nation_midgame_luoyang_route_last_result = await _execute_nation_midgame_luoyang_route_from_page(page_id, action_id)
		return
	if (
		_active_panel_id == "alliance"
		and (
			action_id.strip_edges() == "nation_profile_update_name_submit"
			or action_id.strip_edges() == "nation_profile_update_color_submit"
		)
	):
		await _on_alliance_nation_profile_update_requested(page_id, action_id)
		return
	var overlay_spec := _resolve_active_snapshot_overlay_spec()
	var adapter_method := str(overlay_spec.get("adapter_method", "")).strip_edges()
	if adapter_method == "":
		return
	var adapter = _resolve_slg_domain_action_adapter()
	if not adapter.has_method(adapter_method):
		return
	var outcome: Dictionary = await adapter.call(adapter_method, action_id, page_id)
	await _apply_overlay_action_outcome(outcome)

