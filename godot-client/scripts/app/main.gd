	var skip_counts: Dictionary = map_summary.get("tianxiaYutuLabelPrioritySkipCounts", {}) as Dictionary if map_summary.get("tianxiaYutuLabelPrioritySkipCounts", {}) is Dictionary else {}
	var draw_order: Array = map_summary.get("tianxiaYutuLabelPriorityDrawOrder", []) as Array if map_summary.get("tianxiaYutuLabelPriorityDrawOrder", []) is Array else []
	var label_density_relief_count: int = (
		int(map_summary.get("tianxiaYutuLabelCollisionSkipCount", 0))
		+ int(map_summary.get("tianxiaYutuGateLabelBudgetSkipCount", 0))
		+ int(map_summary.get("tianxiaYutuCityLabelBudgetSkipCount", 0))
		+ int(map_summary.get("tianxiaYutuNormalDenseAdminLabelSuppressionCount", 0))
	)
	var expected_order := ["state", "selected_region", "gate", "state_government", "commandery_seat", "city", "focus"]
	var observed_rank_ok := true
	var last_rank := -1
	for priority_variant in draw_order:
		var priority := str(priority_variant)
		var priority_rank: int = expected_order.find(priority)
		if priority_rank < 0:
			continue
		if priority_rank < last_rank:
			observed_rank_ok = false
			break
		last_rank = priority_rank
	var ok := (
		state_selected_ok
		and region_selected_ok
		and str(panel_summary.get("selectedStateId", "")) == "sili"
		and str(panel_summary.get("selectedRegionId", "")) != ""
		and str(map_summary.get("tianxiaYutuSelectedStateId", "")) == "sili"
		and str(map_summary.get("tianxiaYutuSelectedRegionId", "")) == str(panel_summary.get("selectedRegionId", ""))
		and str(map_summary.get("tianxiaYutuDensityLevel", "")) == "near"
		and observed_rank_ok
		and draw_order.size() >= 4
		and int(draw_counts.get("state", 0)) + int(skip_counts.get("state", 0)) >= 1
		and int(draw_counts.get("selected_region", 0)) >= 1
		and int(draw_counts.get("gate", 0)) >= 1
		and int(draw_counts.get("state_government", 0)) + int(skip_counts.get("state_government", 0)) >= 1
		and int(draw_counts.get("city", 0)) >= 1
		and int(draw_counts.get("commandery_seat", 0)) + int(skip_counts.get("commandery_seat", 0)) >= 1
		and int(draw_counts.get("focus", 0)) + int(skip_counts.get("focus", 0)) >= 1
		and label_density_relief_count >= 1
		and int(map_summary.get("tianxiaYutuAdminFocusAssetMaskDrawCount", 0)) >= 2
		and int(map_summary.get("tianxiaYutuAdminFocusMaskMissingCount", 0)) == 0
		and int(map_summary.get("tianxiaYutuAdminFocusMaskLoadFailedCount", 0)) == 0
		and int(map_summary.get("tianxiaYutuAdminFocusRuntimeHullBlockedCount", 0)) == 0
	)
	return {
		"attempted": true,
		"ok": ok,
		"reason": "tianxia_yutu_dense_label_priority_qa" if ok else "tianxia_yutu_dense_label_priority_qa_failed",
		"setup": setup,
		"stateSelectedOk": state_selected_ok,
		"regionSelectedOk": region_selected_ok,
		"observedRankOk": observed_rank_ok,
		"labelDensityReliefCount": label_density_relief_count,
		"expectedOrder": expected_order,
		"drawOrder": draw_order,
		"drawCounts": draw_counts,
		"skipCounts": skip_counts,
		"panelSummary": panel_summary,
		"mapSummary": map_summary,
		"screenshot": screenshot,
	}


