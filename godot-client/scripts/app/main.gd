func _mainline_visual_smoke_land_manifest_excludes_naval_slots(slot_ids: Array) -> bool:
	var file := FileAccess.open("res://assets/themes/slgclient/manifests/unit_frames_manifest.json", FileAccess.READ)
	if file == null:
		return false
	var text := file.get_as_text()
	for slot_id_variant in slot_ids:
		if text.find(str(slot_id_variant)) >= 0:
			return false
	return true


func _refresh_main_map_cell_action_panel() -> void:
	if _main_map_cell_action_panel == null:
		return
	_position_main_map_cell_action_panel()
	var context: Dictionary = _selected_main_map_cell_context
	var is_nation_midgame_unified_action_hud_context := (
		str(context.get("routeTargetSource", "")).strip_edges() == "nation_midgame_realm_objective_bridge"
		or str(context.get("routeTargetSource", "")).strip_edges() == "nation_midgame_luoyang_route"
	)
	var should_show: bool = _display_mode == DISPLAY_MODE_WORLD and not _is_tianxia_yutu_main_map_mode() and not context.is_empty() and not is_nation_midgame_unified_action_hud_context
	_main_map_cell_action_panel.visible = should_show
	if not should_show:
		_set_world_tile_action_hud_visible(false)
		_show_main_map_owner_delta_buttons()
		if _main_map_claim_cell_button != null:
			_main_map_claim_cell_button.disabled = true
		if _main_map_release_cell_button != null:
			_main_map_release_cell_button.disabled = true
		if _main_map_mark_frontline_button != null:
			_main_map_mark_frontline_button.disabled = true
		return

	var cell_x: int = int(context.get("cellX", -1))
	var cell_y: int = int(context.get("cellY", -1))
	var owner_id: String = str(context.get("owner", "neutral")).strip_edges()
	if owner_id == "":
		owner_id = "neutral"
	var cell_version: int = int(context.get("cellVersion", 0))
	var immunity_active: bool = _is_main_map_cell_context_immunity_active(context)
	if _is_world_tile_action_hud_resource_context(context):
		var tile_hud_summary := _build_world_tile_action_hud_summary(context)
		_apply_world_tile_action_hud_summary(tile_hud_summary)
		_hide_main_map_owner_delta_buttons_for_tile_hud()
		return
	_set_world_tile_action_hud_visible(false)
	_show_main_map_owner_delta_buttons()
	if _main_map_cell_action_summary_label != null:
		_reset_main_map_cell_summary_tone()
		var frontline_suffix := ""
		if not _main_map_frontline_marker_start_context.is_empty():
			frontline_suffix = "\n战线起点 %d,%d" % [
				int(_main_map_frontline_marker_start_context.get("cellX", -1)),
				int(_main_map_frontline_marker_start_context.get("cellY", -1)),
			]
		var immunity_suffix: String = _format_main_map_cell_immunity_summary(context)
		if immunity_suffix != "":
			immunity_suffix = "\n%s" % immunity_suffix
		var summary_title := "主世界格"
		var route_target_label := str(context.get("routeTargetLabel", "")).strip_edges()
		if route_target_label != "":
			summary_title = "国家中局-洛阳目标" if route_target_label == "洛阳" else "%s目标" % route_target_label
			var route_target_visible_copy := str(context.get("routeTargetVisibleCopy", "")).strip_edges()
			if route_target_visible_copy == "":
				route_target_visible_copy = "%s\n东都要冲 · 争夺目标" % summary_title
			_main_map_cell_action_summary_label.text = route_target_visible_copy
		else:
			_main_map_cell_action_summary_label.text = "%s (%d,%d) · %s%s%s" % [summary_title, cell_x, cell_y, _format_main_map_cell_owner_visible_label(owner_id), frontline_suffix, immunity_suffix]

	var has_faction: bool = _target_faction_id.strip_edges() != ""
	var owned_by_self: bool = has_faction and owner_id == _target_faction_id
	var can_claim: bool = has_faction and not _request_in_flight and not owned_by_self and not immunity_active
	var can_release: bool = has_faction and not _request_in_flight and owned_by_self
	if _main_map_claim_cell_button != null:
		_main_map_claim_cell_button.disabled = not can_claim
		_main_map_claim_cell_button.tooltip_text = "免战保护中，暂不能占领" if immunity_active and not owned_by_self else "占领当前主世界格"
	if _main_map_release_cell_button != null:
		_main_map_release_cell_button.disabled = not can_release
	if _main_map_mark_frontline_button != null:
		var has_start: bool = not _main_map_frontline_marker_start_context.is_empty()
		var start_is_current := (
			has_start
			and int(_main_map_frontline_marker_start_context.get("cellX", -1)) == cell_x
			and int(_main_map_frontline_marker_start_context.get("cellY", -1)) == cell_y
		)
		_main_map_mark_frontline_button.text = "设终点" if has_start else "标战线"
		_main_map_mark_frontline_button.disabled = not has_faction or _request_in_flight or (has_start and start_is_current)
		_main_map_mark_frontline_button.tooltip_text = "选择另一个主世界格作为战线终点" if has_start else "把当前主世界格设为战线起点"

func _format_main_map_cell_owner_visible_label(owner_id: String) -> String:
	var normalized := owner_id.strip_edges().to_lower()
	if normalized == "" or normalized == "neutral":
		return "中立地块"
	if normalized == _target_faction_id.strip_edges().to_lower():
		return "我方领地"
	return "他方领地"

func _position_main_map_cell_action_panel() -> void:
	if _main_map_cell_action_panel == null:
		return
	var viewport_size: Vector2 = get_viewport().get_visible_rect().size
	var panel_width: float = minf(420.0, maxf(320.0, viewport_size.x - 32.0))
	var panel_height := 334.0
	_constrain_main_map_cell_action_panel_content(panel_width)
	var left_safe := 256.0
	var right_safe := maxf(left_safe + 16.0, viewport_size.x - panel_width - 16.0)
	var top_safe := 88.0
	var bottom_safe := maxf(top_safe, viewport_size.y - panel_height - 244.0)
	var target_position := Vector2(right_safe, top_safe)
	var selected_screen_position := _resolve_selected_main_map_tile_screen_position()
	var bound_to_selected_tile := selected_screen_position != Vector2.ZERO
	if bound_to_selected_tile:
		target_position = selected_screen_position + Vector2(26.0, -panel_height * 0.48)
		target_position.x = clampf(target_position.x, left_safe, right_safe)
		target_position.y = clampf(target_position.y, top_safe, bottom_safe)
	_main_map_cell_action_panel.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	_main_map_cell_action_panel.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	_main_map_cell_action_panel.custom_minimum_size = Vector2(panel_width, panel_height)
	_main_map_cell_action_panel.set_anchor(SIDE_LEFT, 0.0, false, true)
	_main_map_cell_action_panel.set_anchor(SIDE_TOP, 0.0, false, true)
	_main_map_cell_action_panel.set_anchor(SIDE_RIGHT, 0.0, false, true)
	_main_map_cell_action_panel.set_anchor(SIDE_BOTTOM, 0.0, false, true)
	_main_map_cell_action_panel.set_offset(SIDE_LEFT, target_position.x)
	_main_map_cell_action_panel.set_offset(SIDE_TOP, target_position.y)
	_main_map_cell_action_panel.set_offset(SIDE_RIGHT, target_position.x + panel_width)
	_main_map_cell_action_panel.set_offset(SIDE_BOTTOM, target_position.y + panel_height)
	_main_map_cell_action_panel.set_position(target_position, false)
	_main_map_cell_action_panel.set_size(Vector2(panel_width, panel_height), false)
	_main_map_cell_action_panel.set_meta("tile_hud_anchor_mode", "selected_tile_bound" if bound_to_selected_tile else "screen_right_fixed_fallback")
	_main_map_cell_action_panel.set_meta("tile_hud_bound_to_selected_tile", bound_to_selected_tile)
	_main_map_cell_action_panel.set_meta("selected_tile_screen_position", selected_screen_position)

func _constrain_main_map_cell_action_panel_content(panel_width: float) -> void:
	var content_width := maxf(180.0, panel_width - 28.0)
	var label_specs := [
		[_main_map_tile_hud_title_label, 30.0],
		[_main_map_tile_hud_coordinate_label, 24.0],
		[_main_map_tile_hud_yield_label, 24.0],
		[_main_map_tile_hud_defender_label, 24.0],
		[_main_map_tile_hud_troop_label, 24.0],
		[_main_map_cell_action_summary_label, 28.0],
		[_main_map_tile_hud_feedback_label, 24.0],
	]
	for spec_variant in label_specs:
		var spec: Array = spec_variant as Array
		var label: Label = spec[0] as Label
		if label == null:
			continue
		label.autowrap_mode = TextServer.AUTOWRAP_OFF
		label.clip_text = true
		label.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
		label.max_lines_visible = 1
		label.custom_minimum_size = Vector2(content_width, float(spec[1]))
		label.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		label.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	if _main_map_tile_expedition_button != null:
		_main_map_tile_expedition_button.custom_minimum_size = Vector2(152.0, 54.0)
		_main_map_tile_expedition_button.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
