	return {
		"attempted": true,
		"ok": ok,
		"reason": "nation_profile_local_draft_ok" if ok else "nation_profile_local_draft_failed",
		"expectedNationName": next_name,
		"expectedColorHex": normalized_color,
		"pageSummary": page_summary,
	}

func _press_mainline_visual_smoke_nation_profile_submit(expected_name: String, expected_color_hex: String) -> Dictionary:
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {"attempted": true, "ok": false, "reason": "overlay_missing"}
	var panel_control := _active_overlay_panel as Control
	if panel_control == null:
		return {"attempted": true, "ok": false, "reason": "overlay_not_control"}
	var submit_button := panel_control.find_child("NationProfileSubmitButton", true, false) as Button
	if submit_button == null:
		return {"attempted": true, "ok": false, "reason": "submit_button_missing"}
	var before_summary := _read_mainline_visual_smoke_overlay_page_summary("alliance", "governance/founding")
	if submit_button.disabled:
		return {
			"attempted": true,
			"ok": false,
			"reason": "submit_button_disabled",
			"beforeSummary": before_summary,
		}
	submit_button.emit_signal("pressed")
	var expected_color := expected_color_hex.strip_edges().to_lower()
	var deadline_msec: int = Time.get_ticks_msec() + 9000
	var map_summary: Dictionary = {}
	while Time.get_ticks_msec() <= deadline_msec:
		await get_tree().process_frame
		await get_tree().create_timer(0.2).timeout
		map_summary = _read_tianxia_yutu_explicit_jump_summary()
		if (
			str(map_summary.get("playerNationRuntimeName", "")) == expected_name
			and str(map_summary.get("playerNationRuntimeColorHex", "")).to_lower() == expected_color
		):
			break
	var ok := (
		str(map_summary.get("playerNationRuntimeName", "")) == expected_name
		and str(map_summary.get("playerNationRuntimeColorHex", "")).to_lower() == expected_color
	)
	return {
		"attempted": true,
		"ok": ok,
		"reason": "nation_profile_authoritative_submit_ok" if ok else "nation_profile_authoritative_submit_failed",
		"expectedNationName": expected_name,
		"expectedColorHex": expected_color,
		"beforeSummary": before_summary,
		"mapSummary": map_summary,
	}

func _press_mainline_visual_smoke_nation_profile_update(expected_name: String, expected_color_hex: String) -> Dictionary:
