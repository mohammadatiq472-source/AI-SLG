func _verify_mainline_visual_smoke_nation_found_failure_copy() -> Dictionary:
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {
			"ok": false,
			"reason": "active_overlay_panel_missing",
			"checks": [],
		}
	if not _active_overlay_panel.has_method("record_nation_profile_governance_rejection"):
		return {
			"ok": false,
			"reason": "rejection_recorder_missing",
			"checks": [],
		}
	var cases: Array = [
		{"code": "nation_found_level_required", "expected": "同盟等级不足，达到 20 级后可立国。"},
		{"code": "nation_found_commandery_required", "expected": "还没有占领郡城，占有 1 个郡后可立国。"},
		{"code": "nation_found_capital_not_controlled", "expected": "都城必须选择己方郡城。"},
		{"code": "nation_found_forbidden", "expected": "只有盟主或授权官员可以立国。"},
	]
	var checks: Array = []
	var all_ok := true
	for item_variant in cases:
		var item: Dictionary = item_variant as Dictionary
		var code := str(item.get("code", "")).strip_edges()
		var expected := str(item.get("expected", "")).strip_edges()
		_active_overlay_panel.call("record_nation_profile_governance_rejection", {
			"failureCode": code,
			"message": "backend failure copy should not be shown directly",
		})
		await get_tree().process_frame
		await get_tree().process_frame
		var summary := _read_mainline_visual_smoke_overlay_page_summary("alliance", "governance/founding")
		var actual := str(summary.get("organizationNationFoundingFailureText", "")).strip_edges()
		var label := _active_overlay_panel.find_child("NationProfileFoundingFailureLabel", true, false) as Label
		var label_text := label.text.strip_edges() if label != null else ""
		var label_visible := label != null and label.visible and label.is_visible_in_tree()
		var check_ok := actual == expected and label_text == expected and label_visible
		all_ok = all_ok and check_ok
		checks.append({
			"code": code,
			"expected": expected,
			"actual": actual,
			"labelText": label_text,
			"labelVisible": label_visible,
			"ok": check_ok,
		})
	return {
		"ok": all_ok,
		"reason": "nation_found_failure_copy_ok" if all_ok else "nation_found_failure_copy_missing",
		"checks": checks,
	}


func _press_mainline_visual_smoke_nation_found_submit_failure() -> Dictionary:
	var expected_failure_code := OS.get_environment("SLG_NATION_FOUND_FAILURE_EXPECTED_CODE").strip_edges()
	if expected_failure_code == "":
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "nation_found_expected_failure_code_missing",
		}
	var expected_text := OS.get_environment("SLG_NATION_FOUND_FAILURE_EXPECTED_TEXT").strip_edges()
	if expected_text == "":
		expected_text = _mainline_visual_smoke_nation_found_failure_text(expected_failure_code)
	var capital_tile_id := OS.get_environment("SLG_NATION_FOUND_FAILURE_CAPITAL_TILE_ID").strip_edges()
