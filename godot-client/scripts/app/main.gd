func _find_world_task_by_id(world_tasks: Dictionary, task_id: String) -> Dictionary:
	var normalized_task_id := task_id.strip_edges()
	if normalized_task_id == "":
		return {}
	var tasks_variant: Variant = world_tasks.get("tasks", [])
	if not (tasks_variant is Array):
		return {}
	for task_variant in tasks_variant as Array:
		if not (task_variant is Dictionary):
			continue
		var task: Dictionary = task_variant as Dictionary
		if str(task.get("taskId", "")).strip_edges() == normalized_task_id:
			return task.duplicate(true)
	return {}


func _first_hour_task_reward_resource_keys() -> Array:
	return ["food", "wood", "stone", "iron", "copper", "actionPoints"]


func _read_target_faction_resource_snapshot_for_smoke() -> Dictionary:
	var refreshed := await _refresh_world_and_map(false)
	var faction_state := _read_target_faction_state()
	var resources: Dictionary = {}
	for key in _first_hour_task_reward_resource_keys():
		resources[key] = int(faction_state.get(key, 0))
	return {
		"ok": refreshed and not faction_state.is_empty(),
		"resources": resources,
	}


func _sum_task_reward_preview_resources(task: Dictionary) -> Dictionary:
	var totals: Dictionary = {}
	var allowed_keys := _first_hour_task_reward_resource_keys()
	var rewards_variant: Variant = task.get("rewardPreview", [])
	if not (rewards_variant is Array):
		return totals
	for reward_variant in rewards_variant as Array:
		if not (reward_variant is Dictionary):
			continue
		var reward: Dictionary = reward_variant as Dictionary
		var kind := str(reward.get("kind", "")).strip_edges()
		if kind == "" or not allowed_keys.has(kind):
			continue
		totals[kind] = int(totals.get(kind, 0)) + int(reward.get("amount", 0))
	return totals


func _diff_task_claim_resource_snapshots(before_resources: Dictionary, after_resources: Dictionary) -> Dictionary:
	var delta: Dictionary = {}
	for key in _first_hour_task_reward_resource_keys():
		delta[key] = int(after_resources.get(key, 0)) - int(before_resources.get(key, 0))
	return delta


func _task_claim_reward_resources_applied(expected_rewards: Dictionary, actual_delta: Dictionary) -> bool:
	if expected_rewards.is_empty():
		return false
	for key in expected_rewards.keys():
		if int(actual_delta.get(key, 0)) < int(expected_rewards.get(key, 0)):
			return false
	return true


func _find_next_first_hour_task_after_claim(world_tasks: Dictionary, claimed_task_id: String) -> Dictionary:
	var tasks_variant: Variant = world_tasks.get("tasks", [])
	if not (tasks_variant is Array):
		return {}
	var fallback: Dictionary = {}
	var seen_claimed_task := false
	for task_variant in tasks_variant as Array:
		if not (task_variant is Dictionary):
			continue
		var task: Dictionary = task_variant as Dictionary
		var task_id := str(task.get("taskId", "")).strip_edges()
		var status := str(task.get("status", "")).strip_edges()
		var claim_state := str(task.get("claimState", "")).strip_edges()
		if task_id == claimed_task_id:
			seen_claimed_task = true
			continue
		if status == "claimed" or claim_state == "claimed":
			continue
		if fallback.is_empty():
			fallback = task.duplicate(true)
		if seen_claimed_task:
			return task.duplicate(true)
	return fallback


func _task_has_next_action_guidance(task: Dictionary) -> bool:
	var title := str(task.get("title", "")).strip_edges()
	var objective := str(task.get("objectiveText", "")).strip_edges()
	var action_hint := str(task.get("actionHint", "")).strip_edges()
	var target_variant: Variant = task.get("actionTarget", {})
	var action_target: Dictionary = target_variant as Dictionary if target_variant is Dictionary else {}
	var target_kind := str(action_target.get("kind", "")).strip_edges()
	var target_id := str(action_target.get("id", "")).strip_edges()
	var rewards_variant: Variant = task.get("rewardPreview", [])
	return (
		title != ""
		and objective != ""
		and action_hint != ""
		and target_kind != ""
		and target_id != ""
		and rewards_variant is Array
		and not (rewards_variant as Array).is_empty()
	)


