			draft_page_summary = _read_mainline_visual_smoke_overlay_page_summary("alliance", active_page_id)
			if bool(draft_result.get("ok", false)):
				submit_result = await _press_mainline_visual_smoke_nation_profile_submit("青州试立国", "#3f7fbf")
				await get_tree().process_frame
				await get_tree().process_frame
				panel_summary_after_submit = _read_tianxia_yutu_explicit_jump_summary()
				if bool(submit_result.get("ok", false)):
					profile_update_result = _read_mainline_visual_smoke_nation_profile_locked_summary(_read_mainline_visual_smoke_overlay_page_summary("alliance", _read_mainline_visual_smoke_active_overlay_page_id()))
					await get_tree().process_frame
					await get_tree().process_frame
					panel_summary_after_submit = _read_tianxia_yutu_explicit_jump_summary()
				page_summary = _read_mainline_visual_smoke_overlay_page_summary("alliance", _read_mainline_visual_smoke_active_overlay_page_id())
		var founding_submit_path_ok := (
			active_page_id == "governance/founding"
			and bool(draft_page_summary.get("organizationNationProfileConfigEntryVisible", false))
			and bool(draft_page_summary.get("organizationNationNameInputVisible", false))
			and int(draft_page_summary.get("organizationNationColorSwatchCount", 0)) >= 3
			and bool(draft_page_summary.get("organizationNationProfileDraftLocalOnly", false))
			and bool(draft_page_summary.get("organizationNationProfileBackendSubmitEnabled", false))
			and bool(draft_page_summary.get("organizationNationProfileSubmitButtonVisible", false))
			and not bool(draft_page_summary.get("organizationNationProfileSubmitButtonDisabled", true))
			and str(draft_page_summary.get("organizationNationNameDraft", "")) == "青州试立国"
			and str(draft_page_summary.get("organizationNationColorHex", "")).to_lower() == "#3f7fbf"
			and bool(draft_page_summary.get("organizationNationProfileDraftDirty", false))
			and bool(draft_result.get("ok", false))
			and bool(submit_result.get("ok", false))
			and str(panel_summary_after_submit.get("playerNationRuntimeName", "")) == "青州试立国"
			and str(panel_summary_after_submit.get("playerNationRuntimeColorHex", "")).to_lower() == "#3f7fbf"
		)
		var already_nation_path_ok := (
			opened_as_nation
			and str(page_summary.get("organizationKind", "")).strip_edges().to_lower() == "nation"
		)
		var runtime_nation_present := (
			str(panel_summary_after_submit.get("playerNationRuntimeName", "")).strip_edges() != ""
			and str(panel_summary_after_submit.get("playerNationRuntimeColorHex", "")).strip_edges() != ""
		)
		nation_entry_open_result = {
			"attempted": true,
			"ok": (
				_active_panel_id == "alliance"
				and (
					(founding_submit_path_ok and bool(profile_update_result.get("ok", false)))
					or already_nation_path_ok
				)
				and runtime_nation_present
			),
			"activePanelId": _active_panel_id,
			"activePageId": active_page_id,
			"pageSummary": page_summary,
			"draftPageSummary": draft_page_summary,
			"draftResult": draft_result,
			"submitResult": submit_result,
			"profileUpdateResult": profile_update_result,
			"foundingSubmitPathOk": founding_submit_path_ok,
			"alreadyNationPathOk": already_nation_path_ok,
			"runtimeNationPresent": runtime_nation_present,
		}
	var route_text: String = str(panel_summary_before.get("nationProfileConfigRoute", ""))
	var button_entry_ok: bool = (
		bool(panel_summary_before.get("nationProfileConfigButtonVisible", false))
		and (route_text.find("alliance") >= 0 or route_text.find("governance") >= 0)
	)
	var ok: bool = (
		bool(setup.get("ok", false))
		and button_entry_ok
		and bool(nation_entry_open_result.get("ok", false))
	)
	return {
		"attempted": true,
		"ok": ok,
		"reason": "tianxia_yutu_nation_profile_entry" if ok else "tianxia_yutu_nation_profile_entry_failed",
		"buttonEntryOk": button_entry_ok,
		"tianxiaWait": setup.get("tianxiaWait", {}),
		"panelSummaryBefore": panel_summary_before,
		"panelSummaryAfterSubmit": panel_summary_after_submit,
		"nationEntryOpenResult": nation_entry_open_result,
	}

func _apply_mainline_visual_smoke_alliance_frontline_marker() -> Dictionary:
	var adapter = _resolve_slg_domain_action_adapter()
	if not adapter.has_method("request_alliance_frontline_marker_update"):
		return {"attempted": true, "ok": false, "reason": "adapter_method_missing"}
	var result: Dictionary = await adapter.call(
		"request_alliance_frontline_marker_update",
		"frontline_marker_luoyang_push_v1",
		"洛阳推进线",
		{"x": 4300, "y": 2460},
		{"x": 4387, "y": 2482},
		"官员主世界标注验收"
	)
	if bool(result.get("ok", false)) and bool(result.get("requires_map_refresh", false)):
		await _refresh_world_and_map(true)
		_sync_tianxia_yutu_overlay_visibility_defaults()
		_refresh_tianxia_yutu_jump_panel()
	var summary := _read_tianxia_yutu_explicit_jump_summary()
	result["attempted"] = true
	result["frontlineMarkerCount"] = int(summary.get("frontlineMarkerCount", 0))
	result["frontlineMarkerAuthoritySource"] = str(summary.get("frontlineMarkerAuthoritySource", ""))
	result["ok"] = bool(result.get("ok", false)) and int(summary.get("frontlineMarkerCount", 0)) >= 1
	return result

func _apply_mainline_visual_smoke_nation_profile_local_draft(next_name: String, next_color_hex: String) -> Dictionary:
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {"attempted": true, "ok": false, "reason": "overlay_missing"}
	var panel_control := _active_overlay_panel as Control
	if panel_control == null:
		return {"attempted": true, "ok": false, "reason": "overlay_not_control"}
	var name_edit := panel_control.find_child("NationProfileNameEdit", true, false) as LineEdit
	if name_edit == null:
		return {"attempted": true, "ok": false, "reason": "name_edit_missing"}
	var normalized_color := next_color_hex.strip_edges().to_lower()
	var swatch_name := "NationProfileColorSwatch_%s" % normalized_color.replace("#", "")
