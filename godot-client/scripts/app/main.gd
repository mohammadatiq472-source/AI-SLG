func _press_mainline_visual_smoke_shell_chat_natural_language_proposal_decision(decision: String) -> Dictionary:
	var normalized_decision := decision.strip_edges()
	var expected_status := "approved" if normalized_decision == "approve" else "rejected"
	var expected_text := "已批准" if normalized_decision == "approve" else "已驳回"
	var command_text := "批准刚才这个方案。" if normalized_decision == "approve" else "驳回刚才这个方案。"
	var proposal_id := OS.get_environment("SLG_MAINLINE_VISUAL_SMOKE_AI_PROPOSAL_ID").strip_edges()
	var ai_player_id := OS.get_environment("SLG_MAINLINE_VISUAL_SMOKE_AI_PLAYER_ID").strip_edges()
	if ai_player_id == "":
		ai_player_id = "player_operator_alpha"
	var chat_open_result := await _press_mainline_visual_smoke_shell_open_chat_channel_keep_open()
	if _main_chat_overlay == null or not is_instance_valid(_main_chat_overlay):
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "main_chat_overlay_missing",
			"chatOpenResult": chat_open_result,
		}
	if _main_chat_overlay.has_method("open_ai_player_channel"):
		_main_chat_overlay.call("open_ai_player_channel", ai_player_id)
		await get_tree().process_frame
		await get_tree().create_timer(0.45).timeout
	var send_result: Dictionary = {}
	if _main_chat_overlay.has_method("run_mainline_visual_smoke_natural_language_decision"):
		var send_variant: Variant = await _main_chat_overlay.call("run_mainline_visual_smoke_natural_language_decision", command_text)
		if send_variant is Dictionary:
			send_result = send_variant as Dictionary
	if _main_chat_overlay.has_method("scroll_messages_to_bottom_for_visual_smoke"):
		_main_chat_overlay.call("scroll_messages_to_bottom_for_visual_smoke")
		await get_tree().process_frame
		await get_tree().create_timer(0.35).timeout
	var chat_summary: Dictionary = {}
	if _main_chat_overlay.has_method("get_chat_message_visual_smoke_summary"):
		var chat_summary_variant: Variant = _main_chat_overlay.call("get_chat_message_visual_smoke_summary")
		if chat_summary_variant is Dictionary:
			chat_summary = chat_summary_variant as Dictionary
	var proposal_status := ""
	var proposal_result: Dictionary = {}
	if _api_client != null and _api_client.has_method("get_ai_player_proposal") and proposal_id != "":
		var proposal_result_variant: Variant = await _api_client.call("get_ai_player_proposal", proposal_id)
		if proposal_result_variant is Dictionary:
			proposal_result = proposal_result_variant as Dictionary
			var proposal_data: Dictionary = proposal_result.get("data", {}) as Dictionary if proposal_result.get("data", {}) is Dictionary else {}
			var proposal: Dictionary = proposal_data.get("proposal", {}) as Dictionary if proposal_data.get("proposal", {}) is Dictionary else {}
			proposal_status = str(proposal.get("status", "")).strip_edges()
	var latest_ai_body := str(chat_summary.get("chatLatestAiBodyText", "")).strip_edges()
	var decision_source := str(chat_summary.get("chatLatestAiDecisionSource", "")).strip_edges()
	var decision_kind := str(chat_summary.get("chatLatestAiDecision", "")).strip_edges()
	var decision_status := str(chat_summary.get("chatLatestAiDecisionStatus", "")).strip_edges()
	var forbidden_hits: Array = []
	if _main_chat_overlay != null and is_instance_valid(_main_chat_overlay):
		forbidden_hits = _collect_mainline_visual_smoke_visible_text_hits(_main_chat_overlay, _mainline_visual_smoke_player_visible_forbidden_terms([
			"proposalId",
			"worldAction",
			"recruit_pool_select",
			"等待确认",
			"read model",
			"authority",
			"snake_case",
			"approve",
			"execute",
			"JSON",
			"provider",
			"env",
			"key",
		]))
	var chat_visible := _main_chat_overlay != null and is_instance_valid(_main_chat_overlay) and (_main_chat_overlay as CanvasItem).visible
	var accepted := (
		chat_visible
		and bool(send_result.get("ok", false))
		and decision_source == "chat_natural_language_proposal_decision"
		and decision_kind == normalized_decision
		and decision_status == expected_status
		and proposal_status == expected_status
		and latest_ai_body.find(expected_text) >= 0
		and forbidden_hits.is_empty()
	)
	return {
		"attempted": true,
		"ok": accepted,
		"clicked": true,
		"reason": "chat_natural_language_proposal_decision_verified" if accepted else "chat_natural_language_proposal_decision_not_verified",
		"chatNaturalLanguageProposalDecisionContract": "chat_natural_language_proposal_decision_visual_smoke_v1",
		"chatNaturalLanguageProposalDecisionAccepted": accepted,
		"chatNaturalLanguageProposalDecisionKind": normalized_decision,
		"chatNaturalLanguageProposalDecisionStatus": decision_status,
		"chatNaturalLanguageProposalDecisionRemoteStatus": proposal_status,
		"chatNaturalLanguageProposalDecisionSource": decision_source,
		"chatNaturalLanguageProposalDecisionLatestAiBody": latest_ai_body,
		"chatNaturalLanguageProposalDecisionForbiddenCopyClear": forbidden_hits.is_empty(),
		"chatNaturalLanguageProposalDecisionForbiddenCopyHits": forbidden_hits,
		"chatNaturalLanguageProposalDecisionScreenshotPath": _mainline_visual_smoke_screenshot_path,
		"proposalId": proposal_id,
		"aiPlayerId": ai_player_id,
		"commandText": command_text,
		"chatOpenResult": chat_open_result,
		"sendResult": send_result,
		"chatSummary": chat_summary,
		"proposalResult": proposal_result,
	}

