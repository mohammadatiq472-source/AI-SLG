		var returned_to_map := bool(close_result.get("closed", false)) and _display_mode == DISPLAY_MODE_WORLD and map_visible
		var close_ok := returned_to_map and bool(before_close_screenshot.get("ok", false))
		return {
			"attempted": true,
			"ok": page_content_ok and layout_ok and bool(page_summary.get("profileTabButtonClickVerified", false)) and close_ok,
			"clicked": true,
			"reason": "general_secondary_page_closed_to_map" if page_content_ok and layout_ok and bool(page_summary.get("profileTabButtonClickVerified", false)) and close_ok else "general_secondary_page_close_failed",
			"expectedPanelId": "generals",
