func _focus_mainline_visual_smoke_map_unit_tile(tile_id: String) -> Dictionary:
	if _map_grid == null or not is_instance_valid(_map_grid):
		return {"attempted": true, "ok": false, "reason": "map_grid_missing"}
	if not _map_grid.has_method("focus_and_select_main_map_cell_for_action"):
		return {"attempted": true, "ok": false, "reason": "map_grid_focus_select_missing"}
	var focus_cell := _resolve_mainline_visual_smoke_world_tile_focus_cell(tile_id)
	if focus_cell.is_empty():
		return {
			"attempted": true,
			"ok": false,
			"reason": "map_unit_focus_tile_missing",
			"tileId": tile_id,
		}
	var focus_context: Dictionary = {}
	var focus_variant: Variant = _map_grid.call(
		"focus_and_select_main_map_cell_for_action",
		int(focus_cell.get("x", 0)),
		int(focus_cell.get("y", 0))
	)
	if focus_variant is Dictionary:
		focus_context = (focus_variant as Dictionary).duplicate(true)
	await get_tree().process_frame
	await get_tree().process_frame
	return {
		"attempted": true,
		"ok": true,
		"reason": "map_unit_focus_tile_applied",
		"tileId": tile_id,
		"cell": focus_cell,
		"context": focus_context,
	}


func _resolve_mainline_visual_smoke_world_tile_focus_cell(tile_id: String) -> Dictionary:
	var normalized_tile_id := tile_id.strip_edges()
	if normalized_tile_id == "":
		return {}
	var world_map: Dictionary = WorldStore.world.get("map", {}) as Dictionary
	var raw_tiles: Variant = world_map.get("tiles", [])
	if raw_tiles is Array:
		for tile_variant in raw_tiles as Array:
			if not (tile_variant is Dictionary):
				continue
			var tile: Dictionary = tile_variant as Dictionary
			if str(tile.get("id", "")).strip_edges() != normalized_tile_id:
				continue
			return _project_mainline_visual_smoke_tile_focus_cell(
				normalized_tile_id,
				roundi(float(tile.get("x", 0.0))),
				roundi(float(tile.get("y", 0.0)))
			)
	var fallback_scenario_coords := {
		"tile_03": Vector2i(152, 158),
		"tile_07": Vector2i(151, 159),
		"tile_08": Vector2i(152, 159),
		"tile_09": Vector2i(153, 159),
		"tile_13": Vector2i(152, 160),
	}
	if fallback_scenario_coords.has(normalized_tile_id):
		var fallback_coord: Vector2i = fallback_scenario_coords[normalized_tile_id] as Vector2i
		return _project_mainline_visual_smoke_tile_focus_cell(normalized_tile_id, fallback_coord.x, fallback_coord.y)
	return {}


func _project_mainline_visual_smoke_tile_focus_cell(tile_id: String, tile_x: int, tile_y: int) -> Dictionary:
	var cell_x := tile_x
	var cell_y := tile_y
	if tile_id.begins_with("tile_") and tile_x < 1000 and tile_y < 1000 and abs(tile_x - 152) <= 128 and abs(tile_y - 159) <= 128:
		cell_x = 4300 + tile_x - 152
		cell_y = 2538 + tile_y - 159
	return {
		"x": cell_x,
		"y": cell_y,
	}


func _wait_for_mainline_visual_smoke_world_unit(unit_id: String, timeout_seconds: float) -> Dictionary:
	var waited_seconds := 0.0
	while waited_seconds <= timeout_seconds:
		var unit := _find_mainline_visual_smoke_world_unit(unit_id)
		if not unit.is_empty():
			return unit
		await get_tree().create_timer(0.20).timeout
		waited_seconds += 0.20
	return {}


func _find_mainline_visual_smoke_world_unit(unit_id: String) -> Dictionary:
	var normalized_unit_id := unit_id.strip_edges()
	if normalized_unit_id == "":
		return {}
	var raw_units: Variant = WorldStore.world.get("units", [])
	if not (raw_units is Array):
		return {}
	for unit_variant in raw_units as Array:
		if not (unit_variant is Dictionary):
			continue
		var unit: Dictionary = unit_variant as Dictionary
		if str(unit.get("id", "")).strip_edges() == normalized_unit_id:
			return unit.duplicate(true)
	return {}


func _resolve_mainline_visual_smoke_march_target_tile_id(unit_id: String, origin_tile_id: String) -> String:
	var normalized_origin := origin_tile_id.strip_edges()
	if normalized_origin == "":
		var unit := _find_mainline_visual_smoke_world_unit(unit_id)
		normalized_origin = str(unit.get("tileId", "")).strip_edges()
	if normalized_origin == "":
		return ""
	var requested_target := OS.get_environment("SLG_MAINLINE_VISUAL_SMOKE_MAP_UNIT_MARCH_TARGET_TILE_ID").strip_edges()
	var world_map: Dictionary = WorldStore.world.get("map", {}) as Dictionary
	var connections: Dictionary = world_map.get("connections", {}) as Dictionary
	var candidates_variant: Variant = connections.get(normalized_origin, [])
	var candidate_tile_ids: Array[String] = []
	var smoke_fallback_connections := {
		"tile_08": ["tile_03", "tile_13", "tile_09", "tile_07"],
	}
	if requested_target != "" and requested_target != normalized_origin:
		candidate_tile_ids.append(requested_target)
	var fallback_candidates_variant: Variant = smoke_fallback_connections.get(normalized_origin, [])
	if fallback_candidates_variant is Array:
		for fallback_variant in fallback_candidates_variant as Array:
			var fallback_tile_id := str(fallback_variant).strip_edges()
			if fallback_tile_id != "" and not candidate_tile_ids.has(fallback_tile_id):
				candidate_tile_ids.append(fallback_tile_id)
	if candidates_variant is Array:
		for candidate_variant in candidates_variant as Array:
			var candidate_from_connections := str(candidate_variant).strip_edges()
			if candidate_from_connections != "" and not candidate_tile_ids.has(candidate_from_connections):
				candidate_tile_ids.append(candidate_from_connections)
	for candidate_variant in candidate_tile_ids:
		var candidate_tile_id := str(candidate_variant).strip_edges()
		if candidate_tile_id == "" or candidate_tile_id == normalized_origin:
			continue
		if _mainline_visual_smoke_world_tile_exists(candidate_tile_id) or not connections.has(normalized_origin) or smoke_fallback_connections.has(normalized_origin):
			return candidate_tile_id
	return ""


func _mainline_visual_smoke_world_tile_exists(tile_id: String) -> bool:
	var normalized_tile_id := tile_id.strip_edges()
	if normalized_tile_id == "":
		return false
	if not _read_tile_data(normalized_tile_id).is_empty():
		return true
	var world_map: Dictionary = WorldStore.world.get("map", {}) as Dictionary
	var raw_tiles: Variant = world_map.get("tiles", [])
	if not (raw_tiles is Array):
		return false
	for tile_variant in raw_tiles as Array:
		if not (tile_variant is Dictionary):
			continue
		var tile: Dictionary = tile_variant as Dictionary
		if str(tile.get("id", "")).strip_edges() == normalized_tile_id:
			return true
	return false


func _extract_mainline_visual_smoke_unit_marker_summary(map_unit_summary: Dictionary, unit_id: String) -> Dictionary:
	var raw_markers: Variant = map_unit_summary.get("markers", [])
	if not (raw_markers is Array):
		return {}
	for marker_variant in raw_markers as Array:
		if not (marker_variant is Dictionary):
			continue
		var marker: Dictionary = marker_variant as Dictionary
		if str(marker.get("unitId", "")).strip_edges() != unit_id.strip_edges():
			continue
		var marker_state: Dictionary = marker.get("marker", {}) as Dictionary
		var result := marker_state.duplicate(true)
		result["unitId"] = str(marker.get("unitId", ""))
		result["visualType"] = str(marker.get("visualType", ""))
		result["selected"] = bool(marker.get("selected", false))
		result["position"] = marker.get("position", {})
		return result
	return {}


func _extract_mainline_visual_smoke_formation_visual_types(marker_summary: Dictionary) -> Array:
	var result: Array = []
	var raw_types: Variant = marker_summary.get("formationVisualTypes", [])
	if not (raw_types is Array):
		return result
	for type_variant in raw_types as Array:
		var visual_type := str(type_variant).strip_edges()
		if visual_type != "" and not result.has(visual_type):
			result.append(visual_type)
	return result


