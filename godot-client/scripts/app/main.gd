		return {"attempted": true, "ok": false, "reason": "overlay_not_control"}
	var name_edit := panel_control.find_child("NationProfileUpdateNameEdit", true, false) as LineEdit
	var name_button := panel_control.find_child("NationProfileUpdateNameSubmitButton", true, false) as Button
