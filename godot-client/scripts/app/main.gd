func _count_mainline_visual_smoke_visible_nodes_by_name_prefix(root: Node, prefix: String) -> int:
	if root == null:
		return 0
	var count := 0
	var visible_node := true
	if root is CanvasItem:
		visible_node = (root as CanvasItem).visible and (root as CanvasItem).is_visible_in_tree()
	if visible_node and str(root.name).begins_with(prefix):
		count += 1
	for child in root.get_children():
		if child is Node:
			count += _count_mainline_visual_smoke_visible_nodes_by_name_prefix(child as Node, prefix)
	return count

func _count_mainline_visual_smoke_visible_labels_by_text(root: Node, target_text: String) -> int:
	if root == null:
		return 0
	var count := 0
	var visible_node := true
	if root is CanvasItem:
		visible_node = (root as CanvasItem).visible and (root as CanvasItem).is_visible_in_tree()
	var label := root as Label
	if visible_node and label != null and label.text.strip_edges() == target_text:
		count += 1
	for child in root.get_children():
		if child is Node:
			count += _count_mainline_visual_smoke_visible_labels_by_text(child as Node, target_text)
	return count

func _collect_mainline_visual_smoke_visible_controls_by_name_prefix(root: Node, prefix: String) -> Array:
	var result: Array = []
	_collect_mainline_visual_smoke_visible_controls_by_name_prefix_into(root, prefix, result)
	return result

func _collect_mainline_visual_smoke_visible_controls_by_name_prefix_into(root: Node, prefix: String, result: Array) -> void:
	if root == null:
		return
	var visible_node := true
	if root is CanvasItem:
		visible_node = (root as CanvasItem).visible and (root as CanvasItem).is_visible_in_tree()
	var control := root as Control
	if visible_node and control != null and str(root.name).begins_with(prefix):
		result.append(control)
	for child in root.get_children():
		if child is Node:
			_collect_mainline_visual_smoke_visible_controls_by_name_prefix_into(child as Node, prefix, result)

func _mainline_visual_smoke_rect_intersects(a: Rect2, b: Rect2) -> bool:
	if a.size.x <= 0.0 or a.size.y <= 0.0 or b.size.x <= 0.0 or b.size.y <= 0.0:
		return false
	return (
		a.position.x < b.position.x + b.size.x
		and a.position.x + a.size.x > b.position.x
		and a.position.y < b.position.y + b.size.y
		and a.position.y + a.size.y > b.position.y
	)

