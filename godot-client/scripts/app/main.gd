func _press_mainline_visual_smoke_main_map_immunity_reject_cell(_panel_id: String) -> Dictionary:
	if _display_mode != DISPLAY_MODE_WORLD:
		return {
			"attempted": true,
			"ok": false,
			"reason": "display_mode_not_world",
			"displayMode": _display_mode,
		}
	if _map_grid == null or not is_instance_valid(_map_grid):
		return {
			"attempted": true,
			"ok": false,
			"reason": "map_grid_missing",
		}
	if not _map_grid.has_method("focus_and_select_main_map_cell_for_action"):
		return {
			"attempted": true,
			"ok": false,
			"reason": "map_grid_focus_select_missing",
		}

	var raw_target_x := OS.get_environment("SLG_MAIN_MAP_IMMUNITY_REJECT_CELL_X").strip_edges()
	var raw_target_y := OS.get_environment("SLG_MAIN_MAP_IMMUNITY_REJECT_CELL_Y").strip_edges()
	var target_cell_x: int = 4389 if raw_target_x == "" else maxi(0, raw_target_x.to_int())
	var target_cell_y: int = 2482 if raw_target_y == "" else maxi(0, raw_target_y.to_int())
	var enemy_faction_id: String = OS.get_environment("SLG_MAIN_MAP_IMMUNITY_REJECT_OWNER").strip_edges()
	if enemy_faction_id == "":
		enemy_faction_id = "enemy"
	var before_context: Dictionary = await _focus_select_main_map_cell_for_action_with_viewport_refresh(target_cell_x, target_cell_y)
	if before_context.is_empty():
		return {
			"attempted": true,
			"ok": false,
			"reason": "target_cell_selection_missing",
			"targetCell": {"x": target_cell_x, "y": target_cell_y},
		}
	var before_owner: String = str(before_context.get("owner", "neutral")).strip_edges()
	if before_owner == "":
		before_owner = "neutral"
	var setup_result: Dictionary = {}
	var setup_performed := false
	if before_owner == enemy_faction_id and _is_main_map_cell_context_immunity_active(before_context):
		setup_result = {
			"ok": true,
			"reason": "target_already_enemy_immune",
		}
	elif before_owner != "neutral":
		return {
			"attempted": true,
			"ok": false,
			"reason": "setup_target_not_neutral",
			"targetCell": {"x": target_cell_x, "y": target_cell_y},
			"beforeContext": before_context,
			"enemyFactionId": enemy_faction_id,
		}
	else:
		var setup_payload: Dictionary = {
			"worldId": str(before_context.get("worldId", MAIN_MAP_WORLD_ID)).strip_edges(),
			"coordinateSpace": str(before_context.get("coordinateSpace", MAIN_MAP_COORDINATE_SPACE)).strip_edges(),
			"factionId": enemy_faction_id,
			"requestId": "godot_main_map_immunity_reject_setup_%d_%d_%d" % [target_cell_x, target_cell_y, Time.get_ticks_msec()],
			"cellX": target_cell_x,
			"cellY": target_cell_y,
			"expectedOwner": before_owner,
			"expectedCellVersion": int(before_context.get("cellVersion", 0)),
		}
		setup_result = await _api_client.post_world_action("claimMainMapCell", setup_payload, true)
		setup_performed = true
		if not bool(setup_result.get("ok", false)):
			return {
				"attempted": true,
				"ok": false,
				"reason": "setup_request_failed",
				"targetCell": {"x": target_cell_x, "y": target_cell_y},
				"beforeContext": before_context,
				"setupResult": setup_result,
			}
		var setup_data: Dictionary = setup_result.get("data", {}) as Dictionary
		if not bool(setup_data.get("ok", false)):
			return {
				"attempted": true,
				"ok": false,
				"reason": "setup_claim_rejected",
				"targetCell": {"x": target_cell_x, "y": target_cell_y},
				"beforeContext": before_context,
				"setupResult": setup_result,
			}
		var setup_receipt_variant: Variant = setup_data.get("receipt", {})
		if setup_receipt_variant is Dictionary:
			var setup_receipt: Dictionary = setup_receipt_variant as Dictionary
			_apply_main_map_owner_delta_message_to_map_grid(_build_main_map_owner_delta_message_from_receipt(setup_receipt, "claim", setup_payload))
		await _refresh_main_map_cell_owner_delta()

	var immune_context: Dictionary = await _focus_select_main_map_cell_for_action_with_viewport_refresh(target_cell_x, target_cell_y)
	await get_tree().process_frame
	var claim_button_disabled_immune: bool = _main_map_claim_cell_button != null and _main_map_claim_cell_button.disabled
	var reject_result: Dictionary = await _execute_main_map_cell_owner_action("claim", "visual_smoke_immunity_reject")
	await get_tree().process_frame
	await get_tree().process_frame
	var failure_response: Dictionary = reject_result.get("response", {}) as Dictionary
	var failure_code: String = str(failure_response.get("failureCode", failure_response.get("failure_code", ""))).strip_edges()
	var failure_until: String = str(failure_response.get("immunityUntil", failure_response.get("immunity_until", ""))).strip_edges()
	var summary_text: String = _main_map_cell_action_summary_label.text if _main_map_cell_action_summary_label != null else ""
	var readable_warning_ok := summary_text.find("免战保护中") >= 0 and summary_text.find("暂不能占领") >= 0
	var screenshot_path := _mainline_visual_smoke_aux_screenshot_path("00_immunity_reject_main_map_cell.png")
	var screenshot: Dictionary = _save_mainline_visual_smoke_screenshot(screenshot_path) if screenshot_path != "" else {"ok": false, "reason": "screenshot_path_empty"}

	var cleanup_payload: Dictionary = {
		"worldId": str(immune_context.get("worldId", before_context.get("worldId", MAIN_MAP_WORLD_ID))).strip_edges(),
		"coordinateSpace": str(immune_context.get("coordinateSpace", before_context.get("coordinateSpace", MAIN_MAP_COORDINATE_SPACE))).strip_edges(),
		"factionId": enemy_faction_id,
		"requestId": "godot_main_map_immunity_reject_cleanup_%d_%d_%d" % [target_cell_x, target_cell_y, Time.get_ticks_msec()],
		"cellX": target_cell_x,
		"cellY": target_cell_y,
		"expectedOwner": enemy_faction_id,
		"expectedCellVersion": int(immune_context.get("cellVersion", 1)),
	}
	var cleanup_result: Dictionary = {}
	if setup_performed:
		cleanup_result = await _api_client.post_world_action("releaseMainMapCell", cleanup_payload, true)
	var ok := (
		not bool(reject_result.get("ok", false))
		and str(reject_result.get("reason", "")) == "action_rejected"
		and failure_code == "main_map_cell_immunity_active"
		and bool(failure_response.get("immunityActive", failure_response.get("immunity_active", false)))
		and failure_until != ""
		and readable_warning_ok
		and bool(screenshot.get("ok", false))
	)
	return {
		"attempted": true,
		"ok": ok,
		"clicked": true,
		"reason": "main_map_immunity_reject_verified" if ok else "main_map_immunity_reject_not_verified",
		"targetCell": {"x": target_cell_x, "y": target_cell_y},
		"enemyFactionId": enemy_faction_id,
		"beforeContext": before_context,
		"setupPerformed": setup_performed,
		"setupResult": setup_result,
		"immuneContext": immune_context,
		"claimButtonDisabledImmune": claim_button_disabled_immune,
		"rejectResult": reject_result,
		"failureResponse": failure_response,
		"failureCode": failure_code,
		"failureUntil": failure_until,
		"summaryText": summary_text,
		"readableWarningOk": readable_warning_ok,
		"screenshot": screenshot,
		"cleanupResult": cleanup_result,
	}

func _find_alliance_frontline_marker_read_model(marker_id: String) -> Dictionary:
	var normalized_marker_id := marker_id.strip_edges()
	if normalized_marker_id == "":
		return {}
	var map_variant: Variant = WorldStore.map_layout.get("map", {})
	if not (map_variant is Dictionary):
		return {}
	var map_data: Dictionary = map_variant as Dictionary
	var markers_variant: Variant = map_data.get("allianceFrontlineMarkers", [])
	if not (markers_variant is Array):
		return {}
	var markers: Array = markers_variant as Array
	for marker_variant in markers:
		if not (marker_variant is Dictionary):
			continue
		var marker: Dictionary = marker_variant as Dictionary
		if str(marker.get("id", "")).strip_edges() == normalized_marker_id:
			return marker.duplicate(true)
	return {}

func _fetch_tianxia_yutu_frontline_marker_read_model(marker_id: String) -> Dictionary:
	var normalized_marker_id := marker_id.strip_edges()
	if normalized_marker_id == "":
		return {"ok": false, "reason": "marker_id_empty"}
	var result: Dictionary = await _api_client.get_map_layout("viewport", _build_tianxia_yutu_overview_query_params())
	if not bool(result.get("ok", false)):
		return {"ok": false, "reason": "overview_request_failed", "result": result}
	var data: Dictionary = result.get("data", {}) as Dictionary
	var layer_variant: Variant = data.get("tianxia_yutu_overview_layer", {})
	if not (layer_variant is Dictionary):
		return {"ok": false, "reason": "overview_layer_missing", "result": result}
	var layer: Dictionary = layer_variant as Dictionary
	var strategic_variant: Variant = layer.get("strategic_overlay_layer", {})
	if not (strategic_variant is Dictionary):
		return {"ok": false, "reason": "strategic_overlay_missing", "result": result}
	var strategic_layer: Dictionary = strategic_variant as Dictionary
	var markers_variant: Variant = strategic_layer.get("frontline_markers", [])
	if not (markers_variant is Array):
		return {"ok": false, "reason": "frontline_markers_missing", "result": result}
	var markers: Array = markers_variant as Array
	for marker_variant in markers:
		if not (marker_variant is Dictionary):
			continue
		var marker: Dictionary = marker_variant as Dictionary
		if str(marker.get("id", "")).strip_edges() == normalized_marker_id:
			return {"ok": true, "marker": marker.duplicate(true)}
	return {"ok": false, "reason": "marker_not_found", "markerId": normalized_marker_id}

