		if key.begins_with("shellNav") or key.begins_with("shellCommand") or key.begins_with("shellBottom"):
			target[key] = shell_nav_layout_summary[key_variant]

func _press_mainline_visual_smoke_world_affairs_claim_reward(panel_id: String) -> Dictionary:
	if panel_id != "world_affairs":
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "world_affairs_panel_required",
			"activePanelId": _active_panel_id,
			"panelId": panel_id,
		}
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "panel_missing",
			"activePanelId": _active_panel_id,
		}
	_reset_mainline_visual_smoke_overlay_scroll()
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(0.35).timeout
	var claim_button := _find_mainline_visual_smoke_visible_button(_active_overlay_panel, "WorldAffairsClaimButton")
	if claim_button == null:
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "claim_button_missing",
			"activePanelId": _active_panel_id,
			"before": _read_mainline_visual_smoke_world_affairs_summary(),
		}
	if claim_button.disabled:
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "claim_button_disabled",
			"activePanelId": _active_panel_id,
			"buttonText": claim_button.text,
			"before": _read_mainline_visual_smoke_world_affairs_summary(),
		}
	var action_id := str(claim_button.get_meta("action_id", "")).strip_edges()
	var claimed_node_id := action_id.trim_prefix("world_affairs_claim:").strip_edges() if action_id.begins_with("world_affairs_claim:") else ""
	var button_text := claim_button.text
	var before_summary := _read_mainline_visual_smoke_world_affairs_summary()
	var panel_node := _find_mainline_visual_smoke_visible_node_with_method(_active_overlay_panel, "get_world_affairs_visual_smoke_summary")
	var trigger_mode := "button_signal"
	if panel_node != null and panel_node.has_method("_claim_world_affairs_node_reward"):
		trigger_mode = "panel_claim_method"
		await panel_node.call("_claim_world_affairs_node_reward", claimed_node_id)
	elif panel_node != null and panel_node.has_method("_on_section_page_action_requested"):
		trigger_mode = "panel_action_handler"
		panel_node.call("_on_section_page_action_requested", action_id)
	else:
		claim_button.emit_signal("pressed")
	var after_summary := {}
	var after_node := {}
	for _attempt in range(18):
		await get_tree().process_frame
		await get_tree().create_timer(0.25).timeout
		after_summary = _read_mainline_visual_smoke_world_affairs_summary()
		after_node = _find_mainline_visual_smoke_world_affairs_node_summary(after_summary, claimed_node_id)
		if str(after_node.get("claimState", "")).strip_edges() == "claimed":
			break
	var claimed := str(after_node.get("claimState", "")).strip_edges() == "claimed" and not bool(after_node.get("canClaim", true))
	var read_model_refreshed := bool(after_summary.get("readModelLoaded", false)) and not after_node.is_empty()
	var forbidden_copy_hits: Array = []
	var forbidden_copy_clear := forbidden_copy_hits.is_empty()
	var gameplay_anchor_ok := claimed and read_model_refreshed and forbidden_copy_clear
	return {
		"attempted": true,
		"ok": gameplay_anchor_ok,
		"clicked": true,
		"reason": "claimed" if gameplay_anchor_ok else "claim_state_not_refreshed",
		"activePanelId": _active_panel_id,
		"buttonText": button_text,
		"actionId": action_id,
		"nodeId": claimed_node_id,
		"worldAffairsClaimRewardTriggerMode": trigger_mode,
		"worldAffairsClaimRewardGameplayAnchorOk": gameplay_anchor_ok,
		"worldAffairsClaimRewardRemoteApplied": claimed,
		"worldAffairsClaimRewardReadModelRefreshed": read_model_refreshed,
		"worldAffairsClaimRewardClaimedNodeId": claimed_node_id,
		"worldAffairsClaimRewardAfterClaimState": str(after_node.get("claimState", "")).strip_edges(),
		"worldAffairsClaimRewardCanClaimAfter": bool(after_node.get("canClaim", true)),
		"worldAffairsClaimRewardForbiddenCopyClear": forbidden_copy_clear,
		"worldAffairsClaimRewardForbiddenCopyHits": forbidden_copy_hits,
		"before": before_summary,
		"after": after_summary,
		"afterNode": after_node,
	}

func _read_mainline_visual_smoke_world_affairs_summary() -> Dictionary:
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {"ok": false, "reason": "panel_missing"}
	var panel_node := _find_mainline_visual_smoke_visible_node_with_method(_active_overlay_panel, "get_world_affairs_visual_smoke_summary")
	if panel_node == null:
		return {"ok": false, "reason": "world_affairs_summary_missing"}
	var summary_variant: Variant = panel_node.call("get_world_affairs_visual_smoke_summary")
	if summary_variant is Dictionary:
		var summary := summary_variant as Dictionary
		summary["ok"] = bool(summary.get("readModelLoaded", false))
		return summary
	return {"ok": false, "reason": "world_affairs_summary_invalid"}

func _find_mainline_visual_smoke_world_affairs_node_summary(summary: Dictionary, node_id: String) -> Dictionary:
	var normalized_node_id := node_id.strip_edges()
	if normalized_node_id == "":
		return {}
	var nodes_variant: Variant = summary.get("nodes", [])
	if not (nodes_variant is Array):
		return {}
	for node_variant in nodes_variant as Array:
		if not (node_variant is Dictionary):
			continue
		var node := node_variant as Dictionary
		if str(node.get("nodeId", "")).strip_edges() == normalized_node_id:
			return node
	return {}

func _read_mainline_visual_smoke_world_event_activity_page_summary(panel_id: String, page_id: String) -> Dictionary:
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {"ok": false, "reason": "panel_missing"}
	var panel_node := _find_mainline_visual_smoke_visible_node_with_method(_active_overlay_panel, "get_world_event_activity_visual_smoke_summary")
	if panel_node == null:
		return {"ok": false, "reason": "world_event_activity_summary_missing"}
	var resolved_page_id := page_id.strip_edges()
	if resolved_page_id == "":
		resolved_page_id = _resolve_world_event_activity_registered_page_id(panel_id)
	var summary_variant: Variant = panel_node.call("get_world_event_activity_visual_smoke_summary", resolved_page_id)
	if summary_variant is Dictionary:
		var summary := summary_variant as Dictionary
		summary["ok"] = bool(summary.get("ok", false))
		summary["panelId"] = panel_id
		summary["expectedPageId"] = resolved_page_id
