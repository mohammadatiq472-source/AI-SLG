			"createdAt": "2026-05-28T12:%02d:00Z" % (12 + index),
			"receiptProposalId": str(receipt.get("proposalId", "")),
			"action": str(receipt.get("action", "")),
			"receiptOk": receipt_ok,
			"failureCode": failure_code,
			"metadata": {
				"messageStyle": "ai_player_emotional_receipt_v1",
				"worldAction": world_action,
				"actionRequestId": action_request_id,
				"receiptNarrative": {
