func _press_mainline_visual_smoke_ai_panel_context_document_open(panel_id: String) -> Dictionary:
	if panel_id != "ai_hub" or _active_panel_id != "ai_hub":
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "active_panel_not_ai_hub",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
		}
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "overlay_missing",
			"activePanelId": _active_panel_id,
		}
	if not _active_overlay_panel.has_method("_open_context_file_popup"):
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "context_document_popup_method_missing",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
		}
	_active_overlay_panel.call("_open_context_file_popup")
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(0.15).timeout
	var popup := _active_overlay_panel.get_node_or_null("AIContextFilePopup")
	var visible := popup != null and is_instance_valid(popup) and (popup as CanvasItem).visible
	var popup_rect := Rect2()
	var viewport_size := get_viewport().get_visible_rect().size
	var popup_inside_viewport := false
	if popup is Control:
		var popup_control := popup as Control
		popup_rect = popup_control.get_global_rect()
		popup_inside_viewport = (
			popup_rect.position.x >= -1.0
			and popup_rect.position.y >= -1.0
			and popup_rect.end.x <= viewport_size.x + 1.0
			and popup_rect.end.y <= viewport_size.y + 1.0
		)
	return {
		"attempted": true,
		"ok": visible,
		"clicked": true,
		"reason": "ai_context_document_popup_opened" if visible else "ai_context_document_popup_not_visible",
		"panelId": panel_id,
		"activePanelId": _active_panel_id,
		"pageContentOk": visible,
		"pageContentSummary": {
			"ok": visible,
			"panelId": "ai_hub",
			"activePageId": _read_mainline_visual_smoke_active_overlay_page_id(),
			"aiContextDocumentPopupVisible": visible,
			"aiContextDocumentSupportedKinds": "identity/memory/skill/instruction",
			"aiContextDocumentFileExtensions": "txt/md/skll/skill",
			"aiContextDocumentImageUploadVisible": false,
			"aiContextDocumentPopupResponsiveToken": "ai_context_file_popup_responsive_v1",
			"aiContextDocumentPopupInsideViewport": popup_inside_viewport,
			"aiContextDocumentPopupWidth": int(popup_rect.size.x),
			"aiContextDocumentPopupHeight": int(popup_rect.size.y),
			"aiContextDocumentViewportWidth": int(viewport_size.x),
			"aiContextDocumentViewportHeight": int(viewport_size.y),
		},
	}

func _press_mainline_visual_smoke_ai_panel_context_document_cancel_action(panel_id: String) -> Dictionary:
	var open_result := await _press_mainline_visual_smoke_ai_panel_context_document_open(panel_id)
	if not bool(open_result.get("ok", false)):
		return open_result
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "overlay_missing_after_context_popup_open",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
		}
	var popup := _active_overlay_panel.get_node_or_null("AIContextFilePopup")
	var cancel_button := _find_mainline_visual_smoke_visible_button_by_meta(_active_overlay_panel, "ai_panel_action_id", "ai_context_file_cancel")
	if cancel_button == null:
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "ai_context_file_cancel_button_missing",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
			"pageContentSummary": open_result.get("pageContentSummary", {}),
		}
	if cancel_button.disabled:
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "ai_context_file_cancel_button_disabled",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
			"pageContentSummary": open_result.get("pageContentSummary", {}),
