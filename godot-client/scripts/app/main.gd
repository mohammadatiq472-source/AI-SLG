func _focus_mainline_visual_smoke_mountain_boundary_target(preferred_line_role: String = "", requested_runtime_placement_id: String = "") -> Dictionary:
	if _map_grid == null or not is_instance_valid(_map_grid):
		return {"attempted": true, "ok": false, "reason": "map_grid_missing"}
	if not _map_grid.has_method("focus_and_select_main_map_cell_for_action"):
		return {"attempted": true, "ok": false, "reason": "map_grid_focus_select_missing"}
	var normalized_requested_placement_id := requested_runtime_placement_id.strip_edges()
	var target_cell: Dictionary = _resolve_mainline_visual_smoke_mountain_boundary_target_cell(WorldStore.map_layout, preferred_line_role, normalized_requested_placement_id)
	if target_cell.is_empty():
		return {
			"attempted": true,
			"ok": false,
			"reason": "mountain_boundary_target_missing",
			"preferredLineRole": preferred_line_role,
			"requestedRuntimePlacementId": normalized_requested_placement_id,
		}
	return await _focus_mainline_visual_smoke_mountain_boundary_cell(target_cell, preferred_line_role)

func _focus_mainline_visual_smoke_mountain_boundary_cell(target_cell: Dictionary, preferred_line_role: String = "") -> Dictionary:
	if _map_grid == null or not is_instance_valid(_map_grid):
		return {"attempted": true, "ok": false, "reason": "map_grid_missing"}
	if not _map_grid.has_method("focus_and_select_main_map_cell_for_action"):
		return {"attempted": true, "ok": false, "reason": "map_grid_focus_select_missing"}
	if target_cell.is_empty():
		return {"attempted": true, "ok": false, "reason": "mountain_boundary_target_missing"}
	_close_tianxia_yutu_overview()
	_set_main_map_view_mode(MAIN_MAP_VIEW_MODE_GAMEPLAY)
	_set_display_mode(DISPLAY_MODE_WORLD)
	if _main_city_hub_overlay != null and is_instance_valid(_main_city_hub_overlay) and _main_city_hub_overlay.has_method("set_expanded"):
		_main_city_hub_overlay.call("set_expanded", false)
	var target_x: int = int(target_cell.get("x", -1))
	var target_y: int = int(target_cell.get("y", -1))
	var focus_context: Dictionary = {}
	var focus_variant: Variant = _map_grid.call("focus_and_select_main_map_cell_for_action", target_x, target_y)
	if focus_variant is Dictionary:
		focus_context = (focus_variant as Dictionary).duplicate(true)
	await get_tree().process_frame
	var query_params: Dictionary = _resolve_map_layout_query_params()
	var request_key: String = _build_map_layout_request_key(_active_map_scope, query_params)
	var refresh_ok: bool = await _refresh_viewport_map_layout_immediate(query_params, request_key)
	await get_tree().process_frame
	await get_tree().process_frame
	var selected_context: Dictionary = _resolve_selected_main_map_cell_context()
	var selection_checked := not selected_context.is_empty()
	var selection_matches_target := (
		int(selected_context.get("cellX", -1)) == target_x
		and int(selected_context.get("cellY", -1)) == target_y
	)
	var focus_ok: bool = refresh_ok and (not selection_checked or selection_matches_target)
	return {
		"attempted": true,
		"ok": focus_ok and refresh_ok,
		"reason": "mountain_boundary_focused" if focus_ok and refresh_ok else "mountain_boundary_focus_failed",
		"targetCell": target_cell,
		"focusContext": focus_context,
		"selectedCell": selected_context,
		"selectionChecked": selection_checked,
		"selectionMatchesTarget": selection_matches_target,
		"refreshOk": refresh_ok,
		"requestKey": request_key,
		"preferredLineRole": preferred_line_role,
	}


func _resolve_mainline_visual_smoke_chokepoint_target_cell(map_layout_data: Dictionary, requested_runtime_chokepoint_id: String = "") -> Dictionary:
	var layer_variant: Variant = map_layout_data.get("main_world_chokepoint_layer", {})
	if not (layer_variant is Dictionary):
		return {}
	var layer: Dictionary = layer_variant as Dictionary
	var raw_nodes: Variant = layer.get("visible_nodes", [])
	if not (raw_nodes is Array):
		return {}
	var requested_id := requested_runtime_chokepoint_id.strip_edges()
	for node_variant in raw_nodes as Array:
		if not (node_variant is Dictionary):
			continue
		var node: Dictionary = node_variant as Dictionary
		if requested_id != "" and not _mainline_visual_smoke_chokepoint_node_matches_request(node, requested_id):
			continue
		var render_pieces_variant: Variant = node.get("render_pieces", [])
		if render_pieces_variant is Array:
			for piece_variant in render_pieces_variant as Array:
				if not (piece_variant is Dictionary):
					continue
				var piece: Dictionary = piece_variant as Dictionary
				var piece_cell: Dictionary = _mainline_visual_smoke_cell_from_variant(piece.get("cell_1km", []))
				if not piece_cell.is_empty():
					piece_cell["source"] = "chokepoint_render_piece"
					piece_cell["runtimeChokepointId"] = str(node.get("runtime_chokepoint_id", ""))
					piece_cell["sourceGateId"] = str(node.get("source_gate_id", ""))
					piece_cell["boundaryPairKey"] = str(node.get("boundary_pair_key", ""))
					piece_cell["pieceId"] = str(piece.get("piece_id", ""))
					return piece_cell
		var node_cell: Dictionary = _mainline_visual_smoke_cell_from_variant(node.get("cell_1km", {}))
		if not node_cell.is_empty():
			node_cell["source"] = "chokepoint_node_cell"
			node_cell["runtimeChokepointId"] = str(node.get("runtime_chokepoint_id", ""))
			node_cell["sourceGateId"] = str(node.get("source_gate_id", ""))
			node_cell["boundaryPairKey"] = str(node.get("boundary_pair_key", ""))
			node_cell["pieceId"] = ""
			return node_cell
	return {}


func _mainline_visual_smoke_chokepoint_node_matches_request(node: Dictionary, requested_id: String) -> bool:
	if requested_id == "":
		return true
	var candidate_fields: Array = [
		"runtime_chokepoint_id",
		"source_gate_id",
		"source_gate_jump_target_id",
		"boundary_pair_key",
	]
	for field in candidate_fields:
		if str(node.get(field, "")).strip_edges() == requested_id:
			return true
	var render_pieces_variant: Variant = node.get("render_pieces", [])
	if render_pieces_variant is Array:
		for piece_variant in render_pieces_variant as Array:
			if not (piece_variant is Dictionary):
				continue
			var piece: Dictionary = piece_variant as Dictionary
			if str(piece.get("render_piece_id", "")).strip_edges() == requested_id:
				return true
	return false


