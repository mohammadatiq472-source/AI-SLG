func _read_mainline_visual_smoke_ai_panel_status_summary() -> Dictionary:
	var ai_state := WorldStore.get_ai_state(_target_faction_id)
	var runtime_items: Array = []
	var runtime_items_variant: Variant = ai_state.get("playerRuntimeList", [])
	if runtime_items_variant is Array:
		runtime_items = runtime_items_variant as Array
	var summary := {
		"attempted": false,
		"playerRuntimeCount": runtime_items.size(),
		"modelStatusVisible": false,
		"modelName": "",
		"source": "",
		"budgetTier": "",
		"secretConfigured": false,
		"fallbackEnabled": false,
		"listCardCount": 0,
		"listSummaryVisible": false,
		"autonomyGuardVisible": false,
		"autonomyGuardMode": "",
		"autonomyGuardExecutionEnabled": false,
		"autonomyGuardPendingBlocks": false,
	}
	var list_summary_variant: Variant = ai_state.get("playerRuntimeListSummary", {})
	if list_summary_variant is Dictionary:
		summary["listSummaryVisible"] = not (list_summary_variant as Dictionary).is_empty()
	var autonomy_guard_variant: Variant = ai_state.get("playerRuntimeAutonomyGuard", {})
	if autonomy_guard_variant is Dictionary:
		var autonomy_guard: Dictionary = autonomy_guard_variant as Dictionary
		summary["autonomyGuardVisible"] = not autonomy_guard.is_empty()
		summary["autonomyGuardMode"] = str(autonomy_guard.get("mode", "")).strip_edges()
		summary["autonomyGuardExecutionEnabled"] = bool(autonomy_guard.get("autonomousExecutionEnabled", false))
		summary["autonomyGuardPendingBlocks"] = bool(autonomy_guard.get("pendingApprovalBlocksExecution", false))
	for runtime_variant in runtime_items:
		if not (runtime_variant is Dictionary):
			continue
		var runtime_item: Dictionary = runtime_variant as Dictionary
		var list_card_variant: Variant = runtime_item.get("listCard", {})
		if list_card_variant is Dictionary and not (list_card_variant as Dictionary).is_empty():
			summary["listCardCount"] = int(summary.get("listCardCount", 0)) + 1
		if not bool(summary.get("autonomyGuardVisible", false)):
			var runtime_guard_variant: Variant = runtime_item.get("autonomyGuard", {})
			if runtime_guard_variant is Dictionary:
				var runtime_guard: Dictionary = runtime_guard_variant as Dictionary
				summary["autonomyGuardVisible"] = not runtime_guard.is_empty()
				summary["autonomyGuardMode"] = str(runtime_guard.get("mode", "")).strip_edges()
				summary["autonomyGuardExecutionEnabled"] = bool(runtime_guard.get("autonomousExecutionEnabled", false))
				summary["autonomyGuardPendingBlocks"] = bool(runtime_guard.get("pendingApprovalBlocksExecution", false))
	for model_runtime_variant in runtime_items:
		if not (model_runtime_variant is Dictionary):
			continue
		var model_runtime_item: Dictionary = model_runtime_variant as Dictionary
		var model_status_variant: Variant = model_runtime_item.get("modelStatus", {})
		if not (model_status_variant is Dictionary):
			continue
		var model_status: Dictionary = model_status_variant as Dictionary
		if model_status.is_empty():
			continue
		summary["modelStatusVisible"] = true
		summary["modelName"] = _first_non_empty_runtime_value(
			model_status.get("activeModel", model_status.get("modelName", "")),
			model_status.get("model", model_status.get("targetModel", ""))
		)
		summary["source"] = _first_non_empty_runtime_value(
			model_status.get("source", model_status.get("modelSource", "")),
			model_status.get("activeProvider", model_status.get("provider", ""))
		)
		summary["budgetTier"] = str(model_status.get("budgetTier", model_status.get("budget", ""))).strip_edges()
		summary["secretConfigured"] = bool(model_status.get("secretConfigured", model_status.get("hasSecret", false)))
		summary["fallbackEnabled"] = bool(model_status.get("fallbackEnabled", false))
		return summary
	return summary

func _save_mainline_visual_smoke_screenshot(screenshot_path: String) -> Dictionary:
	if screenshot_path == "":
		return {"ok": false, "error": ERR_UNCONFIGURED, "message": "SLG_MAINLINE_VISUAL_SMOKE_SCREENSHOT is empty"}
	var dir_error := _ensure_absolute_parent_dir(screenshot_path)
	if dir_error != OK:
		return {"ok": false, "error": dir_error, "path": screenshot_path, "message": "failed to create screenshot dir"}
	var image: Image = get_viewport().get_texture().get_image()
	var save_error := image.save_png(screenshot_path)
	return {
		"ok": save_error == OK,
		"error": save_error,
		"path": screenshot_path,
		"width": image.get_width(),
		"height": image.get_height(),
	}

func _save_mainline_visual_smoke_pre_close_screenshot(stage: String) -> Dictionary:
	var screenshot_path := _mainline_visual_smoke_pre_close_screenshot_path.strip_edges()
	if screenshot_path == "":
		return {
			"attempted": false,
			"ok": true,
			"reason": "not_requested",
			"stage": stage,
		}
	var result := _save_mainline_visual_smoke_screenshot(screenshot_path)
	result["attempted"] = true
	result["stage"] = stage
	return result

func _capture_mainline_visual_smoke_sequence(frame_count: int, interval_sec: float) -> Dictionary:
	var sequence_dir := _mainline_visual_smoke_sequence_dir.strip_edges()
	if frame_count <= 0:
		return {"attempted": false, "ok": true, "reason": "not_requested"}
	if sequence_dir == "":
		return {"attempted": true, "ok": false, "reason": "sequence_dir_empty"}
	var normalized_dir := sequence_dir.replace("\\", "/").trim_suffix("/")
	var dir_error := DirAccess.make_dir_recursive_absolute(normalized_dir)
	if dir_error != OK:
		return {"attempted": true, "ok": false, "reason": "sequence_dir_create_failed", "error": dir_error, "dir": normalized_dir}

	var frames: Array = []
	var all_ok := true
	for index in range(frame_count):
		await get_tree().process_frame
		var frame_path := "%s/movement_frame_%02d.png" % [normalized_dir, index]
		var screenshot_result := _save_mainline_visual_smoke_screenshot(frame_path)
		var frame_ok := int(screenshot_result.get("error", ERR_UNCONFIGURED)) == OK
		var map_unit_visual_summary: Dictionary = call("_compact_mainline_visual_smoke_map_unit_summary", _read_mainline_visual_smoke_map_unit_visual_summary())
		all_ok = all_ok and frame_ok
		frames.append({
			"index": index,
			"ok": frame_ok,
			"screenshot": screenshot_result,
			"mapUnitVisual": map_unit_visual_summary,
			"worldTroopMarchFeedbackChainToken": str(map_unit_visual_summary.get("worldTroopMarchFeedbackChainToken", "")),
			"worldTroopMarchFeedbackChainPartial": bool(map_unit_visual_summary.get("worldTroopMarchFeedbackChainPartial", false)),
			"worldTroopMarchFeedbackChainState": str(map_unit_visual_summary.get("worldTroopMarchFeedbackChainState", "")),
			"worldTroopMarchFeedbackChainVisibleReason": str(map_unit_visual_summary.get("worldTroopMarchFeedbackChainVisibleReason", "")),
			"worldTroopMarchFeedbackChainNextActionHint": str(map_unit_visual_summary.get("worldTroopMarchFeedbackChainNextActionHint", "")),
			"worldTroopMarchFeedbackChainVisibleBudgetLines": int(map_unit_visual_summary.get("worldTroopMarchFeedbackChainVisibleBudgetLines", 0)),
			"worldTroopMarchFeedbackChainVisibleBudgetGuard": bool(map_unit_visual_summary.get("worldTroopMarchFeedbackChainVisibleBudgetGuard", false)),
			"worldTroopMarchBlockedVisibleFeedback": bool(map_unit_visual_summary.get("worldTroopMarchBlockedVisibleFeedback", false)),
		})
		if index < frame_count - 1 and interval_sec > 0.0:
			await get_tree().create_timer(interval_sec).timeout

	return {
		"attempted": true,
		"ok": all_ok,
		"dir": normalized_dir,
		"frameCount": frames.size(),
		"intervalSec": interval_sec,
		"frames": frames,
	}

func _mainline_visual_smoke_aux_screenshot_path(file_name: String) -> String:
	var screenshot_path := _mainline_visual_smoke_screenshot_path.strip_edges()
	if screenshot_path == "":
		return ""
	var normalized_path := screenshot_path.replace("\\", "/")
	var slash_index := normalized_path.rfind("/")
	if slash_index < 0:
		return file_name
	return "%s/%s" % [normalized_path.substr(0, slash_index), file_name]

func _write_mainline_visual_smoke_report(report_path: String, payload: Dictionary) -> void:
	if report_path == "":
		push_warning("[mainline-visual-smoke] report path empty")
		return
	var dir_error := _ensure_absolute_parent_dir(report_path)
	if dir_error != OK:
		push_warning("[mainline-visual-smoke] failed to create report dir: %s" % str(dir_error))
		return
	var file := FileAccess.open(report_path, FileAccess.WRITE)
	if file == null:
		push_warning("[mainline-visual-smoke] failed to open report: %s" % str(FileAccess.get_open_error()))
		return
	file.store_string(JSON.stringify(payload, "\t"))
	file.close()

func _read_main_city_hub_visual_smoke_summary() -> Dictionary:
	if _main_city_hub_overlay == null or not is_instance_valid(_main_city_hub_overlay):
		return {"visible": false, "expanded": false, "reason": "missing"}
	if _main_city_hub_overlay.has_method("get_context_summary"):
		var summary: Variant = _main_city_hub_overlay.call("get_context_summary")
		if summary is Dictionary:
			var hub_summary: Dictionary = summary as Dictionary
			if not _last_player_home_city_node_context.is_empty():
				hub_summary["lastMapNodeClick"] = _last_player_home_city_node_context.duplicate(true)
			return hub_summary
	return {"visible": bool(_main_city_hub_overlay.visible), "expanded": false}

func _ensure_absolute_parent_dir(file_path: String) -> Error:
	var normalized_path := file_path.replace("\\", "/")
	var slash_index := normalized_path.rfind("/")
	if slash_index <= 0:
		return OK
	var dir_path := normalized_path.substr(0, slash_index)
	return DirAccess.make_dir_recursive_absolute(dir_path)

