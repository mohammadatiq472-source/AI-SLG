	_ensure_ai_activity_card()
	var card_visible := _ai_activity_card != null and is_instance_valid(_ai_activity_card) and _ai_activity_card.visible and _ai_activity_card.is_visible_in_tree()
	var card_rect := _ai_activity_card.get_global_rect() if card_visible else Rect2()
