func _press_mainline_visual_smoke_tianxia_yutu_explicit_jump(search_query: String = "", filter_id: String = "", expected_scope: String = "") -> Dictionary:
	if _native_shell == null or not is_instance_valid(_native_shell):
		return {"attempted": true, "ok": false, "reason": "native_shell_missing"}
	var mode_button := _native_shell.get_node_or_null("TopStrip/TopMargin/TopRow/Actions/ModeToggleButton") as Button
	if mode_button == null:
		return {"attempted": true, "ok": false, "reason": "mode_toggle_button_missing"}
	if _display_mode != DISPLAY_MODE_WORLD or _is_tianxia_yutu_main_map_mode():
		_open_main_world_map()
		await get_tree().process_frame
		await get_tree().process_frame
	var before_jump_count: int = _tianxia_yutu_explicit_jump_count
	mode_button.emit_signal("pressed")
	var tianxia_wait: Dictionary = await _wait_for_mainline_visual_smoke_main_map_mode(MAIN_MAP_VIEW_MODE_TIANXIA_YUTU, true)
	_refresh_tianxia_yutu_jump_panel()
	var panel_summary_before: Dictionary = _read_tianxia_yutu_explicit_jump_summary()
	var panel_visible: bool = bool(panel_summary_before.get("panelVisible", false))
	var search_selected_ok: bool = true
	if search_query.strip_edges() != "" or filter_id.strip_edges() != "":
		search_selected_ok = _select_tianxia_yutu_first_filtered_target(search_query, filter_id)
		panel_summary_before = _read_tianxia_yutu_explicit_jump_summary()
		panel_visible = bool(panel_summary_before.get("panelVisible", false))
	if _tianxia_yutu_jump_button == null:
		return {
			"attempted": true,
			"ok": false,
			"reason": "explicit_jump_button_missing",
			"tianxiaWait": tianxia_wait,
			"panelSummaryBefore": panel_summary_before,
		}
	_tianxia_yutu_jump_button.emit_signal("pressed")
	var gameplay_wait: Dictionary = await _wait_for_mainline_visual_smoke_main_map_mode(MAIN_MAP_VIEW_MODE_GAMEPLAY, false)
	var deadline_msec: int = Time.get_ticks_msec() + 5000
	while Time.get_ticks_msec() < deadline_msec and _tianxia_yutu_explicit_jump_count <= before_jump_count:
		await get_tree().create_timer(0.1).timeout
	var panel_summary_after: Dictionary = _read_tianxia_yutu_explicit_jump_summary()
	var last_jump: Dictionary = panel_summary_after.get("lastExplicitJump", {}) as Dictionary
	var target: Dictionary = panel_summary_before.get("jumpTarget", {}) as Dictionary
	var expected_scope_ok: bool = expected_scope.strip_edges() == "" or str(target.get("target_scope", target.get("kind", ""))).strip_edges() == expected_scope.strip_edges()
	var mobile_viewport: bool = bool(panel_summary_before.get("mobileViewport", false))
	var selector_visible_contract_ok: bool = bool(panel_summary_before.get("selectorVisible", false)) and int(panel_summary_before.get("selectorItemCount", 0)) > 0
	var hidden_selector_target_contract_ok: bool = (
		int(panel_summary_before.get("filteredJumpTargetCount", 0)) > 0
		and int(panel_summary_before.get("selectorItemCount", 0)) > 0
		and not target.is_empty()
	)
	var selector_contract_ok: bool = selector_visible_contract_ok or hidden_selector_target_contract_ok
	var selector_contract_mode: String = "visible_selector"
	if not selector_visible_contract_ok and hidden_selector_target_contract_ok:
		selector_contract_mode = "hidden_selector_target_ready_mobile" if mobile_viewport else "hidden_selector_target_ready"
	elif not selector_contract_ok:
		selector_contract_mode = "selector_contract_failed"
	var ok: bool = (
		bool(tianxia_wait.get("ok", false))
		and bool(gameplay_wait.get("ok", false))
		and panel_visible
		and search_selected_ok
		and expected_scope_ok
		and selector_contract_ok
		and _tianxia_yutu_explicit_jump_count > before_jump_count
		and bool(last_jump.get("ok", false))
	)
	return {
		"attempted": true,
		"ok": ok,
		"reason": "tianxia_yutu_explicit_jump" if ok else "tianxia_yutu_explicit_jump_failed",
		"searchQuery": search_query,
		"scopeFilterId": filter_id,
