		nation_name = "青州验收国"
	var color_hex := OS.get_environment("SLG_NATION_FOUND_FAILURE_COLOR_HEX").strip_edges().to_lower()
	if color_hex == "":
		color_hex = "#3f7fbf"
	var page_result := await _press_mainline_visual_smoke_main_city_organization_fixture_page("eligible_alliance", "governance/founding", false)
	if not bool(page_result.get("ok", false)):
		page_result["reason"] = "nation_found_submit_failure_page_open_failed"
		return page_result
	var panel_control := _active_overlay_panel as Control
	if panel_control == null:
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "nation_found_submit_failure_overlay_missing",
			"panelResult": page_result,
		}
	if not panel_control.has_method("apply_nation_profile_visual_smoke_draft"):
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "nation_found_submit_failure_draft_override_missing",
			"panelResult": page_result,
		}
	var draft_variant: Variant = panel_control.call("apply_nation_profile_visual_smoke_draft", {
		"capital_tile_id": capital_tile_id,
		"capital_name": capital_name,
		"nation_name": nation_name,
		"color_hex": color_hex,
	})
	var draft_result: Dictionary = draft_variant as Dictionary if draft_variant is Dictionary else {}
	_set_active_overlay_panel_page("governance/founding")
	await get_tree().process_frame
	await get_tree().process_frame
	var before_summary := _read_mainline_visual_smoke_overlay_page_summary("alliance", "governance/founding")
	var submit_button := panel_control.find_child("NationProfileSubmitButton", true, false) as Button
	if submit_button == null:
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "nation_found_submit_failure_button_missing",
			"panelResult": page_result,
			"draftResult": draft_result,
			"beforeSummary": before_summary,
		}
	if submit_button.disabled:
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "nation_found_submit_failure_button_disabled",
			"panelResult": page_result,
			"draftResult": draft_result,
			"beforeSummary": before_summary,
		}
	_runtime_action_receipt = {}
	submit_button.emit_signal("pressed")
	var receipt := {}
	var started_at := Time.get_ticks_msec()
	while Time.get_ticks_msec() - started_at < 12000:
		receipt = _runtime_action_receipt.duplicate(true)
		if str(receipt.get("source_action", "")).strip_edges() == "foundNation":
			break
		await get_tree().create_timer(0.25).timeout
	await get_tree().process_frame
	await get_tree().process_frame
	var active_page_id := _read_mainline_visual_smoke_active_overlay_page_id()
	var page_summary := _read_mainline_visual_smoke_overlay_page_summary("alliance", active_page_id)
	var label := _active_overlay_panel.find_child("NationProfileFoundingFailureLabel", true, false) as Label
	var label_text := label.text.strip_edges() if label != null else ""
	var label_visible := label != null and label.visible and label.is_visible_in_tree()
	var receipt_source := str(receipt.get("source_action", "")).strip_edges()
	var receipt_failure_code := str(receipt.get("failure_code", "")).strip_edges()
	var receipt_remote_attempted := bool(receipt.get("remote_attempted", false))
	var receipt_success := bool(receipt.get("success", false))
	var failure_text := str(page_summary.get("organizationNationFoundingFailureText", "")).strip_edges()
	var page_content_ok := bool(page_summary.get("ok", false)) and active_page_id == "governance/founding"
	var submit_chain_ok := (
		receipt_source == "foundNation"
		and receipt_remote_attempted
		and not receipt_success
		and receipt_failure_code == expected_failure_code
	)
	var failure_copy_ok := (
		expected_text != ""
		and failure_text == expected_text
		and label_text == expected_text
		and label_visible
	)
	var ok := page_content_ok and submit_chain_ok and failure_copy_ok
	page_summary["organizationNationFoundingSubmitFailureVerified"] = submit_chain_ok and failure_copy_ok
	page_summary["organizationNationFoundingSubmitFailureCode"] = receipt_failure_code
	return {
		"attempted": true,
		"ok": ok,
		"clicked": true,
		"reason": "nation_found_submit_failure_backend_chain_verified" if ok else "nation_found_submit_failure_backend_chain_failed",
		"expectedPanelId": "alliance",
		"expectedPageId": "governance/founding",
		"activePanelId": _active_panel_id,
		"activePageId": active_page_id,
		"displayMode": _display_mode,
		"expectedFailureCode": expected_failure_code,
		"backendFailureText": expected_text,
		"backendSubmitReceiptFailureCode": receipt_failure_code,
		"backendSubmitReceiptRemoteAttempted": receipt_remote_attempted,
		"backendSubmitFailureText": failure_text,
		"backendSubmitLabelText": label_text,
		"backendSubmitLabelVisible": label_visible,
		"backendSubmitRemoteStatus": int(receipt.get("remote_status", 0)),
		"pageContentOk": page_content_ok,
		"pageContentSummary": page_summary,
		"beforeSummary": before_summary,
		"panelResult": page_result,
		"draftResult": draft_result,
		"actionReceipt": receipt,
	}


func _mainline_visual_smoke_nation_found_failure_text(failure_code: String) -> String:
	match failure_code:
		"nation_found_level_required":
			return "同盟等级不足，达到 20 级后可立国。"
		"nation_found_commandery_required":
			return "还没有占领郡城，占有 1 个郡后可立国。"
		"nation_found_capital_not_controlled":
			return "都城必须选择己方郡城。"
		"nation_found_forbidden":
			return "只有盟主或授权官员可以立国。"
		_:
			return failure_code


