func _press_mainline_visual_smoke_ai_panel_receipt_history_pagination_contract(panel_id: String) -> Dictionary:
	if panel_id != "ai_hub" or _active_panel_id != "ai_hub":
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "active_panel_not_ai_hub",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
		}
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "overlay_missing",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
		}
	var presenter = _resolve_ai_panel_presenter()
	if presenter == null:
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "ai_panel_presenter_missing",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
		}
	if not presenter.has_method("_build_ai_receipt_detail_cards"):
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "ai_receipt_detail_formatter_missing",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
		}
	var receipt_items := _build_mainline_visual_smoke_ai_receipt_history_fixture_items()
	var receipt_history_page := _build_mainline_visual_smoke_ai_receipt_history_page(receipt_items)
	var receipt_detail_cards_variant = presenter.call("_build_ai_receipt_detail_cards", receipt_items, [], receipt_history_page)
	var receipt_detail_cards: Array = receipt_detail_cards_variant if receipt_detail_cards_variant is Array else []
	var receipt_detail_text_parts: Array[String] = []
	_collect_mainline_visual_smoke_strings(receipt_detail_cards, receipt_detail_text_parts)
	var receipt_detail_text := " ".join(receipt_detail_text_parts)
	var world_actions: Array[String] = []
	var backend_schema_aligned := true
	var page_schema_aligned := true
	var no_fabricated_world_receipts := true
	var expected_ai_world_action_map := {
		"tactical_skill_upgrade": "upgradeTacticalSkill",
		"building_upgrade": "promoteCityBuilding",
		"tile_occupy": "occupyTile",
		"hero_star_upgrade": "upgradeHeroStar",
	}
	var receipts_by_proposal_id := {}
	var required_ai_receipt_keys := [
		"proposalId",
		"aiPlayerId",
		"governorPlayerId",
		"factionId",
		"action",
		"worldAction",
		"worldActionPayload",
		"worldReceipt",
		"actionRequestId",
		"ok",
		"failureCode",
		"message",
		"execution",
		"observedAt",
	]
	for receipt_variant in receipt_items:
		if not (receipt_variant is Dictionary):
			backend_schema_aligned = false
			continue
		var receipt: Dictionary = receipt_variant as Dictionary
		for required_key_variant in required_ai_receipt_keys:
			var required_key := str(required_key_variant)
			if not receipt.has(required_key):
				backend_schema_aligned = false
		var proposal_id := str(receipt.get("proposalId", "")).strip_edges()
		if proposal_id != "":
			receipts_by_proposal_id[proposal_id] = receipt
		var ai_action := str(receipt.get("action", "")).strip_edges()
		var world_action := str(receipt.get("worldAction", "")).strip_edges()
		var expected_world_action := str(expected_ai_world_action_map.get(ai_action, "")).strip_edges()
		if ai_action == "" or world_action == "" or expected_world_action == "" or expected_world_action != world_action:
			backend_schema_aligned = false
		elif not world_actions.has(world_action):
			world_actions.append(world_action)
		var world_receipt_variant: Variant = receipt.get("worldReceipt", {})
		if not (world_receipt_variant is Dictionary) or (world_receipt_variant as Dictionary).is_empty():
			backend_schema_aligned = false
			continue
		var world_receipt: Dictionary = world_receipt_variant as Dictionary
		if str(world_receipt.get("action", "")).strip_edges() != world_action:
			backend_schema_aligned = false
		if str(world_receipt.get("factionId", "")).strip_edges() == "":
			backend_schema_aligned = false
		if world_action == "upgradeHeroStar" and not bool(receipt.get("ok", false)) and world_receipt.has("hero"):
			no_fabricated_world_receipts = false
			backend_schema_aligned = false
	var messages_variant: Variant = receipt_history_page.get("messages", [])
	var history_messages: Array = messages_variant if messages_variant is Array else []
	var history_counts_variant: Variant = receipt_history_page.get("historyCounts", {})
	var history_counts: Dictionary = history_counts_variant if history_counts_variant is Dictionary else {}
	if str(receipt_history_page.get("filter", "")).strip_edges() != "receipt":
		page_schema_aligned = false
	if int(receipt_history_page.get("count", 0)) != history_messages.size() or history_messages.size() != receipt_items.size():
		page_schema_aligned = false
	if int(receipt_history_page.get("totalCount", 0)) != 6:
		page_schema_aligned = false
	if bool(receipt_history_page.get("hasMore", false)) != true:
		page_schema_aligned = false
	if str(receipt_history_page.get("nextBeforeMessageId", "")).strip_edges() == "":
		page_schema_aligned = false
	if int(history_counts.get("receipt", 0)) < 6 or int(history_counts.get("failure", 0)) < 2:
		page_schema_aligned = false
	for message_variant in history_messages:
		if not (message_variant is Dictionary):
			page_schema_aligned = false
			continue
		var message: Dictionary = message_variant as Dictionary
		if str(message.get("kind", "")).strip_edges() != "receipt":
			page_schema_aligned = false
		var receipt_proposal_id := str(message.get("receiptProposalId", "")).strip_edges()
		if receipt_proposal_id == "" or not receipts_by_proposal_id.has(receipt_proposal_id):
			page_schema_aligned = false
			continue
		var linked_receipt: Dictionary = receipts_by_proposal_id.get(receipt_proposal_id, {}) as Dictionary
		if str(message.get("action", "")).strip_edges() != str(linked_receipt.get("action", "")).strip_edges():
			page_schema_aligned = false
		if bool(message.get("receiptOk", false)) != bool(linked_receipt.get("ok", false)):
			page_schema_aligned = false
		var metadata_variant: Variant = message.get("metadata", {})
		if not (metadata_variant is Dictionary):
			page_schema_aligned = false
			continue
		var metadata: Dictionary = metadata_variant as Dictionary
		if str(metadata.get("worldAction", "")).strip_edges() != str(linked_receipt.get("worldAction", "")).strip_edges():
			page_schema_aligned = false
		if str(metadata.get("actionRequestId", "")).strip_edges() != str(linked_receipt.get("actionRequestId", "")).strip_edges():
			page_schema_aligned = false
		var narrative_variant: Variant = metadata.get("receiptNarrative", {})
		if not (narrative_variant is Dictionary):
			page_schema_aligned = false
			continue
		var narrative: Dictionary = narrative_variant as Dictionary
		if str(narrative.get("styleVersion", "")).strip_edges() != "ai_player_emotional_receipt_v1":
			page_schema_aligned = false
		if bool(narrative.get("authorityPreserved", false)) != true:
			page_schema_aligned = false
		if str(narrative.get("worldAction", "")).strip_edges() != str(linked_receipt.get("worldAction", "")).strip_edges():
			page_schema_aligned = false
		if message.has("worldReceipt") or message.has("world_receipt"):
			page_schema_aligned = false
	var next_ai_state := WorldStore.get_ai_state(_target_faction_id).duplicate(true)
	next_ai_state["playerRuntimeList"] = [{
		"aiPlayerId": "receipt_fixture_operator",
		"displayName": "青州后勤官",
		"status": "active",
		"listCard": {
			"displayName": "青州后勤官",
			"statusDot": "gold",
			"statusReason": "receipt_history",
			"actionableProposalCount": 0,
			"viewActionId": "receipt_detail",
		},
		"contextDocuments": [{
			"title": "青州后勤设定",
			"kind": "identity",
			"sourceFileName": "operator_profile.md",
		}],
		"latestReceipt": receipt_items[receipt_items.size() - 1],
	}]
	next_ai_state["playerRuntimeReceiptItems"] = receipt_items.duplicate(true)
	next_ai_state["playerRuntimeReceiptHistoryPage"] = receipt_history_page.duplicate(true)
	next_ai_state["playerRuntimeProposalItems"] = []
	next_ai_state["playerRuntimePrimaryAiPlayerId"] = "receipt_fixture_operator"
	next_ai_state["contextMemorySummary"] = {
		"lines": ["批准后的回执历史已分页归档。"],
		"relatedId": "receipt_fixture_operator",
	}
	next_ai_state["playerRuntimeUpdatedAt"] = "2026-05-28T12:16:00Z"
	WorldStore.set_ai_state(_target_faction_id, next_ai_state)
	_refresh_overlay_panel_state()
	_set_active_overlay_panel_page("context")
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(0.15).timeout
	var receipt_block_for_scroll := _find_mainline_visual_smoke_visible_control_by_name_prefix(_active_overlay_panel, "AIReceiptDetailBlock")
	var content_scroll := _find_mainline_visual_smoke_visible_scroll_container(_active_overlay_panel, "DesktopContentScroll")
	if receipt_block_for_scroll != null and content_scroll != null:
		var scroll_rect := content_scroll.get_global_rect()
		var receipt_rect_before_scroll := receipt_block_for_scroll.get_global_rect()
		content_scroll.scroll_vertical = maxi(0, int(receipt_rect_before_scroll.position.y - scroll_rect.position.y))
		await get_tree().process_frame
		await get_tree().process_frame
		await get_tree().create_timer(0.10).timeout
	var page_summary := _read_mainline_visual_smoke_overlay_page_summary("ai_hub", "context")
	var receipt_block := _find_mainline_visual_smoke_visible_control_by_name_prefix(_active_overlay_panel, "AIReceiptDetailBlock")
	var block_rect := Rect2()
	var block_inside_viewport := false
	if receipt_block != null:
		block_rect = receipt_block.get_global_rect()
		block_inside_viewport = _mainline_visual_smoke_rect_inside_viewport(block_rect, get_viewport().get_visible_rect().size)
	var visual_needles := ["结果明细", "回执历史", "还有更早", "战法升级", "建筑升级", "占地", "武将升星"]
	var card_text_needles := ["回执历史", "还有更早", "战法升级", "建筑升级", "占地", "武将升星"]
	var visible_hits := _collect_mainline_visual_smoke_visible_text_hits(_active_overlay_panel, visual_needles)
	var visible_hit_needles: Array[String] = []
	for hit_variant in visible_hits:
		if not (hit_variant is Dictionary):
			continue
		var hit: Dictionary = hit_variant as Dictionary
		var needle := str(hit.get("needle", "")).strip_edges()
		if needle != "" and not visible_hit_needles.has(needle):
			visible_hit_needles.append(needle)
	var card_text_contains_required := true
	for needle_variant in card_text_needles:
		var needle := str(needle_variant)
		if receipt_detail_text.find(needle) < 0:
			card_text_contains_required = false
	var visible_text_contains_required := true
	for needle_variant in visual_needles:
		var needle := str(needle_variant)
		if not visible_hit_needles.has(needle):
			visible_text_contains_required = false
	var direct_hero_level_hidden := (
		receipt_detail_text.find("upgradeHeroLevel") < 0
		and receipt_detail_text.find("hero_level_upgrade") < 0
	)
	var receipt_detail_forbidden_copy_hits: Array[String] = []
	for needle_variant in [
		"proposalId",
		"worldAction",
		"queuePlanExecution",
		"runtime",
		"provider",
		"env",
		"key",
		"api key",
		"runtime model key",
		"nextBeforeMessageId",
		"receiptProposalId",
		"actionRequestId",
	]:
		var forbidden_needle := str(needle_variant)
		if receipt_detail_text.find(forbidden_needle) >= 0:
			receipt_detail_forbidden_copy_hits.append(forbidden_needle)
	var block_names: Array = page_summary.get("contentBlockNodeNames", []) as Array
	var block_visible := receipt_block != null and block_names.has("AIReceiptDetailBlock")
	page_summary["aiReceiptHistoryPaginationContractMode"] = "approval_receipt_history_pagination_v1"
	page_summary["aiReceiptHistoryPaginationBlockVisible"] = block_visible
	page_summary["aiReceiptHistoryPaginationBlockInsideViewport"] = block_inside_viewport
	page_summary["aiReceiptHistoryPaginationBlockWidth"] = int(block_rect.size.x)
	page_summary["aiReceiptHistoryPaginationBlockHeight"] = int(block_rect.size.y)
	page_summary["aiReceiptHistoryPaginationVisualCardCount"] = receipt_detail_cards.size()
	page_summary["aiReceiptHistoryPaginationBackendFixtureCount"] = receipt_items.size()
	page_summary["aiReceiptHistoryPaginationBackendSchemaAligned"] = backend_schema_aligned
	page_summary["aiReceiptHistoryPaginationPageSchemaAligned"] = page_schema_aligned
	page_summary["aiReceiptHistoryPaginationWorldActions"] = world_actions
	page_summary["aiReceiptHistoryPaginationNoFabricatedWorldReceipts"] = no_fabricated_world_receipts
	page_summary["aiReceiptHistoryPaginationVisibleTextNeedles"] = visible_hit_needles
	page_summary["aiReceiptHistoryPaginationVisualTextStable"] = card_text_contains_required and visible_text_contains_required
	page_summary["aiReceiptHistoryPaginationDirectHeroLevelHidden"] = direct_hero_level_hidden
	page_summary["aiReceiptHistoryPaginationForbiddenCopyHits"] = receipt_detail_forbidden_copy_hits
