	_sync_tianxia_yutu_drilldown_context_to_map()

func _sync_tianxia_yutu_drilldown_context_to_map() -> void:
	if _map_grid == null or not _map_grid.has_method("set_tianxia_yutu_drilldown_context"):
		return
	var panel_rect := Rect2()
	var panel_visible := false
	if _tianxia_yutu_jump_panel != null:
		panel_visible = _tianxia_yutu_jump_panel.visible and _tianxia_yutu_jump_panel.is_visible_in_tree()
		panel_rect = _tianxia_yutu_jump_panel.get_global_rect()
	var selected_region_label := ""
	if _tianxia_yutu_region_selector != null and _tianxia_yutu_region_selector.selected >= 0:
		selected_region_label = _tianxia_yutu_region_selector.get_item_text(_tianxia_yutu_region_selector.selected).strip_edges()
	var compact_target_active: bool = _is_tianxia_yutu_compact_panel_target(_tianxia_yutu_last_jump_target) and not _tianxia_yutu_navigation_panel_expanded
	var compact_target_scope: String = str(_tianxia_yutu_last_jump_target.get("target_scope", _tianxia_yutu_last_jump_target.get("kind", ""))).strip_edges()
	var compact_target_cell: Dictionary = _tianxia_yutu_last_jump_target.get("cell_1km", {}) as Dictionary if _tianxia_yutu_last_jump_target.get("cell_1km", {}) is Dictionary else {}
	_map_grid.call("set_tianxia_yutu_drilldown_context", {
		"selectedStateId": _tianxia_yutu_selected_state_id,
		"selectedRegionId": _tianxia_yutu_selected_region_id,
		"selectedRegionLabel": selected_region_label,
		"scalePresetId": _tianxia_yutu_scale_preset_id,
		"compactTargetActive": compact_target_active,
		"compactTargetScope": compact_target_scope,
		"compactTargetId": str(_tianxia_yutu_last_jump_target.get("target_id", _tianxia_yutu_last_jump_target.get("id", ""))).strip_edges(),
		"compactTargetLabel": str(_tianxia_yutu_last_jump_target.get("navigation_label", _tianxia_yutu_last_jump_target.get("label", ""))).strip_edges(),
		"compactTargetCellX": int(compact_target_cell.get("x", -1)),
		"compactTargetCellY": int(compact_target_cell.get("y", -1)),
		"compactTargetStateId": str(_tianxia_yutu_last_jump_target.get("state_id", "")).strip_edges(),
		"compactTargetRegionId": str(_tianxia_yutu_last_jump_target.get("region_id", "")).strip_edges(),
		"panelBlockRect": {
			"visible": panel_visible,
			"x": panel_rect.position.x,
			"y": panel_rect.position.y,
			"w": panel_rect.size.x,
			"h": panel_rect.size.y,
		},
	})

func _selected_tianxia_yutu_region_summary() -> Dictionary:
	if _tianxia_yutu_region_selector == null or _tianxia_yutu_region_selector.get_item_count() <= 0:
		return {}
	var region_variant: Variant = _tianxia_yutu_region_selector.get_item_metadata(_tianxia_yutu_region_selector.selected)
	if region_variant is Dictionary:
		return (region_variant as Dictionary).duplicate(true)
	return {}

func _find_tianxia_yutu_region_jump_target(region_summary: Dictionary) -> Dictionary:
	if region_summary.is_empty():
		return {}
	var region_id: String = str(region_summary.get("region_id", "")).strip_edges()
	var region_label: String = str(region_summary.get("region_label", "")).strip_edges()
	for target_variant in _tianxia_yutu_jump_targets:
		if not (target_variant is Dictionary):
			continue
		var target: Dictionary = target_variant as Dictionary
		var scope: String = str(target.get("target_scope", target.get("kind", ""))).strip_edges()
		if scope != "commandery_seat":
			continue
		var target_region_id: String = str(target.get("region_id", "")).strip_edges()
		var target_region_label: String = str(target.get("region_label", "")).strip_edges()
		if (region_id != "" and target_region_id == region_id) or (region_label != "" and target_region_label == region_label):
			return target.duplicate(true)
	var centroid: Dictionary = region_summary.get("centroid_base_8k", {}) as Dictionary if region_summary.get("centroid_base_8k", {}) is Dictionary else {}
	if centroid.is_empty():
		return {}
	return {
		"target_id": "region_drilldown_%s" % (region_id if region_id != "" else region_label),
		"label": region_label if region_label != "" else "选定郡",
		"kind": "coordinate",
		"target_scope": "coordinate",
		"state_id": str(region_summary.get("state_id", "")).strip_edges(),
		"state_label": str(region_summary.get("state_label", "")).strip_edges(),
		"region_id": region_id,
		"region_label": region_label,
		"cell_1km": {
			"x": int(centroid.get("x", TIANXIA_YUTU_DEFAULT_CENTER_X)),
			"y": int(centroid.get("y", TIANXIA_YUTU_DEFAULT_CENTER_Y)),
		},
	}

func _apply_tianxia_yutu_region_drilldown_target(region_summary: Dictionary) -> bool:
	var target: Dictionary = _find_tianxia_yutu_region_jump_target(region_summary)
	if target.is_empty():
		return false
	_tianxia_yutu_last_jump_target = target.duplicate(true)
	_focus_tianxia_yutu_target_on_map(_tianxia_yutu_last_jump_target, 4.4)
	_record_last_action("tianxia_yutu/drilldown/%s/%s" % [
		str(region_summary.get("state_id", "")).strip_edges(),
		str(region_summary.get("region_id", "")).strip_edges(),
	], "selected")
	return true

func _tianxia_yutu_target_matches_search(target: Dictionary, query: String) -> bool:
	var normalized_query: String = query.strip_edges().to_lower()
	if normalized_query == "":
		return true
	var haystack := " ".join(PackedStringArray([
		str(target.get("label", "")),
		str(target.get("navigation_label", "")),
		str(target.get("original_gate_name", "")),
		str(target.get("state_label", "")),
		str(target.get("region_label", "")),
		str(target.get("target_scope", "")),
		str(target.get("kind", "")),
		str(target.get("from_region_label", "")),
		str(target.get("to_region_label", "")),
	]))
	return haystack.to_lower().find(normalized_query) >= 0

func _tianxia_yutu_target_matches_scope(target: Dictionary, filter_id: String) -> bool:
	if filter_id == "" or filter_id == "all":
		return true
	var scope: String = str(target.get("target_scope", target.get("kind", ""))).strip_edges()
	if filter_id == "commandery_seat":
		var roles: Array = target.get("roles", []) as Array if target.get("roles", []) is Array else []
		return scope == filter_id or roles.has("commandery_seat")
	if filter_id == "state_government":
		var state_roles: Array = target.get("roles", []) as Array if target.get("roles", []) is Array else []
		return scope == filter_id or state_roles.has("state_government")
	return scope == filter_id or str(target.get("kind", "")).strip_edges() == filter_id

func _filtered_tianxia_yutu_jump_targets() -> Array:
	var query: String = _tianxia_yutu_search_edit.text if _tianxia_yutu_search_edit != null else ""
	var filter_id: String = _current_tianxia_yutu_scope_filter_id()
	var result: Array = []
	for target_variant in _tianxia_yutu_jump_targets:
		if not (target_variant is Dictionary):
			continue
		var target: Dictionary = target_variant as Dictionary
		if _tianxia_yutu_target_matches_search(target, query) and _tianxia_yutu_target_matches_scope(target, filter_id):
			result.append(target)
	return result

