		rows.append(_tianxia_yutu_navigation_matrix_snapshot("mobile_compact_collapsed", "00_tianxia_yutu_navigation_matrix_mobile_collapsed.png", "collapsed", false, false))

		_on_tianxia_yutu_mobile_expand_pressed()
		await get_tree().process_frame
		await get_tree().process_frame
		rows.append(_tianxia_yutu_navigation_matrix_snapshot("mobile_drilldown_expanded", "01_tianxia_yutu_navigation_matrix_mobile_drilldown.png", "drilldown", true, true))

		var coordinate_context: Dictionary = await _tianxia_yutu_select_matrix_target_compact_coordinate()
		await get_tree().process_frame
		rows.append(_tianxia_yutu_navigation_matrix_snapshot("mobile_target_compact", "02_tianxia_yutu_navigation_matrix_mobile_target_compact.png", "target_compact", true, true))
		if not rows.is_empty():
			rows[rows.size() - 1]["coordinateContext"] = coordinate_context
	else:
		_tianxia_yutu_navigation_panel_expanded = false
		_tianxia_yutu_navigation_panel_collapsed = false
		_refresh_tianxia_yutu_state_region_selectors()
		_refresh_tianxia_yutu_jump_panel()
