			_main_map_cell_action_summary_label.text = "底图地块不提供资源产出"
		elif bool(summary.get("worldTileActionHudResourcePreviewPolicyOk", false)):
			var capture_label := str(summary.get("captureRewardLabel", "")).strip_edges()
			var power_label := str(summary.get("recommendedPowerLabel", "")).strip_edges()
			if capture_label != "":
				_main_map_cell_action_summary_label.text = _compact_tile_action_capture_reward_label(capture_label)
			elif power_label != "":
				_main_map_cell_action_summary_label.text = power_label
			else:
				_main_map_cell_action_summary_label.text = "选择部队到达后可出征，占领消耗行动点与粮草"
