func _press_mainline_visual_smoke_tianxia_yutu_product_readability_qa() -> Dictionary:
	var label_result: Dictionary = await _press_mainline_visual_smoke_tianxia_yutu_label_art_polish_qa()
	var map_summary: Dictionary = label_result.get("mapSummary", {}) as Dictionary if label_result.get("mapSummary", {}) is Dictionary else {}
	var marker_label_counts: Dictionary = label_result.get("markerLabelDrawCounts", {}) as Dictionary if label_result.get("markerLabelDrawCounts", {}) is Dictionary else {}
	var marker_scope_counts: Dictionary = label_result.get("markerScopeDrawCounts", {}) as Dictionary if label_result.get("markerScopeDrawCounts", {}) is Dictionary else {}
	var admin_label_ok: bool = bool(label_result.get("normalDenseAdminLabelOk", false))
	var marker_weight_ok: bool = (
		float(label_result.get("markerVisualWeightEstimate", 999.0)) <= 112.0
		and int(label_result.get("lowEmphasisMarkerDrawCount", 0)) >= 12
		and int(label_result.get("outOfRegionGateMicroDrawCount", 0)) >= 8
		and int(label_result.get("ordinaryCityMicroDrawCount", 0)) >= 4
		and int(marker_scope_counts.get("city", 0)) > int(marker_label_counts.get("city", 0))
		and int(marker_scope_counts.get("gate", 0)) > int(marker_label_counts.get("gate", 0))
		and int(marker_label_counts.get("city", 0)) <= 1
		and int(marker_label_counts.get("gate", 0)) <= 1
	)
	var hover_detail_ok: bool = bool(label_result.get("hoverGateLabelOk", false)) and bool(label_result.get("selectedGateLabelOk", false))
	var compact_target_ok: bool = (
		bool(label_result.get("selectedGatePanelOk", false))
		and int(label_result.get("selectedCompactFocusCount", 0)) >= 1
		and int(label_result.get("selectedCompactDimCount", 0)) >= 1
	)
	var policy_helper_ok: bool = (
		str(label_result.get("markerVisualPolicyId", "")).strip_edges() == "tianxia_yutu_marker_visual_policy_v1"
		and bool(label_result.get("markerVisualPolicyHelperActive", false))
		and str(label_result.get("labelBudgetPolicyId", "")).strip_edges() == "tianxia_yutu_label_budget_policy_v1"
		and bool(label_result.get("labelBudgetPolicyHelperActive", false))
	)
	var product_contract_ok: bool = TianxiaYutuProductContractScript.summary_matches(label_result)
	var data_integrity_ok: bool = (
		int(map_summary.get("tianxiaYutuAdminFocusMaskMissingCount", 0)) == 0
		and int(map_summary.get("tianxiaYutuAdminFocusMaskLoadFailedCount", 0)) == 0
		and int(map_summary.get("tianxiaYutuAdminFocusRuntimeHullBlockedCount", 0)) == 0
	)
	var readability_ok: bool = (
		bool(label_result.get("ok", false))
		and admin_label_ok
		and marker_weight_ok
		and hover_detail_ok
		and compact_target_ok
		and policy_helper_ok
		and product_contract_ok
		and data_integrity_ok
	)
	var result := label_result.duplicate(true)
	result["ok"] = readability_ok
	result["reason"] = "tianxia_yutu_product_readability_qa" if readability_ok else "tianxia_yutu_product_readability_qa_failed"
	result["productReadabilityOk"] = readability_ok
	result["adminLabelOk"] = admin_label_ok
	result["markerWeightOk"] = marker_weight_ok
	result["hoverDetailOk"] = hover_detail_ok
	result["compactTargetOk"] = compact_target_ok
	result["policyHelperOk"] = policy_helper_ok
	result["productContractOk"] = product_contract_ok
	result["dataIntegrityOk"] = data_integrity_ok
	result["productReadabilityThresholds"] = {
		"markerVisualWeightMax": 112.0,
		"lowEmphasisMarkerMin": 12,
		"outOfRegionGateMicroMin": 8,
		"ordinaryCityMicroMin": 4,
		"cityLabelMax": 1,
		"gateLabelMax": 1,
	}
	return result


func _select_tianxia_yutu_acceptance_state_region() -> Dictionary:
	if _is_tianxia_yutu_mobile_viewport():
		_tianxia_yutu_navigation_panel_expanded = true
	_refresh_tianxia_yutu_scale_selector()
	_refresh_tianxia_yutu_state_region_selectors()
	var state_selected_ok := false
	var fallback_state_index := -1
	if _tianxia_yutu_state_selector != null:
		for state_index in range(_tianxia_yutu_state_selector.get_item_count()):
			var state_variant: Variant = _tianxia_yutu_state_selector.get_item_metadata(state_index)
			if not (state_variant is Dictionary):
				continue
			var state_entry: Dictionary = state_variant as Dictionary
			var regions: Array = state_entry.get("regions", []) as Array if state_entry.get("regions", []) is Array else []
			if regions.is_empty():
				continue
			if fallback_state_index < 0:
				fallback_state_index = state_index
			var state_id := _tianxia_yutu_state_entry_id(state_entry)
			var state_label := str(state_entry.get("state_label", state_entry.get("_state_key", ""))).strip_edges()
			if state_id != "jiaozhou" and state_label != "交州":
				continue
			_tianxia_yutu_state_selector.select(state_index)
			_on_tianxia_yutu_state_drilldown_selected(state_index)
			state_selected_ok = _tianxia_yutu_selected_state_id != ""
			break
	if not state_selected_ok and fallback_state_index >= 0 and _tianxia_yutu_state_selector != null:
		_tianxia_yutu_state_selector.select(fallback_state_index)
		_on_tianxia_yutu_state_drilldown_selected(fallback_state_index)
		state_selected_ok = _tianxia_yutu_selected_state_id != ""
	var region_selected_ok := false
	var preferred_region_index := -1
	if _tianxia_yutu_region_selector != null and _tianxia_yutu_region_selector.get_item_count() > 0:
		for region_index in range(_tianxia_yutu_region_selector.get_item_count()):
			var region_variant: Variant = _tianxia_yutu_region_selector.get_item_metadata(region_index)
			if not (region_variant is Dictionary):
				continue
			var region_entry: Dictionary = region_variant as Dictionary
			var region_id := str(region_entry.get("region_id", "")).strip_edges()
			var region_label := str(region_entry.get("region_label", region_id)).strip_edges()
			if region_id == "cmd_auto_148" or region_label == "苍梧郡":
				preferred_region_index = region_index
				break
		if preferred_region_index < 0:
			preferred_region_index = 0
		_tianxia_yutu_region_selector.select(preferred_region_index)
		_on_tianxia_yutu_region_drilldown_selected(preferred_region_index)
		region_selected_ok = _tianxia_yutu_selected_region_id != "" and not _tianxia_yutu_last_jump_target.is_empty()
	await get_tree().process_frame
	await get_tree().process_frame
	_refresh_tianxia_yutu_jump_panel()
	return {
		"ok": state_selected_ok and region_selected_ok,
		"stateSelectedOk": state_selected_ok,
		"regionSelectedOk": region_selected_ok,
		"selectedStateId": _tianxia_yutu_selected_state_id,
		"selectedRegionId": _tianxia_yutu_selected_region_id,
	}


