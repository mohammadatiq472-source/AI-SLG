func _press_mainline_visual_smoke_ai_panel_pending_proposals_review_guard(panel_id: String) -> Dictionary:
	if panel_id != "ai_hub" or _active_panel_id != "ai_hub":
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "active_panel_not_ai_hub",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
		}
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "overlay_missing",
			"activePanelId": _active_panel_id,
		}
	_set_active_overlay_panel_page("players")
	_refresh_overlay_panel_state()
	_reset_mainline_visual_smoke_overlay_scroll()
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(0.15).timeout
	var review_button := _find_mainline_visual_smoke_visible_button_by_text(_active_overlay_panel, "查看待办")
	if review_button == null:
		review_button = _find_mainline_visual_smoke_visible_button_by_text(_active_overlay_panel, "查看待批")
	var adapter = _resolve_slg_domain_action_adapter()
	var review_result: Dictionary = {}
	if adapter.has_method("request_ai_player_pending_proposals_review"):
		review_result = await adapter.call("request_ai_player_pending_proposals_review")
	var guard_result: Dictionary = {}
	if adapter.has_method("request_ai_player_latest_proposal_execute"):
		guard_result = await adapter.call("request_ai_player_latest_proposal_execute")
	var guard_blocks_execute := (
		not bool(guard_result.get("ok", false))
		and str(guard_result.get("error", "")).strip_edges() == "approval_only_ui_guard"
		and not bool(guard_result.get("remote_attempted", true))
	)
	var active_page_id := _read_mainline_visual_smoke_active_overlay_page_id()
	var page_summary := _read_mainline_visual_smoke_overlay_page_summary("ai_hub", active_page_id)
	var proposal_count := int(review_result.get("proposal_count", 0))
	var review_button_required := proposal_count > 0
	var review_button_ok := review_button != null if review_button_required else true
	var direct_execute_action_visible := bool(page_summary.get("aiPanelDirectSuggestedActionExecution", false))
	var first_screen_forbidden_copy_hits := _collect_mainline_visual_smoke_visible_text_hits(_active_overlay_panel, [
		"模型",
		"密钥",
		"预算",
		"Deepseek",
		"Nemotron",
		"身份文件",
		"放开什么",
		"身份 0",
		"是否可用",
		"行动管理",
		"托管权限",
		"候选 / 军情",
		"能聊",
		"顺畅",
		"参谋",
		"provider",
		"env",
		"key",
		"runtime",
		"proposalId",
		"worldAction",
		"queuePlanExecution",
		"developmentPoints",
		"runtime model key",
		"api key",
	])
	page_summary["aiPendingProposalReviewButtonVisible"] = review_button != null
	page_summary["aiPendingProposalReviewButtonRequired"] = review_button_required
	page_summary["aiPendingProposalCount"] = proposal_count
	page_summary["aiDirectExecuteActionVisible"] = direct_execute_action_visible
	page_summary["aiApprovalOnlyExecuteGuardVerified"] = guard_blocks_execute
	page_summary["aiApprovalOnlyExecuteGuardError"] = str(guard_result.get("error", "")).strip_edges()
	page_summary["aiApprovalOnlyExecuteRemoteAttempted"] = bool(guard_result.get("remote_attempted", true))
	page_summary["aiPendingProposalReviewAdapterOk"] = bool(review_result.get("ok", false))
	page_summary["aiPlayersFirstScreenCopyMode"] = "consumer_status_words_v1"
	page_summary["aiPlayersFirstScreenForbiddenCopyCount"] = first_screen_forbidden_copy_hits.size()
	page_summary["aiPlayersFirstScreenForbiddenCopyHits"] = first_screen_forbidden_copy_hits
	var ok := (
		review_button_ok
		and not direct_execute_action_visible
		and bool(review_result.get("ok", false))
		and guard_blocks_execute
		and first_screen_forbidden_copy_hits.is_empty()
	)
	return {
		"attempted": true,
		"ok": ok,
		"clicked": review_button != null,
		"reason": "ai_pending_proposal_review_guard_verified" if ok else "ai_pending_proposal_review_guard_failed",
		"panelId": panel_id,
		"activePanelId": _active_panel_id,
		"activePageId": active_page_id,
		"pageContentOk": bool(page_summary.get("ok", false)),
		"pageContentSummary": page_summary,
		"pendingProposalCount": proposal_count,
		"reviewButtonRequired": review_button_required,
		"reviewButtonVisible": review_button != null,
		"directExecuteActionVisible": direct_execute_action_visible,
		"reviewResult": review_result,
		"guardResult": guard_result,
	}

func _press_mainline_visual_smoke_ai_panel_home_city_bind_open_chain(panel_id: String, strict_unbound_start: bool = false) -> Dictionary:
	strict_unbound_start = strict_unbound_start or _is_truthy_env("SLG_MAINLINE_VISUAL_SMOKE_REQUIRE_AI_HOME_CITY_UNBOUND")
	if panel_id != "ai_hub" or _active_panel_id != "ai_hub":
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "active_panel_not_ai_hub",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
		}
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "overlay_missing",
			"activePanelId": _active_panel_id,
		}
	_set_active_overlay_panel_page("players")
	_refresh_overlay_panel_state()
	_reset_mainline_visual_smoke_overlay_scroll()
	await get_tree().process_frame
	await get_tree().process_frame
	await _on_snapshot_overlay_page_action_requested("players", "ai_players_refresh")
	_refresh_overlay_panel_state()
	await get_tree().process_frame
	var refresh_summary := _read_mainline_visual_smoke_overlay_page_summary("ai_hub", "players")
	var binding_status_before := str(refresh_summary.get("aiHomeCityBindingStatus", "")).strip_edges()
	if binding_status_before == "bound":
		if strict_unbound_start:
			return {
				"attempted": true,
				"ok": false,
				"clicked": false,
				"reason": "ai_home_city_isolated_expected_unbound_before_bind",
				"panelId": panel_id,
				"activePanelId": _active_panel_id,
				"bindingStatusBefore": binding_status_before,
				"isolatedUnboundRequired": true,
				"pageContentOk": false,
				"pageContentSummary": refresh_summary,
			}
		await _on_snapshot_overlay_page_action_requested("players", "ai_player_home_city_open")
		await get_tree().process_frame
		await get_tree().process_frame
		await get_tree().create_timer(0.35).timeout
		var bound_facility_summary := _build_main_city_facility_tree_page_summary({})
		var bound_facility_open_ok := (
			_active_panel_id == MAIN_CITY_FACILITY_TREE_PANEL_ID
			and bool(bound_facility_summary.get("facilityTreePageVisible", false))
			and bool(bound_facility_summary.get("facilityTreeReadonly", false))
			and str(bound_facility_summary.get("mainCityFacilitySource", "")) == "ai_home_city_facility_entry"
			and bool(bound_facility_summary.get("hasFacilityTree", false))
		)
		bound_facility_summary["aiHomeCityBindingStatusBefore"] = binding_status_before
		bound_facility_summary["aiHomeCityAlreadyBoundOpenPath"] = true
		bound_facility_summary["aiHomeCityCandidateCount"] = 0
		bound_facility_summary["aiHomeCitySelectedCenterTileId"] = ""
		bound_facility_summary["aiHomeCityBindActionId"] = ""
		bound_facility_summary["aiHomeCityCandidatesActionOk"] = false
		bound_facility_summary["aiHomeCityFacilityOpenOk"] = bound_facility_open_ok
		return {
			"attempted": true,
			"ok": bound_facility_open_ok,
			"clicked": true,
			"reason": "ai_home_city_bound_open_chain_verified" if bound_facility_open_ok else "ai_home_city_bound_open_chain_failed",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
			"bindingStatusBefore": binding_status_before,
			"isolatedUnboundRequired": strict_unbound_start,
			"bindingStartedUnbound": false,
			"candidateCount": 0,
			"selectedCenterTileId": "",
			"bindActionId": "",
			"refreshSummary": refresh_summary,
			"pageContentOk": bound_facility_open_ok,
			"pageContentSummary": bound_facility_summary,
		}
	if binding_status_before != "unbound":
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "ai_home_city_not_unbound_before_bind",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
			"bindingStatusBefore": binding_status_before,
			"isolatedUnboundRequired": strict_unbound_start,
			"bindingStartedUnbound": false,
			"pageContentOk": false,
			"pageContentSummary": refresh_summary,
		}
	await _on_snapshot_overlay_page_action_requested("players", "ai_player_home_city_candidates_open")
	_refresh_overlay_panel_state()
	_reset_mainline_visual_smoke_overlay_scroll()
	var candidates_summary := _read_mainline_visual_smoke_overlay_page_summary("ai_hub", "players")
	var deadline_msec := Time.get_ticks_msec() + 6000
	while Time.get_ticks_msec() < deadline_msec:
		candidates_summary = _read_mainline_visual_smoke_overlay_page_summary("ai_hub", "players")
		if int(candidates_summary.get("aiHomeCityCandidateCount", 0)) > 0 and str(candidates_summary.get("aiHomeCityFirstCandidateCenterTileId", "")).strip_edges() != "":
			break
		await get_tree().create_timer(0.1).timeout
		_refresh_overlay_panel_state()
	var selected_center_tile_id := str(candidates_summary.get("aiHomeCityFirstCandidateCenterTileId", "")).strip_edges()
	if selected_center_tile_id == "":
		return {
			"attempted": true,
			"ok": false,
			"clicked": true,
			"reason": "ai_home_city_candidate_missing",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
			"bindingStatusBefore": binding_status_before,
			"isolatedUnboundRequired": strict_unbound_start,
			"bindingStartedUnbound": binding_status_before == "unbound",
			"candidateCount": int(candidates_summary.get("aiHomeCityCandidateCount", 0)),
			"pageContentOk": false,
			"pageContentSummary": candidates_summary,
		}
	var bind_action_id := "ai_player_home_city_bind:%s" % selected_center_tile_id.uri_encode()
	await _on_snapshot_overlay_page_action_requested("players", bind_action_id)
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(0.35).timeout
	var facility_summary := _build_main_city_facility_tree_page_summary({})
	var facility_open_ok := (
		_active_panel_id == MAIN_CITY_FACILITY_TREE_PANEL_ID
		and bool(facility_summary.get("facilityTreePageVisible", false))
		and bool(facility_summary.get("facilityTreeReadonly", false))
		and str(facility_summary.get("mainCityFacilitySource", "")) == "ai_home_city_facility_entry"
		and bool(facility_summary.get("hasFacilityTree", false))
	)
	facility_summary["aiHomeCityBindingStatusBefore"] = binding_status_before
	facility_summary["aiHomeCityCandidateCount"] = int(candidates_summary.get("aiHomeCityCandidateCount", 0))
	facility_summary["aiHomeCitySelectedCenterTileId"] = selected_center_tile_id
	facility_summary["aiHomeCityBindActionId"] = bind_action_id
	facility_summary["aiHomeCityCandidatesActionOk"] = selected_center_tile_id != ""
	facility_summary["aiHomeCityFacilityOpenOk"] = facility_open_ok
	return {
		"attempted": true,
		"ok": facility_open_ok,
		"clicked": true,
		"reason": "ai_home_city_bind_open_chain_verified" if facility_open_ok else "ai_home_city_bind_open_chain_failed",
		"panelId": panel_id,
		"activePanelId": _active_panel_id,
		"bindingStatusBefore": binding_status_before,
		"isolatedUnboundRequired": strict_unbound_start,
		"bindingStartedUnbound": binding_status_before == "unbound",
		"candidateCount": int(candidates_summary.get("aiHomeCityCandidateCount", 0)),
		"selectedCenterTileId": selected_center_tile_id,
		"bindActionId": bind_action_id,
		"refreshSummary": refresh_summary,
		"candidatesSummary": candidates_summary,
		"pageContentOk": facility_open_ok,
		"pageContentSummary": facility_summary,
	}

func _find_mainline_visual_smoke_visible_button(root: Node, target_name: String) -> Button:
	if root == null:
