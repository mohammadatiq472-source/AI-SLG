func _get_main_city_facility_tree_buildings() -> Array:
	if not _main_city_facility_tree_buildings_cache.is_empty():
		return _main_city_facility_tree_buildings_cache.duplicate(true)
	_load_main_city_facility_tree_read_model()
	return _main_city_facility_tree_buildings_cache.duplicate(true)


func _load_main_city_facility_tree_read_model() -> void:
	_main_city_facility_tree_read_model = {}
	_main_city_facility_tree_buildings_cache = []
	if not FileAccess.file_exists(MAIN_CITY_FACILITY_TREE_READ_MODEL_PATH):
		return
	var file := FileAccess.open(MAIN_CITY_FACILITY_TREE_READ_MODEL_PATH, FileAccess.READ)
	if file == null:
		return
	var raw_text := file.get_as_text()
	var parsed: Variant = JSON.parse_string(raw_text)
	if not (parsed is Dictionary):
		return
	_main_city_facility_tree_read_model = (parsed as Dictionary).duplicate(true)
	var asset_root := str(_main_city_facility_tree_read_model.get("asset_root", MAIN_CITY_FACILITY_TREE_ICON_ROOT)).strip_edges()
	var buildings_variant: Variant = _main_city_facility_tree_read_model.get("buildings", [])
	if not (buildings_variant is Array):
		return
	var building_items := buildings_variant as Array
	for building_variant in building_items:
		if not (building_variant is Dictionary):
			continue
		_main_city_facility_tree_buildings_cache.append(_normalize_main_city_facility_tree_building(building_variant as Dictionary, asset_root))


func _normalize_main_city_facility_tree_building(raw_building: Dictionary, asset_root: String) -> Dictionary:
	var building := raw_building.duplicate(true)
	if str(building.get("iconPath", "")).strip_edges() == "":
		var icon_file := str(building.get("iconFile", "")).strip_edges()
		if icon_file != "":
			building["iconPath"] = "%s/%s" % [asset_root, icon_file]
	return building


func _open_main_city_facility_tree_overlay(map_click_result: Dictionary) -> Dictionary:
	if _ui_layer == null:
		return {
			"facilityTreePageVisible": false,
			"reason": "ui_layer_missing",
		}
	_hide_inline_panel_host()
	_dispose_overlay_panel()
	_active_panel_id = MAIN_CITY_FACILITY_TREE_PANEL_ID
	_active_panel_tab_id = "building_tree"
	_set_native_shell_suppressed_for_overlay(false)
	if _main_city_hub_overlay != null and is_instance_valid(_main_city_hub_overlay) and _main_city_hub_overlay.has_method("set_expanded"):
		_main_city_hub_overlay.call("set_expanded", false)

	var overlay := PanelContainer.new()
	overlay.name = "MainCityFacilityTreeStandaloneOverlay"
	overlay.set_meta("main_city_facility_tree_overlay", true)
	overlay.set_meta("map_click_result", map_click_result.duplicate(true))
	var facility_entry_context := map_click_result.get("facilityEntry", {}) as Dictionary
	var readonly_facility_entry := bool(facility_entry_context.get("readonly", false))
	overlay.set_meta("facility_entry_readonly", readonly_facility_entry)
	overlay.set_anchors_preset(Control.PRESET_FULL_RECT)
	overlay.mouse_filter = Control.MOUSE_FILTER_STOP
	overlay.z_as_relative = false
	overlay.z_index = 4096
	overlay.add_theme_stylebox_override("panel", _make_main_city_facility_tree_style(Color(0.025, 0.024, 0.022, 0.98), Color(0.72, 0.54, 0.28, 0.72), 1, 0))
	_active_overlay_panel = overlay
	_ui_layer.add_child(overlay)

	var margin := MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 16)
	margin.add_theme_constant_override("margin_top", 14)
	margin.add_theme_constant_override("margin_right", 16)
	margin.add_theme_constant_override("margin_bottom", 14)
	overlay.add_child(margin)

	var root := VBoxContainer.new()
	root.add_theme_constant_override("separation", 12)
	root.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	root.size_flags_vertical = Control.SIZE_EXPAND_FILL
	margin.add_child(root)

	root.add_child(_build_main_city_facility_tree_header(map_click_result))
	var body := Control.new()
	body.name = "MainCityFacilityTreeStandaloneBody"
	body.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	body.size_flags_vertical = Control.SIZE_EXPAND_FILL
	root.add_child(body)

	var building_tree = MainCityFacilityBuildingTreeScene.instantiate()
	var upgrade_sheet = MainCityFacilityUpgradeSheetScene.instantiate()
	if building_tree is Control:
		(building_tree as Control).set_anchors_preset(Control.PRESET_FULL_RECT)
		(building_tree as Control).offset_left = 0.0
		(building_tree as Control).offset_top = 0.0
		(building_tree as Control).offset_right = 0.0
		(building_tree as Control).offset_bottom = 0.0
		(building_tree as Control).size_flags_horizontal = Control.SIZE_EXPAND_FILL
		(building_tree as Control).size_flags_vertical = Control.SIZE_EXPAND_FILL
	if upgrade_sheet is Control:
		var upgrade_control := upgrade_sheet as Control
		upgrade_control.anchor_left = 0.35
		upgrade_control.anchor_top = 0.23
		upgrade_control.anchor_right = 0.65
		upgrade_control.anchor_bottom = 0.81
		upgrade_control.offset_left = 0.0
		upgrade_control.offset_top = 0.0
		upgrade_control.offset_right = 0.0
		upgrade_control.offset_bottom = 0.0
		upgrade_control.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		upgrade_control.size_flags_vertical = Control.SIZE_EXPAND_FILL
		upgrade_control.custom_minimum_size = Vector2(480.0, 420.0)
		upgrade_control.visible = false
		upgrade_control.z_index = 6
	overlay.set_meta("facility_upgrade_sheet_instanced", upgrade_sheet != null)
	body.add_child(building_tree)
	body.add_child(upgrade_sheet)

	if building_tree != null and building_tree.has_method("set_tree_contract"):
		building_tree.call("set_tree_contract", _build_main_city_facility_tree_contract())
	var facility_buildings := _get_main_city_facility_tree_buildings()
	var selected_building := _find_main_city_facility_tree_building(str(facility_buildings[0].get("id", ""))) if not facility_buildings.is_empty() else {}
	if upgrade_sheet != null and upgrade_sheet.has_method("set_sheet_contract"):
		upgrade_sheet.call("set_sheet_contract", _build_main_city_facility_sheet_contract(selected_building, false, readonly_facility_entry))
	if building_tree != null and building_tree.has_signal("building_selected"):
		var selected_callback := func(building_id: String) -> void:
			var next_building := _find_main_city_facility_tree_building(building_id)
			if upgrade_sheet is Control:
				(upgrade_sheet as Control).visible = true
			if upgrade_sheet != null and upgrade_sheet.has_method("set_sheet_contract"):
				upgrade_sheet.call("set_sheet_contract", _build_main_city_facility_sheet_contract(next_building, false, readonly_facility_entry))
		building_tree.connect("building_selected", selected_callback)
	if upgrade_sheet != null and upgrade_sheet.has_signal("primary_action_requested"):
		var primary_callback := func(_action_id: String) -> void:
			var building_id := ""
			if building_tree != null and building_tree.has_method("get_selected_building_id"):
				building_id = str(building_tree.call("get_selected_building_id"))
			var selected := _find_main_city_facility_tree_building(building_id)
			if upgrade_sheet is Control:
				(upgrade_sheet as Control).visible = true
			if upgrade_sheet.has_method("set_sheet_contract"):
				upgrade_sheet.call("set_sheet_contract", _build_main_city_facility_sheet_contract(selected, true, readonly_facility_entry))
		upgrade_sheet.connect("primary_action_requested", primary_callback)
	if upgrade_sheet != null and upgrade_sheet.has_signal("secondary_action_requested"):
		var secondary_callback := func(_action_id: String) -> void:
			var building_id := ""
			if building_tree != null and building_tree.has_method("get_selected_building_id"):
				building_id = str(building_tree.call("get_selected_building_id"))
			var selected := _find_main_city_facility_tree_building(building_id)
			if upgrade_sheet is Control:
				(upgrade_sheet as Control).visible = true
			if upgrade_sheet.has_method("set_sheet_contract"):
				upgrade_sheet.call("set_sheet_contract", _build_main_city_facility_sheet_contract(selected, false, readonly_facility_entry))
		upgrade_sheet.connect("secondary_action_requested", secondary_callback)
	_record_last_action("main_city/facility_tree", "opened")
	_update_runtime_label("main city facility tree")
	return _build_main_city_facility_tree_page_summary(map_click_result)

func _open_ai_main_city_facility_tree_from_outcome(outcome: Dictionary) -> void:
	var entry_response: Dictionary = outcome.get("post_open_ai_main_city_facility_entry", {}) as Dictionary
	if entry_response.is_empty():
		var action_result: Dictionary = outcome.get("action_result", {}) as Dictionary
		entry_response = action_result.get("remote_result", {}) as Dictionary
	var entry_data: Dictionary = entry_response.get("data", {}) as Dictionary
	var entry_model: Dictionary = entry_data.get("mainCityFacilityEntry", {}) as Dictionary
	if entry_model.is_empty() and entry_response.has("mainCityFacilityEntry"):
		entry_model = entry_response.get("mainCityFacilityEntry", {}) as Dictionary
	if entry_model.is_empty():
		_open_main_city_facility_tree_overlay({
			"targetContext": {
				"title": "AI主城",
				"readonly": true,
			},
