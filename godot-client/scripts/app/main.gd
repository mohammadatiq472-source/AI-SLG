func _press_mainline_visual_smoke_generals_roster_switch_hero(panel_id: String, action_id: String, button_text: String) -> Dictionary:
	if panel_id != "generals" or _active_panel_id != "generals":
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "generals_panel_not_active",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
			"actionId": action_id,
		}
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "overlay_missing",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
			"actionId": action_id,
		}
	var panel_control := _active_overlay_panel as Control
	if panel_control == null:
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "overlay_not_control",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
			"actionId": action_id,
		}
	var before_page_id := ""
	if panel_control.has_method("get_active_page_id"):
		before_page_id = str(panel_control.call("get_active_page_id")).strip_edges()
	if before_page_id != "roster":
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "active_page_not_roster",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
			"beforeActivePageId": before_page_id,
			"actionId": action_id,
		}
	var before_summary := _read_mainline_visual_smoke_overlay_page_summary(panel_id, before_page_id)
	var before_hero_id := str(before_summary.get("activeHeroId", "")).strip_edges()
	var switch_button := _find_mainline_visual_smoke_visible_button_by_text(panel_control, button_text)
	if switch_button == null:
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "hero_switch_button_missing",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
			"beforeActivePageId": before_page_id,
			"buttonText": button_text,
			"actionId": action_id,
			"beforePageContentSummary": before_summary,
		}
	switch_button.emit_signal("pressed")
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(0.15).timeout
	var after_page_id := ""
	if panel_control.has_method("get_active_page_id"):
		after_page_id = str(panel_control.call("get_active_page_id")).strip_edges()
	var after_summary := _read_mainline_visual_smoke_overlay_page_summary(panel_id, after_page_id)
	var after_hero_id := str(after_summary.get("activeHeroId", "")).strip_edges()
	var layout_after := _read_mainline_visual_smoke_overlay_panel_layout_summary(panel_id)
	var hero_changed := before_hero_id != "" and after_hero_id != "" and before_hero_id != after_hero_id
	var page_ok := after_page_id == "roster"
	var page_content_ok := bool(after_summary.get("ok", false))
	var layout_ok := bool(layout_after.get("layoutOk", false))
	var ok := page_ok and page_content_ok and layout_ok and hero_changed
	return {
		"attempted": true,
		"ok": ok,
		"clicked": true,
		"reason": "hero_switched" if ok else "hero_switch_not_verified",
		"panelId": panel_id,
		"activePanelId": _active_panel_id,
		"actionId": action_id,
		"buttonText": button_text,
		"buttonRect": _rect_to_mainline_visual_smoke_dict(switch_button.get_global_rect()),
		"beforeActivePageId": before_page_id,
		"afterActivePageId": after_page_id,
		"beforeActiveHeroId": before_hero_id,
		"afterActiveHeroId": after_hero_id,
		"heroChanged": hero_changed,
		"pageOk": page_ok,
		"pageContentOk": page_content_ok,
		"pageContentSummary": after_summary,
		"beforePageContentSummary": before_summary,
		"overlayPanelLayoutAfter": layout_after,
	}

