func _resolve_selected_main_map_tile_screen_position() -> Vector2:
	if _map_grid == null or not is_instance_valid(_map_grid):
		return Vector2.ZERO
	var context := _selected_main_map_cell_context
	if context.is_empty():
		context = _resolve_selected_main_map_cell_context()
	if context.is_empty():
		return Vector2.ZERO
	var tile_id := str(context.get("tileId", "")).strip_edges()
	var tile_x := int(context.get("cellX", context.get("tileX", context.get("x", -1))))
	var tile_y := int(context.get("cellY", context.get("tileY", context.get("y", -1))))
	if _map_grid.has_method("_resolve_screen_position_for_tile") and int(context.get("tmxX", -1)) >= 0 and int(context.get("tmxY", -1)) >= 0:
		var direct_variant: Variant = _map_grid.call("_resolve_screen_position_for_tile", context)
		if direct_variant is Vector2:
			return direct_variant as Vector2
	if tile_id != "" and _map_grid.has_method("tile_id_to_screen_position"):
		var by_id_variant: Variant = _map_grid.call("tile_id_to_screen_position", tile_id, maxi(tile_x, 0), maxi(tile_y, 0))
		if by_id_variant is Vector2:
			return by_id_variant as Vector2
	if tile_x >= 0 and tile_y >= 0 and _map_grid.has_method("tile_to_screen_position"):
		var by_coord_variant: Variant = _map_grid.call("tile_to_screen_position", tile_x, tile_y)
		if by_coord_variant is Vector2:
			return by_coord_variant as Vector2
	return Vector2.ZERO

func _build_main_map_frontline_marker_cell(context: Dictionary) -> Dictionary:
	return {
		"x": int(context.get("cellX", context.get("tmxX", 0))),
		"y": int(context.get("cellY", context.get("tmxY", 0))),
	}

func _build_main_map_frontline_marker_id(from_cell: Dictionary, to_cell: Dictionary) -> String:
	return "frontline_marker_main_world_%d_%d_to_%d_%d" % [
		int(from_cell.get("x", 0)),
		int(from_cell.get("y", 0)),
		int(to_cell.get("x", 0)),
		int(to_cell.get("y", 0)),
	]

func _execute_main_map_frontline_marker_action(from_context: Dictionary, to_context: Dictionary, source: String = "player") -> Dictionary:
	if _target_faction_id.strip_edges() == "":
		_update_runtime_label("main map frontline marker missing faction")
		return {"ok": false, "reason": "missing_faction"}
	var from_cell: Dictionary = _build_main_map_frontline_marker_cell(from_context)
	var to_cell: Dictionary = _build_main_map_frontline_marker_cell(to_context)
	if int(from_cell.get("x", -1)) == int(to_cell.get("x", -1)) and int(from_cell.get("y", -1)) == int(to_cell.get("y", -1)):
		return {"ok": false, "reason": "same_cell", "fromCell": from_cell, "toCell": to_cell}
	var adapter = _resolve_slg_domain_action_adapter()
	if not adapter.has_method("request_alliance_frontline_marker_update"):
		return {"ok": false, "reason": "adapter_method_missing"}
	var marker_id: String = _build_main_map_frontline_marker_id(from_cell, to_cell)
	_set_request_state(true, "frontline marker %s..." % source)
	var result: Dictionary = await adapter.call(
		"request_alliance_frontline_marker_update",
		marker_id,
		"主世界推进线",
		from_cell,
		to_cell,
		"官员主世界标注工具",
		MAIN_MAP_FRONTLINE_MARKER_ACTOR_COMMANDER_ID
	)
	if not bool(result.get("ok", false)):
		_record_last_action("main_map_frontline/%s" % marker_id, "rejected")
		_set_request_state(false, "frontline marker rejected")
		return {
			"ok": false,
			"reason": "action_rejected",
			"markerId": marker_id,
			"fromCell": from_cell,
			"toCell": to_cell,
			"result": result,
		}
	var refresh_ok := true
	if bool(result.get("requires_map_refresh", false)):
		refresh_ok = await _refresh_world_and_map(true)
	_sync_selected_main_map_cell_context_from_map_grid()
	_record_last_action("main_map_frontline/%s" % marker_id, "ok" if refresh_ok else "ok_refresh_failed")
	_set_request_state(false, "frontline marker ok" if refresh_ok else "frontline marker ok, refresh failed")
	return {
		"ok": true,
		"markerId": marker_id,
		"fromCell": from_cell,
		"toCell": to_cell,
		"actorCommanderId": MAIN_MAP_FRONTLINE_MARKER_ACTOR_COMMANDER_ID,
		"refreshOk": refresh_ok,
		"result": result,
	}

func _build_main_map_cell_owner_action_payload(context: Dictionary, action_kind: String) -> Dictionary:
	var owner_id: String = str(context.get("owner", "neutral")).strip_edges()
	if owner_id == "":
		owner_id = "neutral"
	var payload: Dictionary = {
		"worldId": str(context.get("worldId", MAIN_MAP_WORLD_ID)).strip_edges(),
		"coordinateSpace": str(context.get("coordinateSpace", MAIN_MAP_COORDINATE_SPACE)).strip_edges(),
		"factionId": _target_faction_id,
		"requestId": "godot_main_map_%s_%d_%d_%d" % [
			action_kind,
			int(context.get("cellX", 0)),
			int(context.get("cellY", 0)),
			Time.get_ticks_msec(),
		],
		"cellX": int(context.get("cellX", 0)),
		"cellY": int(context.get("cellY", 0)),
		"expectedOwner": owner_id,
		"expectedCellVersion": int(context.get("cellVersion", 0)),
	}
	return payload

func _build_main_map_owner_delta_message_from_receipt(receipt: Dictionary, action_kind: String, payload: Dictionary) -> Dictionary:
	if receipt.is_empty():
		return {}
	var cell_x: int = int(receipt.get("cellX", payload.get("cellX", -1)))
	var cell_y: int = int(receipt.get("cellY", payload.get("cellY", -1)))
	if cell_x < 0 or cell_y < 0:
		return {}
	var event_type: String = action_kind.strip_edges().to_lower()
	if event_type != "claim" and event_type != "release":
		event_type = "claim" if str(receipt.get("action", "")).strip_edges() == "claimMainMapCell" else "release"
	var message: Dictionary = {
		"type": "main_map_owner_delta",
		"worldId": str(receipt.get("worldId", payload.get("worldId", MAIN_MAP_WORLD_ID))).strip_edges(),
		"coordinateSpace": str(receipt.get("coordinateSpace", payload.get("coordinateSpace", MAIN_MAP_COORDINATE_SPACE))).strip_edges(),
		"cellId": str(receipt.get("cellId", "")).strip_edges(),
		"chunkId": str(receipt.get("chunkId", "")).strip_edges(),
		"cellX": cell_x,
		"cellY": cell_y,
		"owner": str(receipt.get("nextOwner", "neutral")).strip_edges(),
		"previousOwner": str(receipt.get("previousOwner", "neutral")).strip_edges(),
		"cellVersion": int(receipt.get("nextCellVersion", receipt.get("cellVersion", 0))),
		"previousCellVersion": int(receipt.get("previousCellVersion", payload.get("expectedCellVersion", 0))),
		"eventType": event_type,
		"requestId": str(payload.get("requestId", "")).strip_edges(),
	}
	for key_variant in ["immunityUntil", "immunity_until", "immunityActive", "immunity_active", "immunitySource", "immunity_source"]:
		var key: String = str(key_variant)
		if receipt.has(key):
			message[key] = receipt.get(key)
	return message

func _apply_main_map_owner_delta_message_to_map_grid(message: Dictionary) -> bool:
	if message.is_empty():
		return false
	if _map_grid == null or not is_instance_valid(_map_grid):
		return false
	if not _map_grid.has_method("apply_main_map_owner_delta_invalidation"):
		return false
	var applied_variant: Variant = _map_grid.call("apply_main_map_owner_delta_invalidation", message)
	return bool(applied_variant)

func _execute_world_tile_expedition_minimal_settlement(source: String = "player") -> Dictionary:
	if _target_faction_id.strip_edges() == "":
		return {"ok": false, "reason": "missing_faction"}
	var context: Dictionary = _resolve_selected_main_map_cell_context()
	if context.is_empty() or not _is_world_tile_action_hud_resource_context(context):
		return {"ok": false, "reason": "missing_resource_tile_selection", "selectedContext": context}
	var tile_id := str(context.get("tileId", "")).strip_edges()
	var unit_id := _find_world_tile_expedition_unit_id(tile_id)
	if tile_id == "" or unit_id == "":
		var missing_feedback := "请先调部队到此地"
		var missing_summary := _build_world_tile_action_hud_summary(context, {}, missing_feedback)
		_apply_world_tile_action_hud_summary(missing_summary)
		return {
			"attempted": true,
			"ok": false,
			"reason": "unit_not_on_tile",
			"tileId": tile_id,
			"unitId": unit_id,
			"feedbackVisible": true,
			"pageContentSummary": missing_summary,
		}
	var payload := {
		"factionId": _target_faction_id,
		"unitId": unit_id,
		"tileId": tile_id,
	}
	_set_request_state(true, "tile expedition %s..." % source)
	var action_result: Dictionary = await _api_client.post_world_action("occupyTile", payload, true)
	if not bool(action_result.get("ok", false)):
		var failed_feedback := "出征未成"
		var failed_summary := _build_world_tile_action_hud_summary(context, {}, failed_feedback)
		_apply_world_tile_action_hud_summary(failed_summary)
		_set_request_state(false, failed_feedback)
		return {
			"attempted": true,
			"ok": false,
			"reason": "request_failed",
			"payload": payload,
			"response": action_result,
			"pageContentSummary": failed_summary,
		}
	var action_payload: Dictionary = action_result.get("data", {}) as Dictionary
	if not bool(action_payload.get("ok", false)):
		var reject_feedback := "守军击退"
		var reject_summary := _build_world_tile_action_hud_summary(context, {}, reject_feedback)
		_apply_world_tile_action_hud_summary(reject_summary)
		_set_request_state(false, reject_feedback)
		return {
			"attempted": true,
			"ok": false,
			"reason": "action_rejected",
			"payload": payload,
			"response": action_payload,
			"pageContentSummary": reject_summary,
		}
	var action_world: Variant = action_payload.get("world", null)
	if action_world is Dictionary:
		WorldStore.set_world(action_world as Dictionary)
	var receipt: Dictionary = {}
	var receipt_variant: Variant = action_payload.get("receipt", {})
	if receipt_variant is Dictionary:
		receipt = receipt_variant as Dictionary
		_store_runtime_action_receipt(receipt)
	var refresh_ok := await _refresh_world_and_map(true)
	var battle_record := _find_latest_world_tile_battle_record(tile_id)
	var battle_report_id := str(battle_record.get("id", "")).strip_edges()
	var occupied := bool(receipt.get("occupied", false))
	var feedback_text := "占领成功 · 战报已记" if occupied else "守军击退 · 战报已记"
	var settlement := {
		"settlementOk": true,
		"settlementReceiptId": str(action_payload.get("requestId", "")).strip_edges(),
		"battleReportId": battle_report_id,
		"resourceDelta": {
			"actionPoints": -1,
			"food": -1,
			"expGained": int(receipt.get("expGained", 0)),
		},
		"taskProgressDelta": receipt.get("taskProgressDelta", {}),
		"battleRecordReadback": battle_record,
	}
	var final_summary := _build_world_tile_action_hud_summary(context, settlement, feedback_text)
	_apply_world_tile_action_hud_summary(final_summary)
	_hide_main_map_owner_delta_buttons_for_tile_hud()
	_record_last_action("world_tile_expedition/%s" % tile_id, "ok" if occupied else "settled_not_occupied")
	_set_request_state(false, feedback_text)
	return {
		"attempted": true,
		"ok": bool(final_summary.get("worldTileExpeditionMinimalSettlementOk", false)) and (battle_report_id != "" or not battle_record.is_empty()),
		"reason": "world_tile_expedition_minimal_settlement_done",
		"clicked": true,
		"tileId": tile_id,
		"unitId": unit_id,
		"payload": payload,
		"receipt": receipt,
		"refreshOk": refresh_ok,
		"pageContentOk": bool(final_summary.get("worldTileExpeditionMinimalSettlementOk", false)),
		"pageContentSummary": final_summary,
	}

func _execute_main_map_cell_owner_action(action_kind: String, source: String = "player") -> Dictionary:
	var normalized_action: String = action_kind.strip_edges().to_lower()
	if normalized_action != "claim" and normalized_action != "release":
		return {"ok": false, "reason": "invalid_action", "actionKind": action_kind}
	if _target_faction_id.strip_edges() == "":
		_update_runtime_label("main map cell action missing faction")
		return {"ok": false, "reason": "missing_faction"}
	var context: Dictionary = _resolve_selected_main_map_cell_context()
	if context.is_empty():
		_update_runtime_label("main map cell action missing selection")
		return {"ok": false, "reason": "missing_selection"}
	var action_name: String = "claimMainMapCell" if normalized_action == "claim" else "releaseMainMapCell"
	var payload: Dictionary = _build_main_map_cell_owner_action_payload(context, normalized_action)
	_set_request_state(true, "%s %s..." % [action_name, source])
	var action_result: Dictionary = await _api_client.post_world_action(action_name, payload, true)
	if not bool(action_result.get("ok", false)):
		push_warning("[godot-runtime] %s request failed: %s" % [action_name, str(action_result)])
		_record_last_action("main_map_cell/%s/%d_%d" % [normalized_action, int(payload.get("cellX", 0)), int(payload.get("cellY", 0))], "request_failed")
		_set_request_state(false, "%s failed" % action_name)
		return {
			"ok": false,
			"reason": "request_failed",
			"action": action_name,
			"payload": payload,
			"response": action_result,
		}

	var action_payload: Dictionary = action_result.get("data", {}) as Dictionary
	if not bool(action_payload.get("ok", false)):
		push_warning("[godot-runtime] %s action returned ok=false: %s" % [action_name, str(action_payload)])
		_record_last_action("main_map_cell/%s/%d_%d" % [normalized_action, int(payload.get("cellX", 0)), int(payload.get("cellY", 0))], "rejected")
		var failure_message: String = _format_world_action_failure_message(action_payload, action_name)
		_set_request_state(false, failure_message.replace("\n", " "))
		_set_main_map_cell_summary_warning(failure_message)
		return {
			"ok": false,
			"reason": "action_rejected",
			"action": action_name,
			"payload": payload,
			"response": action_payload,
		}

	var action_world: Variant = action_payload.get("world", null)
	if action_world is Dictionary:
		WorldStore.set_world(action_world as Dictionary)
	var receipt_variant: Variant = action_payload.get("receipt", {})
	var receipt_owner_delta_message: Dictionary = {}
	var owner_delta_applied: bool = false
	if receipt_variant is Dictionary:
		var receipt: Dictionary = receipt_variant as Dictionary
		_store_runtime_action_receipt(receipt)
		receipt_owner_delta_message = _build_main_map_owner_delta_message_from_receipt(receipt, normalized_action, payload)
		owner_delta_applied = _apply_main_map_owner_delta_message_to_map_grid(receipt_owner_delta_message)
	var delta_refresh_ok: bool = await _refresh_main_map_cell_owner_delta()
	if not receipt_owner_delta_message.is_empty():
		owner_delta_applied = _apply_main_map_owner_delta_message_to_map_grid(receipt_owner_delta_message) or owner_delta_applied
	_sync_selected_main_map_cell_context_from_map_grid()
	_record_last_action("main_map_cell/%s/%d_%d" % [normalized_action, int(payload.get("cellX", 0)), int(payload.get("cellY", 0))], "ok" if delta_refresh_ok else "ok_delta_refresh_failed")
	var final_status_message: String = "%s %s ok" % [action_name, source] if delta_refresh_ok else "%s ok, delta refresh failed" % action_name
	_set_request_state(false, final_status_message)
	return {
		"ok": true,
		"action": action_name,
		"payload": payload,
		"receipt": receipt_variant if receipt_variant is Dictionary else {},
		"deltaRefreshOk": delta_refresh_ok,
		"ownerDeltaApplied": owner_delta_applied,
		"selectedContext": _selected_main_map_cell_context.duplicate(true),
	}

func _refresh_main_map_cell_owner_delta() -> bool:
	if _is_tianxia_yutu_main_map_mode():
		return true
	var map_query_params: Dictionary = _resolve_map_layout_query_params()
	var map_request_key: String = _build_map_layout_request_key(_active_map_scope, map_query_params)
	if map_request_key != "":
		_viewport_map_cache.erase(map_request_key)
		_viewport_map_cache_order.erase(map_request_key)
	var map_result: Dictionary = await _api_client.get_map_layout(_active_map_scope, map_query_params)
	if bool(map_result.get("ok", false)):
		var map_layout_data: Dictionary = map_result.get("data", {}) as Dictionary
		_apply_map_layout_data(map_layout_data, map_request_key if _active_map_scope == "viewport" else "", "network")
		_update_runtime_label("main map owner delta refreshed")
		return true
	push_warning("[godot-runtime] main map owner delta refresh failed: %s" % str(map_result))
	return false

func _resolve_map_layout_query_params() -> Dictionary:
	var params: Dictionary = _active_map_query_params.duplicate(true)
	if _active_map_scope != "viewport":
		return params

	if not params.has("layer") or str(params.get("layer", "")).strip_edges() == "":
		params["layer"] = "layered" if params.has("includeLayers") else "tile"
	if _is_tianxia_yutu_main_map_mode():
		params["layer"] = "layered"
		params["includeLayers"] = TIANXIA_YUTU_INCLUDE_LAYERS

	var use_dynamic_camera_viewport: bool = _active_map_scope == "viewport" and not _is_truthy_env("SLG_MAP_DYNAMIC_VIEWPORT_DISABLED")
	if _map_grid != null and _map_grid.has_method("get_camera_viewport_query_params"):
		var camera_params_variant: Variant = _map_grid.call("get_camera_viewport_query_params")
		if camera_params_variant is Dictionary:
			var camera_params: Dictionary = camera_params_variant as Dictionary
			for key_variant in camera_params.keys():
				var key: String = str(key_variant)
				var value: String = str(camera_params.get(key_variant, "")).strip_edges()
				if key == "" or value == "":
					continue
				if use_dynamic_camera_viewport and _can_dynamic_camera_override_map_param(key):
					params[key] = value
				elif not params.has(key) or str(params.get(key, "")).strip_edges() == "":
					params[key] = value
	if _is_tianxia_yutu_main_map_mode():
		params["layer"] = "layered"
		params["includeLayers"] = TIANXIA_YUTU_INCLUDE_LAYERS
		params.erase("loadedChunkIds")
	if _viewport_loaded_chunk_ids.size() > 0 and not params.has("loadedChunkIds"):
		params["loadedChunkIds"] = _join_chunk_id_array(_viewport_loaded_chunk_ids)
	if _is_tianxia_yutu_main_map_mode():
		params.erase("loadedChunkIds")

	return params

func _can_dynamic_camera_override_map_param(key: String) -> bool:
	match key:
		"centerX":
			return AppConfig.map_layout_center_x.strip_edges() == ""
		"centerY":
			return AppConfig.map_layout_center_y.strip_edges() == ""
		"visibleCells":
			return AppConfig.map_layout_visible_cells.strip_edges() == ""
		"preloadMargin":
			return AppConfig.map_layout_preload_margin.strip_edges() == ""
		"chunkSize":
			return AppConfig.map_layout_chunk_size.strip_edges() == ""
		"worldId", "coordinateSpace", "visibleSizeCells", "preloadMarginCells", "includeLayers", "loadedChunkIds":
			return true
		_:
			return false

func _join_chunk_id_array(chunk_ids: Array) -> String:
	var packed: PackedStringArray = PackedStringArray()
	for chunk_id_variant in chunk_ids:
		var chunk_id: String = str(chunk_id_variant).strip_edges()
		if chunk_id != "":
			packed.append(chunk_id)
	return ",".join(packed)

func _is_viewport_map_streaming_enabled() -> bool:
	return _active_map_scope == "viewport"

func _start_main_map_owner_delta_ws_bridge() -> void:
	if _main_map_owner_delta_ws_bridge != null:
		return
	if not _is_viewport_map_streaming_enabled():
		return
	_main_map_owner_delta_ws_bridge = MainMapOwnerDeltaWsBridgeScript.new()
	_main_map_owner_delta_ws_bridge.name = "MainMapOwnerDeltaWsBridge"
	add_child(_main_map_owner_delta_ws_bridge)
	if _main_map_owner_delta_ws_bridge.has_signal("owner_delta_invalidated"):
		var callback := Callable(self, "_on_main_map_owner_delta_ws_invalidated")
		if not _main_map_owner_delta_ws_bridge.is_connected("owner_delta_invalidated", callback):
			_main_map_owner_delta_ws_bridge.connect("owner_delta_invalidated", callback)
	if _main_map_owner_delta_ws_bridge.has_signal("war_room_live_refresh_received"):
		var war_room_callback := Callable(self, "_on_war_room_ws_live_refresh_received")
		if not _main_map_owner_delta_ws_bridge.is_connected("war_room_live_refresh_received", war_room_callback):
			_main_map_owner_delta_ws_bridge.connect("war_room_live_refresh_received", war_room_callback)
	if _main_map_owner_delta_ws_bridge.has_method("configure"):
		_main_map_owner_delta_ws_bridge.call("configure", AppConfig.backend_base_url)
	if _main_map_owner_delta_ws_bridge.has_method("bind_session"):
		_main_map_owner_delta_ws_bridge.call("bind_session", _target_faction_id, SessionStore.token)
	if _main_map_owner_delta_ws_bridge.has_method("start"):
		_main_map_owner_delta_ws_bridge.call("start")

func _on_main_map_owner_delta_ws_invalidated(message: Dictionary) -> void:
	_main_map_owner_delta_ws_invalidation_count += 1
	_main_map_owner_delta_ws_last_type = str(message.get("type", "main_map_owner_delta"))
	var override_version: int = int(message.get("overrideVersion", -1))
	if override_version >= 0:
		_main_map_owner_delta_override_version = max(_main_map_owner_delta_override_version, override_version)
	call_deferred("_refresh_main_map_owner_delta_from_ws")

func _on_war_room_ws_live_refresh_received(message: Dictionary) -> void:
	_war_room_ws_live_refresh_count += 1
	_main_map_owner_delta_ws_last_type = str(message.get("type", "war_room_live_refresh"))
	var refresh: Dictionary = message.get("refresh", {}) as Dictionary if message.get("refresh", {}) is Dictionary else {}
	if refresh.is_empty():
		return
	var ai_state := WorldStore.get_ai_state(_target_faction_id)
	var next_ai_state := ai_state.duplicate(true)
	next_ai_state["playerRuntimeAutonomousCombatWarRoomLiveRefresh"] = refresh.duplicate(true)
	next_ai_state["playerRuntimeUpdatedAt"] = Time.get_datetime_string_from_system(false, true)
	WorldStore.set_ai_state(_target_faction_id, next_ai_state)
	if _active_panel_id == "alliance":
		call_deferred("_refresh_overlay_panel_state")

func _refresh_main_map_owner_delta_from_ws() -> void:
	if not _is_viewport_map_streaming_enabled():
		return
	if _is_tianxia_yutu_main_map_mode():
		return
	var ok: bool = await _refresh_main_map_cell_owner_delta()
	if ok:
		_main_map_owner_delta_ws_refresh_ok_count += 1
		_update_runtime_label("main map owner delta ws invalidation ok")
	else:
		_main_map_owner_delta_ws_refresh_fail_count += 1

func _build_map_layout_request_key(scope: String, query_params: Dictionary) -> String:
	var normalized_scope: String = scope.strip_edges()
	if normalized_scope == "":
		normalized_scope = "bootstrap"
	var keys: Array = query_params.keys()
	keys.sort()
	var parts: PackedStringArray = PackedStringArray()
	parts.append("scope=%s" % normalized_scope)
	for key_variant in keys:
		var key: String = str(key_variant).strip_edges()
		var value: String = str(query_params.get(key_variant, "")).strip_edges()
		if key == "" or value == "":
			continue
		parts.append("%s=%s" % [key, value])
	return "|".join(parts)

func _schedule_viewport_map_refresh(map_query_params: Dictionary, request_key: String) -> void:
	_viewport_map_refresh_debounce_seq += 1
	_viewport_map_pending_key = request_key
	var debounce_seq: int = _viewport_map_refresh_debounce_seq
	call_deferred("_execute_viewport_map_refresh_after_debounce", debounce_seq, map_query_params.duplicate(true), request_key)

func _execute_viewport_map_refresh_after_debounce(debounce_seq: int, map_query_params: Dictionary, request_key: String) -> void:
	await get_tree().create_timer(VIEWPORT_MAP_REFRESH_DEBOUNCE_SECONDS).timeout
	if debounce_seq != _viewport_map_refresh_debounce_seq:
		return
	if not _is_viewport_map_streaming_enabled():
		return
	var current_query_params: Dictionary = _resolve_map_layout_query_params()
	var current_key: String = _build_map_layout_request_key(_active_map_scope, current_query_params)
	if current_key != request_key:
		_schedule_viewport_map_refresh(current_query_params, current_key)
		return
	await _refresh_viewport_map_layout(map_query_params, request_key)

func _refresh_viewport_map_layout(map_query_params: Dictionary, request_key: String) -> bool:
	if _viewport_map_cache.has(request_key):
		_viewport_cache_hit_count += 1
		var cached_layout: Dictionary = (_viewport_map_cache.get(request_key, {}) as Dictionary).duplicate(false)
		_apply_map_layout_data(cached_layout, request_key, "cache")
		_update_runtime_label("viewport map cache hit")
		return true

	_viewport_map_request_seq += 1
	var request_seq: int = _viewport_map_request_seq
	_viewport_map_active_request_seq = request_seq
	_viewport_map_inflight_key = request_key
	var map_result: Dictionary = await _api_client.get_map_layout(_active_map_scope, map_query_params)
	if request_seq != _viewport_map_active_request_seq or request_key != _viewport_map_pending_key:
		if _viewport_map_inflight_key == request_key:
			_viewport_map_inflight_key = ""
		if request_key != "" and request_key == _viewport_map_last_applied_key:
			return true
		_viewport_stale_response_count += 1
		return false
	_viewport_map_inflight_key = ""
	if bool(map_result.get("ok", false)):
		var map_layout_data: Dictionary = map_result.get("data", {}) as Dictionary
		_apply_map_layout_data(map_layout_data, request_key, "network")
		_update_runtime_label("viewport map refreshed")
		return true
	if _viewport_map_pending_key == request_key:
		_viewport_map_pending_key = ""
	push_warning("[godot-runtime] viewport map layout request failed: %s" % str(map_result))
	return false

func _refresh_viewport_map_layout_immediate(map_query_params: Dictionary, request_key: String) -> bool:
	if request_key == "":
		return false
	_viewport_map_refresh_debounce_seq += 1
	_viewport_map_pending_key = request_key
	return await _refresh_viewport_map_layout(map_query_params, request_key)

func _apply_map_layout_data(map_layout_data: Dictionary, request_key: String, source: String) -> void:
	WorldStore.set_map_layout(map_layout_data)
	if request_key != "":
		_viewport_map_last_applied_key = request_key
		if _viewport_map_pending_key == request_key:
			_viewport_map_pending_key = ""
	if source == "network" and request_key != "":
		_cache_viewport_map_layout(request_key, map_layout_data)
	_update_viewport_chunk_tracking(map_layout_data)
	_ingest_tianxia_yutu_main_map_layer(map_layout_data)
	var override_version: int = _extract_main_map_override_version(map_layout_data)
	if override_version >= 0:
		_main_map_owner_delta_override_version = override_version
	_sync_selected_main_map_cell_context_from_map_grid()

func _cache_viewport_map_layout(request_key: String, map_layout_data: Dictionary) -> void:
	if request_key == "":
		return
	# Large layered map payloads are treated as immutable after ingestion; shallow cache avoids Godot deep-copy crashes.
	_viewport_map_cache[request_key] = map_layout_data.duplicate(false)
	_viewport_map_cache_order.erase(request_key)
	_viewport_map_cache_order.append(request_key)
	while _viewport_map_cache_order.size() > VIEWPORT_MAP_CACHE_MAX_ENTRIES:
		var evicted_key: String = str(_viewport_map_cache_order.pop_front())
		_viewport_map_cache.erase(evicted_key)

func _update_viewport_chunk_tracking(map_layout_data: Dictionary) -> void:
	var next_loaded_chunk_ids: Array = _extract_loaded_chunk_ids(map_layout_data)
	var next_set: Dictionary = {}
	for chunk_id_variant in next_loaded_chunk_ids:
		next_set[str(chunk_id_variant)] = true
	var unload_candidates: Array = []
	for chunk_id_variant in _viewport_loaded_chunk_ids:
		var chunk_id: String = str(chunk_id_variant)
		if chunk_id != "" and not next_set.has(chunk_id):
			unload_candidates.append(chunk_id)
	_viewport_unload_candidate_chunk_ids = unload_candidates
	_viewport_loaded_chunk_ids = next_loaded_chunk_ids

func _extract_loaded_chunk_ids(map_layout_data: Dictionary) -> Array:
	var layered_chunk: Dictionary = _extract_layered_chunk_layer(map_layout_data)
	var raw_layered_loaded_chunk_ids: Variant = layered_chunk.get("loaded_chunk_ids", [])
	if raw_layered_loaded_chunk_ids is Array:
		return (raw_layered_loaded_chunk_ids as Array).duplicate(true)
	var chunk: Dictionary = map_layout_data.get("chunk", {}) as Dictionary
	var camera_viewport: Dictionary = chunk.get("cameraViewport", {}) as Dictionary
	var raw_loaded_chunk_ids: Variant = camera_viewport.get("loadedChunkIds", [])
	if raw_loaded_chunk_ids is Array:
		return (raw_loaded_chunk_ids as Array).duplicate(true)
	var raw_legacy_loaded_province_ids: Variant = chunk.get("loadedProvinceIds", [])
	if raw_legacy_loaded_province_ids is Array:
		return (raw_legacy_loaded_province_ids as Array).duplicate(true)
	return []

func _extract_layered_chunk_layer(map_layout_data: Dictionary) -> Dictionary:
	var direct_layer_variant: Variant = map_layout_data.get("chunk_layer", {})
	if direct_layer_variant is Dictionary:
		return direct_layer_variant as Dictionary
	for key in ["layeredAdapter", "layered", "layers"]:
		var nested_variant: Variant = map_layout_data.get(key, {})
		if not (nested_variant is Dictionary):
			continue
		var nested: Dictionary = nested_variant as Dictionary
		var nested_chunk_variant: Variant = nested.get("chunk_layer", {})
		if nested_chunk_variant is Dictionary:
			return nested_chunk_variant as Dictionary
	return {}

func _start_main_map_owner_delta_polling() -> void:
	if _main_map_owner_delta_poll_timer != null:
		return
	if not _is_viewport_map_streaming_enabled():
		return
	_main_map_owner_delta_poll_timer = Timer.new()
	_main_map_owner_delta_poll_timer.name = "MainMapOwnerDeltaPollTimer"
	_main_map_owner_delta_poll_timer.wait_time = MAIN_MAP_OWNER_DELTA_POLL_INTERVAL_SECONDS
	_main_map_owner_delta_poll_timer.one_shot = false
	_main_map_owner_delta_poll_timer.autostart = true
	add_child(_main_map_owner_delta_poll_timer)
	var callback := Callable(self, "_on_main_map_owner_delta_poll_timeout")
	if not _main_map_owner_delta_poll_timer.timeout.is_connected(callback):
		_main_map_owner_delta_poll_timer.timeout.connect(callback)
	call_deferred("_poll_main_map_owner_delta")

func _on_main_map_owner_delta_poll_timeout() -> void:
	if _main_map_owner_delta_poll_in_flight:
		return
	call_deferred("_poll_main_map_owner_delta")

func _poll_main_map_owner_delta() -> void:
	if _main_map_owner_delta_poll_in_flight:
		return
	if not _is_viewport_map_streaming_enabled():
		return
	if _display_mode != DISPLAY_MODE_WORLD:
		return
	if _is_tianxia_yutu_main_map_mode():
		return
	_main_map_owner_delta_poll_in_flight = true
	var map_query_params: Dictionary = _resolve_map_layout_query_params()
	var request_key: String = _build_map_layout_request_key(_active_map_scope, map_query_params)
	if request_key != "":
		_viewport_map_cache.erase(request_key)
		_viewport_map_cache_order.erase(request_key)
	var map_result: Dictionary = await _api_client.get_map_layout(_active_map_scope, map_query_params)
	_main_map_owner_delta_poll_in_flight = false
	if bool(map_result.get("ok", false)):
		var map_layout_data: Dictionary = map_result.get("data", {}) as Dictionary
		_main_map_owner_delta_override_version = _extract_main_map_override_version(map_layout_data)
		_main_map_owner_delta_poll_ok_count += 1
		_apply_map_layout_data(map_layout_data, request_key, "network")
		_update_runtime_label("main map owner delta poll ok")
		return
	_main_map_owner_delta_poll_fail_count += 1
	push_warning("[godot-runtime] main map owner delta poll failed: %s" % str(map_result))

func _extract_main_map_override_version(map_layout_data: Dictionary) -> int:
	var cell_override_layer: Dictionary = {}
	var direct_layer_variant: Variant = map_layout_data.get("cell_override_layer", {})
	if direct_layer_variant is Dictionary:
		cell_override_layer = direct_layer_variant as Dictionary
	else:
		for key in ["layeredAdapter", "layered", "layers"]:
			var nested_variant: Variant = map_layout_data.get(key, {})
			if not (nested_variant is Dictionary):
				continue
			var nested: Dictionary = nested_variant as Dictionary
			var nested_layer_variant: Variant = nested.get("cell_override_layer", {})
			if nested_layer_variant is Dictionary:
				cell_override_layer = nested_layer_variant as Dictionary
				break
	if cell_override_layer.is_empty():
		return -1
	return int(cell_override_layer.get("override_version", -1))

func _refresh_world_and_map(fetch_map_layout: bool) -> bool:
	var world_result: Dictionary = await _api_client.get_world_summary()
	if not bool(world_result.get("ok", false)):
		push_warning("[godot-runtime] world request failed: %s" % str(world_result))
		return false

	var world_response: Dictionary = world_result.get("data", {}) as Dictionary
	var world_data: Dictionary = world_response.get("world", world_response) as Dictionary
	if world_data.is_empty():
		push_warning("[godot-runtime] world payload empty")
		return false

	WorldStore.set_world(world_data)

	var should_fetch_map: bool = fetch_map_layout or WorldStore.map_layout.is_empty()
	if not should_fetch_map:
		_update_runtime_label("world refreshed")
		return true

	var map_query_params: Dictionary = _resolve_map_layout_query_params()
	var map_request_key: String = _build_map_layout_request_key(_active_map_scope, map_query_params)
	if fetch_map_layout and map_request_key != "":
		_viewport_map_cache.erase(map_request_key)
		_viewport_map_cache_order.erase(map_request_key)
	if _is_viewport_map_streaming_enabled() and _viewport_map_cache.has(map_request_key):
		var cached_layout: Dictionary = (_viewport_map_cache.get(map_request_key, {}) as Dictionary).duplicate(false)
		_apply_map_layout_data(cached_layout, map_request_key, "cache")
		_update_runtime_label("world/map refreshed from viewport cache")
		return true
	var map_result: Dictionary = await _api_client.get_map_layout(_active_map_scope, map_query_params)
	if not bool(map_result.get("ok", false)) and int(map_result.get("status", 0)) == 403 and _active_map_scope == "full":
		print("[godot-runtime] map scope=full unavailable, fallback to scope=bootstrap")
		_active_map_scope = "bootstrap"
		_active_map_query_params = {}
		map_result = await _api_client.get_map_layout(_active_map_scope, {})

	if bool(map_result.get("ok", false)):
		var map_layout_data: Dictionary = map_result.get("data", {}) as Dictionary
		_apply_map_layout_data(map_layout_data, map_request_key if _active_map_scope == "viewport" else "", "network")
		_update_runtime_label("world/map refreshed")
		return true

	push_warning("[godot-runtime] map layout request failed: %s" % str(map_result))
	return false

func _resolve_target_faction_id(runtime_data: Dictionary) -> String:
	var factions: Array = _read_faction_rows(runtime_data)
	var preferred: String = AppConfig.preferred_faction_id.strip_edges()
	if preferred != "":
		for faction_row in factions:
			var row: Dictionary = faction_row as Dictionary
			if str(row.get("factionId", "")) == preferred:
				return preferred

	if factions.is_empty():
		return ""
	return str((factions[0] as Dictionary).get("factionId", ""))

func _should_join_faction(runtime_data: Dictionary, faction_id: String) -> bool:
	for faction_row in _read_faction_rows(runtime_data):
		var row: Dictionary = faction_row as Dictionary
		if str(row.get("factionId", "")) != faction_id:
			continue
		var online_seat_count: int = int(row.get("onlineSeatCount", 0))
		return online_seat_count <= 0
	return true

func _read_faction_rows(runtime_data: Dictionary) -> Array:
	var raw_factions: Variant = runtime_data.get("factions", [])
	if raw_factions is Array:
		return raw_factions
	return []

func _find_runtime_faction_row(runtime_data: Dictionary, faction_id: String) -> Dictionary:
	for faction_row in _read_faction_rows(runtime_data):
		var row: Dictionary = faction_row as Dictionary
		if str(row.get("factionId", "")) == faction_id:
			return row
	return {}

func _apply_runtime_faction_row(runtime_row: Dictionary) -> void:
	if runtime_row.is_empty():
		_runtime_autonomy_level = "unknown"
		_runtime_control_mode = "unknown"
		_runtime_seat_count = 0
		_runtime_online_seat_count = 0
		_runtime_player_names = "none"
		return

	_runtime_autonomy_level = str(runtime_row.get("autonomyLevel", "unknown"))
	_runtime_control_mode = str(runtime_row.get("controlMode", "unknown"))
	_runtime_seat_count = int(runtime_row.get("seatCount", 0))
	_runtime_online_seat_count = int(runtime_row.get("onlineSeatCount", 0))
	_runtime_player_names = _format_player_names(runtime_row.get("playerNames", []))
	SessionStore.set_control_context(_runtime_autonomy_level, _runtime_control_mode)
	_sync_world_store_ai_control_context("session_runtime_bootstrap")

func _format_player_names(raw_player_names: Variant) -> String:
	if raw_player_names is Array:
		var names: Array = raw_player_names
		if names.is_empty():
			return "none"
		var parts: PackedStringArray = PackedStringArray()
		for item in names:
			parts.append(str(item))
		return ",".join(parts).left(80)
	return "none"

func _string_array_from_values(values: Array) -> PackedStringArray:
	var parts: PackedStringArray = PackedStringArray()
	for value in values:
		var text: String = str(value).strip_edges()
		if text != "":
			parts.append(text)
	return parts

func _read_tick_label(world_data: Dictionary) -> String:
	var tick_value: Variant = world_data.get("tick", null)
	if tick_value is int:
		return str(tick_value)
	if tick_value is float:
		return str(int(tick_value))
	return "unknown"

func _read_world_version_label(world_data: Dictionary) -> String:
	var world_version: Variant = world_data.get("worldVersion", null)
	if world_version is int:
		return str(world_version)
	if world_version is float:
		return str(int(world_version))
	return "unknown"

func _set_request_state(in_flight: bool, status_message: String) -> void:
	_set_request_controls_disabled(in_flight)
	_update_runtime_label(status_message)

func _set_request_controls_disabled(in_flight: bool) -> void:
	_request_in_flight = in_flight
	if _refresh_button != null:
		_refresh_button.disabled = in_flight
	if _advance_tick_button != null:
		_advance_tick_button.disabled = in_flight
	_refresh_main_map_cell_action_panel()

func _start_observability() -> void:
	if OBSERVABILITY_PANEL_PERMANENTLY_DISABLED:
		return
	if _observability_bridge == null:
		return
	_observability_bridge.bind_session(_target_faction_id, SessionStore.token)
	_observability_bridge.start()

func _on_observability_snapshot_updated(snapshot: Dictionary) -> void:
	_sync_world_store_ai_control_context_from_snapshot(snapshot)
	_update_observability_panel(snapshot)

func _update_runtime_label(status_message: String) -> void:
	_runtime_status_message = status_message
	var runtime_label_text := _compose_runtime_label_text(status_message)
	if _runtime_label != null:
		_runtime_label.text = runtime_label_text
	_refresh_shell_state(status_message)
	_refresh_main_city_hub_context()

func _update_observability_panel(snapshot: Dictionary) -> void:
	if OBSERVABILITY_PANEL_PERMANENTLY_DISABLED:
		return
	if _observability_panel == null:
		return
	if _observability_panel is CanvasItem and not (_observability_panel as CanvasItem).visible:
		return

	if _observability_panel.has_method("update_snapshot"):
		var merged_snapshot: Dictionary = snapshot.duplicate(true)
		var runtime_snapshot: Dictionary = _build_runtime_snapshot()
		for key in runtime_snapshot.keys():
			merged_snapshot[key] = runtime_snapshot[key]
		_observability_panel.call("update_snapshot", merged_snapshot)

func _build_runtime_snapshot() -> Dictionary:
	var world_data: Dictionary = WorldStore.world
	var control_context := WorldStore.get_resolved_ai_control_context(_target_faction_id)
	var display_control_mode: String = str(control_context.get("controlMode", _runtime_control_mode)).strip_edges()
	var display_autonomy_level: String = str(control_context.get("autonomyLevel", _runtime_autonomy_level)).strip_edges()
	var control_authority_source := str(control_context.get("authoritySource", "unknown")).strip_edges()
	var execution_state := WorldStore.get_resolved_ai_execution(_target_faction_id)
	var action_receipt := WorldStore.get_ai_action_receipt(_target_faction_id)
	var ai_execution_summary := _format_runtime_ai_execution_summary(execution_state)
	var ai_budget_summary := _format_runtime_ai_budget_summary(execution_state)
	var ai_request_id := _first_non_empty_runtime_value(
		action_receipt.get("request_id", ""),
		execution_state.get("requestId", "")
	)
	var ai_failure_code := _first_non_empty_runtime_value(
		action_receipt.get("failure_code", ""),
		"none"
	)
	var ai_receipt_message := _first_non_empty_runtime_value(
		action_receipt.get("message", ""),
		"none"
	)
	return {
		"runtimeFactionId": _target_faction_id if _target_faction_id != "" else "none",
		"runtimeControlMode": display_control_mode,
		"runtimeAutonomyLevel": display_autonomy_level,
		"runtimeControlAuthoritySource": control_authority_source if control_authority_source != "" else "unknown",
		"runtimeSeatCount": _runtime_seat_count,
		"runtimeOnlineSeatCount": _runtime_online_seat_count,
		"runtimePlayerNames": _runtime_player_names,
		"runtimeSessionId": SessionStore.session_id if SessionStore.session_id != "" else "none",
		"runtimeSeatId": SessionStore.seat_id if SessionStore.seat_id != "" else "none",
		"runtimeSessionMode": _runtime_session_mode,
		"runtimeTick": _read_tick_label(world_data),
		"runtimeWorldVersion": _read_world_version_label(world_data),
		"runtimeLastAction": _runtime_last_action,
		"runtimeLastActionStatus": _runtime_last_action_status,
		"runtimeLastActionTick": _runtime_last_action_tick,
		"runtimeAiExecutionSummary": ai_execution_summary,
		"runtimeAiBudgetSummary": ai_budget_summary,
		"runtimeAiRequestId": ai_request_id if ai_request_id != "" else "none",
		"runtimeAiFailureCode": ai_failure_code if ai_failure_code != "" else "none",
		"runtimeAiReceiptMessage": ai_receipt_message if ai_receipt_message != "" else "none",
		"backendHealthStatus": _backend_health_status,
		"backendHealthMessage": _backend_health_message,
		"runtimeBootstrapDiagnostic": _runtime_bootstrap_diagnostic,
		"runtimeBackendUrl": AppConfig.backend_base_url,
		"viewportMapCacheEntries": _viewport_map_cache_order.size(),
		"viewportMapCacheHits": _viewport_cache_hit_count,
		"viewportMapStaleResponses": _viewport_stale_response_count,
		"viewportLoadedChunkIds": ",".join(_string_array_from_values(_viewport_loaded_chunk_ids)),
		"viewportUnloadCandidateChunkIds": ",".join(_string_array_from_values(_viewport_unload_candidate_chunk_ids)),
	}


func _compose_runtime_label_text(status_message: String) -> String:
	var world_data: Dictionary = WorldStore.world
	var control_context := WorldStore.get_resolved_ai_control_context(_target_faction_id)
	var display_control_mode: String = str(control_context.get("controlMode", _runtime_control_mode)).strip_edges()
	var display_autonomy_level: String = str(control_context.get("autonomyLevel", _runtime_autonomy_level)).strip_edges()
	return (
		"Runtime | view=%s | status=%s | faction=%s | mode=%s | autonomy=%s | tick=%s | worldVersion=%s | mapScope=%s | seats=%s/%s | session=%s | sessionMode=%s"
		% [
			_display_mode,
			status_message,
			_target_faction_id,
			display_control_mode,
			display_autonomy_level,
			_read_tick_label(world_data),
			_read_world_version_label(world_data),
			_active_map_scope,
			str(_runtime_online_seat_count),
			str(_runtime_seat_count),
			SessionStore.session_id,
			_runtime_session_mode,
		]
	)


func _format_runtime_ai_execution_summary(execution_state: Dictionary) -> String:
