func _scroll_mainline_visual_smoke_player_history_save_restore_into_view() -> Dictionary:
	var host := _resolve_mainline_visual_smoke_panel_root("player_history")
	if host == null:
		return {"attempted": true, "ok": false, "reason": "player_history_panel_missing"}
	var panel_control := host as Control
	if panel_control == null:
		return {"attempted": true, "ok": false, "reason": "player_history_panel_not_control"}
	var scroll := _find_mainline_visual_smoke_visible_scroll_container(panel_control, "PlayerHistoryScroll")
	if scroll == null:
		return {"attempted": true, "ok": false, "reason": "player_history_scroll_missing"}
	var target := _find_mainline_visual_smoke_visible_control_by_name_prefix(panel_control, "SaveSlotRestoreButton")
	if target == null:
		return {"attempted": true, "ok": false, "reason": "save_restore_button_missing"}
	var scroll_rect := scroll.get_global_rect()
	var target_rect := target.get_global_rect()
	var before_scroll := scroll.scroll_vertical
	var target_scroll := maxi(0, int(round(float(before_scroll) + target_rect.position.y - scroll_rect.position.y - 180.0)))
	scroll.scroll_vertical = target_scroll
	var after_scroll := scroll.scroll_vertical
	var save_restore_focus_scrolled := after_scroll > before_scroll
	return {
		"attempted": true,
		"ok": save_restore_focus_scrolled,
		"reason": "save_restore_focus_scrolled" if save_restore_focus_scrolled else "save_restore_focus_not_scrolled",
		"save_restore_focus_scrolled": save_restore_focus_scrolled,
		"saveRestoreFocusScrolled": save_restore_focus_scrolled,
		"beforeScroll": before_scroll,
		"afterScroll": after_scroll,
		"targetScroll": target_scroll,
		"scrollRect": _rect_to_mainline_visual_smoke_dict(scroll_rect),
		"targetRect": _rect_to_mainline_visual_smoke_dict(target_rect),
	}

