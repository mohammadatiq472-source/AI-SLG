func _find_current_goal_by_id(current_goals_model: Dictionary, goal_id: String) -> Dictionary:
	var normalized_goal_id := goal_id.strip_edges()
	var layers_variant: Variant = current_goals_model.get("layers", [])
	if not (layers_variant is Array):
		return {}
	for layer_variant in layers_variant as Array:
		if not (layer_variant is Dictionary):
			continue
		var layer := layer_variant as Dictionary
		var goals_variant: Variant = layer.get("goals", [])
		if not (goals_variant is Array):
			continue
		for goal_variant in goals_variant as Array:
			if not (goal_variant is Dictionary):
				continue
			var goal := goal_variant as Dictionary
			if str(goal.get("goalId", "")).strip_edges() == normalized_goal_id:
				return goal.duplicate(true)
	return {}


func _read_current_goal_action_target_id(goal: Dictionary) -> String:
	var target_variant: Variant = goal.get("actionTarget", {})
	if target_variant is Dictionary:
		return str((target_variant as Dictionary).get("id", "")).strip_edges()
	return ""


