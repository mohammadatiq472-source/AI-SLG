		"chatOverlayVisibleAfter": chat_visible_after,
		"activePanelId": _active_panel_id,
		"pageContentOk": panel_closed and chat_visible_after,
		"pageContentSummary": page_summary_before,
	}

func _press_mainline_visual_smoke_ai_panel_chat_metadata_contract(panel_id: String) -> Dictionary:
	if panel_id != "ai_hub" or _active_panel_id != "ai_hub":
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "active_panel_not_ai_hub",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
		}
	var presenter = _resolve_ai_panel_presenter()
	if presenter == null:
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "ai_panel_presenter_missing",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
		}
	var required_methods := [
		"_format_ai_chat_message_meta",
		"_format_ai_chat_message_description",
		"_resolve_ai_chat_message_tone",
	]
	for method_name in required_methods:
		if not presenter.has_method(method_name):
			return {
				"attempted": true,
				"ok": false,
				"clicked": false,
				"reason": "ai_chat_metadata_formatter_missing",
				"missingMethod": method_name,
				"panelId": panel_id,
				"activePanelId": _active_panel_id,
			}
	var metadata_message := {
		"kind": "system",
		"name": "系统",
		"body": "普通巡查记录",
		"metadata": {
			"source": "patrol_proactive_message",
			"proactiveReason": "battle_high_loss",
			"severity": "high",
			"suggestedAction": "resource_transfer_to_governor",
			"cooldownMinutes": 30,
			"triggerCondition": {
				"requiresHumanApproval": true,
			},
		},
	}
	var body_only_message := {
		"kind": "system",
		"name": "系统",
		"body": "战损提醒 紧急 建议：resource_transfer_to_governor",
		"metadata": {},
	}
	var metadata_meta := str(presenter.call("_format_ai_chat_message_meta", metadata_message)).strip_edges()
	var metadata_description := str(presenter.call("_format_ai_chat_message_description", metadata_message)).strip_edges()
	var metadata_tone := str(presenter.call("_resolve_ai_chat_message_tone", metadata_message)).strip_edges()
	var body_only_meta := str(presenter.call("_format_ai_chat_message_meta", body_only_message)).strip_edges()
	var body_only_description := str(presenter.call("_format_ai_chat_message_description", body_only_message)).strip_edges()
	var body_only_tone := str(presenter.call("_resolve_ai_chat_message_tone", body_only_message)).strip_edges()
	var metadata_driven := (
		metadata_meta.find("战损提醒") >= 0
		and metadata_meta.find("紧急") >= 0
		and metadata_meta.find("主意：") >= 0
		and metadata_description.find("点开待确认查看") >= 0
		and metadata_tone == "gold"
	)
	var body_keyword_ignored := (
		body_only_meta.find("战损提醒") < 0
		and body_only_meta.find("紧急") < 0
		and body_only_meta.find("主意：") < 0
		and body_only_description.find("点开待确认查看") < 0
		and body_only_tone == "neutral"
	)
	var summary := {
		"ok": metadata_driven and body_keyword_ignored,
		"panelId": "ai_hub",
		"activePageId": _read_mainline_visual_smoke_active_overlay_page_id(),
		"aiChatMetadataContractMode": "presenter_metadata_only_v1",
		"aiChatMetadataSource": "message.metadata",
		"aiChatBodyParseForAction": false,
		"aiChatSuggestedActionExecutesDirectly": false,
		"aiChatMetadataDriven": metadata_driven,
		"aiChatBodyKeywordIgnored": body_keyword_ignored,
		"aiChatMetadataMetaText": metadata_meta,
		"aiChatMetadataDescriptionText": metadata_description,
		"aiChatMetadataTone": metadata_tone,
		"aiChatBodyOnlyMetaText": body_only_meta,
		"aiChatBodyOnlyDescriptionText": body_only_description,
		"aiChatBodyOnlyTone": body_only_tone,
	}
	return {
		"attempted": true,
		"ok": bool(summary.get("ok", false)),
		"clicked": false,
		"reason": "ai_chat_metadata_contract_verified" if bool(summary.get("ok", false)) else "ai_chat_metadata_contract_failed",
		"panelId": panel_id,
		"activePanelId": _active_panel_id,
		"pageContentOk": bool(summary.get("ok", false)),
		"pageContentSummary": summary,
	}

func _press_mainline_visual_smoke_ai_panel_autonomy_guard_contract(panel_id: String) -> Dictionary:
	if panel_id != "ai_hub" or _active_panel_id != "ai_hub":
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "active_panel_not_ai_hub",
			"panelId": panel_id,
			"activePanelId": _active_panel_id,
		}
	var presenter = _resolve_ai_panel_presenter()
	var required_methods := [
		"_build_autonomy_status_hero",
		"_build_autonomy_reading_items",
	]
	for method_name in required_methods:
		if not presenter.has_method(method_name):
			return {
				"attempted": true,
				"ok": false,
				"clicked": false,
				"reason": "ai_autonomy_guard_formatter_missing",
				"missingMethod": method_name,
				"panelId": panel_id,
				"activePanelId": _active_panel_id,
			}
	var autonomy_guard := {
		"mode": "approval_only",
		"autonomousExecutionEnabled": false,
		"pendingApprovalBlocksExecution": true,
	}
	var hero_variant: Variant = presenter.call("_build_autonomy_status_hero", "L3_negotiated", autonomy_guard)
	var hero: Dictionary = hero_variant if hero_variant is Dictionary else {}
	var items_variant: Variant = presenter.call("_build_autonomy_reading_items", "L3_negotiated", autonomy_guard)
	var items: Array = items_variant if items_variant is Array else []
	var guard_item: Dictionary = {}
	for item_variant in items:
		if not (item_variant is Dictionary):
			continue
		var item: Dictionary = item_variant as Dictionary
		if str(item.get("title", "")).strip_edges() == "托管红线":
			guard_item = item
			break
	var facts: Array = hero.get("facts", []) as Array
	var facts_text_parts: Array[String] = []
	for fact_variant in facts:
		if not (fact_variant is Dictionary):
			continue
		var fact: Dictionary = fact_variant as Dictionary
		facts_text_parts.append("%s:%s" % [str(fact.get("label", "")), str(fact.get("value", ""))])
	var player_copy_text := "%s %s %s %s %s %s" % [
		str(hero.get("headline", "")),
		str(hero.get("subtitle", "")),
		str(hero.get("state", "")),
		" / ".join(facts_text_parts),
		str(guard_item.get("title", "")),
		str(guard_item.get("description", "")),
	]
	var fallback_hero_variant: Variant = presenter.call("_build_autonomy_status_hero", "L2_delegated", {})
	var fallback_hero: Dictionary = fallback_hero_variant if fallback_hero_variant is Dictionary else {}
	var fallback_facts: Array = fallback_hero.get("facts", []) as Array
	var fallback_facts_text_parts: Array[String] = []
	for fallback_fact_variant in fallback_facts:
		if not (fallback_fact_variant is Dictionary):
			continue
		var fallback_fact: Dictionary = fallback_fact_variant as Dictionary
		fallback_facts_text_parts.append("%s:%s" % [str(fallback_fact.get("label", "")), str(fallback_fact.get("value", ""))])
	var fallback_copy_text := "%s %s %s %s" % [
		str(fallback_hero.get("headline", "")),
		str(fallback_hero.get("subtitle", "")),
		str(fallback_hero.get("state", "")),
		" / ".join(fallback_facts_text_parts),
	]
	var all_copy_text := "%s %s" % [player_copy_text, fallback_copy_text]
	var forbidden_copy_hits: Array = []
	for needle_variant in ["权限", "执行", "模型", "AI", "审批", "待批阻断", "关闭"]:
		var needle := str(needle_variant)
		if all_copy_text.find(needle) >= 0:
			forbidden_copy_hits.append(needle)
	var uses_read_model := (
		str(hero.get("headline", "")).strip_edges() == "只读观察"
		and str(hero.get("state", "")).strip_edges() == "待你点头"
		and player_copy_text.find("你点头才动") >= 0
		and player_copy_text.find("不自动出手") >= 0
		and player_copy_text.find("只看提醒和主意") >= 0
		and fallback_copy_text.find("日常可托管") >= 0
		and fallback_copy_text.find("范围:日常代管") >= 0
		and fallback_copy_text.find("主意:已就绪") >= 0
	)
	var executes_directly := bool(autonomy_guard.get("autonomousExecutionEnabled", false))
	var player_copy_ok := forbidden_copy_hits.is_empty()
	var summary := {
		"ok": uses_read_model and not executes_directly and player_copy_ok,
		"panelId": "ai_hub",
		"activePageId": _read_mainline_visual_smoke_active_overlay_page_id(),
		"aiAutonomyGuardContractMode": "autonomy_guard_read_model_v1",
		"aiAutonomyGuardSource": "autonomyGuard",
		"aiAutonomyGuardUsesReadModel": uses_read_model,
		"aiAutonomyGuardExecutesDirectly": executes_directly,
		"aiAutonomyGuardPlayerCopyOk": player_copy_ok,
		"aiAutonomyGuardForbiddenCopyHits": forbidden_copy_hits,
		"aiAutonomyGuardHeroText": player_copy_text,
		"aiAutonomyGuardFallbackText": fallback_copy_text,
	}
	return {
		"attempted": true,
		"ok": bool(summary.get("ok", false)),
		"clicked": false,
		"reason": "ai_autonomy_guard_contract_verified" if bool(summary.get("ok", false)) else "ai_autonomy_guard_contract_failed",
		"panelId": panel_id,
		"activePanelId": _active_panel_id,
		"pageContentOk": bool(summary.get("ok", false)),
		"pageContentSummary": summary,
	}

