func _press_mainline_visual_smoke_main_city_troop_submit_player_formation() -> Dictionary:
	var context_result := await _press_mainline_visual_smoke_main_city_context("troop")
	if not bool(context_result.get("ok", false)):
		return {
			"attempted": true,
			"ok": false,
			"clicked": bool(context_result.get("clicked", false)),
			"reason": "main_city_troop_context_open_failed",
			"contextResult": context_result,
		}
	if _main_city_hub_overlay != null and is_instance_valid(_main_city_hub_overlay) and _main_city_hub_overlay.has_method("select_troop_team_for_smoke"):
		_main_city_hub_overlay.call("select_troop_team_for_smoke", "team_01")
	await get_tree().process_frame
	await get_tree().process_frame
	var before_submit_summary := _read_main_city_hub_visual_smoke_summary()
	var world_task_event_ledger_results: Array = []
	world_task_event_ledger_results.append(await _record_world_task_event_from_ui(
		"huangtian_task_04_register_militia",
		"troop_formation_viewed",
		"godot_main_city_troop_formation_viewed",
		"Godot main-city troop formation panel viewed by player UI"
	))
	var submitted := false
	_runtime_action_receipt = {}
	if _main_city_hub_overlay != null and is_instance_valid(_main_city_hub_overlay) and _main_city_hub_overlay.has_method("submit_selected_troop_formation_for_smoke"):
		submitted = bool(_main_city_hub_overlay.call("submit_selected_troop_formation_for_smoke"))
	await get_tree().process_frame
	await get_tree().process_frame
	var waited_seconds := 0.0
	while waited_seconds < 4.0 and _runtime_action_receipt.is_empty():
		await get_tree().create_timer(0.25).timeout
		waited_seconds += 0.25
	var receipt := _runtime_action_receipt.duplicate(true)
	var co_hero_ids_variant: Variant = receipt.get("co_hero_ids", [])
	var co_hero_count := (co_hero_ids_variant as Array).size() if co_hero_ids_variant is Array else 0
	var receipt_hero_ids: Array[String] = []
	var primary_hero_id := str(receipt.get("hero_id", "")).strip_edges()
	if primary_hero_id != "":
		receipt_hero_ids.append(primary_hero_id)
	if co_hero_ids_variant is Array:
		for co_hero_id_variant in co_hero_ids_variant:
			var co_hero_id := str(co_hero_id_variant).strip_edges()
			if co_hero_id != "" and not receipt_hero_ids.has(co_hero_id):
				receipt_hero_ids.append(co_hero_id)
	var expected_player_formation_hero_ids: Array[String] = ["100031", "100013", "100017"]
	var expected_player_formation_ok := true
	for expected_hero_id in expected_player_formation_hero_ids:
		if not receipt_hero_ids.has(expected_hero_id):
			expected_player_formation_ok = false
			break
	var ok := (
		submitted
		and bool(receipt.get("success", false))
		and str(receipt.get("source_action", "")) == "deployReserveHero"
		and expected_player_formation_ok
		and co_hero_count >= 2
	)
	if ok:
		world_task_event_ledger_results.append(await _record_world_task_event_from_ui(
			"huangtian_task_05_drill_ground",
			"troop_formation_prepared",
			"godot_main_city_troop_formation_submitted",
			"Godot main-city troop formation submitted by player UI"
		))
	return {
		"attempted": true,
		"ok": ok,
		"clicked": true,
		"reason": "main_city_troop_player_formation_submitted" if ok else "main_city_troop_player_formation_submit_failed",
		"contextResult": context_result,
		"beforeSubmitSummary": before_submit_summary,
		"submitted": submitted,
		"waitedSeconds": waited_seconds,
		"receipt": receipt,
		"worldTaskEventLedgerResults": world_task_event_ledger_results,
		"pageContentOk": ok,
		"pageContentSummary": {
			"ok": ok,
			"requestedPageId": "main_city/troop_submit_player_formation",
			"activePageId": _active_panel_id,
			"troopFormationSubmitMode": str(before_submit_summary.get("troopFormationSubmitMode", "")),
			"troopFormationFormalSubmitAvailable": bool(before_submit_summary.get("troopFormationFormalSubmitAvailable", false)),
			"troopFormationSubmitFormationOrder": str(before_submit_summary.get("troopFormationSubmitFormationOrder", "")),
			"authorityTriggered": submitted,
			"worldTaskEventLedgerResults": world_task_event_ledger_results,
			"templateOnly": false,
		},
		"templateOnly": false,
		"authorityTriggered": submitted,
	}


func _press_mainline_visual_smoke_main_city_troop_configure_then_clear_slot() -> Dictionary:
	var submit_result := await _press_mainline_visual_smoke_main_city_troop_submit_player_formation()
	if not bool(submit_result.get("ok", false)):
		return {
			"attempted": true,
			"ok": false,
			"reason": "player_formation_submit_failed_before_clear_slot",
			"submitResult": submit_result,
		}
	var receipt: Dictionary = submit_result.get("receipt", {}) as Dictionary
	var unit_id := str(receipt.get("unit_id", receipt.get("unitId", ""))).strip_edges()
	if unit_id == "":
		var remote_result: Dictionary = receipt.get("remote_result", {}) as Dictionary
		unit_id = str(remote_result.get("unitId", remote_result.get("unit_id", ""))).strip_edges()
	await _refresh_main_city_troop_formation_read_model()
	if _main_city_hub_overlay != null and is_instance_valid(_main_city_hub_overlay) and _main_city_hub_overlay.has_method("select_troop_team_for_smoke"):
		_main_city_hub_overlay.call("select_troop_team_for_smoke", "team_01")
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(0.2).timeout
	var configured_summary := _read_main_city_hub_visual_smoke_summary()
	var configured_ok := (
		int(configured_summary.get("troopFormationAssignedSlotCount", 0)) == 3
		and int(configured_summary.get("troopFormationEmptySlotCount", 0)) == 0
		and int(configured_summary.get("troopFormationSlotSquadPreviewCount", 0)) == 3
		and bool(configured_summary.get("troopFormationFormalSubmitAvailable", false))
	)
	var adapter = _resolve_slg_domain_action_adapter()
	if not adapter.has_method("request_configure_deployed_unit_formation"):
		return {
