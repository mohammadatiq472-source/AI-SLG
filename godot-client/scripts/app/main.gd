func _build_mainline_visual_smoke_player_visible_ui_governance_result(spec: Dictionary) -> Dictionary:
	var copy_contract_id := str(spec.get("copyContractId", "")).strip_edges()
	var expected_copy_contract_id := str(spec.get("expectedCopyContractId", "")).strip_edges()
	var primary_goal_text := str(spec.get("primaryGoalText", "")).strip_edges()
	var expected_primary_goal_text := str(spec.get("expectedPrimaryGoalText", "")).strip_edges()
	var visible_primary_card_count := int(spec.get("visiblePrimaryCardCount", 0))
	var visible_primary_card_limit := int(spec.get("visiblePrimaryCardLimit", 0))
	var actual_stage_card_count := int(spec.get("stageCardCount", 0))
	var required_stage_card_count := int(spec.get("requiredStageCardCount", 0))
	var actual_member_card_count := int(spec.get("memberCardCount", 0))
	var required_member_card_count := int(spec.get("requiredMemberCardCount", 0))
	var copy_contract_ok := copy_contract_id != "" and copy_contract_id == expected_copy_contract_id
	var primary_goal_ok := primary_goal_text != "" and (expected_primary_goal_text == "" or primary_goal_text == expected_primary_goal_text)
	var short_chinese_ok := bool(spec.get("primaryGoalTextShortChinese", false))
	var forbidden_clear := bool(spec.get("forbiddenVisibleCopyClear", false))
	var density_ok := visible_primary_card_limit <= 0 or (visible_primary_card_count > 0 and visible_primary_card_count <= visible_primary_card_limit)
	var stage_count_ok := required_stage_card_count <= 0 or actual_stage_card_count >= required_stage_card_count
	var member_count_ok := required_member_card_count <= 0 or actual_member_card_count >= required_member_card_count
	var ok := copy_contract_ok and primary_goal_ok and short_chinese_ok and forbidden_clear and density_ok and stage_count_ok and member_count_ok
	return {
		"contract_id": PLAYER_VISIBLE_UI_GOVERNANCE_CONTRACT,
		"ok": ok,
		"reason": "player_visible_ui_governance_ok" if ok else "player_visible_ui_governance_failed",
		"context": str(spec.get("context", "")).strip_edges(),
		"copyContractId": copy_contract_id,
		"copyContractOk": copy_contract_ok,
		"primaryGoalText": primary_goal_text,
		"primaryGoalOk": primary_goal_ok,
		"primaryGoalTextShortChinese": short_chinese_ok,
		"forbiddenVisibleCopyClear": forbidden_clear,
		"visiblePrimaryCardCount": visible_primary_card_count,
		"visiblePrimaryCardLimit": visible_primary_card_limit,
		"visibleDensityOk": density_ok,
		"stageCardCount": actual_stage_card_count,
		"stageCardCountOk": stage_count_ok,
		"memberCardCount": actual_member_card_count,
		"memberCardCountOk": member_count_ok,
	}


