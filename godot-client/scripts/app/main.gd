	return {
		"attempted": true,
		"ok": ok,
		"clicked": true,
		"reason": ("main_city_overlay_panel_open_via_hub_fallback" if fallback_reason != "" else "main_city_overlay_panel_open") if ok else "main_city_overlay_panel_open_failed",
