func _wait_for_tianxia_yutu_runtime_nation_profile(expected_name: String, expected_color_hex: String, timeout_msec: int) -> Dictionary:
	var expected_color := expected_color_hex.strip_edges().to_lower()
	var deadline_msec: int = Time.get_ticks_msec() + timeout_msec
	var map_summary: Dictionary = {}
	while Time.get_ticks_msec() <= deadline_msec:
		await get_tree().process_frame
		await get_tree().create_timer(0.2).timeout
		map_summary = _read_tianxia_yutu_explicit_jump_summary()
		var name_ok := expected_name == "" or str(map_summary.get("playerNationRuntimeName", "")) == expected_name
		var color_ok := expected_color == "" or str(map_summary.get("playerNationRuntimeColorHex", "")).to_lower() == expected_color
		if name_ok and color_ok:
			return {"ok": true, "mapSummary": map_summary}
	return {"ok": false, "mapSummary": map_summary}

func _wait_for_mainline_visual_smoke_main_map_mode(expected_mode: String, require_tianxia_layer: bool) -> Dictionary:
	var deadline_msec: int = Time.get_ticks_msec() + 9000
	var summary: Dictionary = _read_main_map_streaming_debug_summary()
	while Time.get_ticks_msec() < deadline_msec:
		await get_tree().process_frame
		summary = _read_main_map_streaming_debug_summary()
		var mode_ok: bool = str(summary.get("mainMapViewMode", "")) == expected_mode
		var layer_ok: bool = true
		if require_tianxia_layer:
			layer_ok = (
				bool(summary.get("tianxiaYutuOverviewLayerPresent", false))
				and bool(summary.get("tianxiaYutuOverviewTextureLoaded", false))
				and int(summary.get("tianxiaYutuOverviewDrawCount", 0)) > 0
			)
		elif expected_mode == MAIN_MAP_VIEW_MODE_GAMEPLAY:
			var layer_order: Array = []
			var raw_layer_order: Variant = summary.get("layerOrder", [])
			if raw_layer_order is Array:
				layer_order = raw_layer_order as Array
			layer_ok = (
				not bool(summary.get("tianxiaYutuOverviewLayerPresent", false))
				and layer_order.has("base_map")
				and layer_order.has("resource_overlay")
				and layer_order.has("city_gate_anchors")
				and layer_order.has("cell_overrides")
			)
		if mode_ok and layer_ok:
			return {
				"ok": true,
				"expectedMode": expected_mode,
				"summary": summary,
			}
		await get_tree().create_timer(0.1).timeout
	return {
		"ok": false,
		"expectedMode": expected_mode,
		"requireTianxiaLayer": require_tianxia_layer,
		"summary": summary,
	}


func _copy_mainline_visual_smoke_shell_nav_contract_fields(target: Dictionary, shell_nav_layout_summary: Dictionary) -> void:
	target["shellNavLayout"] = shell_nav_layout_summary
	for key_variant in shell_nav_layout_summary.keys():
