func _on_main_city_ai_troop_team_viewed(payload: Dictionary) -> void:
	var team_id := str(payload.get("teamId", "")).strip_edges()
	if team_id == "":
		return
	var team_index := int(payload.get("teamIndex", 0))
	var owner_type := str(payload.get("ownerType", "")).strip_edges().to_lower()
	var ai_player_id := str(payload.get("aiPlayerId", "")).strip_edges()
	if owner_type != "ai" and ai_player_id == "":
		return
	var focus_key := "%s|%s|%d|%s" % [_target_faction_id, team_id, team_index, ai_player_id]
	if focus_key == _last_ai_troop_team_context_focus_key:
		return
	_last_ai_troop_team_context_focus_key = focus_key
	var focus_payload := {
		"teamId": team_id,
		"teamIndex": team_index,
		"teamName": str(payload.get("teamName", "")).strip_edges(),
		"ownerType": "ai",
		"aiPlayerId": ai_player_id,
		"heroNames": payload.get("heroNames", []),
	}
	var adapter = _resolve_slg_domain_action_adapter()
	if adapter == null or not adapter.has_method("request_ai_context_focus"):
		return
	var focus_result: Dictionary = await adapter.call("request_ai_context_focus", "focus_team", focus_payload)
	if not bool(focus_result.get("ok", false)):
		_last_ai_troop_team_context_focus_key = ""
		_store_runtime_action_receipt({
			"source_action": "setAiContextFocus",
			"success": false,
			"reason": str(focus_result.get("error", "focus_team_rejected")),
			"context_focus_id": "focus_team",
			"team_id": team_id,
			"ai_player_id": ai_player_id,
		})
		return
	if adapter.has_method("finalize_world_action_result"):
		adapter.call("finalize_world_action_result", focus_result)
	var local_ai_context_memory := {
		"focusId": "focus_team",
		"relatedId": team_id,
		"teamId": team_id,
		"teamIndex": team_index,
		"teamName": str(focus_payload.get("teamName", "")).strip_edges(),
		"ownerType": "ai",
		"aiPlayerId": ai_player_id,
		"heroNames": focus_payload.get("heroNames", []),
	}
	WorldStore.set_ai_player_state(ai_player_id, {
		"contextFocusId": "focus_team",
		"contextMemorySummary": local_ai_context_memory,
		"authoritySource": "backend_setAiContextFocus_success",
	})
	_store_runtime_action_receipt({
		"source_action": "setAiContextFocus",
		"success": true,
		"context_focus_id": "focus_team",
		"team_id": team_id,
		"ai_player_id": ai_player_id,
	})


func _on_main_city_troop_formation_submit_requested(payload: Dictionary) -> void:
	var team_id := str(payload.get("teamId", "")).strip_edges()
	var submit_mode := str(payload.get("submitMode", "")).strip_edges()
	var record_path := "main_city_hub/troop_formation/%s" % (team_id if team_id != "" else "unknown")
	if submit_mode == "ai_instruction_required":
		var ai_player_id := str(payload.get("aiPlayerId", "")).strip_edges()
		_record_last_action("%s/ai_instruction" % record_path, "chat_requested")
		_update_runtime_label("main city troop formation ai instruction")
		_open_main_chat_overlay(ai_player_id)
		return
	if submit_mode != "player_direct":
		_store_runtime_action_receipt({
			"source_action": "deployReserveHero",
			"success": false,
			"reason": "unsupported_submit_mode",
			"submit_mode": submit_mode,
			"team_id": team_id,
		})
		_apply_overlay_feedback(record_path, "rejected", "main city troop formation rejected")
		return
	var hero_id := str(payload.get("heroId", "")).strip_edges()
	var tile_id := str(payload.get("tileId", "")).strip_edges()
	var co_hero_ids: Array[String] = []
	var co_hero_ids_variant: Variant = payload.get("coHeroIds", [])
	if co_hero_ids_variant is Array:
		for co_hero_id_variant in co_hero_ids_variant as Array:
			var co_hero_id := str(co_hero_id_variant).strip_edges()
			if co_hero_id == "" or co_hero_id == hero_id or co_hero_ids.has(co_hero_id):
				continue
			co_hero_ids.append(co_hero_id)
			if co_hero_ids.size() >= 2:
				break
	if hero_id == "" or tile_id == "" or co_hero_ids.size() < 2:
		_store_runtime_action_receipt({
			"source_action": "deployReserveHero",
			"success": false,
			"reason": "invalid_formation_payload",
			"hero_id": hero_id,
			"co_hero_ids": co_hero_ids,
			"tile_id": tile_id,
			"team_id": team_id,
		})
		_apply_overlay_feedback(record_path, "rejected", "main city troop formation invalid")
		return
	var adapter = _resolve_slg_domain_action_adapter()
	if not adapter.has_method("request_deploy_general"):
		_store_runtime_action_receipt({
			"source_action": "deployReserveHero",
			"success": false,
			"reason": "adapter_method_missing",
			"team_id": team_id,
		})
		_apply_overlay_feedback(record_path, "rejected", "main city troop formation adapter missing")
		return
	var deploy_options := {
		"teamId": team_id,
		"teamIndex": int(payload.get("teamIndex", 0)),
	}
	var deploy_ai_player_id := str(payload.get("aiPlayerId", "")).strip_edges()
	if deploy_ai_player_id != "":
		deploy_options["aiPlayerId"] = deploy_ai_player_id
	var action_result: Dictionary = await adapter.call("request_deploy_general", hero_id, tile_id, co_hero_ids, false, deploy_options)
	var remote_result: Dictionary = action_result.get("remote_result", {}) as Dictionary
	var response_data: Dictionary = remote_result.get("data", {}) as Dictionary
	var ok := bool(action_result.get("ok", false))
	var unit_id := str(response_data.get("unitId", "")).strip_edges()
	_store_runtime_action_receipt({
		"source_action": "deployReserveHero",
		"success": ok,
		"team_id": team_id,
		"hero_id": hero_id,
		"co_hero_ids": co_hero_ids,
		"unit_id": unit_id,
		"tile_id": tile_id,
		"message": str(response_data.get("message", action_result.get("error", ""))).strip_edges(),
		"world_action_intent": action_result.get("world_action_intent", {}),
	})
	if not ok:
		_apply_overlay_feedback(record_path, "rejected", "main city troop formation rejected")
		return
	var finalize_result: Dictionary = adapter.finalize_world_action_result(action_result)
	if bool(finalize_result.get("requires_map_refresh", false)):
		await _refresh_world_and_map(true)
	if unit_id != "":
		_apply_overlay_runtime_state_patch(_resolve_overlay_runtime_helper().build_shell_troop_runtime_patch(unit_id))
	await _record_world_task_event_from_ui(
		"huangtian_task_05_drill_ground",
		"troop_formation_prepared",
		"godot_main_city_troop_formation_submitted",
		"Godot main-city troop formation submitted by player UI"
	)
	_apply_overlay_feedback(record_path, "executed", "main city troop formation deployed")
	_update_runtime_label("main_city_troop_formation_submit_no_legacy_troop_panel_v1")

