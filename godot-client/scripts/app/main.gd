		{"id": "faction_colors", "label": "势力色", "default_visible": true},
		{"id": "resource_points", "label": "资源", "default_visible": false},
		{"id": "frontiers", "label": "州界/战线", "default_visible": false},
		{"id": "gate_markers", "label": "关口", "default_visible": false},
	]

func _tianxia_yutu_overlay_specs() -> Array:
	var raw_overlays: Variant = _tianxia_yutu_strategic_overlay_layer.get("overlays", [])
	if raw_overlays is Array and not (raw_overlays as Array).is_empty():
		return raw_overlays as Array
	return _default_tianxia_yutu_overlay_specs()

func _sync_tianxia_yutu_overlay_visibility_defaults() -> void:
	for overlay_variant in _tianxia_yutu_overlay_specs():
		if not (overlay_variant is Dictionary):
			continue
		var overlay: Dictionary = overlay_variant as Dictionary
		var overlay_id: String = str(overlay.get("id", "")).strip_edges()
		if overlay_id == "":
			continue
		if not _tianxia_yutu_overlay_visibility.has(overlay_id):
			_tianxia_yutu_overlay_visibility[overlay_id] = bool(overlay.get("default_visible", true))
		var checkbox_variant: Variant = _tianxia_yutu_overlay_checkboxes.get(overlay_id)
		if checkbox_variant is CheckBox:
			var checkbox: CheckBox = checkbox_variant as CheckBox
			checkbox.set_block_signals(true)
			checkbox.text = str(overlay.get("label", overlay_id)).strip_edges()
			checkbox.button_pressed = bool(_tianxia_yutu_overlay_visibility.get(overlay_id, bool(overlay.get("default_visible", true))))
			checkbox.set_block_signals(false)
	_push_tianxia_yutu_overlay_visibility_to_map_grid()

func _push_tianxia_yutu_overlay_visibility_to_map_grid() -> void:
	if _map_grid != null and _map_grid.has_method("set_tianxia_yutu_overlay_visibility"):
		_map_grid.call("set_tianxia_yutu_overlay_visibility", _tianxia_yutu_overlay_visibility.duplicate(true))

func _set_tianxia_yutu_overlay_visible(overlay_id: String, enabled: bool) -> bool:
	var normalized_id: String = overlay_id.strip_edges()
	if normalized_id == "":
		return false
	var previous_value: bool = bool(_tianxia_yutu_overlay_visibility.get(normalized_id, false))
	_tianxia_yutu_overlay_visibility[normalized_id] = enabled
	var checkbox_variant: Variant = _tianxia_yutu_overlay_checkboxes.get(normalized_id)
	if checkbox_variant is CheckBox:
		var checkbox: CheckBox = checkbox_variant as CheckBox
		checkbox.set_block_signals(true)
		checkbox.button_pressed = enabled
		checkbox.set_block_signals(false)
	_push_tianxia_yutu_overlay_visibility_to_map_grid()
	_refresh_tianxia_yutu_jump_panel()
	return previous_value != enabled

func _tianxia_yutu_enabled_overlay_labels() -> PackedStringArray:
	var labels: PackedStringArray = PackedStringArray()
	for overlay_variant in _tianxia_yutu_overlay_specs():
		if not (overlay_variant is Dictionary):
			continue
		var overlay: Dictionary = overlay_variant as Dictionary
		var overlay_id: String = str(overlay.get("id", "")).strip_edges()
		if overlay_id == "" or not bool(_tianxia_yutu_overlay_visibility.get(overlay_id, bool(overlay.get("default_visible", true)))):
			continue
		var label: String = str(overlay.get("label", overlay_id)).strip_edges()
		if label != "":
			labels.append(label)
	return labels

func _format_tianxia_yutu_legend_summary() -> String:
	var state_count: int = int(_tianxia_yutu_administrative_layer.get("state_count", 0))
	var region_count: int = int(_tianxia_yutu_administrative_layer.get("region_count", 0))
	var color_mode: String = str(_tianxia_yutu_faction_color_layer.get("color_mode", "neutral")).strip_edges()
	var color_label: String = "运行时势力色" if color_mode.find("runtime") >= 0 else "中性行政底色"
	var enabled_labels: PackedStringArray = _tianxia_yutu_enabled_overlay_labels()
	var runtime_color_entries: Array = _tianxia_yutu_faction_color_layer.get("current_runtime_color_entries", []) as Array if _tianxia_yutu_faction_color_layer.get("current_runtime_color_entries", []) is Array else []
	var frontline_markers: Array = _tianxia_yutu_strategic_overlay_layer.get("frontline_markers", []) as Array if _tianxia_yutu_strategic_overlay_layer.get("frontline_markers", []) is Array else []
	var nation_profile_label := "国家档案" if not _read_tianxia_yutu_player_nation_runtime_profile().is_empty() else "同盟-立国"
	return "图例：州%d 郡%d | %s(%d) | 战线%d | 开启 %s | 国号/颜色：%s" % [
		state_count,
		region_count,
		color_label,
		runtime_color_entries.size(),
		frontline_markers.size(),
		" / ".join(enabled_labels) if not enabled_labels.is_empty() else "无",
		nation_profile_label,
	]

func _format_tianxia_yutu_hover_summary() -> String:
	var target_label: String = str(_tianxia_yutu_last_jump_target.get("navigation_label", _tianxia_yutu_last_jump_target.get("label", "坐标点"))).strip_edges()
	var scope_label: String = _format_tianxia_yutu_target_scope_label(str(_tianxia_yutu_last_jump_target.get("target_scope", _tianxia_yutu_last_jump_target.get("kind", ""))).strip_edges())
	var selected_context: Dictionary = _resolve_selected_main_map_cell_context()
	var cell: Dictionary = _tianxia_yutu_last_jump_target.get("cell_1km", {}) as Dictionary
	var cell_x: int = int(selected_context.get("cellX", int(cell.get("x", TIANXIA_YUTU_DEFAULT_CENTER_X))))
	var cell_y: int = int(selected_context.get("cellY", int(cell.get("y", TIANXIA_YUTU_DEFAULT_CENTER_Y))))
	var region_label: String = str(_tianxia_yutu_last_jump_target.get("region_label", "")).strip_edges()
	var state_label: String = str(_tianxia_yutu_last_jump_target.get("state_label", "")).strip_edges()
	var frontline_markers: Array = _tianxia_yutu_strategic_overlay_layer.get("frontline_markers", []) as Array if _tianxia_yutu_strategic_overlay_layer.get("frontline_markers", []) is Array else []
	var place_parts: PackedStringArray = PackedStringArray()
	if state_label != "":
		place_parts.append(state_label)
	if region_label != "" and region_label != state_label:
		place_parts.append(region_label)
	if target_label != "":
		place_parts.append(target_label)
	return "悬停摘要：%s | 坐标 %d,%d | %s | 战线%d | %s" % [
		" / ".join(place_parts) if not place_parts.is_empty() else "坐标点",
		cell_x,
		cell_y,
		scope_label if scope_label != "" else "坐标",
		frontline_markers.size(),
		" / ".join(_tianxia_yutu_enabled_overlay_labels()).left(52),
	]

func _is_tianxia_yutu_gate_target(target: Dictionary) -> bool:
	if target.is_empty():
		return false
	var scope: String = str(target.get("target_scope", target.get("kind", ""))).strip_edges()
	return scope == "gate"

func _is_tianxia_yutu_compact_panel_target(target: Dictionary) -> bool:
	if target.is_empty():
		return false
	if not bool(target.get("panel_detail_mode", false)):
		return false
	var cell: Dictionary = target.get("cell_1km", {}) as Dictionary if target.get("cell_1km", {}) is Dictionary else {}
	if cell.is_empty():
		return false
	var scope: String = str(target.get("target_scope", target.get("kind", ""))).strip_edges()
	return scope == "gate" or scope == "state_government" or scope == "commandery_seat" or scope == "city" or scope == "coordinate"

func _format_tianxia_yutu_gate_display_name(target: Dictionary) -> String:
	var label: String = str(target.get("navigation_label", target.get("label", "关口"))).strip_edges()
	if label == "":
		label = "关口"
	if label.find("关") < 0:
		label = "%s关" % label
	return label

func _format_tianxia_yutu_gate_boundary_summary(target: Dictionary) -> String:
	var explicit_summary: String = str(target.get("panel_boundary_summary", target.get("snapBoundarySummary", ""))).strip_edges()
	if explicit_summary != "":
		return explicit_summary
	var from_state: String = str(target.get("from_state_label", target.get("from_state_group_label", target.get("state_label", "")))).strip_edges()
	if from_state == "":
		from_state = _tianxia_yutu_player_source_label(str(target.get("from_state_group_id", target.get("state_id", ""))).strip_edges())
	var to_state: String = str(target.get("to_state_label", target.get("to_state_group_label", ""))).strip_edges()
	if to_state == "":
		to_state = _tianxia_yutu_player_source_label(str(target.get("to_state_group_id", "")).strip_edges())
	var from_region: String = str(target.get("from_region_label", target.get("region_label", ""))).strip_edges()
	var to_region: String = str(target.get("to_region_label", "")).strip_edges()
	var left_parts := PackedStringArray()
	var right_parts := PackedStringArray()
	if from_state != "":
		left_parts.append(from_state)
	if from_region != "" and from_region != from_state:
		left_parts.append(from_region)
	if to_state != "":
		right_parts.append(to_state)
	if to_region != "" and to_region != to_state:
		right_parts.append(to_region)
	if not left_parts.is_empty() and not right_parts.is_empty():
		return "%s ↔ %s" % ["/".join(left_parts), "/".join(right_parts)]
	if not left_parts.is_empty():
		return "/".join(left_parts)
	return "边界语义待补"

func _tianxia_yutu_player_source_label(source_id: String) -> String:
	var normalized_id := source_id.strip_edges()
	if normalized_id == "":
		return ""
	return str(TIANXIA_YUTU_PLAYER_SOURCE_LABELS.get(normalized_id, normalized_id)).strip_edges()

func _format_tianxia_yutu_target_display_name(target: Dictionary) -> String:
	if _is_tianxia_yutu_gate_target(target):
		return _format_tianxia_yutu_gate_display_name(target)
	var scope: String = str(target.get("target_scope", target.get("kind", ""))).strip_edges()
	var label: String = str(target.get("navigation_label", target.get("label", ""))).strip_edges()
	if label == "":
		label = "选定坐标" if scope == "coordinate" else "选定目标"
	return label

func _format_tianxia_yutu_target_detail_summary(target: Dictionary) -> String:
	if _is_tianxia_yutu_gate_target(target):
		return _format_tianxia_yutu_gate_boundary_summary(target)
	var scope: String = str(target.get("target_scope", target.get("kind", ""))).strip_edges()
	var scope_label: String = _format_tianxia_yutu_target_scope_label(scope)
	var state_label: String = str(target.get("state_label", "")).strip_edges()
	var region_label: String = str(target.get("region_label", "")).strip_edges()
	var parts := PackedStringArray()
	if state_label != "":
		parts.append(state_label)
	if region_label != "" and region_label != state_label:
		parts.append(region_label)
	if scope_label != "":
		parts.append(scope_label)
	if parts.is_empty():
		return "选定坐标"
	return " / ".join(parts)

func _find_tianxia_yutu_jump_target_by_id(target_id: String) -> Dictionary:
	var normalized_id: String = target_id.strip_edges()
	if normalized_id == "":
		return {}
	for target_variant in _tianxia_yutu_jump_targets:
		if not (target_variant is Dictionary):
			continue
		var target: Dictionary = target_variant as Dictionary
		for key in ["target_id", "id"]:
			if str(target.get(key, "")).strip_edges() == normalized_id:
				return target.duplicate(true)
	return {}

func _build_tianxia_yutu_gate_target_from_selected_context(context: Dictionary) -> Dictionary:
	if context.is_empty():
		return {}
	if not bool(context.get("tianxiaYutuMarkerSnap", false)):
		return {}
	if str(context.get("snapTargetScope", "")).strip_edges() != "gate":
		return {}
	var target_id: String = str(context.get("snapTargetId", "")).strip_edges()
	var target: Dictionary = _find_tianxia_yutu_jump_target_by_id(target_id)
	if target.is_empty():
		target = {
			"target_id": target_id if target_id != "" else "selected_gate_%d_%d" % [int(context.get("cellX", TIANXIA_YUTU_DEFAULT_CENTER_X)), int(context.get("cellY", TIANXIA_YUTU_DEFAULT_CENTER_Y))],
			"label": str(context.get("snapTargetLabel", "关口")).strip_edges(),
			"navigation_label": str(context.get("snapTargetNavigationLabel", context.get("snapTargetLabel", "关口"))).strip_edges(),
			"kind": "gate",
			"target_scope": "gate",
			"cell_1km": {
				"x": int(context.get("cellX", TIANXIA_YUTU_DEFAULT_CENTER_X)),
				"y": int(context.get("cellY", TIANXIA_YUTU_DEFAULT_CENTER_Y)),
			},
		}
	target["source"] = "tianxia_yutu_selected_gate_marker"
	target["panel_boundary_summary"] = str(context.get("snapBoundarySummary", target.get("panel_boundary_summary", ""))).strip_edges()
	target["panel_detail_mode"] = true
	return target

func _build_tianxia_yutu_target_from_marker_context(context: Dictionary) -> Dictionary:
	if context.is_empty():
		return {}
	if not bool(context.get("tianxiaYutuMarkerSnap", false)):
		return {}
	var scope: String = str(context.get("snapTargetScope", "")).strip_edges()
	if scope == "":
		return {}
	if scope == "gate":
		return _build_tianxia_yutu_gate_target_from_selected_context(context)
	var target_id: String = str(context.get("snapTargetId", "")).strip_edges()
	var target: Dictionary = _find_tianxia_yutu_jump_target_by_id(target_id)
	if target.is_empty():
		target = {
			"target_id": target_id if target_id != "" else "selected_%s_%d_%d" % [scope, int(context.get("cellX", TIANXIA_YUTU_DEFAULT_CENTER_X)), int(context.get("cellY", TIANXIA_YUTU_DEFAULT_CENTER_Y))],
			"label": str(context.get("snapTargetLabel", "选定目标")).strip_edges(),
			"navigation_label": str(context.get("snapTargetNavigationLabel", context.get("snapTargetLabel", "选定目标"))).strip_edges(),
			"kind": scope,
			"target_scope": scope,
			"state_id": str(context.get("snapStateId", "")).strip_edges(),
			"state_label": str(context.get("snapStateLabel", "")).strip_edges(),
			"region_id": str(context.get("snapRegionId", "")).strip_edges(),
			"region_label": str(context.get("snapRegionLabel", "")).strip_edges(),
			"cell_1km": {
				"x": int(context.get("cellX", TIANXIA_YUTU_DEFAULT_CENTER_X)),
				"y": int(context.get("cellY", TIANXIA_YUTU_DEFAULT_CENTER_Y)),
			},
		}
	else:
		for key_pair in [
			["snapStateId", "state_id"],
			["snapStateLabel", "state_label"],
			["snapRegionId", "region_id"],
			["snapRegionLabel", "region_label"],
		]:
			var source_key: String = str(key_pair[0])
			var target_key: String = str(key_pair[1])
			var value: String = str(context.get(source_key, "")).strip_edges()
			if value != "":
				target[target_key] = value
	target["source"] = "tianxia_yutu_selected_marker"
	target["panel_detail_mode"] = true
	return target

func _format_tianxia_yutu_overlay_summary() -> String:
	var admin_count: int = int(_tianxia_yutu_administrative_layer.get("region_count", 0))
	var state_count: int = int(_tianxia_yutu_administrative_layer.get("state_count", 0))
	var overlay_labels: PackedStringArray = PackedStringArray()
	for overlay_variant in _tianxia_yutu_overlay_specs():
		if not (overlay_variant is Dictionary):
			continue
		var overlay: Dictionary = overlay_variant as Dictionary
		var overlay_id: String = str(overlay.get("id", "")).strip_edges()
		if overlay_id != "" and not bool(_tianxia_yutu_overlay_visibility.get(overlay_id, bool(overlay.get("default_visible", true)))):
			continue
		var label: String = str(overlay.get("label", overlay.get("id", ""))).strip_edges()
		if label != "":
			overlay_labels.append(label)
	var color_mode: String = str(_tianxia_yutu_faction_color_layer.get("color_mode", "neutral")).strip_edges()
	var runtime_color_entries: Array = _tianxia_yutu_faction_color_layer.get("current_runtime_color_entries", []) as Array if _tianxia_yutu_faction_color_layer.get("current_runtime_color_entries", []) is Array else []
	var frontline_markers: Array = _tianxia_yutu_strategic_overlay_layer.get("frontline_markers", []) as Array if _tianxia_yutu_strategic_overlay_layer.get("frontline_markers", []) is Array else []
	return "图层：州%d 郡%d | %s | 势力色 %s(%d) | 战线%d" % [
		state_count,
		admin_count,
		" / ".join(overlay_labels).left(48) if not overlay_labels.is_empty() else "州郡 / 势力色 / 关口",
		"运行时" if color_mode.find("runtime") >= 0 else "中性",
		runtime_color_entries.size(),
		frontline_markers.size(),
	]

func _same_tianxia_yutu_jump_target(left: Dictionary, right: Dictionary) -> bool:
	var left_id: String = str(left.get("target_id", "")).strip_edges()
	var right_id: String = str(right.get("target_id", "")).strip_edges()
	if left_id != "" and right_id != "":
		return left_id == right_id
	return str(left.get("label", "")).strip_edges() == str(right.get("label", "")).strip_edges()

func _refresh_tianxia_yutu_target_selector() -> void:
	if _tianxia_yutu_target_selector == null:
		return
	_refresh_tianxia_yutu_scope_filter()
	_tianxia_yutu_filtered_jump_targets = _filtered_tianxia_yutu_jump_targets()
	_tianxia_yutu_target_selector.set_block_signals(true)
	_tianxia_yutu_target_selector.clear()
	var selected_index: int = -1
	for index in range(_tianxia_yutu_filtered_jump_targets.size()):
		var target_variant: Variant = _tianxia_yutu_filtered_jump_targets[index]
		if not (target_variant is Dictionary):
			continue
		var target: Dictionary = target_variant as Dictionary
		_tianxia_yutu_target_selector.add_item(_format_tianxia_yutu_jump_target_option(target))
		var item_index: int = _tianxia_yutu_target_selector.get_item_count() - 1
		_tianxia_yutu_target_selector.set_item_metadata(item_index, target.duplicate(true))
		if selected_index < 0 and _same_tianxia_yutu_jump_target(target, _tianxia_yutu_last_jump_target):
			selected_index = item_index
	if selected_index < 0 and not _tianxia_yutu_last_jump_target.is_empty():
		_tianxia_yutu_target_selector.add_item(_format_tianxia_yutu_jump_target_option(_tianxia_yutu_last_jump_target))
		selected_index = _tianxia_yutu_target_selector.get_item_count() - 1
		_tianxia_yutu_target_selector.set_item_metadata(selected_index, _tianxia_yutu_last_jump_target.duplicate(true))
	if _tianxia_yutu_target_selector.get_item_count() == 0:
		_tianxia_yutu_target_selector.add_item("无匹配锚点")
		_tianxia_yutu_target_selector.set_item_metadata(0, {})
		selected_index = 0
	if selected_index < 0:
		selected_index = 0
		var metadata_variant: Variant = _tianxia_yutu_target_selector.get_item_metadata(selected_index)
		if metadata_variant is Dictionary:
			_tianxia_yutu_last_jump_target = (metadata_variant as Dictionary).duplicate(true)
	_tianxia_yutu_target_selector.select(selected_index)
	_tianxia_yutu_target_selector.disabled = _tianxia_yutu_filtered_jump_targets.is_empty()
	_tianxia_yutu_target_selector.set_block_signals(false)

func _refresh_tianxia_yutu_jump_panel() -> void:
	if _tianxia_yutu_jump_panel == null:
		return
	var visible: bool = _display_mode == DISPLAY_MODE_WORLD and _is_tianxia_yutu_main_map_mode()
	if _demo_capture_mode and _demo_capture_hide_tianxia_panel:
		visible = false
	_tianxia_yutu_jump_panel.visible = visible
	if not visible:
		if _tianxia_yutu_mobile_expand_button != null:
			_tianxia_yutu_mobile_expand_button.visible = false
		return
	if _tianxia_yutu_last_jump_target.is_empty():
		_tianxia_yutu_last_jump_target = _resolve_tianxia_yutu_jump_target(_tianxia_yutu_jump_targets, "洛阳")
	var target_label: String = str(_tianxia_yutu_last_jump_target.get("label", "洛阳")).strip_edges()
	var cell: Dictionary = _tianxia_yutu_last_jump_target.get("cell_1km", {}) as Dictionary
	var target_x: int = int(cell.get("x", TIANXIA_YUTU_DEFAULT_CENTER_X))
	var target_y: int = int(cell.get("y", TIANXIA_YUTU_DEFAULT_CENTER_Y))
	var keep_panel_detail_mode: bool = bool(_tianxia_yutu_last_jump_target.get("panel_detail_mode", false))
	var snapped_target: Dictionary = _snap_tianxia_yutu_jump_target_to_anchor(target_x, target_y, target_label) if not keep_panel_detail_mode else {}
	if not snapped_target.is_empty():
		_tianxia_yutu_last_jump_target = snapped_target.duplicate(true)
		if keep_panel_detail_mode:
			_tianxia_yutu_last_jump_target["panel_detail_mode"] = true
		target_label = str(snapped_target.get("label", target_label)).strip_edges()
		var snapped_cell: Dictionary = snapped_target.get("cell_1km", {}) as Dictionary
		target_x = int(snapped_cell.get("x", target_x))
		target_y = int(snapped_cell.get("y", target_y))
	_refresh_tianxia_yutu_target_selector()
	var target_scope_id: String = str(_tianxia_yutu_last_jump_target.get("target_scope", _tianxia_yutu_last_jump_target.get("kind", ""))).strip_edges()
	var navigation_label: String = _format_tianxia_yutu_target_display_name(_tianxia_yutu_last_jump_target)
	var scope_label: String = _format_tianxia_yutu_target_scope_label(target_scope_id)
	var compact_target_active: bool = _is_tianxia_yutu_compact_panel_target(_tianxia_yutu_last_jump_target)
	var target_context_line: String = _format_tianxia_yutu_target_detail_summary(_tianxia_yutu_last_jump_target) if compact_target_active else _format_tianxia_yutu_hover_summary()
	var jump_button_text: String = "跳转主世界" if compact_target_active else "跳转"
	var jump_tooltip_text: String = "跳转到 %s" % str(_tianxia_yutu_last_jump_target.get("navigation_label", target_label)).strip_edges()
	TianxiaYutuCompactTargetCardScript.apply_existing_card_nodes({
		"target": _tianxia_yutu_last_jump_target,
		"coordinate": {"x": target_x, "y": target_y},
		"fallback_label": target_label,
		"scope_label": scope_label,
		"title_text": "%s%s" % [navigation_label if navigation_label != "" else target_label, " · %s" % scope_label if scope_label != "" else ""],
		"context_line": target_context_line,
		"jump_label": jump_button_text,
		"jump_tooltip": jump_tooltip_text,
		"compact_target": compact_target_active,
		"title_label_node": _tianxia_yutu_jump_target_label,
		"coordinate_label_node": _tianxia_yutu_coordinate_label,
		"context_label_node": _tianxia_yutu_hover_summary_label,
		"jump_button_node": _tianxia_yutu_jump_button,
	})
	if _tianxia_yutu_overlay_summary_label != null:
		_tianxia_yutu_overlay_summary_label.text = _format_tianxia_yutu_overlay_summary()
	if _tianxia_yutu_legend_label != null:
		_tianxia_yutu_legend_label.text = _format_tianxia_yutu_legend_summary()
	if _tianxia_yutu_jump_button != null:
		_tianxia_yutu_jump_button.disabled = _tianxia_yutu_last_jump_target.is_empty()
	if _tianxia_yutu_origin_button != null:
		_tianxia_yutu_origin_button.disabled = _build_tianxia_yutu_origin_jump_target().is_empty()
	if _tianxia_yutu_focus_origin_button != null:
		_tianxia_yutu_focus_origin_button.disabled = _build_tianxia_yutu_origin_jump_target().is_empty()
	if _tianxia_yutu_nation_profile_button != null:
		var has_player_nation_profile := not _read_tianxia_yutu_player_nation_runtime_profile().is_empty()
		_tianxia_yutu_nation_profile_button.text = "国家档案" if has_player_nation_profile else "立国配置"
		_tianxia_yutu_nation_profile_button.tooltip_text = "打开国家档案页的国号与颜色治理" if has_player_nation_profile else "打开同盟治理页的立国国号与颜色配置"
	_apply_tianxia_yutu_jump_panel_layout()
	_sync_tianxia_yutu_drilldown_context_to_map()

func _snap_tianxia_yutu_jump_target_to_anchor(cell_x: int, cell_y: int, preferred_label: String = "") -> Dictionary:
	var best_target: Dictionary = {}
	var best_distance_sq: float = float(TIANXIA_YUTU_ANCHOR_SNAP_RADIUS_CELLS * TIANXIA_YUTU_ANCHOR_SNAP_RADIUS_CELLS) + 1.0
	for target_variant in _tianxia_yutu_jump_targets:
		if not (target_variant is Dictionary):
			continue
		var target: Dictionary = target_variant as Dictionary
		var cell: Dictionary = target.get("cell_1km", {}) as Dictionary
		if cell.is_empty():
			continue
		if preferred_label != "" and str(target.get("label", "")).strip_edges() == preferred_label:
			return target.duplicate(true)
		var dx: float = float(int(cell.get("x", cell_x)) - cell_x)
		var dy: float = float(int(cell.get("y", cell_y)) - cell_y)
		var distance_sq: float = dx * dx + dy * dy
		if distance_sq < best_distance_sq:
			best_distance_sq = distance_sq
			best_target = target.duplicate(true)
	return best_target

func _should_snap_tianxia_yutu_direct_click_to_anchor() -> bool:
	var view_state: Dictionary = _read_tianxia_yutu_view_state()
	return float(view_state.get("zoom", 1.0)) < 2.35

func _build_tianxia_yutu_origin_jump_target() -> Dictionary:
	if _main_world_view_transform_bookmark.is_empty():
		return {}
	var center_cell: Dictionary = _main_world_view_transform_bookmark.get("centerCell", {}) as Dictionary
	if center_cell.is_empty():
