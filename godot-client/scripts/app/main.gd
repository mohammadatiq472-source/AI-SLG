func _is_world_tile_action_hud_resource_context(context: Dictionary) -> bool:
	var tile_type := str(context.get("tileType", "")).strip_edges().to_lower()
	var tile_level := int(context.get("resourceLevel", 0))
	return tile_type == "resource" and tile_level >= 1 and tile_level <= 9 and not _is_main_map_context_protected_from_resource_tile_context(context)

func _is_main_map_context_protected_from_resource_tile_context(context: Dictionary) -> bool:
	if context.is_empty():
		return false
	if bool(context.get("isReservedHit", false)):
		return true
	var footprint_id := str(context.get("footprintId", "")).strip_edges().to_lower()
	if footprint_id != "" and footprint_id != "resource_1x1":
		return true
	var tile_type := str(context.get("tileType", context.get("type", ""))).strip_edges().to_lower()
	match tile_type:
		"city", "player_city", "ai_city", "system_city", "pass", "fort", "dock", "mountain_barrier", "river_corridor":
			return true
	return false

func _format_world_tile_resource_kind_label(resource_kind: String) -> String:
	match resource_kind.strip_edges().to_lower():
		"food":
			return "粮草"
		"wood":
			return "木材"
		"stone":
			return "石料"
		"iron":
			return "铁矿"
		"copper":
			return "铜矿"
		_:
			return "资源"

func _extract_world_tile_guard_summary(context: Dictionary) -> Dictionary:
	var guard: Dictionary = {}
	var guard_variant: Variant = context.get("resourceGuard", {})
	if guard_variant is Dictionary:
		guard = guard_variant as Dictionary
	var tile_level := clampi(int(guard.get("resourceLevel", context.get("resourceLevel", 0))), 1, 9)
	var recommended_strength := int(guard.get("recommendedAttackerStrength", 0))
	var units: Array = []
	var units_variant: Variant = guard.get("units", [])
	if units_variant is Array:
		units = units_variant as Array
	var guard_names: Array[String] = []
	for unit_variant in units:
		if not (unit_variant is Dictionary):
			continue
		var unit_entry: Dictionary = unit_variant as Dictionary
		var unit_name := str(unit_entry.get("name", "")).strip_edges()
		if unit_name != "":
			guard_names.append(unit_name)
	var guard_name_label := "守军"
	if guard_names.size() > 0:
		guard_name_label = "、".join(guard_names.slice(0, 2))
	var defender_troop_count := maxi(recommended_strength, units.size() * tile_level * 120)
	if defender_troop_count <= 0:
		defender_troop_count = tile_level * 160
	return {
		"tileLevel": tile_level,
		"guardNameLabel": guard_name_label,
		"recommendedStrength": maxi(recommended_strength, defender_troop_count),
		"defenderTroopCount": defender_troop_count,
	}

func _extract_world_tile_expedition_preview(context: Dictionary) -> Dictionary:
	var preview: Dictionary = {}
	var preview_variant: Variant = context.get("resourceTileExpeditionPreview", {})
	if preview_variant is Dictionary:
		preview = (preview_variant as Dictionary).duplicate(true)
	if preview.is_empty():
		var economy_variant: Variant = context.get("resourceEconomy", {})
		if economy_variant is Dictionary:
			var economy: Dictionary = economy_variant as Dictionary
			preview = {
				"status": "ready",
				"isResourceTile": true,
				"resourceEconomyModelVersion": str(economy.get("resourceEconomyModelVersion", "")).strip_edges(),
				"resourceKind": str(economy.get("resourceKind", context.get("resourceKind", ""))).strip_edges(),
				"resourceLevel": int(economy.get("tileLevel", context.get("resourceLevel", 0))),
				"resourceLabel": _format_world_tile_resource_kind_label(str(economy.get("resourceKind", context.get("resourceKind", ""))).strip_edges()),
				"baseYieldPerHour": economy.get("baseYieldPerHour", {}),
				"captureReward": economy.get("captureReward", {}),
				"defenderStrength": economy.get("defenderStrength", {}),
				"defenderTroopCount": economy.get("defenderTroopCount", {}),
				"recommendedPower": int(economy.get("recommendedPower", 0)),
				"guardLevel": int(economy.get("tileLevel", context.get("resourceLevel", 0))),
				"difficultyLabel": "",
				"riskLabel": "",
			}
	return preview

func _format_resource_tile_range_label(prefix: String, range_variant: Variant, unit_label: String) -> String:
	if not (range_variant is Dictionary):
		return ""
	var range_dict: Dictionary = range_variant as Dictionary
	var min_value := int(range_dict.get("min", 0))
	var max_value := int(range_dict.get("max", min_value))
	if max_value > min_value:
		return "%s +%d-%d %s" % [prefix, min_value, max_value, unit_label]
	return "%s +%d %s" % [prefix, min_value, unit_label]

func _format_resource_tile_capture_reward_label(preview: Dictionary, resource_label: String) -> String:
	var reward_variant: Variant = preview.get("captureReward", {})
	if not (reward_variant is Dictionary):
		return ""
	var reward: Dictionary = reward_variant as Dictionary
	var amount_label := _format_resource_tile_range_label("占领奖励", reward.get("amount", {}), resource_label)
	var hero_exp := int(reward.get("heroExp", 0))
	if amount_label != "" and hero_exp > 0:
		return "%s · 经验 +%d" % [amount_label, hero_exp]
	return amount_label

func _compact_tile_action_capture_reward_label(capture_label: String) -> String:
	return capture_label.strip_edges().replace(" / 武将经验 ", " · 经验 ").replace("/ 武将经验 ", "· 经验 ")

func _collect_world_tile_action_visible_copy_forbidden_hits(texts: Array[String]) -> Array:
	var forbidden_hits: Array = []
	var forbidden_terms := [
		"occupyTile",
		"tileId",
		"resourceGuard",
		"read model",
		"authority",
		"contract",
		"cellVersion",
		"owner",
		"L10",
		"守军强度",
		"海上接战",
		"舰队受损",
		"回港整修",
		"修理入列",
	]
	var all_text := " ".join(texts)
	for term_variant in forbidden_terms:
		var term := str(term_variant)
		if all_text.find(term) >= 0 and not forbidden_hits.has(term):
			forbidden_hits.append(term)
	return forbidden_hits

func _build_world_tile_action_hud_visual_polish_summary(visible_primary_labels: Array, tile_id: String, forbidden_hits: Array, is_l0_tile: bool, is_l1_l9_resource_tile: bool, expedition_clicked: bool = false) -> Dictionary:
	var normalized_labels: Array = []
	for label_variant in visible_primary_labels:
		var label := str(label_variant).strip_edges()
		if label != "":
			normalized_labels.append(label)
	var all_text := " ".join(normalized_labels)
	var raw_tile_id_visible := tile_id != "" and all_text.find(tile_id) >= 0
	var text_density_ok := normalized_labels.size() >= 5 and normalized_labels.size() <= 11
	for label_variant in normalized_labels:
		if str(label_variant).length() > 46:
			text_density_ok = false
	return {
		"tileHudVisualPolishOk": text_density_ok and not raw_tile_id_visible and forbidden_hits.is_empty() and all_text.find("守军强度") < 0,
		"tileHudCardVisible": true,
		"tileHudCardNodeName": "MainMapCellActionPanel",
		"tileHudArtOwner": TILE_ACTION_HUD_ART_OWNER,
		"tileHudSharedStyleOwner": SlgUiComponentFactoryScript.land_tile_action_hud_art_owner(),
		"tileHudBackplateToken": SlgUiComponentFactoryScript.land_tile_action_hud_backplate_token(),
		"tileHudVisualPolishToken": TILE_ACTION_HUD_VISUAL_POLISH_TOKEN,
