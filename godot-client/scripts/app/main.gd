func _select_tianxia_yutu_scope_filter(filter_id: String) -> void:
	if _tianxia_yutu_scope_filter == null:
		return
	var normalized_filter_id: String = filter_id.strip_edges()
	for index in range(_tianxia_yutu_scope_filter.get_item_count()):
		var metadata_variant: Variant = _tianxia_yutu_scope_filter.get_item_metadata(index)
		if str(metadata_variant).strip_edges() == normalized_filter_id:
			_tianxia_yutu_scope_filter.select(index)
			return

func _select_tianxia_yutu_first_filtered_target(search_query: String, filter_id: String) -> bool:
	if _is_tianxia_yutu_mobile_viewport():
		_tianxia_yutu_navigation_panel_expanded = true
	if _tianxia_yutu_search_edit != null:
		_tianxia_yutu_search_edit.text = search_query
	_select_tianxia_yutu_scope_filter(filter_id)
	_refresh_tianxia_yutu_target_selector()
	if _tianxia_yutu_target_selector == null or _tianxia_yutu_target_selector.get_item_count() <= 0:
		return false
	var metadata_variant: Variant = _tianxia_yutu_target_selector.get_item_metadata(0)
	if not (metadata_variant is Dictionary):
		return false
	var target: Dictionary = metadata_variant as Dictionary
	if target.is_empty():
		return false
	_tianxia_yutu_target_selector.select(0)
	_tianxia_yutu_last_jump_target = target.duplicate(true)
	_tianxia_yutu_last_jump_target["panel_detail_mode"] = true
	_tianxia_yutu_navigation_panel_collapsed = false
	_tianxia_yutu_navigation_panel_expanded = false
	_focus_tianxia_yutu_target_on_map(_tianxia_yutu_last_jump_target, 2.8)
	_refresh_tianxia_yutu_jump_panel()
	return true

func _on_tianxia_yutu_target_selected(index: int) -> void:
	if _tianxia_yutu_target_selector == null:
		return
	if index < 0 or index >= _tianxia_yutu_target_selector.get_item_count():
		return
	var metadata_variant: Variant = _tianxia_yutu_target_selector.get_item_metadata(index)
	if metadata_variant is Dictionary:
		_tianxia_yutu_last_jump_target = (metadata_variant as Dictionary).duplicate(true)
		_tianxia_yutu_last_jump_target["panel_detail_mode"] = true
		_tianxia_yutu_navigation_panel_collapsed = false
		_tianxia_yutu_navigation_panel_expanded = false
		_focus_tianxia_yutu_target_on_map(_tianxia_yutu_last_jump_target, 2.8)
	_refresh_tianxia_yutu_jump_panel()

