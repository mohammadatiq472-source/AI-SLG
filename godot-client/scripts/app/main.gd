func _inject_mainline_visual_smoke_backend_campaign_daily_summary(ai_player_id: String, report_id: String) -> void:
	var next_ai_state := WorldStore.get_ai_state(_target_faction_id).duplicate(true)
	next_ai_state["playerRuntimePrimaryAiPlayerId"] = ai_player_id
	var daily_summary := _build_mainline_visual_smoke_ai_campaign_daily_summary(ai_player_id, report_id)
	next_ai_state["playerRuntimeAutonomousCombatDailySummary"] = daily_summary
	next_ai_state["playerRuntimeAutonomousCombatCampaignArchive"] = (daily_summary.get("campaignArchive", {}) as Dictionary).duplicate(true)
	WorldStore.set_ai_state(_target_faction_id, next_ai_state)


