func _read_main_map_streaming_debug_summary() -> Dictionary:
	if _map_grid != null and _map_grid.has_method("get_main_map_streaming_debug_summary"):
		var summary_variant: Variant = _map_grid.call("get_main_map_streaming_debug_summary")
		if summary_variant is Dictionary:
			return (summary_variant as Dictionary).duplicate(true)
	return {
		"ok": false,
		"reason": "map_grid_streaming_summary_unavailable",
	}


func _read_runtime_memory_metrics() -> Dictionary:
	var current_bytes: int = OS.get_static_memory_usage() if OS.has_method("get_static_memory_usage") else -1
	var peak_bytes: int = OS.get_static_memory_peak_usage() if OS.has_method("get_static_memory_peak_usage") else -1
	var current_mb: Variant = null
	var peak_mb: Variant = null
	var recovered_mb: Variant = null
	if current_bytes >= 0:
		current_mb = snapped(float(current_bytes) / 1048576.0, 0.01)
	if peak_bytes >= 0:
		peak_mb = snapped(float(peak_bytes) / 1048576.0, 0.01)
	if current_bytes >= 0 and peak_bytes >= current_bytes:
		recovered_mb = snapped(float(peak_bytes - current_bytes) / 1048576.0, 0.01)
	return {
		"memorySamplingAvailable": current_bytes >= 0 or peak_bytes >= 0,
		"memoryCurrentMb": current_mb,
		"memoryPeakMb": peak_mb,
		"memoryRecoveredMb": recovered_mb,
	}


func _read_camera_zoom_focus_runtime_summary() -> Dictionary:
	var streaming_summary: Dictionary = _read_main_map_streaming_debug_summary()
	var selected_state_id: String = str(streaming_summary.get("tianxiaYutuSelectedStateId", "")).strip_edges()
	var use_tianxia_metrics: bool = selected_state_id != ""
	var memory_summary: Dictionary = _read_runtime_memory_metrics()
	var loaded_chunk_ids: Array = streaming_summary.get("loadedChunkIds", []).duplicate(true) if streaming_summary.get("loadedChunkIds", []) is Array else []
	var unload_candidate_ids: Array = streaming_summary.get("unloadCandidateChunkIds", []).duplicate(true) if streaming_summary.get("unloadCandidateChunkIds", []) is Array else []
	var memory_peak_mb: Variant = memory_summary.get("memoryPeakMb", null)
	var memory_after_unload_mb: Variant = memory_summary.get("memoryCurrentMb", null)
	var memory_recovered_mb: Variant = memory_summary.get("memoryRecoveredMb", null)
	var memory_sampling_available: bool = bool(memory_summary.get("memorySamplingAvailable", false))
	var wheel_pivot_recorded: bool = bool(streaming_summary.get("tianxiaYutuWheelPivotMetricRecorded", false)) if use_tianxia_metrics else bool(streaming_summary.get("wheelPivotMetricRecorded", false))
	var pinch_pivot_recorded: bool = bool(streaming_summary.get("tianxiaYutuPinchPivotMetricRecorded", false)) if use_tianxia_metrics else bool(streaming_summary.get("pinchPivotMetricRecorded", false))
	var hit_metric_recorded: bool = bool(streaming_summary.get("tianxiaYutuHitMetricRecorded", false))
	var state_fill_ratio_2k: float = float(streaming_summary.get("stateFillRatio2k", 0.0))
	var cache_unload_ok: bool = unload_candidate_ids.size() > 0 or (memory_recovered_mb is float and float(memory_recovered_mb) > 0.0) or (memory_recovered_mb is int and int(memory_recovered_mb) > 0)
	var producer_invalid_fields: Array[String] = []
	if not use_tianxia_metrics or state_fill_ratio_2k <= 0.0:
		producer_invalid_fields.append("stateFillRatio2k")
	if not wheel_pivot_recorded:
		producer_invalid_fields.append("wheelPivotDriftPx")
	if not pinch_pivot_recorded:
		producer_invalid_fields.append("pinchPivotDriftPx")
	if not _last_camera_zoom_focus_settle_recorded:
		producer_invalid_fields.append("focusSettleTimeMs")
	if not hit_metric_recorded:
		producer_invalid_fields.append("hitRadiusPx")
	if loaded_chunk_ids.is_empty():
		producer_invalid_fields.append("loadedChunkCount")
	if not memory_sampling_available or memory_peak_mb == null:
		producer_invalid_fields.append("memoryPeakMb")
	if not memory_sampling_available or memory_after_unload_mb == null:
		producer_invalid_fields.append("memoryAfterUnloadMb")
	if not memory_sampling_available or memory_recovered_mb == null:
		producer_invalid_fields.append("memoryRecoveredMb")
	if not cache_unload_ok:
		producer_invalid_fields.append("cacheUnloadOk")
	var producer_field_sources := {
		"stateFillRatio2k": "map_grid._compute_tianxia_yutu_state_fill_ratio_2k",
		"wheelPivotDriftPx": "map_grid._record_main_map_zoom_pivot_metrics/_record_tianxia_yutu_zoom_pivot_metrics",
		"pinchPivotDriftPx": "map_grid._record_main_map_zoom_pivot_metrics/_record_tianxia_yutu_zoom_pivot_metrics",
		"pivotCellDrift": "map_grid._record_main_map_zoom_pivot_metrics/_record_tianxia_yutu_zoom_pivot_metrics",
		"focusSettleTimeMs": "main.gd._run_mainworld_camera_pan_resource_roundtrip_fixture",
		"hitRadiusPx": "map_grid._build_tianxia_yutu_marker_hit",
		"labelOverlapCount": "map_grid._reserve_tianxia_yutu_label_slot",
		"loadedChunkCount": "map_grid.get_main_map_streaming_debug_summary",
		"loadedChunkIds": "map_grid.get_main_map_streaming_debug_summary.loadedChunkIds",
		"unloadCandidateChunkIds": "map_grid.get_main_map_streaming_debug_summary.unloadCandidateChunkIds",
		"viewportCacheHitCount": "main.gd._refresh_viewport_map_layout",
		"viewportStaleResponseCount": "main.gd._refresh_viewport_map_layout",
		"memoryPeakMb": "main.gd._read_runtime_memory_metrics",
		"memoryAfterUnloadMb": "main.gd._read_runtime_memory_metrics",
		"memoryRecoveredMb": "main.gd._read_runtime_memory_metrics",
		"cacheUnloadOk": "main.gd._update_viewport_chunk_tracking/_read_runtime_memory_metrics",
	}
	return {
		"planOnly": false,
		"runtimeProducerOk": producer_invalid_fields.is_empty(),
		"runtimeProducerInvalidFields": producer_invalid_fields,
		"runtimeProducerFieldSources": producer_field_sources,
		"stateFillRatio2k": state_fill_ratio_2k,
		"wheelPivotDriftPx": float(streaming_summary.get("tianxiaYutuWheelPivotDriftPx", 0.0)) if use_tianxia_metrics else float(streaming_summary.get("wheelPivotDriftPx", 0.0)),
		"pinchPivotDriftPx": float(streaming_summary.get("tianxiaYutuPinchPivotDriftPx", 0.0)) if use_tianxia_metrics else float(streaming_summary.get("pinchPivotDriftPx", 0.0)),
		"pivotCellDrift": float(streaming_summary.get("tianxiaYutuPivotCellDrift", 0.0)) if use_tianxia_metrics else float(streaming_summary.get("pivotCellDrift", 0.0)),
		"focusSettleTimeMs": _last_camera_zoom_focus_settle_time_ms,
		"hitRadiusPx": float(streaming_summary.get("hitRadiusPx", 0.0)),
		"labelOverlapCount": int(streaming_summary.get("labelOverlapCount", streaming_summary.get("tianxiaYutuLabelCollisionSkipCount", 0))),
		"loadedChunkCount": int(streaming_summary.get("loadedChunkCount", 0)),
		"loadedChunkIds": loaded_chunk_ids,
		"unloadCandidateChunkCount": int(streaming_summary.get("unloadCandidateChunkCount", 0)),
		"unloadCandidateChunkIds": unload_candidate_ids,
		"resourceOverlayEntryCount": int(streaming_summary.get("resourceOverlayEntryCount", 0)),
		"cityGateAnchorObjectCount": int(streaming_summary.get("cityGateAnchorObjectCount", 0)),
		"viewportCacheHitCount": _viewport_cache_hit_count,
		"viewportStaleResponseCount": _viewport_stale_response_count,
		"viewportLoadedChunkIds": _viewport_loaded_chunk_ids.duplicate(true),
		"viewportUnloadCandidateChunkIds": _viewport_unload_candidate_chunk_ids.duplicate(true),
		"memorySamplingAvailable": memory_sampling_available,
		"memoryCurrentMb": memory_summary.get("memoryCurrentMb", null),
		"memoryPeakMb": memory_peak_mb,
		"memoryAfterUnloadMb": memory_after_unload_mb,
		"memoryRecoveredMb": memory_recovered_mb,
		"cacheUnloadOk": cache_unload_ok,
	}

