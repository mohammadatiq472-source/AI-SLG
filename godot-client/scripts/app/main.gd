func _execute_tianxia_yutu_explicit_jump(target: Dictionary, reason: String) -> Dictionary:
	if target.is_empty():
		return {"ok": false, "reason": "target_missing"}
	var cell: Dictionary = target.get("cell_1km", {}) as Dictionary
	if cell.is_empty():
		return {"ok": false, "reason": "target_cell_missing", "target": target.duplicate(true)}
	var target_x: int = int(cell.get("x", TIANXIA_YUTU_DEFAULT_CENTER_X))
	var target_y: int = int(cell.get("y", TIANXIA_YUTU_DEFAULT_CENTER_Y))
	var before_selected_context: Dictionary = _resolve_selected_main_map_cell_context()
	_close_tianxia_yutu_overview()
	_set_main_map_view_mode(MAIN_MAP_VIEW_MODE_GAMEPLAY)
	_set_display_mode(DISPLAY_MODE_WORLD)
	_refresh_tianxia_yutu_jump_panel()
	var focus_context: Dictionary = {}
	if _map_grid != null and _map_grid.has_method("focus_and_select_main_map_cell_for_action"):
		var focus_variant: Variant = _map_grid.call("focus_and_select_main_map_cell_for_action", target_x, target_y)
		if focus_variant is Dictionary:
			focus_context = (focus_variant as Dictionary).duplicate(true)
	await get_tree().process_frame
	await get_tree().process_frame
	var query_params: Dictionary = _resolve_map_layout_query_params()
	var request_key: String = _build_map_layout_request_key(_active_map_scope, query_params)
	var refresh_ok: bool = await _refresh_viewport_map_layout_immediate(query_params, request_key)
	await get_tree().process_frame
	_sync_selected_main_map_cell_context_from_map_grid()
	var selected_context: Dictionary = _resolve_selected_main_map_cell_context()
	if (
		int(selected_context.get("cellX", -1)) != target_x
		or int(selected_context.get("cellY", -1)) != target_y
	):
		if _map_grid != null and _map_grid.has_method("focus_and_select_main_map_cell_for_action"):
			var refocus_variant: Variant = _map_grid.call("focus_and_select_main_map_cell_for_action", target_x, target_y)
			if refocus_variant is Dictionary:
				var refocus_context: Dictionary = (refocus_variant as Dictionary).duplicate(true)
				if not refocus_context.is_empty():
					focus_context = refocus_context
			await get_tree().process_frame
			await get_tree().process_frame
			_sync_selected_main_map_cell_context_from_map_grid()
			selected_context = _resolve_selected_main_map_cell_context()
	var focus_ok: bool = (
		int(selected_context.get("cellX", -1)) == target_x
		and int(selected_context.get("cellY", -1)) == target_y
	)
	var jump_ok: bool = (
		focus_ok
		and _display_mode == DISPLAY_MODE_WORLD
		and _main_map_view_mode == MAIN_MAP_VIEW_MODE_GAMEPLAY
	)
	var delta_cells: Dictionary = {
		"x": target_x - int(before_selected_context.get("cellX", target_x)),
		"y": target_y - int(before_selected_context.get("cellY", target_y)),
	}
	_tianxia_yutu_explicit_jump_count += 1
	_tianxia_yutu_last_explicit_jump = {
		"ok": jump_ok,
		"refreshOk": refresh_ok,
		"focusOk": focus_ok,
		"reason": reason,
		"target": target.duplicate(true),
		"cell": {"x": target_x, "y": target_y},
		"deltaCells": delta_cells,
		"beforeSelectedCell": before_selected_context.duplicate(true),
		"focusContext": focus_context,
		"selectedCell": selected_context,
		"viewMode": _main_map_view_mode,
	}
	_record_last_action("tianxia_yutu/explicit_jump/%s" % reason, "focused" if jump_ok else "focus_failed")
	_update_runtime_label("tianxia yutu explicit jump %s" % reason)
	return _tianxia_yutu_last_explicit_jump.duplicate(true)

func _load_repo_or_res_texture(path_value: String) -> Texture2D:
	var normalized_path: String = path_value.strip_edges()
	if normalized_path == "":
		return null
	if normalized_path.begins_with("res://"):
		return load(normalized_path) as Texture2D
	var abs_path: String = ProjectSettings.globalize_path("res://../%s" % normalized_path)
	var image := Image.new()
	var err: Error = image.load(abs_path)
	if err != OK:
		push_warning("[tianxia-yutu] preview image load failed: %s err=%d" % [abs_path, int(err)])
		return null
	return ImageTexture.create_from_image(image)

