func _seed_world_tile_action_hud_expedition_fixture(action_name: String = "seedTileActionHudExpeditionFixture", fixture_key: String = "seededTileActionHudExpeditionFixture") -> Dictionary:
	var action_result: Dictionary = await _api_client.post_world_action(
		action_name,
		{"factionId": _target_faction_id},
		true
	)
	if not bool(action_result.get("ok", false)):
		return {
			"ok": false,
			"reason": "seed_request_failed",
			"response": action_result,
		}
	var action_payload: Dictionary = action_result.get("data", {}) as Dictionary
	if not bool(action_payload.get("ok", false)):
		return {
			"ok": false,
			"reason": "seed_action_failed",
			"response": action_payload,
		}
	var action_world: Variant = action_payload.get("world", null)
	if action_world is Dictionary:
		WorldStore.set_world(action_world as Dictionary)
	var fixture: Dictionary = {}
	var fixture_variant: Variant = action_payload.get(fixture_key, {})
	if fixture_variant is Dictionary:
		fixture = fixture_variant as Dictionary
	return {
		"ok": not fixture.is_empty(),
		"reason": "seeded" if not fixture.is_empty() else "fixture_payload_missing",
		"fixture": fixture,
		"response": action_payload,
	}

func _open_world_tile_action_hud_for_fixture(action_name: String = "seedTileActionHudExpeditionFixture", fixture_key: String = "seededTileActionHudExpeditionFixture") -> Dictionary:
	var seed_result := await _seed_world_tile_action_hud_expedition_fixture(action_name, fixture_key)
	if not bool(seed_result.get("ok", false)):
		return {
			"attempted": true,
			"ok": false,
			"reason": "seed_failed",
			"seedResult": seed_result,
		}
	await _refresh_world_and_map(true)
	var fixture: Dictionary = seed_result.get("fixture", {}) as Dictionary
	var tile_id := str(fixture.get("tileId", "")).strip_edges()
	var cell_x := int(fixture.get("cellX", -1))
	var cell_y := int(fixture.get("cellY", -1))
	var focus_result: Dictionary = {}
	if cell_x >= 0 and cell_y >= 0:
		var focus_context := await _focus_select_main_map_cell_for_action_with_viewport_refresh(cell_x, cell_y)
		focus_result = {
			"attempted": true,
			"ok": not focus_context.is_empty(),
			"reason": "main_map_cell_action_focus_applied" if not focus_context.is_empty() else "main_map_cell_action_focus_empty",
			"tileId": tile_id,
			"cell": {"x": cell_x, "y": cell_y},
			"context": focus_context,
		}
	else:
		focus_result = await _focus_mainline_visual_smoke_map_unit_tile(tile_id)
	var context: Dictionary = _selected_main_map_cell_context.duplicate(true)
	if context.is_empty():
		var context_variant: Variant = focus_result.get("context", {})
		if context_variant is Dictionary:
			context = context_variant as Dictionary
	if (
		not _is_world_tile_action_hud_resource_context(context)
		and not _is_main_map_context_protected_from_resource_tile_context(context)
		and _map_grid != null
		and _map_grid.has_method("select_main_map_backend_tile_for_action")
	):
		var response: Dictionary = seed_result.get("response", {}) as Dictionary
		var response_world: Dictionary = response.get("world", {}) as Dictionary
		var response_map: Dictionary = response_world.get("map", {}) as Dictionary
		var response_tiles_variant: Variant = response_map.get("tiles", [])
		if response_tiles_variant is Array:
			for tile_variant in response_tiles_variant as Array:
				if not (tile_variant is Dictionary):
					continue
				var response_tile: Dictionary = tile_variant as Dictionary
				if str(response_tile.get("id", "")).strip_edges() != tile_id:
					continue
				var backend_context_variant: Variant = _map_grid.call("select_main_map_backend_tile_for_action", response_tile)
				if backend_context_variant is Dictionary:
					context = (backend_context_variant as Dictionary).duplicate(true)
					focus_result["backendTileContext"] = context
				break
	if context.is_empty():
		return {
			"attempted": true,
			"ok": false,
			"reason": "fixture_tile_selection_missing",
			"seedResult": seed_result,
			"focusResult": focus_result,
		}
	var hud_summary := _build_world_tile_action_hud_summary(context)
	_apply_world_tile_action_hud_summary(hud_summary)
	_hide_main_map_owner_delta_buttons_for_tile_hud()
	await get_tree().process_frame
	await get_tree().process_frame
	return {
		"attempted": true,
		"ok": bool(hud_summary.get("worldTileActionHudOpenOk", false)) and bool(hud_summary.get("expeditionButtonVisible", false)),
		"reason": "world_tile_action_hud_opened",
		"seedResult": seed_result,
		"focusResult": focus_result,
		"selectedContext": context,
		"pageContentOk": bool(hud_summary.get("worldTileActionHudOpenOk", false)),
		"pageContentSummary": hud_summary,
	}

