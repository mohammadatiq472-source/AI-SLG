func _on_alliance_nation_found_submit_requested(page_id: String) -> void:
	var resolved_page_id := page_id.strip_edges()
	if resolved_page_id == "":
		resolved_page_id = _read_mainline_visual_smoke_active_overlay_page_id()
	var record_path := "panel/alliance/%s/found_nation_submit" % resolved_page_id
	var runtime_label := "panel 同盟 / 治理 / 立国 / 提交"
	var page_summary := _read_mainline_visual_smoke_overlay_page_summary("alliance", resolved_page_id)
	var nation_name := str(page_summary.get("organizationNationNameDraft", "")).strip_edges()
	var color_hex := str(page_summary.get("organizationNationColorHex", "")).strip_edges().to_lower()
	var capital_tile_id := str(page_summary.get("organizationNationCapitalTileIdDraft", "")).strip_edges()
	if nation_name == "" or color_hex == "":
		_store_runtime_action_receipt({
			"source_action": "foundNation",
			"success": false,
			"reason": "nation_profile_draft_missing",
			"source_page": resolved_page_id,
		})
		_apply_overlay_feedback(record_path, "rejected", runtime_label)
		return
	var adapter = _resolve_slg_domain_action_adapter()
	if not adapter.has_method("request_alliance_nation_found"):
		_store_runtime_action_receipt({
			"source_action": "foundNation",
			"success": false,
			"reason": "adapter_method_missing",
			"source_page": resolved_page_id,
		})
		_apply_overlay_feedback(record_path, "rejected", runtime_label)
		return
	var action_result: Dictionary = await adapter.call(
		"request_alliance_nation_found",
		nation_name,
		color_hex,
		capital_tile_id,
		MAIN_MAP_FRONTLINE_MARKER_ACTOR_COMMANDER_ID
	)
	var ok := bool(action_result.get("ok", false))
	var remote_result: Dictionary = action_result.get("remote_result", {}) as Dictionary
	var response_data: Dictionary = remote_result.get("data", {}) as Dictionary
	_store_runtime_action_receipt({
		"source_action": "foundNation",
		"success": ok,
		"source_page": resolved_page_id,
		"faction_id": _target_faction_id,
		"nation_name": nation_name,
		"color_hex": color_hex,
		"capital_tile_id": capital_tile_id,
		"remote_attempted": bool(action_result.get("remote_attempted", false)),
		"remote_applied": bool(action_result.get("remote_applied", false)),
		"remote_status": int(remote_result.get("status", 0)),
		"failure_code": str(action_result.get("failure_code", response_data.get("failureCode", ""))).strip_edges(),
		"message": str(response_data.get("message", action_result.get("error", ""))).strip_edges(),
		"retry_after_ms": int(action_result.get("retry_after_ms", 0)),
		"conflicting_faction_id": str(action_result.get("conflicting_faction_id", "")),
		"conflicting_nation_name": str(action_result.get("conflicting_nation_name", "")),
		"requirement": action_result.get("requirement", response_data.get("requirement", {})),
		"world_action_intent": action_result.get("world_action_intent", {}),
	})
	if not ok:
		_apply_overlay_feedback(record_path, "rejected", runtime_label)
		if resolved_page_id != "":
