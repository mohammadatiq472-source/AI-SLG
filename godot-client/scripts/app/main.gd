func _resolve_first_mainline_visual_smoke_trace_id(trace_items: Array) -> String:
	for trace_variant in trace_items:
		if not (trace_variant is Dictionary):
			continue
		var trace: Dictionary = trace_variant as Dictionary
		var trace_id := str(trace.get("traceId", trace.get("trace_id", trace.get("reportId", "")))).strip_edges()
		if trace_id != "":
			return trace_id
	return ""


func _build_mainline_visual_smoke_governed_trace_summary(trace_items_variant: Variant) -> Dictionary:
	var trace_items: Array = trace_items_variant as Array if trace_items_variant is Array else []
	for trace_variant in trace_items:
		if not (trace_variant is Dictionary):
			continue
		var trace: Dictionary = trace_variant as Dictionary
		var source_kind := str(trace.get("sourceKind", "")).strip_edges()
		var action := str(trace.get("action", "")).strip_edges()
		if source_kind != "governed_proposal" or action != "maritime_patrol_intercept":
			continue
		return {
			"governedProposalTraceVisible": true,
			"sourceKind": source_kind,
			"action": action,
			"traceId": str(trace.get("traceId", trace.get("trace_id", trace.get("reportId", "")))).strip_edges(),
			"phase": str(trace.get("phase", "")).strip_edges(),
			"currentTaskText": str(trace.get("currentTaskText", trace.get("title", ""))).strip_edges(),
			"reportId": str(trace.get("reportId", "")).strip_edges(),
		}
	return {
		"governedProposalTraceVisible": false,
		"sourceKind": "",
		"action": "",
		"traceId": "",
		"phase": "",
		"currentTaskText": "",
		"reportId": "",
	}


