	for index in range(receipt_items.size()):
		var receipt: Dictionary = receipt_items[index] as Dictionary
		var receipt_ok := bool(receipt.get("ok", false))
		var failure_code: Variant = receipt.get("failureCode", null)
		var world_action := str(receipt.get("worldAction", "")).strip_edges()
		var action_request_id := str(receipt.get("actionRequestId", "")).strip_edges()
		messages.append({
			"messageId": "chat_receipt_%03d" % (index + 1),
			"aiPlayerId": str(receipt.get("aiPlayerId", "receipt_fixture_operator")),
			"channelId": "chat_receipt_fixture_channel",
