			"skipped": true,
			"reason": "mainline_visual_smoke_summary_missing",
			"panelId": panel_id,
			"expectedPageId": page_id,
		}
	var summary_variant: Variant = panel_node.call("get_mainline_visual_smoke_summary", page_id)
	if summary_variant is Dictionary:
