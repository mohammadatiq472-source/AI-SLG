func _tianxia_yutu_viewport_size() -> Vector2:
	return get_viewport().get_visible_rect().size

func _is_tianxia_yutu_mobile_viewport() -> bool:
	var viewport_size: Vector2 = _tianxia_yutu_viewport_size()
	return viewport_size.x <= 960.0 or viewport_size.y <= 520.0

func _build_tianxia_yutu_panel_layout_state() -> Dictionary:
	var mobile_viewport: bool = _is_tianxia_yutu_mobile_viewport()
	var expanded: bool = _tianxia_yutu_navigation_panel_expanded if mobile_viewport else false
	var target_detail: bool = _is_tianxia_yutu_compact_panel_target(_tianxia_yutu_last_jump_target) and not expanded
	return TianxiaYutuPanelStateScript.build_layout_state({
		"mobile": mobile_viewport,
		"expanded": expanded,
		"target_detail": target_detail,
		"collapsed": _tianxia_yutu_navigation_panel_collapsed,
	})

func _tianxia_yutu_jump_panel_layout_mode() -> String:
	return str(_build_tianxia_yutu_panel_layout_state().get("panelLayoutMode", "full"))

func _is_tianxia_yutu_control_visible(control: Control) -> bool:
	return control != null and control.visible and control.is_visible_in_tree()

func _set_tianxia_yutu_control_visible(control: Control, should_show: bool) -> void:
	if control == null:
		return
	control.visible = should_show

func _apply_tianxia_yutu_jump_panel_layout() -> void:
	if _tianxia_yutu_jump_panel == null:
		return
	var viewport_size: Vector2 = _tianxia_yutu_viewport_size()
	var mobile_viewport: bool = _is_tianxia_yutu_mobile_viewport()
	if not mobile_viewport:
		_tianxia_yutu_navigation_panel_expanded = false
	var layout_state: Dictionary = _build_tianxia_yutu_panel_layout_state()
	var target_detail_mode: bool = bool(layout_state.get("targetDetailMode", false))
	var compact_mode: bool = bool(layout_state.get("compactMode", false))
	var drilldown_mode: bool = bool(layout_state.get("drilldownMode", false))
	var collapsed_mode: bool = bool(layout_state.get("navigationPanelCollapsed", false))
	if _tianxia_yutu_mobile_expand_button != null:
		_tianxia_yutu_mobile_expand_button.visible = collapsed_mode and _display_mode == DISPLAY_MODE_WORLD and _is_tianxia_yutu_main_map_mode()
		_tianxia_yutu_mobile_expand_button.offset_left = -58.0
		_tianxia_yutu_mobile_expand_button.offset_right = -14.0
		_tianxia_yutu_mobile_expand_button.offset_top = -104.0
		_tianxia_yutu_mobile_expand_button.offset_bottom = -14.0
	if collapsed_mode:
		_tianxia_yutu_jump_panel.visible = false
		return

	_tianxia_yutu_jump_panel.anchor_left = 1.0
	_tianxia_yutu_jump_panel.anchor_right = 1.0
	_tianxia_yutu_jump_panel.anchor_top = 1.0
	_tianxia_yutu_jump_panel.anchor_bottom = 1.0
	if target_detail_mode:
		var detail_width: float = minf(372.0, maxf(286.0, viewport_size.x - 24.0))
		var detail_height: float = minf(146.0, maxf(124.0, viewport_size.y * 0.34))
		_tianxia_yutu_jump_panel.offset_left = -detail_width - 12.0
		_tianxia_yutu_jump_panel.offset_right = -12.0
		_tianxia_yutu_jump_panel.offset_top = -detail_height - 12.0
		_tianxia_yutu_jump_panel.offset_bottom = -12.0
		_tianxia_yutu_jump_panel.modulate = Color(1.0, 1.0, 1.0, 0.92)
	elif compact_mode:
		var compact_width: float = minf(360.0, maxf(260.0, viewport_size.x - 24.0))
		var compact_height: float = minf(124.0, maxf(104.0, viewport_size.y * 0.28))
		_tianxia_yutu_jump_panel.offset_left = -compact_width - 12.0
		_tianxia_yutu_jump_panel.offset_right = -12.0
		_tianxia_yutu_jump_panel.offset_top = -compact_height - 12.0
		_tianxia_yutu_jump_panel.offset_bottom = -12.0
		_tianxia_yutu_jump_panel.modulate = Color(1.0, 1.0, 1.0, 0.86)
	elif drilldown_mode:
		var drilldown_width: float = minf(430.0, maxf(320.0, viewport_size.x * 0.48))
		var drilldown_height: float = minf(214.0, maxf(172.0, viewport_size.y - 90.0))
		_tianxia_yutu_jump_panel.offset_left = -drilldown_width - 12.0
		_tianxia_yutu_jump_panel.offset_right = -12.0
		_tianxia_yutu_jump_panel.offset_top = -drilldown_height - 12.0
		_tianxia_yutu_jump_panel.offset_bottom = -12.0
		_tianxia_yutu_jump_panel.modulate = Color(1.0, 1.0, 1.0, 0.90)
	else:
		_tianxia_yutu_jump_panel.offset_left = -390.0
		_tianxia_yutu_jump_panel.offset_right = -24.0
		_tianxia_yutu_jump_panel.offset_top = -240.0
		_tianxia_yutu_jump_panel.offset_bottom = -28.0
		_tianxia_yutu_jump_panel.modulate = Color(1.0, 1.0, 1.0, 0.92)

	var desktop_full_mode: bool = bool(layout_state.get("desktopFullMode", false))
	var mobile_detail_mode: bool = bool(layout_state.get("mobileDetailMode", false))
	_set_tianxia_yutu_control_visible(_tianxia_yutu_panel_title_label, not compact_mode and not target_detail_mode)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_search_row, false)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_drilldown_row, bool(layout_state.get("drilldownVisible", false)))
	_set_tianxia_yutu_control_visible(_tianxia_yutu_scale_selector, false)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_target_selector, false)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_coordinate_label, bool(layout_state.get("coordinateVisible", false)))
	_set_tianxia_yutu_control_visible(_tianxia_yutu_view_action_row, false)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_overlay_summary_label, false)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_overlay_toggle_flow, false)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_hover_summary_label, target_detail_mode)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_legend_label, false)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_action_row, true)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_jump_button, true)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_origin_button, false)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_focus_origin_button, true)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_zoom_in_button, true)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_zoom_out_button, true)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_reset_view_button, bool(layout_state.get("resetViewVisible", false)))
	_set_tianxia_yutu_control_visible(_tianxia_yutu_nation_profile_button, false)
	_set_tianxia_yutu_control_visible(_tianxia_yutu_mobile_drilldown_button, bool(layout_state.get("compactDrilldownVisible", false)))
	_set_tianxia_yutu_control_visible(_tianxia_yutu_mobile_close_button, bool(layout_state.get("mobileCloseVisible", false)))

func _ingest_tianxia_yutu_main_map_layer(map_layout_data: Dictionary) -> void:
	if not _is_tianxia_yutu_main_map_mode():
		return
	var layer: Dictionary = _extract_tianxia_yutu_overview_layer(map_layout_data)
	if layer.is_empty():
		_refresh_tianxia_yutu_jump_panel()
		return
	_apply_tianxia_yutu_overview_layer(layer)

func _build_tianxia_yutu_overview_query_params() -> Dictionary:
	return {
		"layer": "layered",
		"worldId": MAIN_MAP_WORLD_ID,
		"coordinateSpace": MAIN_MAP_COORDINATE_SPACE,
		"centerX": str(TIANXIA_YUTU_DEFAULT_CENTER_X),
		"centerY": str(TIANXIA_YUTU_DEFAULT_CENTER_Y),
		"visibleCells": "512x320",
		"visibleSizeCells": "512x320",
		"preloadMargin": "64",
		"preloadMarginCells": "64",
		"chunkSize": "64",
		"includeLayers": TIANXIA_YUTU_INCLUDE_LAYERS,
		"tianxiaYutuScalePreset": _tianxia_yutu_scale_preset_id,
	}

func _extract_tianxia_yutu_overview_layer(payload: Dictionary) -> Dictionary:
	var direct: Variant = payload.get("tianxia_yutu_overview_layer", {})
	if direct is Dictionary:
		return direct as Dictionary
	for key in ["layeredAdapter", "layered", "layers"]:
		var nested_variant: Variant = payload.get(key, {})
		if not (nested_variant is Dictionary):
			continue
		var nested: Dictionary = nested_variant as Dictionary
		var layer_variant: Variant = nested.get("tianxia_yutu_overview_layer", {})
		if layer_variant is Dictionary:
			return layer_variant as Dictionary
	return {}

func _apply_tianxia_yutu_overview_layer(layer: Dictionary) -> void:
	if layer.is_empty():
		if _tianxia_yutu_status_label != null:
			_tianxia_yutu_status_label.text = "天下舆图数据缺失"
		return
	var preview: Dictionary = layer.get("preview_image", {}) as Dictionary
	var preview_path: String = str(preview.get("path", "")).strip_edges()
	var texture: Texture2D = _load_repo_or_res_texture(preview_path)
	if texture != null and _tianxia_yutu_preview_texture != null:
		_tianxia_yutu_preview_texture.texture = texture
	var jump_targets: Array = layer.get("jump_targets", []) as Array if layer.get("jump_targets", []) is Array else []
	_tianxia_yutu_jump_targets = jump_targets.duplicate(true)
	_tianxia_yutu_navigation_facets = layer.get("navigation_facets", {}) as Dictionary if layer.get("navigation_facets", {}) is Dictionary else {}
	_tianxia_yutu_administrative_layer = layer.get("administrative_ownership_layer", {}) as Dictionary if layer.get("administrative_ownership_layer", {}) is Dictionary else {}
	_tianxia_yutu_faction_color_layer = layer.get("faction_color_layer", {}) as Dictionary if layer.get("faction_color_layer", {}) is Dictionary else {}
	_tianxia_yutu_strategic_overlay_layer = layer.get("strategic_overlay_layer", {}) as Dictionary if layer.get("strategic_overlay_layer", {}) is Dictionary else {}
	_tianxia_yutu_scale_preset_catalog = layer.get("scale_preset_catalog", []) as Array if layer.get("scale_preset_catalog", []) is Array else []
	var active_scale_preset: Dictionary = layer.get("scale_preset", {}) as Dictionary if layer.get("scale_preset", {}) is Dictionary else {}
	var active_scale_preset_id: String = str(active_scale_preset.get("id", _tianxia_yutu_scale_preset_id)).strip_edges()
	if active_scale_preset_id != "":
		_tianxia_yutu_scale_preset_id = _coerce_tianxia_yutu_scale_preset_id(active_scale_preset_id, _tianxia_yutu_scale_preset_catalog, "16k")
	else:
		_tianxia_yutu_scale_preset_id = _coerce_tianxia_yutu_scale_preset_id(_tianxia_yutu_scale_preset_id, _tianxia_yutu_scale_preset_catalog, "16k")
	_sync_tianxia_yutu_overlay_visibility_defaults()
	_tianxia_yutu_last_jump_target = _resolve_tianxia_yutu_jump_target(jump_targets, "洛阳")
	_refresh_tianxia_yutu_scale_selector()
	_refresh_tianxia_yutu_state_region_selectors()
	_sync_tianxia_yutu_drilldown_context_to_map()
	_refresh_tianxia_yutu_jump_panel()
	if _tianxia_yutu_status_label != null:
		_tianxia_yutu_status_label.text = "天下舆图已加载"
	if _tianxia_yutu_layer_label != null:
		_tianxia_yutu_layer_label.text = "天下舆图已就绪"

func _resolve_tianxia_yutu_jump_target(jump_targets: Array, label: String) -> Dictionary:
	for target_variant in jump_targets:
		if not (target_variant is Dictionary):
			continue
		var target: Dictionary = target_variant as Dictionary
		if str(target.get("label", "")).strip_edges() == label:
			return target.duplicate(true)
	return {
		"label": label,
		"cell_1km": {"x": TIANXIA_YUTU_DEFAULT_CENTER_X, "y": TIANXIA_YUTU_DEFAULT_CENTER_Y},
	}

func _format_tianxia_yutu_jump_target_option(target: Dictionary) -> String:
	var state_label: String = str(target.get("state_label", "")).strip_edges()
	var region_label: String = str(target.get("region_label", "")).strip_edges()
	var label: String = str(target.get("navigation_label", target.get("label", ""))).strip_edges()
	var scope_label: String = _format_tianxia_yutu_target_scope_label(str(target.get("target_scope", target.get("kind", ""))).strip_edges())
	var parts: PackedStringArray = PackedStringArray()
	if state_label != "":
		parts.append(state_label)
	if region_label != "" and region_label != state_label and label.find(region_label) < 0:
		parts.append(region_label)
	if label != "":
		parts.append(label)
	if scope_label != "":
		parts.append(scope_label)
	if parts.is_empty():
		return "未命名锚点"
	return " / ".join(parts)

func _format_tianxia_yutu_target_scope_label(scope: String) -> String:
	match scope:
		"state_government":
			return "州治"
		"commandery_seat":
			return "郡治"
		"gate":
			return "关口"
		"city":
			return "城池"
		"coordinate":
			return "坐标"
		_:
			return scope

func _current_tianxia_yutu_scope_filter_id() -> String:
	if _tianxia_yutu_scope_filter == null or _tianxia_yutu_scope_filter.get_item_count() <= 0:
		return "all"
	var metadata_variant: Variant = _tianxia_yutu_scope_filter.get_item_metadata(_tianxia_yutu_scope_filter.selected)
	return str(metadata_variant).strip_edges() if metadata_variant != null else "all"

func _refresh_tianxia_yutu_scope_filter() -> void:
	if _tianxia_yutu_scope_filter == null:
		return
	var selected_filter_id: String = _current_tianxia_yutu_scope_filter_id()
	_tianxia_yutu_scope_filter.set_block_signals(true)
	_tianxia_yutu_scope_filter.clear()
	var filter_groups: Array = []
	var raw_filter_groups: Variant = _tianxia_yutu_navigation_facets.get("filter_groups", [])
	if raw_filter_groups is Array:
		filter_groups = raw_filter_groups as Array
	if filter_groups.is_empty():
		filter_groups = [
			{"id": "all", "label": "全部"},
			{"id": "state_government", "label": "州治"},
			{"id": "commandery_seat", "label": "郡治"},
			{"id": "gate", "label": "关口"},
		]
	var selected_index: int = 0
	for group_variant in filter_groups:
