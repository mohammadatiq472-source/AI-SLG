	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(0.15).timeout
	var page_summary_before := _read_mainline_visual_smoke_overlay_page_summary("ai_hub", "context")
	var open_chat_button := _find_mainline_visual_smoke_visible_button_by_meta(_active_overlay_panel, "ai_panel_action_id", "ai_player_open_chat_channel")
	if open_chat_button == null:
		open_chat_button = _find_mainline_visual_smoke_visible_button_by_text(_active_overlay_panel, "打开聊天频道")
	if open_chat_button == null:
		open_chat_button = _find_mainline_visual_smoke_visible_button_by_text(_active_overlay_panel, "打开频道")
