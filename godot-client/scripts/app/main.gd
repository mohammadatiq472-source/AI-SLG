			"expectedPageId": expected_page_id,
			"touchOk": false,
		}
	var viewport_rect := Rect2(Vector2.ZERO, get_viewport().get_visible_rect().size)
	var button_rect := tab_button.get_global_rect()
	var button_inside_viewport := _mainline_visual_smoke_rect_intersects(button_rect, viewport_rect)
	var scrolled_for_button := false
	if not button_inside_viewport and detail_scroll != null:
		detail_scroll.scroll_vertical = 100000
