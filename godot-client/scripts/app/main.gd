func _read_mainline_visual_smoke_player_home_city_map_context() -> Dictionary:
	if _map_grid == null or not is_instance_valid(_map_grid):
		return {}
	var entries_variant: Variant = _map_grid.get("_home_city_overlay_entries")
	if not (entries_variant is Array):
		return {}
	var fallback_context: Dictionary = {}
	for entry_variant in entries_variant as Array:
		if not (entry_variant is Dictionary):
			continue
		var entry: Dictionary = entry_variant as Dictionary
		var faction_id := str(entry.get("factionId", "")).strip_edges()
		var is_human := bool(entry.get("isHuman", false))
		if fallback_context.is_empty() and _target_faction_id != "" and faction_id == _target_faction_id:
			fallback_context = _build_main_city_hub_context_from_map_node_click(entry)
		if is_human:
			return _build_main_city_hub_context_from_map_node_click(entry)
	return fallback_context

func _read_mainline_visual_smoke_player_home_city_formal_anchor_context() -> Dictionary:
	if _map_grid == null or not is_instance_valid(_map_grid):
		return {}
	var anchors_variant: Variant = _map_grid.get("_world_cell_node_anchor_by_tmx_key")
	if not (anchors_variant is Dictionary):
		return {}
	var anchors: Dictionary = anchors_variant as Dictionary
	var fallback_context: Dictionary = {}
	for anchor_variant in anchors.values():
		if not (anchor_variant is Dictionary):
			continue
		var anchor: Dictionary = anchor_variant as Dictionary
		var anchor_type := str(anchor.get("type", "")).strip_edges().to_lower()
		var footprint_id := str(anchor.get("footprintId", "")).strip_edges()
		if anchor_type != "player_city" and footprint_id != "player_city_3x3_initial":
			continue
		var faction_id := str(anchor.get("factionId", "")).strip_edges()
		if fallback_context.is_empty():
			fallback_context = _build_main_city_hub_context_from_formal_anchor(anchor)
		if _target_faction_id != "" and faction_id == _target_faction_id:
			return _build_main_city_hub_context_from_formal_anchor(anchor)
		var owner := str(anchor.get("owner", "")).strip_edges().to_lower()
		if owner == "player":
			return _build_main_city_hub_context_from_formal_anchor(anchor)
	return fallback_context

