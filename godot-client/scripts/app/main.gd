		await get_tree().process_frame
		await get_tree().process_frame
		await get_tree().create_timer(0.2).timeout
		button_rect = tab_button.get_global_rect()
		button_inside_viewport = _mainline_visual_smoke_rect_intersects(button_rect, viewport_rect)
	var touch_ok := button_rect.size.x >= 42.0 and button_rect.size.y >= 42.0 and button_inside_viewport
