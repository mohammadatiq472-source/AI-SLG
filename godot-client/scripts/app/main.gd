	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(0.25).timeout
	var active_page_id := _read_mainline_visual_smoke_active_overlay_page_id()
	var layout_summary := _read_mainline_visual_smoke_overlay_panel_layout_summary("generals")
	var page_summary := _read_mainline_visual_smoke_overlay_page_summary("generals", active_page_id)
