func _resolve_mainline_visual_smoke_movement_geography_samples() -> Dictionary:
	var samples := {}
	var world_map: Dictionary = WorldStore.world.get("map", {}) as Dictionary
	var raw_tiles: Variant = world_map.get("tiles", [])
	if not (raw_tiles is Array):
		return samples
	var tiles: Array = raw_tiles as Array
	var tile_by_coord := {}
	for tile_variant in tiles:
		if not (tile_variant is Dictionary):
			continue
		var tile: Dictionary = tile_variant as Dictionary
		tile_by_coord["%d:%d" % [int(tile.get("x", 0)), int(tile.get("y", 0))]] = tile
	var directions := [Vector2i(1, 0), Vector2i(0, 1), Vector2i(-1, 0), Vector2i(0, -1)]
	for tile_variant in tiles:
		if not (tile_variant is Dictionary):
			continue
		var from_tile: Dictionary = tile_variant as Dictionary
		for direction in directions:
			var to_key := "%d:%d" % [int(from_tile.get("x", 0)) + direction.x, int(from_tile.get("y", 0)) + direction.y]
			if not tile_by_coord.has(to_key):
				continue
			var to_tile: Dictionary = tile_by_coord.get(to_key, {}) as Dictionary
			_maybe_record_movement_geography_sample(samples, from_tile, to_tile)
			_maybe_record_movement_geography_sample(samples, to_tile, from_tile)
		if samples.size() >= 5:
			break
	_apply_mainline_visual_smoke_movement_geography_fallback_samples(samples)
	return samples

func _apply_mainline_visual_smoke_movement_geography_fallback_samples(samples: Dictionary) -> void:
	if not samples.has("cross_state_blocked_requires_pass"):
		samples["cross_state_blocked_requires_pass"] = {"fromTileId": "grid_154_1", "targetTileId": "grid_155_1"}
	if not samples.has("state_boundary_pass_allowed"):
		samples["state_boundary_pass_allowed"] = {"fromTileId": "grid_0_19", "targetTileId": "grid_1_19"}
	if not samples.has("mountain_blocked_requires_pass"):
		samples["mountain_blocked_requires_pass"] = {"fromTileId": "grid_1_18", "targetTileId": "grid_1_19"}
	if not samples.has("river_blocked_requires_dock"):
		samples["river_blocked_requires_dock"] = {"fromTileId": "grid_154_0", "targetTileId": "grid_154_1"}
	if not samples.has("river_crossing_dock_allowed"):
		samples["river_crossing_dock_allowed"] = {"fromTileId": "grid_74_145", "targetTileId": "dock_liangzhou_yellow_river"}

func _maybe_record_movement_geography_sample(samples: Dictionary, from_tile: Dictionary, to_tile: Dictionary) -> void:
	var from_district := str(from_tile.get("district", "")).strip_edges()
	var to_district := str(to_tile.get("district", "")).strip_edges()
	var from_type := str(from_tile.get("type", "")).strip_edges()
	var to_type := str(to_tile.get("type", "")).strip_edges()
	var from_terrain := str(from_tile.get("terrain", "")).strip_edges()
	var to_terrain := str(to_tile.get("terrain", "")).strip_edges()
	if from_district != "" and to_district != "" and from_district != to_district:
		if not samples.has("cross_state_blocked_requires_pass") and from_type != "pass" and to_type != "pass" and from_type != "dock" and to_type != "dock" and from_type != "fort" and to_type != "fort" and from_type != "city" and to_type != "city":
			samples["cross_state_blocked_requires_pass"] = {"fromTileId": str(from_tile.get("id", "")), "targetTileId": str(to_tile.get("id", ""))}
		if not samples.has("state_boundary_pass_allowed") and from_type == "pass" and str(from_tile.get("owner", "")) == _target_faction_id and to_type != "pass":
			samples["state_boundary_pass_allowed"] = {"fromTileId": str(from_tile.get("id", "")), "targetTileId": str(to_tile.get("id", ""))}
	if from_district != "" and from_district == to_district:
		if not samples.has("mountain_blocked_requires_pass") and to_terrain == "mountain" and to_type != "pass":
			samples["mountain_blocked_requires_pass"] = {"fromTileId": str(from_tile.get("id", "")), "targetTileId": str(to_tile.get("id", ""))}
		if from_terrain != "riverland" and to_terrain == "riverland":
			if not samples.has("river_blocked_requires_dock") and to_type != "pass" and to_type != "city" and to_type != "dock":
				samples["river_blocked_requires_dock"] = {"fromTileId": str(from_tile.get("id", "")), "targetTileId": str(to_tile.get("id", ""))}
			if not samples.has("river_crossing_dock_allowed") and to_type == "dock":
				samples["river_crossing_dock_allowed"] = {"fromTileId": str(from_tile.get("id", "")), "targetTileId": str(to_tile.get("id", ""))}

