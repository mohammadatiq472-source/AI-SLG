			selected_index = item_index
	if _tianxia_yutu_scale_selector.get_item_count() == 0:
		_tianxia_yutu_scale_selector.add_item("16K")
		_tianxia_yutu_scale_selector.set_item_metadata(0, "16k")
	_tianxia_yutu_scale_selector.select(clampi(selected_index, 0, _tianxia_yutu_scale_selector.get_item_count() - 1))
	_tianxia_yutu_scale_selector.set_block_signals(false)

func _state_region_index_entries() -> Array:
	var raw_index: Variant = _tianxia_yutu_administrative_layer.get("state_region_index", {})
	if not (raw_index is Dictionary):
		return []
	var entries: Array = []
	for state_key_variant in (raw_index as Dictionary).keys():
		var entry_variant: Variant = (raw_index as Dictionary).get(state_key_variant)
		if entry_variant is Dictionary:
			var entry: Dictionary = (entry_variant as Dictionary).duplicate(true)
			entry["_state_key"] = str(state_key_variant).strip_edges()
			entries.append(entry)
	entries.sort_custom(func(left: Dictionary, right: Dictionary) -> bool:
		return str(left.get("state_label", left.get("_state_key", ""))) < str(right.get("state_label", right.get("_state_key", "")))
	)
	return entries


func _tianxia_yutu_state_entry_id(state_entry: Dictionary) -> String:
	var state_id: String = str(state_entry.get("state_id", "")).strip_edges()
	if state_id != "":
		return state_id
	return str(state_entry.get("_state_key", "")).strip_edges()


func _refresh_tianxia_yutu_state_region_selectors() -> void:
	if _tianxia_yutu_state_selector == null:
		return
	var entries: Array = _state_region_index_entries()
	_tianxia_yutu_state_selector.set_block_signals(true)
	_tianxia_yutu_state_selector.clear()
	var selected_index: int = 0
	for state_variant in entries:
		if not (state_variant is Dictionary):
			continue
		var state_entry: Dictionary = state_variant as Dictionary
		var state_id: String = _tianxia_yutu_state_entry_id(state_entry)
		var state_key: String = str(state_entry.get("_state_key", state_id)).strip_edges()
		var state_label: String = str(state_entry.get("state_label", state_key)).strip_edges()
		var regions: Array = state_entry.get("regions", []) as Array if state_entry.get("regions", []) is Array else []
		_tianxia_yutu_state_selector.add_item("%s(%d)" % [state_label, regions.size()])
		var item_index: int = _tianxia_yutu_state_selector.get_item_count() - 1
		_tianxia_yutu_state_selector.set_item_metadata(item_index, state_entry.duplicate(true))
		if _tianxia_yutu_selected_state_id != "" and (_tianxia_yutu_selected_state_id == state_id or _tianxia_yutu_selected_state_id == state_key):
			selected_index = item_index
	if _tianxia_yutu_state_selector.get_item_count() == 0:
		_tianxia_yutu_state_selector.add_item("无州郡")
		_tianxia_yutu_state_selector.set_item_metadata(0, {})
		_tianxia_yutu_selected_state_id = ""
		_tianxia_yutu_selected_region_id = ""
	else:
		_tianxia_yutu_state_selector.select(clampi(selected_index, 0, _tianxia_yutu_state_selector.get_item_count() - 1))
		var selected_state_variant: Variant = _tianxia_yutu_state_selector.get_item_metadata(_tianxia_yutu_state_selector.selected)
		if selected_state_variant is Dictionary:
			var selected_state: Dictionary = selected_state_variant as Dictionary
			_tianxia_yutu_selected_state_id = _tianxia_yutu_state_entry_id(selected_state)
	_tianxia_yutu_state_selector.set_block_signals(false)
	_refresh_tianxia_yutu_region_selector_for_state(_tianxia_yutu_selected_state_id)
	_sync_tianxia_yutu_drilldown_context_to_map()

func _refresh_tianxia_yutu_region_selector_for_state(state_id: String) -> void:
	if _tianxia_yutu_region_selector == null:
		return
	var selected_state: Dictionary = {}
	if _tianxia_yutu_state_selector != null and _tianxia_yutu_state_selector.get_item_count() > 0:
