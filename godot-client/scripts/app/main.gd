func _press_mainline_visual_smoke_world_sea_overseas_naval_frame_preview() -> Dictionary:
	_set_display_mode(DISPLAY_MODE_WORLD)
	await get_tree().process_frame
	var manifest: Dictionary = _read_mainline_visual_smoke_naval_frame_manifest()
	var policy: Dictionary = manifest.get("movingBodyFramePolicy", {}) if manifest.get("movingBodyFramePolicy", {}) is Dictionary else {}
	var bodies: Array = manifest.get("requiredMovingBodies", []) if manifest.get("requiredMovingBodies", []) is Array else []
	var expected_slots := [
		"naval_light_patrol_warship_v1",
		"naval_interceptor_warship_v1",
		"naval_transport_warship_v1",
	]
	var directions: Array = policy.get("directions", []) if policy.get("directions", []) is Array else []
	var slots_summary: Array = []
	var frame_count_by_slot := {}
	var import_count_by_slot := {}
	var texture_loaded_by_slot := {}
	var visible_slot_count := 0
	var preview_panel := _build_mainline_visual_smoke_naval_frame_preview_panel()
	var cards_row := preview_panel.get_meta("cards_row", null) as HBoxContainer
	for slot_id_variant in expected_slots:
		var slot_id := str(slot_id_variant)
		var body := _find_mainline_visual_smoke_naval_body_by_slot(bodies, slot_id)
		var target_root := str(body.get("targetRoot", ""))
		var naming_pattern := str(body.get("frameNamingPattern", ""))
		var frame_count := 0
		var import_count := 0
		var loaded_count := 0
		var sample_paths: Array = []
		for direction_variant in directions:
			var direction := str(direction_variant)
			for frame_index in range(10):
				var frame_path := "%s/%s" % [
					target_root,
					naming_pattern.replace("{direction}", direction).replace("{frameIndex}", "%02d" % frame_index),
				]
				if ResourceLoader.exists(frame_path):
					frame_count += 1
				if FileAccess.file_exists(frame_path + ".import"):
					import_count += 1
				if frame_index in [0, 3, 6, 9] and direction in ["r", "d", "l", "u"] and sample_paths.size() < 4:
					sample_paths.append(frame_path)
		var card := _build_mainline_visual_smoke_naval_frame_preview_card(slot_id, body, sample_paths)
		if cards_row != null:
			cards_row.add_child(card)
		visible_slot_count += 1
		for sample_path_variant in sample_paths:
			if _load_mainline_visual_smoke_naval_png_texture(str(sample_path_variant)) != null:
				loaded_count += 1
		frame_count_by_slot[slot_id] = frame_count
		import_count_by_slot[slot_id] = import_count
		texture_loaded_by_slot[slot_id] = loaded_count
		slots_summary.append({
			"slotId": slot_id,
			"assetStatus": str(body.get("assetStatus", "")),
			"requiredFrameCount": int(body.get("requiredFrameCount", 0)),
			"frameCount": frame_count,
			"importCount": import_count,
			"sampleTextureLoadedCount": loaded_count,
			"targetRoot": target_root,
		})
	var host := get_node_or_null(UI_LAYER_PATH)
	if host != null:
		host.add_child(preview_panel)
	else:
		add_child(preview_panel)
	var viewport_size: Vector2 = get_viewport().get_visible_rect().size
	var panel_width: float = min(1120.0, max(720.0, viewport_size.x - 48.0))
	preview_panel.size = Vector2(panel_width, 340)
	preview_panel.position = Vector2(max(24.0, (viewport_size.x - panel_width) * 0.5), max(88.0, viewport_size.y - 386.0))
	await get_tree().process_frame
	await get_tree().create_timer(0.20).timeout
	var all_slots_ready := true
	for slot_id_variant in expected_slots:
		var slot_id := str(slot_id_variant)
		all_slots_ready = all_slots_ready and int(frame_count_by_slot.get(slot_id, 0)) == 80 and int(import_count_by_slot.get(slot_id, 0)) == 80 and int(texture_loaded_by_slot.get(slot_id, 0)) >= 4
	var land_manifest_untouched := _mainline_visual_smoke_land_manifest_excludes_naval_slots(expected_slots)
	var preview_ok := all_slots_ready and visible_slot_count == expected_slots.size()
	var summary := {
		"attempted": true,
		"ok": preview_ok and str(manifest.get("status", "")) == "frame_batch_ready_pending_runtime_adapter" and str(policy.get("connectionStatus", "")) == "brief_only_not_connected_to_runtime_unit_marker" and land_manifest_untouched,
		"worldSeaOverseasNavalFramePreviewOk": preview_ok,
		"worldSeaOverseasNavalFramePreviewContract": SEA_OVERSEAS_NAVAL_FRAME_PREVIEW_CONTRACT,
		"worldSeaOverseasNavalFramePreviewVisibleSlotCount": visible_slot_count,
		"worldSeaOverseasNavalFramePreviewSlots": slots_summary,
		"worldSeaOverseasNavalFramePreviewFrameCountBySlot": frame_count_by_slot,
		"worldSeaOverseasNavalFramePreviewImportCountBySlot": import_count_by_slot,
		"worldSeaOverseasNavalFramePreviewTextureLoadedBySlot": texture_loaded_by_slot,
		"worldSeaOverseasNavalFramePreviewManifestStatus": str(manifest.get("status", "")),
		"worldSeaOverseasNavalFramePreviewConnectionStatus": str(policy.get("connectionStatus", "")),
		"worldSeaOverseasNavalFramePreviewLandManifestUntouched": land_manifest_untouched,
		"worldSeaOverseasNavalFramePreviewDoesNotUseUnitMarker": true,
		"worldSeaOverseasNavalFramePreviewRuntimeAdapterStatus": "preview_only_pending_runtime_adapter",
	}
	_record_last_action("world_sea_overseas_naval_frame_preview", "ok" if bool(summary.get("ok", false)) else "contract_failed")
	return summary


func _read_mainline_visual_smoke_naval_frame_manifest() -> Dictionary:
	var file := FileAccess.open(SEA_OVERSEAS_NAVAL_FRAME_MANIFEST_PATH, FileAccess.READ)
	if file == null:
		return {}
	var parsed: Variant = JSON.parse_string(file.get_as_text())
	if parsed is Dictionary:
		return parsed as Dictionary
	return {}


func _find_mainline_visual_smoke_naval_body_by_slot(bodies: Array, slot_id: String) -> Dictionary:
	for body_variant in bodies:
		if body_variant is Dictionary:
			var body := body_variant as Dictionary
			if str(body.get("slotId", "")) == slot_id:
				return body
	return {}


func _load_mainline_visual_smoke_naval_png_texture(path_value: String) -> Texture2D:
	var normalized_path := path_value.strip_edges()
	if normalized_path == "":
		return null
	if normalized_path.ends_with(".png"):
		var png_load_path := normalized_path
		if normalized_path.begins_with("res://"):
			png_load_path = ProjectSettings.globalize_path(normalized_path)
		elif not FileAccess.file_exists(png_load_path):
			png_load_path = ProjectSettings.globalize_path("res://../%s" % normalized_path)
		if FileAccess.file_exists(png_load_path):
			var png_image := Image.new()
			if png_image.load(png_load_path) == OK:
				return ImageTexture.create_from_image(png_image)
	if ResourceLoader.exists(normalized_path):
		var resource := load(normalized_path)
		if resource is Texture2D:
			return resource as Texture2D
	return null


