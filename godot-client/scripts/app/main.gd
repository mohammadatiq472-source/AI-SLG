func _augment_shell_troop_slots_with_position(slot_payloads: Array, troop_specs: Array) -> Array:
	var result: Array = slot_payloads.duplicate(true)
	for index in range(result.size()):
		if not (result[index] is Dictionary):
			continue
		var slot: Dictionary = (result[index] as Dictionary).duplicate(true)
		var spec: Dictionary = {}
		if index < troop_specs.size() and troop_specs[index] is Dictionary:
			spec = troop_specs[index] as Dictionary
		var troop_id := str(slot.get("id", spec.get("id", ""))).strip_edges()
		var unit := _find_target_unit_by_id(troop_id)
		var tile_id := str(unit.get("tileId", spec.get("tileId", ""))).strip_edges()
		slot["tileId"] = tile_id
		slot["hasMapPosition"] = tile_id != ""
		slot["jumpActionId"] = "world_left_troop_rail_jump_to_unit_fixture" if tile_id != "" else ""
		slot["jumpActionNodeName"] = "TroopSlot%02dButton" % (index + 1) if tile_id != "" else ""
		result[index] = slot
	return result

