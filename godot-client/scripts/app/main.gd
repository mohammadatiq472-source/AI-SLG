func _press_mainline_visual_smoke_generals_secondary_page(expected_page_id: String, close_after_open: bool) -> Dictionary:
	var resolved_page_id := expected_page_id.strip_edges()
	var expected_tab_label := ""
	match resolved_page_id:
		"tactics":
			expected_tab_label = "配点"
		"growth":
			expected_tab_label = "兵种"
		"profile":
			expected_tab_label = "详情"
		_:
			return {
				"attempted": true,
				"ok": false,
				"clicked": false,
				"reason": "general_secondary_page_unknown",
				"expectedPanelId": "generals",
