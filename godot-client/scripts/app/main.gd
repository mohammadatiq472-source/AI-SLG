	}


func _nation_midgame_route_label_has_engineering_copy(text: String) -> bool:
	var normalized := text.strip_edges().to_lower()
	if normalized == "":
		return true
	for forbidden in ["tier", "contract", "read model", "kingdom_progress_state", "authority", "sourcepageid", "targetlabel", "neutral", "v0"]:
		if normalized.find(forbidden) >= 0:
			return true
	return normalized.find("_") >= 0


func _nation_midgame_visible_copy_forbidden_hits(text: String) -> Array[String]:
	var normalized := text.strip_edges().to_lower()
	var hits: Array[String] = []
	for forbidden in ["tier", "contract", "read model", "kingdom_progress_state", "authority", "sourcepageid", "targetlabel", "neutral", "v0"]:
		if normalized.find(forbidden) >= 0:
			hits.append(forbidden)
	if normalized.find("_") >= 0:
		hits.append("snake_case")
	return hits


