func _read_mainline_visual_smoke_nation_midgame_summary_read_model_ok(page_summary: Dictionary, objective_row_count: int) -> bool:
	var skeleton_contract_ok := str(page_summary.get("organizationNationMidgameFrontendContractId", "")) == "nation_midgame_frontend_skeleton_v1"
	var war_contract_ok := str(page_summary.get("organizationNationWarObjectiveContractId", "")) == "nation_war_objective_read_model_v1"
	var skeleton_objectives_ok := skeleton_contract_ok and objective_row_count >= 5
	var organizationNationMidgameEmpireInfoVisible := bool(page_summary.get("organizationNationMidgameEmpireInfoVisible", false)) or objective_row_count >= 5
	return war_contract_ok or (skeleton_objectives_ok and organizationNationMidgameEmpireInfoVisible)


