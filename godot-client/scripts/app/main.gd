func _run_click_priority_protected_object_matrix() -> Dictionary:
	var matrix_source: Dictionary = {}
	if _map_grid != null and _map_grid.has_method("build_click_priority_matrix_samples"):
		var matrix_variant: Variant = _map_grid.call("build_click_priority_matrix_samples")
		if matrix_variant is Dictionary:
			matrix_source = matrix_variant as Dictionary
	var source_samples: Array = matrix_source.get("protectedSamples", []) as Array
	var unavailable_samples: Array = matrix_source.get("unavailableProtectedSamples", []) as Array
	var samples: Array = []
	var protected_screenshot: Dictionary = {}
	var protected_ok_count := 0
	var protected_index := 0
	for sample_variant in source_samples:
		if not (sample_variant is Dictionary):
			continue
		var sample: Dictionary = sample_variant as Dictionary
		var context := await _select_click_priority_protected_sample(sample)
		var sample_summary := _build_click_priority_matrix_protected_sample(sample, context)
		if bool(sample_summary.get("ok", false)):
			protected_ok_count += 1
		if protected_index == 0:
			protected_screenshot = _save_mainline_visual_smoke_screenshot(_mainline_visual_smoke_aux_screenshot_path("01_click_priority_protected.png"))
			sample_summary["screenshot"] = protected_screenshot
		samples.append(sample_summary)
		protected_index += 1
	return {
		"ok": protected_ok_count >= 1 and protected_ok_count == samples.size(),
		"protectedFootprintVetoOk": protected_ok_count >= 1 and protected_ok_count == samples.size(),
		"protectedOkCount": protected_ok_count,
		"samples": samples,
		"unavailableSamples": unavailable_samples,
		"requiredSamples": matrix_source.get("requiredProtectedSamples", []),
		"presentSampleIds": _collect_click_priority_present_protected_sample_ids(samples),
		"missingSampleIds": _collect_click_priority_missing_protected_sample_ids(matrix_source.get("requiredProtectedSamples", []), samples, unavailable_samples),
		"protectedScreenshot": protected_screenshot,
		"source": matrix_source,
	}

func _collect_click_priority_present_protected_sample_ids(samples: Array) -> Array:
	var present: Array = []
	for sample_variant in samples:
		if not (sample_variant is Dictionary):
			continue
		var sample: Dictionary = sample_variant as Dictionary
		if not bool(sample.get("ok", false)):
			continue
		var sample_id := str(sample.get("sampleId", "")).strip_edges()
		if sample_id != "" and not present.has(sample_id):
			present.append(sample_id)
	return present

func _collect_click_priority_missing_protected_sample_ids(required_samples: Array, samples: Array, unavailable_samples: Array) -> Array:
	var present := _collect_click_priority_present_protected_sample_ids(samples)
	var missing: Array = []
	for sample_id_variant in required_samples:
		var sample_id := str(sample_id_variant).strip_edges()
		if sample_id != "" and not present.has(sample_id) and not missing.has(sample_id):
			missing.append(sample_id)
	for unavailable_variant in unavailable_samples:
		if not (unavailable_variant is Dictionary):
			continue
		var unavailable: Dictionary = unavailable_variant as Dictionary
		var sample_id := str(unavailable.get("sampleId", "")).strip_edges()
		if sample_id != "" and not missing.has(sample_id):
			missing.append(sample_id)
	return missing

func _select_click_priority_protected_sample(sample: Dictionary) -> Dictionary:
	if _map_grid == null or not is_instance_valid(_map_grid):
		return {}
	var context: Dictionary = {}
	if _map_grid.has_method("focus_and_select_main_map_tmx_for_action"):
		var tmx_x := int(sample.get("tmxX", -1))
		var tmx_y := int(sample.get("tmxY", -1))
		if tmx_x >= 0 and tmx_y >= 0:
			var context_variant: Variant = _map_grid.call("focus_and_select_main_map_tmx_for_action", tmx_x, tmx_y)
			if context_variant is Dictionary:
				context = context_variant as Dictionary
	if context.is_empty():
		context = await _focus_select_main_map_cell_for_action_with_viewport_refresh(int(sample.get("cellX", -1)), int(sample.get("cellY", -1)))
	await get_tree().process_frame
	await get_tree().process_frame
	_sync_selected_main_map_cell_context_from_map_grid()
	return _resolve_selected_main_map_cell_context()

