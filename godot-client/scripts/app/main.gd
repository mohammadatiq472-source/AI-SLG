func _record_active_alliance_nation_profile_rejection(action_result: Dictionary, nation_name: String, color_hex: String) -> void:
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return
	if not _active_overlay_panel.has_method("record_nation_profile_governance_rejection"):
		return
	_active_overlay_panel.call("record_nation_profile_governance_rejection", _extract_nation_profile_update_rejection(action_result, nation_name, color_hex))


func _extract_nation_profile_update_rejection(action_result: Dictionary, nation_name: String, color_hex: String) -> Dictionary:
	var remote_result_variant: Variant = action_result.get("remote_result", {})
	var remote_result: Dictionary = {}
	if remote_result_variant is Dictionary:
		remote_result = remote_result_variant as Dictionary
	var response_data_variant: Variant = remote_result.get("data", {})
	var response_data: Dictionary = {}
	if response_data_variant is Dictionary:
		response_data = response_data_variant as Dictionary
	var failure_code := str(action_result.get("failure_code", response_data.get("failureCode", ""))).strip_edges()
	var conflict_faction_id := str(action_result.get("conflicting_faction_id", response_data.get("conflictingFactionId", ""))).strip_edges()
	var conflict_nation_name := str(action_result.get("conflicting_nation_name", response_data.get("conflictingNationName", ""))).strip_edges()
	return {
		"failureCode": failure_code,
		"retryAfterMs": int(action_result.get("retry_after_ms", response_data.get("retryAfterMs", 0))),
		"conflictingFactionId": conflict_faction_id,
		"conflictingNationName": conflict_nation_name,
		"nationName": nation_name,
		"colorHex": color_hex,
		"message": str(response_data.get("message", action_result.get("error", ""))).strip_edges(),
		"recordedAt": Time.get_datetime_string_from_system(true),
	}


