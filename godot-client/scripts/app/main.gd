func _format_ai_activity_card_source_copy(open_source: String) -> String:
	match open_source.strip_edges().to_lower():
		"marker":
			return "地图热点"
		"badge":
			return "活动提醒"
		"list":
			return "活动列表"
		_:
			return "活动线索"


func _merge_ai_activity_marker_payload_into_card_payload(base_payload: Dictionary, marker_payload: Dictionary) -> Dictionary:
	var payload := base_payload.duplicate(true)
	var activity_event_id := str(marker_payload.get("activityEventId", "")).strip_edges()
	var map_target_tile_id := str(marker_payload.get("mapTargetTileId", marker_payload.get("tileId", ""))).strip_edges()
	var raw_jump_target: Variant = marker_payload.get("jumpTarget", {})
	var jump_target: Dictionary = raw_jump_target.duplicate(true) if raw_jump_target is Dictionary else {}
	var raw_source_ref: Variant = marker_payload.get("sourceRef", {})
	var source_ref: Dictionary = raw_source_ref.duplicate(true) if raw_source_ref is Dictionary else {}
	payload["activityEventId"] = activity_event_id
	payload["mapTargetTileId"] = map_target_tile_id
	payload["jumpTarget"] = jump_target
	payload["sourceRef"] = source_ref
	var title_text := str(marker_payload.get("title", "")).strip_edges()
	if title_text != "":
		payload["titleText"] = title_text
	var summary_text := str(marker_payload.get("summary", "")).strip_edges()
	if summary_text != "":
		payload["resultText"] = summary_text
	var target_label := str(jump_target.get("label", marker_payload.get("label", ""))).strip_edges()
	if target_label == "" and map_target_tile_id != "":
		target_label = map_target_tile_id
	if target_label != "":
		payload["targetText"] = "目标：%s" % target_label
	var trace_id := str(marker_payload.get("traceId", "")).strip_edges()
	if trace_id != "":
		payload["traceId"] = trace_id
	return payload


func _resolve_ai_activity_card_jump_target_id(jump_target: Dictionary) -> String:
	var target_id := str(jump_target.get("targetId", "")).strip_edges()
	if target_id == "":
		target_id = str(jump_target.get("target_id", "")).strip_edges()
	return target_id


func _is_ai_activity_card_jump_target_ready(jump_target: Dictionary, map_target_tile_id: String) -> bool:
	var surface := str(jump_target.get("surface", "")).strip_edges()
	var target_id := _resolve_ai_activity_card_jump_target_id(jump_target)
	if surface != "world_map" or target_id == "":
		return false
	return map_target_tile_id == "" or target_id == map_target_tile_id


func _build_ai_activity_card_focus_expectation(jump_target: Dictionary, map_target_tile_id: String) -> Dictionary:
	var target_id := _resolve_ai_activity_card_jump_target_id(jump_target)
	var surface := str(jump_target.get("surface", "")).strip_edges()
	var label := str(jump_target.get("label", "")).strip_edges()
	var ready := _is_ai_activity_card_jump_target_ready(jump_target, map_target_tile_id)
	return {
		"ready": ready,
		"surface": surface,
		"targetId": target_id,
		"mapTargetTileId": map_target_tile_id,
		"label": label,
		"requiresRuntimeClick": true,
		"focusPerformed": false,
		"reason": "jump_target_ready_pending_runtime_click" if ready else "jump_target_not_ready",
	}


func _resolve_ai_activity_focus_target_tile_id(payload: Dictionary) -> String:
	var raw_jump_target: Variant = payload.get("jumpTarget", {})
	var jump_target: Dictionary = raw_jump_target as Dictionary if raw_jump_target is Dictionary else {}
	var map_target_tile_id := str(payload.get("mapTargetTileId", payload.get("tileId", ""))).strip_edges()
	var jump_target_tile_id := _resolve_ai_activity_card_jump_target_id(jump_target)
	var jump_surface := str(jump_target.get("surface", "")).strip_edges()
	if jump_surface == "world_map" and jump_target_tile_id != "":
		return jump_target_tile_id
	return map_target_tile_id


func _resolve_ai_activity_payload_source_ref_request_id(payload: Dictionary) -> String:
	var raw_source_ref: Variant = payload.get("sourceRef", {})
	if raw_source_ref is Dictionary:
		return str((raw_source_ref as Dictionary).get("requestId", "")).strip_edges()
	return ""


func _focus_ai_activity_target_from_payload(payload: Dictionary) -> Dictionary:
	var focus_target_tile_id := _resolve_ai_activity_focus_target_tile_id(payload)
	var source_ref_request_id := _resolve_ai_activity_payload_source_ref_request_id(payload)
	if focus_target_tile_id == "":
		return {
			"attempted": true,
			"ok": false,
			"performed": false,
			"reason": "ai_activity_focus_target_missing",
			"focusTargetTileId": "",
			"sourceRefRequestId": source_ref_request_id,
		}
	var focus_result := await _focus_mainline_visual_smoke_map_unit_tile(focus_target_tile_id)
	var performed := bool(focus_result.get("ok", false))
	return {
		"attempted": true,
		"ok": performed,
		"performed": performed,
		"reason": "ai_activity_focus_applied" if performed else str(focus_result.get("reason", "ai_activity_focus_failed")),
		"focusTargetTileId": focus_target_tile_id,
		"sourceRefRequestId": source_ref_request_id,
		"focusResult": focus_result,
	}


func _open_ai_activity_card_and_focus_from_marker_payload(marker_payload: Dictionary) -> void:
	var payload := marker_payload.duplicate(true)
	_open_ai_activity_card_from_execution_trace("marker", payload)
	_ai_activity_card_last_focus_result = await _focus_ai_activity_target_from_payload(payload)


