	if submit_button.disabled:
		return {
			"attempted": true,
			"ok": false,
			"clicked": true,
			"reason": "nation_capital_migrate_submit_button_disabled",
			"panelResult": page_result,
			"beforeSummary": before_summary,
		}
	submit_button.emit_signal("pressed")
	var receipt := {}
	var started_at := Time.get_ticks_msec()
	while Time.get_ticks_msec() - started_at < 9000:
		receipt = _runtime_action_receipt.duplicate(true)
		if str(receipt.get("source_action", "")).strip_edges() == "migrateCapital":
