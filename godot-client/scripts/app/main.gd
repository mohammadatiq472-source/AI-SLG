func _collect_click_priority_matrix_forbidden_hits(samples: Array) -> Array:
	var texts: Array[String] = []
	for sample_variant in samples:
		if not (sample_variant is Dictionary):
			continue
		var sample: Dictionary = sample_variant as Dictionary
		var visible_variant: Variant = sample.get("visibleText", [])
		if visible_variant is Array:
			for text_variant in visible_variant as Array:
				texts.append(str(text_variant))
	var hits := _collect_world_tile_action_visible_copy_forbidden_hits(texts)
	var all_text := " ".join(texts).to_lower()
	for term in ["neutral", "v0", "snake_case", "read model", "authority", "tier", "backend", "contract id"]:
		if all_text.find(term) >= 0 and not hits.has(term):
			hits.append(term)
	return hits

func _merge_world_tile_action_hud_smoke_result(base_result: Dictionary, summary: Dictionary) -> Dictionary:
