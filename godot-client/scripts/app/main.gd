func _read_mainline_visual_smoke_ai_context_focus_state(ai_player_id: String = "ai_player_jihan_vanguard") -> Dictionary:
	var normalized_ai_player_id := ai_player_id.strip_edges()
	if normalized_ai_player_id == "":
		normalized_ai_player_id = "ai_player_jihan_vanguard"
	if WorldStore == null:
		return {}
	if WorldStore.has_method("get_ai_player_state"):
		var local_ai_player_state: Dictionary = WorldStore.get_ai_player_state(normalized_ai_player_id)
		if not local_ai_player_state.is_empty():
			return local_ai_player_state.duplicate(true)
	var world: Dictionary = WorldStore.world
	var slg_domain_state: Dictionary = world.get("slgDomainState", {}) as Dictionary
	var ai_state_by_player_id: Dictionary = slg_domain_state.get("aiStateByPlayerId", {}) as Dictionary
	var ai_player_state: Dictionary = ai_state_by_player_id.get(normalized_ai_player_id, {}) as Dictionary
	if not ai_player_state.is_empty():
		return ai_player_state.duplicate(true)
	var ai_state_by_faction: Dictionary = slg_domain_state.get("aiStateByFaction", {}) as Dictionary
	return (ai_state_by_faction.get(_target_faction_id, {}) as Dictionary).duplicate(true)


