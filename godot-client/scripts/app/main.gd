			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "general_secondary_overlay_missing",
			"expectedPanelId": "generals",
			"expectedPageId": resolved_page_id,
			"profileResult": profile_result,
		}
	var tab_button := _find_mainline_visual_smoke_visible_button_by_meta(_active_overlay_panel, "general_profile_tab_page_id", resolved_page_id)
	if tab_button == null:
		tab_button = _find_mainline_visual_smoke_visible_button_by_text(_active_overlay_panel, expected_tab_label)
	if tab_button == null:
		var missing_summary := _read_mainline_visual_smoke_overlay_page_summary("generals", _read_mainline_visual_smoke_active_overlay_page_id())
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "general_secondary_tab_button_missing",
			"expectedPanelId": "generals",
			"expectedPageId": resolved_page_id,
			"expectedTabLabel": expected_tab_label,
			"pageContentSummary": missing_summary,
			"profileResult": profile_result,
		}
	var clicked_label := str(tab_button.get_meta("general_profile_tab_live_text_label", tab_button.text)).strip_edges()
	var clicked_token := str(tab_button.get_meta("general_profile_tab_button_token", "")).strip_edges()
	var clicked_contract := str(tab_button.get_meta("general_profile_tab_live_text_contract", "")).strip_edges()
	var clicked_page_id := str(tab_button.get_meta("general_profile_tab_page_id", resolved_page_id)).strip_edges()
