func _read_tianxia_yutu_player_nation_runtime_profile() -> Dictionary:
	var raw_runtime_color_entries: Variant = _tianxia_yutu_faction_color_layer.get("current_runtime_color_entries", [])
	if raw_runtime_color_entries is Array:
		var runtime_color_entries := raw_runtime_color_entries as Array
		for entry_variant in runtime_color_entries:
			if not (entry_variant is Dictionary):
				continue
			var entry: Dictionary = entry_variant as Dictionary
			if str(entry.get("faction_id", "")).strip_edges() != _target_faction_id:
				continue
			var nation_name := str(entry.get("nation_name", "")).strip_edges()
			var color_hex := str(entry.get("color_hex", "")).strip_edges().to_lower()
			if nation_name == "" and color_hex == "":
				continue
			return {
				"nationName": nation_name,
				"colorHex": color_hex,
			}
	return {}


func _collect_visible_text_controls(target_texts: Array) -> Array:
	var results: Array = []
	var targets: Dictionary = {}
	for target_variant in target_texts:
		var target: String = str(target_variant).strip_edges()
		if target != "":
			targets[target] = true
	_collect_visible_text_controls_recursive(get_tree().root, targets, results)
	return results


func _collect_visible_text_controls_recursive(node: Node, targets: Dictionary, results: Array) -> void:
	if node == null:
		return
	var control := node as Control
	if control != null and control.visible and control.is_visible_in_tree():
		var text_value := ""
		if node is Button:
			text_value = (node as Button).text.strip_edges()
		elif node is Label:
			text_value = (node as Label).text.strip_edges()
		if targets.has(text_value):
			var rect := control.get_global_rect()
			results.append({
				"name": node.name,
				"class": node.get_class(),
				"text": text_value,
				"rect": {"x": rect.position.x, "y": rect.position.y, "w": rect.size.x, "h": rect.size.y},
			})
	for child in node.get_children():
		_collect_visible_text_controls_recursive(child, targets, results)


