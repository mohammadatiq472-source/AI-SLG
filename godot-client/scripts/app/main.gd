func _press_mainline_visual_smoke_main_city_hub_jump_coordinate() -> Dictionary:
	var open_result := await _ensure_mainline_visual_smoke_main_city_hub_expanded()
	var hub_summary: Dictionary = open_result.get("mainCityHub", {}) as Dictionary
	var before_jump_count: int = _coordinate_jump_count
	var before_tianxia_jump_count: int = _tianxia_yutu_explicit_jump_count
	var button := _find_mainline_visual_smoke_visible_button(_main_city_hub_overlay, "MainCityHubCoordinateJumpButton")
	if button == null:
		return {
			"attempted": true,
			"ok": false,
			"clicked": false,
			"reason": "main_city_hub_coordinate_jump_button_missing",
			"openResult": open_result,
			"mainCityHub": hub_summary,
		}
	button.emit_signal("pressed")
	var deadline_msec: int = Time.get_ticks_msec() + 6000
	while Time.get_ticks_msec() < deadline_msec and _coordinate_jump_count <= before_jump_count:
		await get_tree().create_timer(0.1).timeout
	var jump_result := _last_coordinate_jump.duplicate(true)
	var tianxia_summary := _read_tianxia_yutu_explicit_jump_summary()
	var last_explicit_jump: Dictionary = tianxia_summary.get("lastExplicitJump", {}) as Dictionary
	var source_payload: Dictionary = jump_result.get("sourcePayload", {}) as Dictionary
	var ok: bool = (
		bool(open_result.get("ok", false))
		and bool(hub_summary.get("hubCoordinateJumpButtonVisible", false))
		and _coordinate_jump_count > before_jump_count
		and _tianxia_yutu_explicit_jump_count > before_tianxia_jump_count
		and bool(jump_result.get("ok", false))
		and bool(last_explicit_jump.get("ok", false))
		and str(source_payload.get("source", "")) == "main_city_hub"
	)
	return {
		"attempted": true,
		"ok": ok,
		"clicked": true,
		"reason": "main_city_hub_coordinate_jump_ok" if ok else "main_city_hub_coordinate_jump_failed",
		"openResult": open_result,
		"mainCityHub": hub_summary,
		"jumpButtonVisibleBefore": true,
		"coordinateJumpCountBefore": before_jump_count,
		"coordinateJumpCountAfter": _coordinate_jump_count,
		"tianxiaExplicitJumpCountBefore": before_tianxia_jump_count,
		"tianxiaExplicitJumpCountAfter": _tianxia_yutu_explicit_jump_count,
		"jumpResult": jump_result,
		"tianxiaYutuExplicitJump": tianxia_summary,
	}


