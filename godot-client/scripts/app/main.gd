	var all_rows_ok := true
	var row_ids: Array = []
	for row_variant in rows:
		if not (row_variant is Dictionary):
			all_rows_ok = false
			continue
		var row: Dictionary = row_variant as Dictionary
		all_rows_ok = all_rows_ok and bool(row.get("ok", false))
		row_ids.append(str(row.get("rowId", "")))
	return {
		"attempted": true,
		"ok": all_rows_ok and not rows.is_empty(),
		"reason": "tianxia_yutu_navigation_matrix_qa" if all_rows_ok and not rows.is_empty() else "tianxia_yutu_navigation_matrix_qa_failed",
		"mobileViewport": mobile_viewport,
		"rowIds": row_ids,
		"rows": rows,
		"setup": setup,
	}


