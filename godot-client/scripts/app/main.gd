func _request_tianxia_yutu_scale_preset_refresh() -> void:
	var query_params: Dictionary = _build_tianxia_yutu_overview_query_params()
	var request_key: String = _build_map_layout_request_key(_active_map_scope, query_params)
	var refresh_ok: bool = await _refresh_viewport_map_layout_immediate(query_params, request_key)
	var layer: Dictionary = _extract_tianxia_yutu_overview_layer(WorldStore.map_layout)
	if not layer.is_empty():
		_apply_tianxia_yutu_overview_layer(layer)
	_record_last_action("tianxia_yutu/scale/%s" % _tianxia_yutu_scale_preset_id, "loaded" if refresh_ok else "failed")
	_refresh_tianxia_yutu_jump_panel()

