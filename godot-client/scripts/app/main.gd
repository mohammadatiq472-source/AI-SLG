func _press_mainline_visual_smoke_tianxia_yutu_navigation_matrix_qa() -> Dictionary:
	var setup: Dictionary = await _prepare_mainline_visual_smoke_tianxia_yutu_panel()
	if not bool(setup.get("ok", false)):
		return {
			"attempted": true,
			"ok": false,
			"reason": "tianxia_yutu_navigation_matrix_setup_failed",
			"setup": setup,
		}
	var mobile_viewport := _is_tianxia_yutu_mobile_viewport()
	var rows: Array = []
	if mobile_viewport:
		_tianxia_yutu_navigation_panel_expanded = false
		_tianxia_yutu_navigation_panel_collapsed = false
