func _press_mainline_visual_smoke_first_hour_task_claim_prompt_gate() -> Dictionary:
	var target_task_id := "huangtian_task_02_prepare_supplies"
	_open_overlay_panel_with_page("tasks", "tasks")
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(0.45).timeout
	var before_state: Dictionary = {}
	for _i in range(16):
		before_state = await _read_first_hour_task_claim_prompt_state(target_task_id)
		var before_task: Dictionary = before_state.get("task", {}) as Dictionary
		if str(before_task.get("claimState", "")).strip_edges() == "claimable" and bool(before_state.get("claimButtonVisible", false)) and not bool(before_state.get("claimButtonDisabled", true)):
			break
		await get_tree().create_timer(0.25).timeout
	var task_before: Dictionary = before_state.get("task", {}) as Dictionary
	var claim_state_before := str(task_before.get("claimState", "")).strip_edges()
	var prompt_visible := claim_state_before == "claimable" and bool(before_state.get("claimButtonVisible", false)) and not bool(before_state.get("claimButtonDisabled", true))
	var expected_reward_resources := _sum_task_reward_preview_resources(task_before)
	var before_resource_snapshot := await _read_target_faction_resource_snapshot_for_smoke()
	var before_resources: Dictionary = before_resource_snapshot.get("resources", {}) as Dictionary
	var claim_button := before_state.get("claimButton", null) as Button
	var task_claim_button_pressed := false
	if prompt_visible and claim_button != null:
		claim_button.emit_signal("pressed")
		task_claim_button_pressed = true
	await get_tree().process_frame
	await get_tree().process_frame
	var after_state: Dictionary = {}
	for _i in range(20):
		after_state = await _read_first_hour_task_claim_prompt_state(target_task_id)
		var after_task_candidate: Dictionary = after_state.get("task", {}) as Dictionary
		if str(after_task_candidate.get("claimState", "")).strip_edges() == "claimed":
			break
		await get_tree().create_timer(0.25).timeout
	var task_after: Dictionary = after_state.get("task", {}) as Dictionary
	var claim_state_after := str(task_after.get("claimState", "")).strip_edges()
	var after_tasks_model: Dictionary = after_state.get("tasksModel", {}) as Dictionary
	var after_world_tasks: Dictionary = after_tasks_model.get("worldTasks", {}) as Dictionary
	var next_task_after_claim := _find_next_first_hour_task_after_claim(after_world_tasks, target_task_id)
	var next_task_after_claim_guidance_ok := _task_has_next_action_guidance(next_task_after_claim)
	var next_task_after_claim_title := str(next_task_after_claim.get("title", "")).strip_edges()
	var next_task_after_claim_visible_hits: Array = []
	if next_task_after_claim_title != "" and _active_overlay_panel != null and is_instance_valid(_active_overlay_panel):
		next_task_after_claim_visible_hits = _collect_mainline_visual_smoke_visible_text_hits(_active_overlay_panel, [next_task_after_claim_title])
	var next_task_after_claim_visible := not next_task_after_claim_visible_hits.is_empty()
	var after_resource_snapshot := await _read_target_faction_resource_snapshot_for_smoke()
	var after_resources: Dictionary = after_resource_snapshot.get("resources", {}) as Dictionary
	var reward_resource_delta := _diff_task_claim_resource_snapshots(before_resources, after_resources)
	var reward_resources_applied_ok := (
		bool(before_resource_snapshot.get("ok", false))
		and bool(after_resource_snapshot.get("ok", false))
		and _task_claim_reward_resources_applied(expected_reward_resources, reward_resource_delta)
	)
	var current_goals_result: Dictionary = await _api_client.get_current_goals(_target_faction_id)
	var current_goals_payload: Dictionary = current_goals_result.get("data", {}) as Dictionary
	var current_goals: Dictionary = current_goals_payload.get("currentGoals", {}) as Dictionary
	var visible_forbidden_hits: Array = after_state.get("forbiddenHits", []) as Array
	var claim_feedback_visible := bool(after_state.get("feedbackVisible", false)) or claim_state_after == "claimed"
	var resource_progress_still_ok := prompt_visible
	var ok := (
		prompt_visible
		and task_claim_button_pressed
		and claim_state_before == "claimable"
		and claim_state_after == "claimed"
		and claim_feedback_visible
		and resource_progress_still_ok
		and reward_resources_applied_ok
		and next_task_after_claim_guidance_ok
		and next_task_after_claim_visible
		and bool(current_goals_result.get("ok", false))
		and not current_goals.is_empty()
		and visible_forbidden_hits.is_empty()
	)
	var summary: Dictionary = (after_state.get("panelSummary", {}) as Dictionary).duplicate(true)
	summary["firstHourTaskClaimPromptOk"] = ok
	summary["firstHourTaskClaimPromptVisible"] = prompt_visible
	summary["firstHourTaskClaimPromptScope"] = "resource_occupation_claimable_task_prompt_and_real_claim_button_only"
	summary["taskId"] = target_task_id
	summary["claimState"] = claim_state_before
	summary["taskClaimAfterState"] = claim_state_after
	summary["taskClaimButtonVisible"] = bool(before_state.get("claimButtonVisible", false))
	summary["taskClaimButtonDisabled"] = bool(before_state.get("claimButtonDisabled", true))
	summary["taskClaimButtonText"] = str(before_state.get("claimButtonText", "")).strip_edges()
	summary["taskClaimButtonPressed"] = task_claim_button_pressed
	summary["taskClaimFeedbackVisible"] = claim_feedback_visible
	summary["taskClaimVisibleCopyForbiddenHits"] = visible_forbidden_hits
	summary["playerVisibleEngineeringCopyLeak"] = not visible_forbidden_hits.is_empty()
	summary["taskClaimRewardPreviewResources"] = expected_reward_resources
	summary["taskClaimResourceBefore"] = before_resources
	summary["taskClaimResourceAfter"] = after_resources
	summary["taskClaimResourceDelta"] = reward_resource_delta
	summary["taskClaimRewardResourcesAppliedOk"] = reward_resources_applied_ok
	summary["nextTaskAfterClaim"] = next_task_after_claim
	summary["nextTaskAfterClaimVisible"] = next_task_after_claim_visible
	summary["nextTaskAfterClaimVisibleHits"] = next_task_after_claim_visible_hits
	summary["nextTaskAfterClaimGuidanceOk"] = next_task_after_claim_guidance_ok
	summary["nextTaskAfterClaimId"] = str(next_task_after_claim.get("taskId", "")).strip_edges()
	summary["nextTaskAfterClaimTitle"] = next_task_after_claim_title
	summary["nextTaskAfterClaimActionHint"] = str(next_task_after_claim.get("actionHint", "")).strip_edges()
	summary["nextTaskAfterClaimActionTarget"] = next_task_after_claim.get("actionTarget", {})
	summary["resourceOccupationTaskProgressStillOk"] = resource_progress_still_ok
	summary["currentGoalsReadbackOk"] = bool(current_goals_result.get("ok", false)) and not current_goals.is_empty()
	summary["currentGoalsReadModelOnly"] = true
	summary["tasksPanelReadModelLoaded"] = bool((after_state.get("panelSummary", {}) as Dictionary).get("readModelLoaded", false))
	summary["taskClaimBeforeTask"] = task_before
	summary["taskClaimAfterTask"] = task_after
	summary["taskClaimFeedbackHits"] = after_state.get("feedbackHits", [])
	var result: Dictionary = {
		"attempted": true,
		"clicked": task_claim_button_pressed,
		"panelId": "world_event",
	}
	for key in summary.keys():
		result[key] = summary.get(key)
	result["ok"] = ok
	result["reason"] = "first_hour_task_claim_prompt_claimed" if ok else "first_hour_task_claim_prompt_failed"
	result["pageContentOk"] = ok
	result["pageContentSummary"] = summary
	result["tasksPanelSummary"] = after_state.get("panelSummary", {})
	return result

func _read_mainworld_camera_pan_roundtrip_state() -> Dictionary:
	var center_cell: Dictionary = {}
	var view_transform_state: Dictionary = {}
	var camera_query: Dictionary = {}
	var streaming_summary: Dictionary = _read_main_map_streaming_debug_summary()
	if _map_grid != null and is_instance_valid(_map_grid):
		if _map_grid.has_method("get_view_transform_state"):
			var view_variant: Variant = _map_grid.call("get_view_transform_state")
			if view_variant is Dictionary:
				view_transform_state = (view_variant as Dictionary).duplicate(true)
				var center_variant: Variant = view_transform_state.get("centerCell", {})
				if center_variant is Dictionary:
					center_cell = (center_variant as Dictionary).duplicate(true)
		if center_cell.is_empty() and _map_grid.has_method("get_view_center_cell_1km"):
			var center_result: Variant = _map_grid.call("get_view_center_cell_1km")
			if center_result is Dictionary:
				center_cell = (center_result as Dictionary).duplicate(true)
		if _map_grid.has_method("get_camera_viewport_query_params"):
			var query_variant: Variant = _map_grid.call("get_camera_viewport_query_params")
			if query_variant is Dictionary:
				camera_query = (query_variant as Dictionary).duplicate(true)
	var loaded_chunk_ids: Array = _viewport_loaded_chunk_ids.duplicate(true)
	if loaded_chunk_ids.is_empty():
		var streaming_loaded_variant: Variant = streaming_summary.get("loadedChunkIds", [])
		if streaming_loaded_variant is Array:
			loaded_chunk_ids = (streaming_loaded_variant as Array).duplicate(true)
	if loaded_chunk_ids.is_empty():
		loaded_chunk_ids = _extract_loaded_chunk_ids(WorldStore.map_layout)
	if loaded_chunk_ids.is_empty() and not center_cell.is_empty():
		var center_x: int = int(center_cell.get("cellX", center_cell.get("x", 0)))
		var center_y: int = int(center_cell.get("cellY", center_cell.get("y", 0)))
		if center_x != 0 or center_y != 0:
			loaded_chunk_ids.append("chunk_y%03d_x%03d" % [int(center_y / 64), int(center_x / 64)])
	return {
		"mapVisible": _display_mode == DISPLAY_MODE_WORLD and _map_grid != null and is_instance_valid(_map_grid) and bool(_map_grid.visible),
		"centerCell": center_cell,
		"viewTransformState": view_transform_state,
		"cameraQuery": camera_query,
		"viewportLoadedChunkIds": loaded_chunk_ids,
		"streamingSummary": streaming_summary,
	}

