func _collect_ai_activity_trace_items_from_world_state() -> Array:
	var ai_state := WorldStore.get_ai_state(_target_faction_id)
	var trace_items_variant: Variant = ai_state.get("playerRuntimeExecutionTraceItems", [])
	if trace_items_variant is Array:
		return (trace_items_variant as Array).duplicate(true)
	var read_model_variant: Variant = ai_state.get("playerRuntimeExecutionTraceReadModel", {})
	if read_model_variant is Dictionary:
		var read_model: Dictionary = read_model_variant as Dictionary
		var read_model_items_variant: Variant = read_model.get("items", [])
		if read_model_items_variant is Array:
			return (read_model_items_variant as Array).duplicate(true)
	return []


func _sync_ai_activity_list_item_from_world_state() -> Dictionary:
	_ensure_ai_activity_list_item_button()
	var trace_items := _collect_ai_activity_trace_items_from_world_state()
	if trace_items.is_empty():
		_ai_activity_list_item_payload = {}
		if _ai_activity_list_item_button != null and is_instance_valid(_ai_activity_list_item_button):
			_ai_activity_list_item_button.visible = false
			_ai_activity_list_item_button.disabled = true
		return {
			"visible": false,
			"reason": "ai_activity_list_item_trace_missing",
		}
	var payload := _build_ai_activity_card_payload_from_trace(trace_items, "list")
	_ai_activity_list_item_payload = payload.duplicate(true)
	var raw_source_ref: Variant = payload.get("sourceRef", {})
	var source_ref: Dictionary = raw_source_ref as Dictionary if raw_source_ref is Dictionary else {}
	if _ai_activity_list_item_button != null and is_instance_valid(_ai_activity_list_item_button):
		var title_text := str(payload.get("titleText", "查看行动")).strip_edges()
		if title_text == "":
			title_text = "查看行动"
		}
		_ai_activity_list_item_button.text = title_text
		_ai_activity_list_item_button.visible = true
		_ai_activity_list_item_button.disabled = false
		_ai_activity_list_item_button.set_meta("ai_activity_list_item_action_id", "ai_activity_list_open_card")
		_ai_activity_list_item_button.set_meta("ai_activity_list_item_activity_event_id", str(payload.get("activityEventId", "")).strip_edges())
		_ai_activity_list_item_button.set_meta("ai_activity_list_item_map_target_tile_id", str(payload.get("mapTargetTileId", "")).strip_edges())
		_ai_activity_list_item_button.set_meta("ai_activity_list_item_jump_target", payload.get("jumpTarget", {}))
		_ai_activity_list_item_button.set_meta("ai_activity_list_item_source_ref", source_ref)
	return {
		"visible": true,
		"reason": "ai_activity_list_item_ready",
		"activityEventId": str(payload.get("activityEventId", "")).strip_edges(),
		"mapTargetTileId": str(payload.get("mapTargetTileId", "")).strip_edges(),
		"sourceRefRequestId": str(source_ref.get("requestId", "")).strip_edges(),
	}


func _build_ai_activity_card_payload_from_trace(trace_items: Array, open_source: String) -> Dictionary:
	var ai_state := WorldStore.get_ai_state(_target_faction_id)
	var trace_item: Dictionary = {}
	for trace_variant in trace_items:
		if trace_variant is Dictionary:
			trace_item = (trace_variant as Dictionary).duplicate(true)
			break
	var fallback_runtime_item := _resolve_ai_activity_card_runtime_item(ai_state, "")
	var fallback_list_card_variant: Variant = fallback_runtime_item.get("listCard", {})
	var fallback_list_card: Dictionary = fallback_list_card_variant as Dictionary if fallback_list_card_variant is Dictionary else {}
	var fallback_avatar_ref := _resolve_ai_activity_card_avatar_path(fallback_runtime_item)
	if trace_item.is_empty():
		return {
			"usesExecutionTrace": false,
			"traceCount": 0,
			"openSource": open_source,
			"aiPlayerId": "",
			"aiPlayerName": "AI玩家",
			"avatarId": str(fallback_runtime_item.get("avatarId", fallback_runtime_item.get("avatar_id", ""))).strip_edges(),
			"avatarImagePath": str(fallback_avatar_ref.get("path", "")).strip_edges(),
			"avatarSource": str(fallback_avatar_ref.get("source", "")).strip_edges(),
			"statusDot": str(fallback_list_card.get("statusDot", "gray")).strip_edges(),
			"statusReason": str(fallback_list_card.get("statusReason", "no_execution_trace")).strip_edges(),
			"titleText": "AI玩家暂无行动",
			"currentTaskText": "当前没有可展示的执行流。",
			"targetText": "目标：--",
			"resultText": "结果：等待后端执行流。",
			"traceContinuityText": "执行线索：等待后端执行流",
		}
	var marker_payload_variant: Variant = trace_item.get("marker", {})
	var marker_payload: Dictionary = marker_payload_variant as Dictionary if marker_payload_variant is Dictionary else {}
	var ai_player_id := str(trace_item.get("aiPlayerId", "")).strip_edges()
	var title_text := _first_non_empty_runtime_value(trace_item.get("title", ""), "AI玩家正在行动")
	var current_task_text := _first_non_empty_runtime_value(trace_item.get("currentTaskText", ""), title_text)
	var marker_label := str(marker_payload.get("label", "")).strip_edges()
	var target_tile_id := _first_non_empty_runtime_value(marker_payload.get("tileId", ""), trace_item.get("targetTileId", ""))
	var activity_event_id := _first_non_empty_runtime_value(marker_payload.get("activityEventId", ""), trace_item.get("activityEventId", trace_item.get("worldEventId", trace_item.get("eventId", trace_item.get("traceId", "")))))
	var map_target_tile_id := _first_non_empty_runtime_value(marker_payload.get("mapTargetTileId", ""), marker_payload.get("targetTileId", marker_payload.get("tileId", trace_item.get("mapTargetTileId", trace_item.get("targetTileId", "")))))
	var raw_jump_target: Variant = marker_payload.get("jumpTarget", trace_item.get("jumpTarget", {}))
	var jump_target: Dictionary = raw_jump_target.duplicate(true) if raw_jump_target is Dictionary else {}
	if jump_target.is_empty() and map_target_tile_id != "":
		jump_target = {
			"surface": "world_map",
			"targetId": map_target_tile_id,
			"label": marker_label if marker_label != "" else "目标地",
		}
	var raw_source_ref: Variant = marker_payload.get("sourceRef", trace_item.get("sourceRef", {}))
	var source_ref: Dictionary = raw_source_ref.duplicate(true) if raw_source_ref is Dictionary else {}
	if not source_ref.has("visibility"):
		source_ref["visibility"] = "internal_link_only"
	source_ref["visible"] = false
	if not source_ref.has("worldEventId") and activity_event_id != "":
		source_ref["worldEventId"] = activity_event_id
	var request_id := _first_non_empty_runtime_value(marker_payload.get("requestId", ""), trace_item.get("requestId", trace_item.get("traceId", "")))
	if not source_ref.has("requestId") and request_id != "":
		source_ref["requestId"] = request_id
	var target_text := "目标：%s" % marker_label if marker_label != "" else "目标：%s" % target_tile_id
	if target_tile_id != "" and marker_label != "" and marker_label != target_tile_id:
		target_text = "%s · %s" % [target_text, target_tile_id]
	var result_text := _first_non_empty_runtime_value(trace_item.get("result", ""), trace_item.get("summary", ""))
	if result_text == "":
		result_text = "结果：执行中"
	var runtime_item := _resolve_ai_activity_card_runtime_item(ai_state, ai_player_id)
	var list_card_variant: Variant = runtime_item.get("listCard", {})
	var list_card: Dictionary = list_card_variant as Dictionary if list_card_variant is Dictionary else {}
	var avatar_ref := _resolve_ai_activity_card_avatar_path(runtime_item)
	var source_text := "地图标记" if open_source == "marker" else "底部入口"
	var trace_count := trace_items.size()
	return {
		"usesExecutionTrace": true,
		"traceCount": trace_count,
		"openSource": open_source,
		"traceId": str(trace_item.get("traceId", "")).strip_edges(),
		"activityEventId": activity_event_id,
		"mapTargetTileId": map_target_tile_id,
		"jumpTarget": jump_target,
		"sourceRef": source_ref,
		"aiPlayerId": ai_player_id,
		"aiPlayerName": _resolve_ai_activity_card_player_name(ai_state, ai_player_id),
		"avatarId": str(runtime_item.get("avatarId", runtime_item.get("avatar_id", ""))).strip_edges(),
		"avatarImagePath": str(avatar_ref.get("path", "")).strip_edges(),
		"avatarSource": str(avatar_ref.get("source", "")).strip_edges(),
		"statusDot": str(list_card.get("statusDot", list_card.get("status_dot", "gray"))).strip_edges(),
		"statusReason": str(list_card.get("statusReason", list_card.get("status_reason", ""))).strip_edges(),
		"titleText": title_text,
		"currentTaskText": current_task_text,
		"targetText": target_text,
		"resultText": result_text,
		"traceContinuityText": "执行线索：%s · 同步 %d 个行动节点" % [source_text, trace_count],
	}


func _resolve_ai_activity_card_player_name(ai_state: Dictionary, ai_player_id: String) -> String:
	var runtime_items_variant: Variant = ai_state.get("playerRuntimeList", [])
	if runtime_items_variant is Array:
		for runtime_variant in runtime_items_variant as Array:
			if not (runtime_variant is Dictionary):
				continue
			var runtime_item: Dictionary = runtime_variant as Dictionary
			var runtime_ai_player_id := str(runtime_item.get("aiPlayerId", "")).strip_edges()
			if ai_player_id != "" and runtime_ai_player_id != ai_player_id:
				continue
			var display_name := str(runtime_item.get("displayName", runtime_item.get("name", ""))).strip_edges()
			if display_name != "":
				return display_name
	var primary_name := str(ai_state.get("playerRuntimePrimaryDisplayName", "")).strip_edges()
	if primary_name != "":
		return primary_name
	return "AI玩家"


func _resolve_ai_activity_card_runtime_item(ai_state: Dictionary, ai_player_id: String) -> Dictionary:
	var runtime_items_variant: Variant = ai_state.get("playerRuntimeList", [])
	if not (runtime_items_variant is Array):
		return {}
	var fallback_runtime_item: Dictionary = {}
	for runtime_variant in runtime_items_variant as Array:
		if not (runtime_variant is Dictionary):
			continue
		var runtime_item: Dictionary = runtime_variant as Dictionary
		if fallback_runtime_item.is_empty():
			fallback_runtime_item = runtime_item.duplicate(true)
		var runtime_ai_player_id := str(runtime_item.get("aiPlayerId", "")).strip_edges()
		if ai_player_id != "" and runtime_ai_player_id == ai_player_id:
			return runtime_item.duplicate(true)
	if ai_player_id == "" and not fallback_runtime_item.is_empty():
		return fallback_runtime_item.duplicate(true)
	return {}


func _resolve_ai_activity_card_avatar_path(runtime_item: Dictionary) -> Dictionary:
	var direct_avatar_path := _first_non_empty_runtime_value(
		runtime_item.get("avatarImagePath", runtime_item.get("avatar_image_path", "")),
		runtime_item.get("portraitPath", runtime_item.get("portrait_path", ""))
	)
	if _ai_activity_card_texture_path_exists(direct_avatar_path):
		return {
			"path": direct_avatar_path,
			"source": "runtime.avatarImagePath",
		}
	var list_card_variant: Variant = runtime_item.get("listCard", {})
	if list_card_variant is Dictionary:
		var list_card: Dictionary = list_card_variant as Dictionary
		var list_card_avatar_path := _first_non_empty_runtime_value(
			list_card.get("avatarImagePath", list_card.get("avatar_image_path", "")),
			list_card.get("portraitPath", list_card.get("portrait_path", ""))
		)
		if _ai_activity_card_texture_path_exists(list_card_avatar_path):
			return {
				"path": list_card_avatar_path,
				"source": "runtime.listCard.avatarImagePath",
			}
	var avatar_id := str(runtime_item.get("avatarId", runtime_item.get("avatar_id", ""))).strip_edges()
	var manifest_avatar_path := _load_ai_activity_card_portrait_manifest_path(avatar_id)
	if manifest_avatar_path != "":
		return {
			"path": manifest_avatar_path,
			"source": "ai_chat_portraits_manifest",
		}
	return {
		"path": AI_ACTIVITY_CARD_FALLBACK_AVATAR_PATH,
		"source": "fallback_avatar_path",
	}


func _load_ai_activity_card_portrait_manifest_path(avatar_id: String) -> String:
	var normalized_avatar_id := avatar_id.strip_edges()
	if normalized_avatar_id == "":
		return ""
	if not FileAccess.file_exists(AI_ACTIVITY_CARD_AI_CHAT_PORTRAIT_MANIFEST):
		return ""
	var raw_text := FileAccess.get_file_as_string(AI_ACTIVITY_CARD_AI_CHAT_PORTRAIT_MANIFEST)
	var parsed: Variant = JSON.parse_string(raw_text)
	if not (parsed is Dictionary):
		return ""
	var portraits_variant: Variant = (parsed as Dictionary).get("portraits", [])
	if not (portraits_variant is Array):
		return ""
	for portrait_variant in portraits_variant as Array:
		if not (portrait_variant is Dictionary):
			continue
		var portrait: Dictionary = portrait_variant as Dictionary
		if str(portrait.get("id", "")).strip_edges() != normalized_avatar_id:
			continue
		var image_path := _first_non_empty_runtime_value(portrait.get("image", ""), portrait.get("portraitPath", ""))
		if _ai_activity_card_texture_path_exists(image_path):
			return image_path
	return ""


func _ai_activity_card_texture_path_exists(path_value: String) -> bool:
	var normalized_path := path_value.strip_edges()
	if normalized_path == "":
		return false
	if FileAccess.file_exists(normalized_path):
		return true
	if normalized_path.begins_with("res://"):
		return false
	return FileAccess.file_exists(ProjectSettings.globalize_path("res://../%s" % normalized_path))


func _load_ai_activity_card_avatar_texture(path_value: String) -> Texture2D:
	var normalized_path := path_value.strip_edges()
	if normalized_path == "":
		return null
	var load_path := normalized_path
	if not FileAccess.file_exists(load_path) and not normalized_path.begins_with("res://"):
		load_path = ProjectSettings.globalize_path("res://../%s" % normalized_path)
	if not FileAccess.file_exists(load_path):
		return null
	var image := Image.new()
	var error := image.load(load_path)
	if error != OK:
		return null
	return ImageTexture.create_from_image(image)


func _load_ai_activity_card_troop_formation_read_model() -> Dictionary:
	var read_model_path := "res://data/ui/main_city_troop_formation_read_model.json"
	if not FileAccess.file_exists(read_model_path):
		return {}
	var raw_text := FileAccess.get_file_as_string(read_model_path)
	var parsed: Variant = JSON.parse_string(raw_text)
	if parsed is Dictionary:
		return parsed as Dictionary
	return {}


func _resolve_ai_activity_card_carrying_troop_slots(ai_player_id: String) -> Array:
	var read_model := _load_ai_activity_card_troop_formation_read_model()
	var teams_variant: Variant = read_model.get("teams", [])
	if not (teams_variant is Array):
		return []
	var preferred_ai_player_id := ai_player_id.strip_edges()
	var fallback_ai_player_id := "ai_player_jihan_vanguard"
	var fallback_team: Dictionary = {}
	var selected_team: Dictionary = {}
	for team_variant in teams_variant as Array:
		if not (team_variant is Dictionary):
			continue
		var team: Dictionary = team_variant as Dictionary
		var owner_type := str(team.get("owner_type", team.get("ownerType", ""))).strip_edges().to_lower()
		var team_ai_player_id := str(team.get("ai_player_id", team.get("aiPlayerId", ""))).strip_edges()
		if owner_type != "ai" and team_ai_player_id == "":
			continue
		if fallback_team.is_empty() or team_ai_player_id == fallback_ai_player_id:
			fallback_team = team.duplicate(true)
		if preferred_ai_player_id != "" and team_ai_player_id == preferred_ai_player_id:
			selected_team = team.duplicate(true)
			break
	if selected_team.is_empty():
		selected_team = fallback_team
	if selected_team.is_empty():
		return []
	var slots_variant: Variant = selected_team.get("slots", [])
	if not (slots_variant is Array):
		return []
	var slot_payloads: Array = []
	for slot_variant in slots_variant as Array:
		if slot_payloads.size() >= 3:
			break
		if not (slot_variant is Dictionary):
			continue
		var slot: Dictionary = slot_variant as Dictionary
		var troop_label := str(slot.get("troop_type", slot.get("troopType", ""))).strip_edges()
		if troop_label == "":
			continue
		var general_name := str(slot.get("general_name", slot.get("generalName", ""))).strip_edges()
		if general_name == "":
			general_name = "武将"
		var asset_path := SlgUiComponentFactoryScript.generated_troop_illustration_for_label(troop_label)
		slot_payloads.append({
			"generalName": general_name,
			"troopType": troop_label,
			"label": "%s %s" % [general_name, troop_label],
			"assetPath": asset_path,
			"aiPlayerId": str(selected_team.get("ai_player_id", selected_team.get("aiPlayerId", ""))).strip_edges(),
			"teamId": str(selected_team.get("id", selected_team.get("team_id", ""))).strip_edges(),
			"source": "main_city_troop_formation_read_model",
			"sourcePath": "main_city_troop_formation_read_model.json",
		})
	return slot_payloads


func _apply_ai_activity_card_carrying_troop_slots(slots: Array) -> void:
	_ai_activity_card_carrying_troops_slot_count = 0
	_ai_activity_card_carrying_troops_texture_count = 0
	_ai_activity_card_carrying_troops_labels = []
	_ai_activity_card_carrying_troops_asset_paths = []
	if _ai_activity_card_carrying_troops_row == null or not is_instance_valid(_ai_activity_card_carrying_troops_row):
		return
	_ai_activity_card_carrying_troops_row.visible = not slots.is_empty()
	for chip_index in range(_ai_activity_card_carrying_troops_row.get_child_count()):
		var chip := _ai_activity_card_carrying_troops_row.get_child(chip_index)
		if chip == null or not is_instance_valid(chip):
			continue
		var has_slot := chip_index < slots.size() and slots[chip_index] is Dictionary
		chip.visible = has_slot
		if not has_slot:
			continue
		var slot: Dictionary = slots[chip_index] as Dictionary
		var asset_path := str(slot.get("assetPath", "")).strip_edges()
		var label_text := str(slot.get("label", "")).strip_edges()
		if label_text == "":
			label_text = str(slot.get("troopType", "")).strip_edges()
		chip.set_meta("ai_activity_carrying_troops_chip_contract", SlgUiComponentFactoryScript.ai_activity_carrying_troops_chip_contract())
		chip.set_meta("generated_troops_illustration_source", SlgUiComponentFactoryScript.generated_troops_illustration_source())
		chip.set_meta("ai_activity_carrying_troops_label", label_text)
		chip.set_meta("ai_activity_carrying_troops_asset_path", asset_path)
		var texture_node := chip.find_child("AIActivityCardCarryingTroopsTexture_%d" % chip_index, true, false) as TextureRect
		if texture_node != null:
			texture_node.texture = _load_ai_activity_card_avatar_texture(asset_path)
			texture_node.visible = texture_node.texture != null
			texture_node.set_meta("generated_troops_illustration_source", SlgUiComponentFactoryScript.generated_troops_illustration_source())
			texture_node.set_meta("generated_troops_asset_path", asset_path)
			if texture_node.texture != null:
				_ai_activity_card_carrying_troops_texture_count += 1
		var label_node := chip.find_child("AIActivityCardCarryingTroopsLabel_%d" % chip_index, true, false) as Label
		if label_node != null:
			label_node.text = label_text
		_ai_activity_card_carrying_troops_slot_count += 1
		_ai_activity_card_carrying_troops_labels.append(label_text)
		_ai_activity_card_carrying_troops_asset_paths.append(asset_path)


