func _read_mainline_visual_smoke_shell_nav_layout_summary() -> Dictionary:
	if _native_shell == null or not is_instance_valid(_native_shell):
		return {"ok": false, "reason": "native_shell_missing"}
	if _active_panel_id == "battle_report" and _native_shell is CanvasItem and not (_native_shell as CanvasItem).visible:
		return {
			"ok": true,
			"reason": "native_shell_hidden_by_battle_report_fullscreen",
			"visibleButtonCount": 0,
			"missingVisibleRequired": [],
			"overlaps": [],
			"buttons": [],
		}
	var nav_buttons := _native_shell.get_node_or_null("BottomNav/BottomMargin/BottomRow/MainNav/NavButtons") as Control
	if nav_buttons == null:
		nav_buttons = _native_shell.get_node_or_null("BottomNav/BottomMargin/BottomRow/MainNav/NavControlRow/NavButtons") as Control
	if nav_buttons == null:
		return {"ok": false, "reason": "nav_buttons_missing"}
	var bottom_nav := _native_shell.get_node_or_null("BottomNav") as Control
	var shell_command_chrome_token := "shell_command_chrome_v1"
	var bottom_nav_chrome_token := str(bottom_nav.get_meta("shell_command_chrome_token", "")) if bottom_nav != null else ""
	var require_ai_switch := _display_mode == DISPLAY_MODE_WORLD
	if _is_tianxia_yutu_main_map_mode():
		var top_strip := _native_shell.get_node_or_null("TopStrip") as Control
		var left_rail := _native_shell.get_node_or_null("LeftRail") as Control
		var mode_toggle := _native_shell.get_node_or_null("TopStrip/TopMargin/TopRow/Actions/ModeToggleButton") as Button
		var top_identity := _native_shell.get_node_or_null("TopStrip/TopMargin/TopRow/TopIdentityBlock") as Control
		var top_resource_icon_row := _native_shell.get_node_or_null("TopStrip/TopMargin/TopRow/TopResourceIconRow") as Control
		var resource_strip := _native_shell.get_node_or_null("TopStrip/TopMargin/TopRow/ResourceStrip") as Control
		var premium_currency_row := _native_shell.get_node_or_null("TopStrip/TopMargin/TopRow/Actions/PremiumCurrencyRow") as Control
		var bottom_nav_hidden := bottom_nav == null or not bottom_nav.visible or not bottom_nav.is_visible_in_tree()
		var left_rail_hidden := left_rail == null or not left_rail.visible or not left_rail.is_visible_in_tree()
		var top_identity_hidden := top_identity == null or not top_identity.visible or not top_identity.is_visible_in_tree()
		var top_resource_hidden := top_resource_icon_row == null or not top_resource_icon_row.visible or not top_resource_icon_row.is_visible_in_tree()
		var resource_strip_hidden := resource_strip == null or not resource_strip.visible or not resource_strip.is_visible_in_tree()
		var premium_currency_hidden := premium_currency_row == null or not premium_currency_row.visible or not premium_currency_row.is_visible_in_tree()
		var top_main_hud_hidden := top_identity_hidden and top_resource_hidden and resource_strip_hidden and premium_currency_hidden
		var mode_toggle_visible := mode_toggle != null and mode_toggle.visible and mode_toggle.is_visible_in_tree()
		var mode_toggle_hidden := not mode_toggle_visible
		var top_strip_hidden := top_strip == null or not top_strip.visible or not top_strip.is_visible_in_tree()
		var top_strip_compact := top_strip_hidden or (top_strip.get_global_rect().size.x <= 220.0 and top_strip.get_global_rect().size.y <= 64.0)
		var tianxia_shell_hud_hidden := bottom_nav_hidden and left_rail_hidden and top_main_hud_hidden and mode_toggle_hidden and top_strip_compact
		return {
			"ok": tianxia_shell_hud_hidden,
			"reason": "native_shell_main_world_hud_hidden_by_tianxia_yutu" if tianxia_shell_hud_hidden else "tianxia_yutu_main_world_hud_still_visible",
			"tianxiaYutuMode": true,
			"bottomNavVisible": not bottom_nav_hidden,
			"topMainHudHidden": top_main_hud_hidden,
			"topStripCompact": top_strip_compact,
			"topStripHidden": top_strip_hidden,
			"topStripRect": _rect_to_mainline_visual_smoke_dict(top_strip.get_global_rect() if top_strip != null else Rect2()),
			"topIdentityVisible": not top_identity_hidden,
			"topResourceIconRowVisible": not top_resource_hidden,
			"resourceStripVisible": not resource_strip_hidden,
			"premiumCurrencyRowVisible": not premium_currency_hidden,
			"leftRailVisible": not left_rail_hidden,
			"modeToggleVisible": mode_toggle_visible,
			"modeToggleHidden": mode_toggle_hidden,
			"modeToggleText": mode_toggle.text.strip_edges() if mode_toggle != null else "",
