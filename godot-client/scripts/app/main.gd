func _on_main_map_cell_selected(context: Dictionary) -> void:
	_selected_main_map_cell_context = context.duplicate(true)
	if _is_tianxia_yutu_main_map_mode():
		var cell_x: int = int(context.get("cellX", context.get("tmxX", TIANXIA_YUTU_DEFAULT_CENTER_X)))
		var cell_y: int = int(context.get("cellY", context.get("tmxY", TIANXIA_YUTU_DEFAULT_CENTER_Y)))
		_tianxia_yutu_navigation_panel_collapsed = false
		_tianxia_yutu_navigation_panel_expanded = false
		var selected_marker_target: Dictionary = _build_tianxia_yutu_target_from_marker_context(context)
		if not selected_marker_target.is_empty():
			_tianxia_yutu_last_jump_target = selected_marker_target.duplicate(true)
		else:
			var snapped_target: Dictionary = _snap_tianxia_yutu_jump_target_to_anchor(cell_x, cell_y) if _should_snap_tianxia_yutu_direct_click_to_anchor() else {}
			if not snapped_target.is_empty():
				_tianxia_yutu_last_jump_target = snapped_target.duplicate(true)
				_tianxia_yutu_last_jump_target["panel_detail_mode"] = true
			else:
				_tianxia_yutu_last_jump_target = {
					"target_id": "clicked_cell_%d_%d" % [cell_x, cell_y],
					"label": "坐标点",
					"kind": "coordinate",
					"target_scope": "coordinate",
					"cell_1km": {"x": cell_x, "y": cell_y},
					"source": "tianxia_yutu_direct_map_click",
