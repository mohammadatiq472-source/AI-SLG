func _press_mainline_visual_smoke_main_nav_toggle_roundtrip() -> Dictionary:
	if _native_shell == null or not is_instance_valid(_native_shell):
		return {"attempted": true, "ok": false, "reason": "native_shell_missing"}
	var menu_button := _native_shell.get_node_or_null("BottomNav/BottomMargin/BottomRow/MainNav/MainNavMenuButton") as Button
	var nav_buttons := _native_shell.get_node_or_null("BottomNav/BottomMargin/BottomRow/MainNav/NavButtons") as Control
	if menu_button == null:
		menu_button = _native_shell.get_node_or_null("BottomNav/BottomMargin/BottomRow/MainNav/NavControlRow/MainNavMenuButton") as Button
	if nav_buttons == null:
		nav_buttons = _native_shell.get_node_or_null("BottomNav/BottomMargin/BottomRow/MainNav/NavControlRow/NavButtons") as Control
	if menu_button == null or nav_buttons == null:
		return {"attempted": true, "ok": false, "reason": "main_nav_nodes_missing"}
	menu_button.emit_signal("pressed")
	await get_tree().process_frame
	await get_tree().process_frame
	var collapsed_text := menu_button.text.strip_edges()
	var collapsed_tooltip := menu_button.tooltip_text.strip_edges()
	var collapsed_arrow_ok := collapsed_text.find("▶") >= 0
	var collapsed_semantic_ok := collapsed_arrow_ok or collapsed_text.find("展开") >= 0 or collapsed_tooltip.find("展开") >= 0
	var collapsed_ok := menu_button.visible and menu_button.is_visible_in_tree() and not nav_buttons.visible and collapsed_semantic_ok
	var collapsed_menu_rect := menu_button.get_global_rect()
	var collapsed_touch_ok := collapsed_menu_rect.size.x >= 44.0 and collapsed_menu_rect.size.y >= 72.0
	var collapsed_compact_ok := collapsed_menu_rect.size.x <= 64.0 and collapsed_menu_rect.size.y >= 84.0
	var collapsed_screenshot := _save_mainline_visual_smoke_pre_close_screenshot("main_nav_collapsed")
	menu_button.emit_signal("pressed")
	await get_tree().process_frame
	await get_tree().process_frame
	var expanded_text := menu_button.text.strip_edges()
	var expanded_tooltip := menu_button.tooltip_text.strip_edges()
	var expanded_arrow_ok := expanded_text.find("▶") >= 0
	var expanded_semantic_ok := expanded_arrow_ok or expanded_text.find("收起") >= 0 or expanded_tooltip.find("收起") >= 0
	var expanded_ok := menu_button.visible and menu_button.is_visible_in_tree() and nav_buttons.visible and expanded_semantic_ok
	var expanded_menu_rect := menu_button.get_global_rect()
	var expanded_touch_ok := expanded_menu_rect.size.x >= 44.0 and expanded_menu_rect.size.y >= 72.0
	var expanded_compact_ok := expanded_menu_rect.size.x <= 64.0 and expanded_menu_rect.size.y >= 84.0
	var shell_nav_layout_summary := _read_mainline_visual_smoke_shell_nav_layout_summary()
	var shell_nav_layout_ok := bool(shell_nav_layout_summary.get("ok", false))
	var shell_nav_toggle_mode := "right_arrow_toggle_v1" if collapsed_arrow_ok and expanded_arrow_ok else "legacy_text_toggle"
	var result := {
		"attempted": true,
		"ok": collapsed_ok and expanded_ok and collapsed_touch_ok and expanded_touch_ok and collapsed_compact_ok and expanded_compact_ok and shell_nav_layout_ok and bool(collapsed_screenshot.get("ok", false)),
		"reason": "main_nav_toggle_roundtrip",
		"collapsedOk": collapsed_ok,
		"collapsedText": collapsed_text,
		"collapsedTooltip": collapsed_tooltip,
		"collapsedArrowOk": collapsed_arrow_ok,
		"collapsedSemanticOk": collapsed_semantic_ok,
		"collapsedTouchOk": collapsed_touch_ok,
		"collapsedCompactOk": collapsed_compact_ok,
		"collapsedMenuRect": _rect_to_mainline_visual_smoke_dict(collapsed_menu_rect),
		"expandedOk": expanded_ok,
		"expandedText": expanded_text,
		"expandedTooltip": expanded_tooltip,
		"expandedArrowOk": expanded_arrow_ok,
		"expandedSemanticOk": expanded_semantic_ok,
		"expandedTouchOk": expanded_touch_ok,
		"expandedCompactOk": expanded_compact_ok,
		"expandedMenuRect": _rect_to_mainline_visual_smoke_dict(expanded_menu_rect),
		"shellNavToggleMode": shell_nav_toggle_mode,
		"beforeCloseScreenshot": collapsed_screenshot,
	}
	_copy_mainline_visual_smoke_shell_nav_contract_fields(result, shell_nav_layout_summary)
	return result

func _press_mainline_visual_smoke_bottom_nav_component_contract() -> Dictionary:
	if _native_shell == null or not is_instance_valid(_native_shell):
		return {"attempted": true, "ok": false, "reason": "native_shell_missing"}
	var main_nav := _native_shell.get_node_or_null("BottomNav/BottomMargin/BottomRow/MainNav") as Control
