func _resolve_mainline_visual_smoke_naval_route_feedback(attacker_vessel_type: String, defender_vessel_type: String) -> Dictionary:
	var manifest: Dictionary = _read_mainline_visual_smoke_naval_frame_manifest()
	var policy: Dictionary = manifest.get("movingBodyFramePolicy", {}) if manifest.get("movingBodyFramePolicy", {}) is Dictionary else {}
	var bodies: Array = manifest.get("requiredMovingBodies", []) if manifest.get("requiredMovingBodies", []) is Array else []
	var vessel_to_slot := {
		"light_patrol_warship": "naval_light_patrol_warship_v1",
		"interceptor_warship": "naval_interceptor_warship_v1",
		"transport_warship": "naval_transport_warship_v1",
	}
	var attacker_slot := str(vessel_to_slot.get(attacker_vessel_type, ""))
	var defender_slot := str(vessel_to_slot.get(defender_vessel_type, ""))
	var directions: Array = policy.get("directions", []) if policy.get("directions", []) is Array else []
	var texture_loaded_by_slot := {}
	var sample_paths_by_slot := {}
	var frame_count_by_slot := {}
	for slot_id_variant in [attacker_slot, defender_slot]:
		var slot_id := str(slot_id_variant)
		if slot_id == "":
			continue
		var body := _find_mainline_visual_smoke_naval_body_by_slot(bodies, slot_id)
		var target_root := str(body.get("targetRoot", ""))
		var naming_pattern := str(body.get("frameNamingPattern", ""))
		var sample_paths: Array = []
		var frame_count := 0
		for direction_variant in directions:
			var direction := str(direction_variant)
			for frame_index in range(10):
				var frame_path := "%s/%s" % [
					target_root,
					naming_pattern.replace("{direction}", direction).replace("{frameIndex}", "%02d" % frame_index),
				]
				if ResourceLoader.exists(frame_path):
					frame_count += 1
				if frame_index in [0, 5] and direction in ["r", "l"] and sample_paths.size() < 2:
					sample_paths.append(frame_path)
		var loaded_count := 0
		for sample_path_variant in sample_paths:
			if _load_mainline_visual_smoke_naval_png_texture(str(sample_path_variant)) != null:
				loaded_count += 1
		texture_loaded_by_slot[slot_id] = loaded_count
		sample_paths_by_slot[slot_id] = sample_paths
		frame_count_by_slot[slot_id] = frame_count
	var ok := (
		str(manifest.get("status", "")) == "frame_batch_ready_pending_runtime_adapter"
		and str(policy.get("connectionStatus", "")) == "brief_only_not_connected_to_runtime_unit_marker"
		and attacker_slot != ""
		and defender_slot != ""
		and int(frame_count_by_slot.get(attacker_slot, 0)) == 80
		and int(frame_count_by_slot.get(defender_slot, 0)) == 80
		and int(texture_loaded_by_slot.get(attacker_slot, 0)) >= 1
		and int(texture_loaded_by_slot.get(defender_slot, 0)) >= 1
	)
	return {
		"ok": ok,
		"contract": "sea_patrol_intercept_naval_frame_route_feedback_v1",
		"status": "w13_frame_batch_ready_route_feedback_preview_only" if ok else "w13_frame_batch_route_feedback_unavailable",
		"attackerFrameSlotId": attacker_slot,
		"defenderFrameSlotId": defender_slot,
		"textureLoadedBySlot": texture_loaded_by_slot,
		"samplePathsBySlot": sample_paths_by_slot,
		"frameCountBySlot": frame_count_by_slot,
		"doesNotUseUnitMarker": true,
		"movementRuntimeStatus": "preview_only_no_sea_runtime_movement",
		"connectionStatus": "route_feedback_preview_only_no_unit_marker",
	}


func _show_mainline_visual_smoke_naval_route_feedback_panel(route_feedback: Dictionary) -> int:
	var host: Node = _active_overlay_panel if _active_overlay_panel != null and is_instance_valid(_active_overlay_panel) else null
	if host == null:
		host = get_node_or_null(UI_LAYER_PATH)
	if host == null:
		host = self
	var old := host.get_node_or_null("SeaPatrolInterceptNavalRouteFeedback")
	if old != null:
		old.queue_free()
	var panel := PanelContainer.new()
	panel.name = "SeaPatrolInterceptNavalRouteFeedback"
	panel.set_anchors_preset(Control.PRESET_TOP_LEFT)
	panel.custom_minimum_size = Vector2(360, 132)
	panel.z_index = 1000
	var panel_style := StyleBoxFlat.new()
	panel_style.bg_color = Color(0.11, 0.065, 0.02, 0.86)
	panel_style.border_color = Color(0.85, 0.52, 0.14, 0.95)
	panel_style.set_border_width_all(1)
	panel_style.set_corner_radius_all(8)
	panel.add_theme_stylebox_override("panel", panel_style)
	var margin := MarginContainer.new()
	margin.add_theme_constant_override("margin_left", 12)
	margin.add_theme_constant_override("margin_top", 10)
	margin.add_theme_constant_override("margin_right", 12)
	margin.add_theme_constant_override("margin_bottom", 10)
	panel.add_child(margin)
	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", 8)
	margin.add_child(column)
	var title := Label.new()
	title.text = "海路船队"
	title.add_theme_font_size_override("font_size", 18)
	column.add_child(title)
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	column.add_child(row)
	var sample_paths_by_slot: Dictionary = route_feedback.get("samplePathsBySlot", {}) if route_feedback.get("samplePathsBySlot", {}) is Dictionary else {}
	var entries := [
		{"label": "拦截船", "slotId": str(route_feedback.get("attackerFrameSlotId", ""))},
		{"label": "运输船", "slotId": str(route_feedback.get("defenderFrameSlotId", ""))},
	]
	var visible_count := 0
	for entry_variant in entries:
		var entry: Dictionary = entry_variant
		var slot_id := str(entry.get("slotId", ""))
		var paths: Array = sample_paths_by_slot.get(slot_id, []) if sample_paths_by_slot.get(slot_id, []) is Array else []
		if paths.is_empty():
			continue
		var card := HBoxContainer.new()
		card.name = "NavalRouteFeedback_%s" % slot_id
		card.add_theme_constant_override("separation", 6)
		var image := TextureRect.new()
		image.custom_minimum_size = Vector2(58, 58)
		image.size = Vector2(58, 58)
		image.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		image.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
		image.texture = _load_mainline_visual_smoke_naval_png_texture(str(paths[0]))
		card.add_child(image)
		var label := Label.new()
		label.text = str(entry.get("label", "船队"))
		label.add_theme_font_size_override("font_size", 15)
		card.add_child(label)
		row.add_child(card)
		visible_count += 1
	host.add_child(panel)
	var viewport_size: Vector2 = get_viewport().get_visible_rect().size
	if host is Control:
		viewport_size = (host as Control).size
	panel.size = Vector2(360, 132)
	panel.position = Vector2(max(24.0, viewport_size.x - 388.0), max(96.0, viewport_size.y - 168.0))
	panel.set_meta("sea_patrol_intercept_naval_route_feedback_contract", str(route_feedback.get("contract", "")))
	return visible_count


