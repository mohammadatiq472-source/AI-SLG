func _sync_shell_ai_activity_status_badge_from_world_state() -> Dictionary:
	if _native_shell == null or not is_instance_valid(_native_shell):
		return {
			"contract": "ai_activity_status_badge_v1",
			"visible": false,
			"traceCount": 0,
			"source": "none",
			"usesExecutionTrace": false,
			"fallbackUsed": false,
			"reason": "native_shell_missing",
		}
	var ai_state := WorldStore.get_ai_state(_target_faction_id)
	var trace_items: Array = []
	var trace_items_variant: Variant = ai_state.get("playerRuntimeExecutionTraceItems", [])
	if trace_items_variant is Array:
		trace_items = (trace_items_variant as Array).duplicate(true)
	if _native_shell.has_method("set_ai_activity_status_badge"):
		_native_shell.call("set_ai_activity_status_badge", trace_items)
	var summary := {
		"contract": "ai_activity_status_badge_v1",
		"visible": false,
		"traceCount": trace_items.size(),
		"source": "execution_trace" if trace_items.size() > 0 else "none",
		"usesExecutionTrace": trace_items.size() > 0,
		"fallbackUsed": false,
	}
	if _native_shell.has_method("get_ai_activity_status_badge_summary"):
		var summary_variant: Variant = _native_shell.call("get_ai_activity_status_badge_summary")
		if summary_variant is Dictionary:
			summary = summary_variant as Dictionary
	_sync_ai_activity_list_item_from_world_state()
	return summary


