func _read_mainline_visual_smoke_naval_runtime_fleet(fleet_id: String) -> Dictionary:
	var normalized_fleet_id := fleet_id.strip_edges()
	if normalized_fleet_id == "":
		return {}
	var world_data: Dictionary = WorldStore.world
	var naval_runtime: Dictionary = world_data.get("navalRuntime", {}) as Dictionary
	var fleets: Dictionary = naval_runtime.get("fleets", {}) as Dictionary
	var fleet: Variant = fleets.get(normalized_fleet_id, {})
	return fleet as Dictionary if fleet is Dictionary else {}


func _find_mainline_visual_smoke_forbidden_visible_copy_hits(copy: String) -> Array:
	var hits: Array = []
	var lower_copy := copy.to_lower()
	for token in ["snake_case", "contract", "read model", "authority", "tier", "v0", "backend"]:
		if lower_copy.find(token) >= 0:
			hits.append(token)
	return hits


