func _request_mainline_visual_smoke_mail_live_inbox_readback() -> Dictionary:
	if _api_client == null:
		return {"ok": false, "reason": "api_client_missing"}
	if not _api_client.has_method("get_unified_inbox"):
		return {"ok": false, "reason": "get_unified_inbox_missing"}
	var faction_id := _target_faction_id.strip_edges()
	if faction_id == "":
		faction_id = "player"
	var governor_player_id := AppConfig.player_name.strip_edges()
	if governor_player_id == "":
		governor_player_id = "human_alpha"
	var first_response: Dictionary = await _api_client.call("get_unified_inbox", faction_id, governor_player_id)
	var first_data: Dictionary = first_response.get("data", {}) as Dictionary
	var first_count := int(first_data.get("count", 0))
	var seeded_for_proof := false
	var seed_response: Dictionary = {}
	var read_response := first_response
	var read_data := first_data
	if bool(first_response.get("ok", false)) and first_count <= 0 and _api_client.has_method("request_json"):
		seeded_for_proof = true
		seed_response = await _api_client.call("request_json", "POST", "/api/inbox/daily-welfare", {
			"factionId": faction_id,
			"benefitDate": "2026-06-09",
			"label": "每日补给",
			"summary": "今日补给已经送达。",
			"reward": {
				"food": 80,
				"ap": 10,
			},
			"includeWorld": false,
		})
		read_response = await _api_client.call("get_unified_inbox", faction_id, governor_player_id)
		read_data = read_response.get("data", {}) as Dictionary
	var read_items: Array = read_data.get("items", []) as Array
	var read_count := int(read_data.get("count", read_items.size()))
	return {
		"ok": bool(read_response.get("ok", false)) and read_count > 0,
		"reason": "live_inbox_readback_ok" if bool(read_response.get("ok", false)) and read_count > 0 else "live_inbox_empty_or_failed",
		"factionId": faction_id,
		"governorPlayerId": governor_player_id,
		"liveInboxCount": read_count,
		"seededForProof": seeded_for_proof,
		"firstResponseStatus": int(first_response.get("status", -1)),
		"readResponseStatus": int(read_response.get("status", -1)),
		"seedResponseStatus": int(seed_response.get("status", -1)),
		"inboxData": read_data,
	}

func _build_mainline_visual_smoke_mail_live_inbox_visible_copy(snapshot: Dictionary, summary: Dictionary, clicked_label: String) -> String:
	var parts: Array[String] = []
	for item_variant in snapshot.get("mail_items", []) as Array:
		if not (item_variant is Dictionary):
			continue
		var item := item_variant as Dictionary
		for key in ["title", "value", "sender", "status_label", "summary", "time"]:
			var value := str(item.get(key, "")).strip_edges()
			if value != "":
				parts.append(value)
		var body_lines: Array = item.get("body_lines", []) as Array
		for line_variant in body_lines:
			var line := str(line_variant).strip_edges()
			if line != "":
				parts.append(line)
		var reward_lines: Array = item.get("reward_lines", []) as Array
		for reward_variant in reward_lines:
			var reward := str(reward_variant).strip_edges()
			if reward != "":
				parts.append(reward)
	if clicked_label.strip_edges() != "":
		parts.append(clicked_label.strip_edges())
	var selected_title := str(summary.get("mailPanelSelectedMailTitle", "")).strip_edges()
	if selected_title != "":
		parts.append(selected_title)
	var row_labels := str(summary.get("mailPanelRowSelectLabels", "")).strip_edges()
	if row_labels != "":
		parts.append(row_labels)
	return " / ".join(parts)

func _collect_mainline_visual_smoke_mail_live_inbox_forbidden_hits(copy: String) -> Array:
	var hits: Array = []
	var lower_copy := copy.to_lower()
	for token in ["snake_case", "read model", "authority", "tier", "v0", "neutral", "backend", "contract id", "/api/inbox", "inbox_mail"]:
		if lower_copy.find(token) >= 0 and not hits.has(token):
			hits.append(token)
	return hits

