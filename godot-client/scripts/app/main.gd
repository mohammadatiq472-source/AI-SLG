		and int(streaming_summary.get("mainWorldChokepointSpriteOnScreenCount", 0)) > 0
		and int(streaming_summary.get("worldCellNodeDrawCount", 0)) == 0
		and int(streaming_summary.get("worldCellNodeDrawFailedCount", 0)) == 0
	)
	var focus_ok: bool = refresh_ok and (not selection_checked or selection_matches_target) and visual_ok
	return {
		"attempted": true,
		"ok": focus_ok,
		"reason": "chokepoint_focused" if focus_ok else "chokepoint_focus_failed",
		"requestedRuntimeChokepointId": requested_id,
		"targetCell": target_cell,
		"focusContext": focus_context,
		"selectedCell": selected_context,
		"selectionChecked": selection_checked,
		"selectionMatchesTarget": selection_matches_target,
		"refreshOk": refresh_ok,
		"visualOk": visual_ok,
		"streamingSummary": streaming_summary,
		"requestKey": request_key,
	}


func _sweep_mainline_visual_smoke_mountain_boundary_targets() -> Dictionary:
	var target_specs: Array[Dictionary] = [
		{
			"lineRole": "cross_state_commandery_boundary_blockade_candidate",
			"minCount": 3,
			"maxCount": 4,
		},
		{
			"lineRole": "stable_direct_outer_contact_boundary_blockade_candidate",
			"minCount": 2,
			"maxCount": 3,
		},
		{
			"lineRole": "special_internal_commandery_boundary_blockade_candidate",
			"minCount": 1,
			"maxCount": 1,
		},
	]
	var target_cells: Array = []
	var role_counts: Dictionary = {}
	var role_minimums: Dictionary = {}
	for spec in target_specs:
		var line_role := str(spec.get("lineRole", "")).strip_edges()
		var max_count := int(spec.get("maxCount", 1))
		var cells: Array = _resolve_mainline_visual_smoke_mountain_boundary_target_cells(WorldStore.map_layout, line_role, max_count)
		role_counts[line_role] = cells.size()
		role_minimums[line_role] = int(spec.get("minCount", 1))
		for cell_variant in cells:
			if cell_variant is Dictionary:
				target_cells.append(cell_variant)
	var role_requirements_ok := true
	for role_key in role_minimums.keys():
		if int(role_counts.get(role_key, 0)) < int(role_minimums.get(role_key, 0)):
			role_requirements_ok = false
	if target_cells.is_empty():
		return {
			"attempted": true,
			"ok": false,
			"reason": "large_world_mountain_boundary_sweep_targets_missing",
			"roleCounts": role_counts,
			"roleMinimums": role_minimums,
		}
	var results: Array = []
	var all_focus_ok := role_requirements_ok
	var all_visual_ok := role_requirements_ok
	for target_variant in target_cells:
		if not (target_variant is Dictionary):
			continue
		var target_cell: Dictionary = target_variant as Dictionary
		var line_role := str(target_cell.get("lineRole", "")).strip_edges()
		var focus_result: Dictionary = await _focus_mainline_visual_smoke_mountain_boundary_cell(target_cell, line_role)
		await get_tree().process_frame
		await get_tree().process_frame
		var streaming_summary: Dictionary = _read_main_map_streaming_debug_summary()
		var visual_ok := (
			bool(streaming_summary.get("mainWorldMountainBoundaryLayerPresent", false))
			and int(streaming_summary.get("mainWorldMountainBoundaryRuntimeAssetLoadedCount", 0)) >= 12
			and int(streaming_summary.get("mainWorldMountainBoundarySpriteDrawCount", 0)) > 0
			and int(streaming_summary.get("mainWorldMountainBoundarySpriteFailedCount", 0)) == 0
			and int(streaming_summary.get("mainWorldMountainBoundarySpriteOnScreenCount", 0)) > 0
		)
		if not bool(focus_result.get("ok", false)):
			all_focus_ok = false
		if not visual_ok:
			all_visual_ok = false
		results.append({
			"targetCell": target_cell,
			"focusResult": focus_result,
			"visualOk": visual_ok,
			"spriteDrawCount": int(streaming_summary.get("mainWorldMountainBoundarySpriteDrawCount", 0)),
			"spriteFailedCount": int(streaming_summary.get("mainWorldMountainBoundarySpriteFailedCount", 0)),
			"spriteOnScreenCount": int(streaming_summary.get("mainWorldMountainBoundarySpriteOnScreenCount", 0)),
			"runtimeAssetLoadedCount": int(streaming_summary.get("mainWorldMountainBoundaryRuntimeAssetLoadedCount", 0)),
		})
	return {
		"attempted": true,
		"ok": all_focus_ok and all_visual_ok,
		"reason": "large_world_mountain_boundary_sweep_focused" if all_focus_ok and all_visual_ok else "large_world_mountain_boundary_sweep_failed",
		"targetCount": target_cells.size(),
		"roleCounts": role_counts,
		"roleMinimums": role_minimums,
		"targets": target_cells,
		"results": results,
		"focusOk": all_focus_ok,
		"visualOk": all_visual_ok,
	}

func _resolve_mainline_visual_smoke_mountain_boundary_target_cell(map_layout_data: Dictionary, preferred_line_role: String = "", requested_runtime_placement_id: String = "") -> Dictionary:
	var cells: Array = _resolve_mainline_visual_smoke_mountain_boundary_target_cells(map_layout_data, preferred_line_role, 1, requested_runtime_placement_id)
	if not cells.is_empty() and cells[0] is Dictionary:
		return cells[0] as Dictionary
	return {}

func _resolve_mainline_visual_smoke_mountain_boundary_target_cells(map_layout_data: Dictionary, preferred_line_role: String = "", max_count: int = 1, requested_runtime_placement_id: String = "") -> Array:
	var layer_variant: Variant = map_layout_data.get("main_world_mountain_boundary_layer", {})
	if not (layer_variant is Dictionary):
		return []
	var layer: Dictionary = layer_variant as Dictionary
	var normalized_preferred_line_role := preferred_line_role.strip_edges()
	var normalized_requested_placement_id := requested_runtime_placement_id.strip_edges()
	var result: Array = []
	var seen_placement_ids: Dictionary = {}
	var visible_placements: Array = []
	var placements_variant: Variant = layer.get("visible_placements", [])
	if placements_variant is Array:
		visible_placements = placements_variant as Array
	var focus_targets: Array = []
	var focus_targets_variant: Variant = layer.get("placement_focus_targets", [])
	if focus_targets_variant is Array:
		focus_targets = focus_targets_variant as Array
	for focus_target_variant in focus_targets:
		if result.size() >= max_count:
			return result
		if not (focus_target_variant is Dictionary):
			continue
		var focus_target: Dictionary = focus_target_variant as Dictionary
		var focus_line_role := str(focus_target.get("line_role", "")).strip_edges()
		if normalized_preferred_line_role != "" and focus_line_role != normalized_preferred_line_role:
			continue
		var focus_placement_id := str(focus_target.get("runtime_placement_id", "")).strip_edges()
		if normalized_requested_placement_id != "" and focus_placement_id != normalized_requested_placement_id:
			continue
		var focus_cell: Dictionary = _mainline_visual_smoke_cell_from_variant(focus_target.get("first_cell_1km", []))
		if focus_cell.is_empty():
			continue
		if seen_placement_ids.has(focus_placement_id):
			continue
		seen_placement_ids[focus_placement_id] = true
		focus_cell["source"] = "placement_focus_target"
		focus_cell["placementId"] = focus_placement_id
		focus_cell["requestedPlacementId"] = normalized_requested_placement_id
		focus_cell["lineRole"] = focus_line_role
		focus_cell["pieceId"] = ""
		result.append(focus_cell)
	for placement_variant in visible_placements:
		if result.size() >= max_count:
			return result
		if not (placement_variant is Dictionary):
			continue
		var placement: Dictionary = placement_variant as Dictionary
		var placement_line_role := str(placement.get("lineRole", "")).strip_edges()
		if normalized_preferred_line_role != "" and placement_line_role != normalized_preferred_line_role:
			continue
		var runtime_placement_id := str(placement.get("runtimePlacementId", placement.get("placement_id", ""))).strip_edges()
		if normalized_requested_placement_id != "" and runtime_placement_id != normalized_requested_placement_id:
			continue
		if seen_placement_ids.has(runtime_placement_id):
			continue
		var render_pieces_variant: Variant = placement.get("render_pieces", [])
		if render_pieces_variant is Array:
			for piece_variant in render_pieces_variant as Array:
				if not (piece_variant is Dictionary):
					continue
				var piece: Dictionary = piece_variant as Dictionary
				var piece_cell: Dictionary = _mainline_visual_smoke_cell_from_variant(piece.get("cell_1km", []))
				if not piece_cell.is_empty():
					piece_cell["source"] = "render_piece"
					piece_cell["placementId"] = runtime_placement_id
					piece_cell["requestedPlacementId"] = normalized_requested_placement_id
					piece_cell["lineRole"] = placement_line_role
					piece_cell["pieceId"] = str(piece.get("piece_id", ""))
					seen_placement_ids[runtime_placement_id] = true
					result.append(piece_cell)
					break
		var anchor_cell: Dictionary = _mainline_visual_smoke_cell_from_variant(placement.get("anchor_cell_1km", []))
		if not anchor_cell.is_empty() and not seen_placement_ids.has(runtime_placement_id) and result.size() < max_count:
			anchor_cell["source"] = "placement_anchor"
			anchor_cell["placementId"] = runtime_placement_id
			anchor_cell["requestedPlacementId"] = normalized_requested_placement_id
			anchor_cell["lineRole"] = placement_line_role
			anchor_cell["pieceId"] = ""
			seen_placement_ids[runtime_placement_id] = true
			result.append(anchor_cell)
	if normalized_preferred_line_role != "":
		for placement_variant in visible_placements:
			if result.size() >= max_count:
				return result
			if not (placement_variant is Dictionary):
				continue
			var placement: Dictionary = placement_variant as Dictionary
			var runtime_placement_id := str(placement.get("runtimePlacementId", placement.get("placement_id", ""))).strip_edges()
			if normalized_requested_placement_id != "" and runtime_placement_id != normalized_requested_placement_id:
				continue
			if seen_placement_ids.has(runtime_placement_id):
				continue
			var render_pieces_variant: Variant = placement.get("render_pieces", [])
			if render_pieces_variant is Array:
				for piece_variant in render_pieces_variant as Array:
					if not (piece_variant is Dictionary):
						continue
					var piece: Dictionary = piece_variant as Dictionary
					var piece_cell: Dictionary = _mainline_visual_smoke_cell_from_variant(piece.get("cell_1km", []))
					if not piece_cell.is_empty():
						piece_cell["source"] = "render_piece_fallback"
						piece_cell["placementId"] = runtime_placement_id
						piece_cell["requestedPlacementId"] = normalized_requested_placement_id
						piece_cell["lineRole"] = str(placement.get("lineRole", "")).strip_edges()
						piece_cell["pieceId"] = str(piece.get("piece_id", ""))
						seen_placement_ids[runtime_placement_id] = true
						result.append(piece_cell)
						break
		for focus_target_variant in focus_targets:
			if result.size() >= max_count:
				return result
			if not (focus_target_variant is Dictionary):
				continue
			var focus_target: Dictionary = focus_target_variant as Dictionary
			var focus_cell: Dictionary = _mainline_visual_smoke_cell_from_variant(focus_target.get("first_cell_1km", []))
			if not focus_cell.is_empty():
				var focus_placement_id := str(focus_target.get("runtime_placement_id", "")).strip_edges()
				if normalized_requested_placement_id != "" and focus_placement_id != normalized_requested_placement_id:
					continue
				if seen_placement_ids.has(focus_placement_id):
					continue
				focus_cell["source"] = "placement_focus_target_fallback"
				focus_cell["placementId"] = focus_placement_id
				focus_cell["requestedPlacementId"] = normalized_requested_placement_id
				focus_cell["lineRole"] = str(focus_target.get("line_role", "")).strip_edges()
				focus_cell["pieceId"] = ""
				seen_placement_ids[focus_placement_id] = true
				result.append(focus_cell)
	return result

func _mainline_visual_smoke_cell_from_variant(raw_cell: Variant) -> Dictionary:
	if raw_cell is Array:
		var raw_array: Array = raw_cell as Array
		if raw_array.size() >= 2:
			return {"x": maxi(0, int(raw_array[0])), "y": maxi(0, int(raw_array[1]))}
	if raw_cell is Dictionary:
		var raw_dict: Dictionary = raw_cell as Dictionary
		if raw_dict.has("x") and raw_dict.has("y"):
			return {"x": maxi(0, int(raw_dict.get("x", 0))), "y": maxi(0, int(raw_dict.get("y", 0)))}
	return {}

func _press_mainline_visual_smoke_overlay_close_button(panel_id: String) -> Dictionary:
	if _active_panel_id != panel_id:
		return {
			"attempted": true,
			"pressed": false,
			"closed": false,
			"reason": "active_panel_mismatch",
			"activePanelId": _active_panel_id,
		}
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {
			"attempted": true,
			"pressed": false,
			"closed": false,
			"reason": "overlay_missing",
			"activePanelId": _active_panel_id,
		}
	var close_button := _find_mainline_visual_smoke_visible_button(_active_overlay_panel, "CloseButton")
	if close_button == null:
		return {
			"attempted": true,
			"pressed": false,
			"closed": false,
			"reason": "close_button_missing",
			"activePanelId": _active_panel_id,
		}
	var clicked_action_id := str(close_button.get_meta("fullscreen_panel_close_action_id", "")).strip_edges()
	var clicked_token := str(close_button.get_meta("fullscreen_panel_close_button_token", "")).strip_edges()
	var clicked_contract := str(close_button.get_meta("fullscreen_panel_close_live_text_contract", "")).strip_edges()
	var clicked_label := str(close_button.get_meta("fullscreen_panel_close_live_text_label", close_button.text)).strip_edges()
	close_button.emit_signal("pressed")
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(0.15).timeout
	var closed := (
		_active_panel_id == ""
		and (_active_overlay_panel == null or not is_instance_valid(_active_overlay_panel))
	)
	return {
		"attempted": true,
		"pressed": true,
		"closed": closed,
		"reason": "closed" if closed else "still_open",
		"activePanelId": _active_panel_id,
		"closeButtonClickedActionId": clicked_action_id,
		"closeButtonClickedToken": clicked_token,
		"closeButtonClickedLiveTextContract": clicked_contract,
		"closeButtonClickedLiveTextLabel": clicked_label,
		"closeButtonClickVerified": (
			closed
			and clicked_action_id == "fullscreen_panel_close"
			and clicked_token == "fullscreen_panel_close_button_v1"
			and clicked_contract == "fullscreen_panel_close_live_text_v1"
			and clicked_label != ""
		),
	}

