			continue
		button.visible = true

func _find_world_tile_expedition_unit_id(tile_id: String) -> String:
	var normalized_tile_id := tile_id.strip_edges()
	if normalized_tile_id == "":
		return ""
	var world_units: Variant = WorldStore.world.get("units", [])
	if not (world_units is Array):
		return ""
	for unit_variant in world_units as Array:
		if not (unit_variant is Dictionary):
			continue
		var unit: Dictionary = unit_variant as Dictionary
		if str(unit.get("faction", "")).strip_edges() == _target_faction_id and str(unit.get("tileId", "")).strip_edges() == normalized_tile_id:
			return str(unit.get("id", "")).strip_edges()
	return ""

func _find_latest_world_tile_battle_record(tile_id: String) -> Dictionary:
	var feedback: Dictionary = WorldStore.world.get("feedback", {}) as Dictionary
	var records_variant: Variant = feedback.get("battleRecords", [])
	if not (records_variant is Array):
		return {}
	for record_variant in records_variant as Array:
		if not (record_variant is Dictionary):
			continue
		var record: Dictionary = record_variant as Dictionary
		if str(record.get("tileId", "")).strip_edges() == tile_id.strip_edges():
			return record.duplicate(true)
	return {}

func _format_main_map_immunity_until_label(raw_value: String) -> String:
	var normalized: String = raw_value.strip_edges()
	if normalized == "":
		return ""
	if normalized.ends_with("Z"):
		normalized = normalized.substr(0, normalized.length() - 1)
	normalized = normalized.replace("T", " ")
	if normalized.length() >= 16:
		normalized = normalized.substr(0, 16)
	return normalized

func _is_main_map_cell_context_immunity_active(context: Dictionary) -> bool:
	return bool(context.get("immunityActive", context.get("immunity_active", false)))

func _format_main_map_cell_immunity_summary(context: Dictionary) -> String:
	if not _is_main_map_cell_context_immunity_active(context):
		return ""
	var until_label: String = _format_main_map_immunity_until_label(str(context.get("immunityUntil", context.get("immunity_until", ""))))
	if until_label != "":
		return "免战保护中 | 至 %s" % until_label
	return "免战保护中"

func _format_world_action_failure_message(action_payload: Dictionary, action_name: String) -> String:
	var failure_code: String = str(action_payload.get("failureCode", action_payload.get("failure_code", ""))).strip_edges()
	match failure_code:
		"main_map_cell_immunity_active":
			var until_label: String = _format_main_map_immunity_until_label(str(action_payload.get("immunityUntil", action_payload.get("immunity_until", ""))))
			if until_label != "":
				return "免战保护中，暂不能占领\n保护至 %s" % until_label
			return "免战保护中，暂不能占领"
		"main_map_cell_conflict":
			return "地块状态已变化\n请刷新后再试"
		"invalid_main_map_cell":
			return "目标地块无效\n不能执行该操作"
	var backend_message: String = str(action_payload.get("message", "")).strip_edges()
	if backend_message != "":
		return backend_message
	return "%s 被服务器拒绝" % action_name

func _press_mainline_visual_smoke_world_movement_geography_feedback_fixture() -> Dictionary:
	if _api_client == null:
		return {
			"attempted": true,
			"ok": false,
			"reason": "api_client_missing",
			"movementGeographyFeedbackFixtureOk": false,
		}
	var samples := _resolve_mainline_visual_smoke_movement_geography_samples()
	var required_keys := [
		"cross_state_blocked_requires_pass",
		"state_boundary_pass_allowed",
		"mountain_blocked_requires_pass",
		"river_blocked_requires_dock",
		"river_crossing_dock_allowed",
	]
	for required_key in required_keys:
		if not samples.has(required_key):
			return {
				"attempted": true,
				"ok": false,
				"reason": "movement_geography_sample_missing:%s" % required_key,
				"movementGeographyFeedbackFixtureOk": false,
				"movementGeographySampleKeys": samples.keys(),
			}

	var feedback_by_code := {}
	for required_key in required_keys:
		var sample: Dictionary = samples.get(required_key, {}) as Dictionary
		var preview_payload := {
			"factionId": _target_faction_id,
			"fromTileId": str(sample.get("fromTileId", "")),
			"targetTileId": str(sample.get("targetTileId", "")),
		}
		var preview_result: Dictionary = await _api_client.post_world_action("previewMovementGeography", preview_payload, false)
		if not bool(preview_result.get("ok", false)):
			return {
				"attempted": true,
				"ok": false,
				"reason": "preview_request_failed:%s" % required_key,
				"payload": preview_payload,
				"response": preview_result,
				"movementGeographyFeedbackFixtureOk": false,
			}
		var preview_data: Dictionary = preview_result.get("data", {}) as Dictionary
		var receipt: Dictionary = preview_data.get("receipt", {}) as Dictionary
		var feedback: Dictionary = receipt.get("movementGeographyFeedback", {}) as Dictionary
		if str(feedback.get("code", "")) != required_key:
			return {
				"attempted": true,
				"ok": false,
				"reason": "preview_code_mismatch:%s" % required_key,
				"payload": preview_payload,
				"response": preview_data,
				"movementGeographyFeedbackFixtureOk": false,
			}
		feedback_by_code[required_key] = feedback

	var sea_result: Dictionary = await _press_mainline_visual_smoke_world_sea_route_status_fixture()
	var blocked_feedback: Dictionary = feedback_by_code.get("cross_state_blocked_requires_pass", {}) as Dictionary
	var mountain_feedback: Dictionary = feedback_by_code.get("mountain_blocked_requires_pass", {}) as Dictionary
	var river_feedback: Dictionary = feedback_by_code.get("river_blocked_requires_dock", {}) as Dictionary
	var dock_feedback: Dictionary = feedback_by_code.get("river_crossing_dock_allowed", {}) as Dictionary
	var pass_requirement: Dictionary = blocked_feedback.get("requiredPass", {}) as Dictionary
	var dock_requirement: Dictionary = river_feedback.get("requiredDock", {}) as Dictionary
	var blocked_reason := str(blocked_feedback.get("blockedReason", "")).strip_edges()
	var required_pass := str(pass_requirement.get("label", "")).strip_edges()
	var required_dock := str(dock_requirement.get("label", "")).strip_edges()
	var route_status := str(sea_result.get("seaRouteStatusRouteStatus", "")).strip_edges()
	var sea_boundary := str(blocked_feedback.get("seaRouteAuthorityBoundary", "")).strip_edges()
	var fixture_ok := (
		blocked_reason != ""
		and required_pass != ""
		and required_dock != ""
		and route_status == "route_open"
		and sea_boundary == "land_movement_only_sea_route_authority_is_independent"
		and bool(sea_result.get("seaRouteStatusFixtureOk", false))
		and bool(mountain_feedback.get("blockedReason", "") != "")
		and bool(dock_feedback.get("ok", false))
	)
	var summary_text := "地理移动：%s | 需关口=%s | 需渡口=%s | 海路=%s" % [
		blocked_reason,
