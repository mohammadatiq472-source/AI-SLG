func _build_player_history_panel_content() -> Control:
	var panel := PlayerHistoryPanelScript.new() as Control
	panel.name = "PlayerHistoryPanel"
	if panel.has_signal("timeline_recovery_requested"):
		panel.connect("timeline_recovery_requested", Callable(self, "_on_player_history_timeline_recovery_requested"))
	if _battle_report_pending_replay_request_id.strip_edges() != "" and panel.has_method("configure_dedicated_replay_mode"):
		panel.call("configure_dedicated_replay_mode", {
			"originSurface": "battle_report_detail",
			"closeReturnTarget": "battle_report_detail",
			"sourceBattleReportId": _battle_report_pending_replay_selected_report_id,
		})
	return panel

func _on_player_history_timeline_recovery_requested(recovery_kind: String) -> void:
	var resolved_kind := recovery_kind.strip_edges()
	var target_surface := _resolve_player_history_timeline_recovery_surface(resolved_kind)
	_player_history_timeline_recovery_host_count += 1
	_player_history_timeline_recovery_host_kind = resolved_kind
	_player_history_timeline_recovery_host_surface = target_surface
	_player_history_timeline_recovery_host_feedback = _resolve_player_history_timeline_recovery_feedback(target_surface)
	if resolved_kind == "ai_proposal_apply":
		_player_history_timeline_recovery_host_feedback = "已准备处理 AI 提案"
	if resolved_kind == "ai_proposal_denied":
		_player_history_timeline_recovery_host_feedback = "已记录 AI 提案驳回"
	if resolved_kind == "ai_execution_receipt":
		_player_history_timeline_recovery_host_feedback = "已准备查看 AI 执行回执"
	_player_history_timeline_recovery_surface_opened = false
	_player_history_timeline_recovery_surface_open_reason = "target_resolved"
	_player_history_timeline_recovery_internal_identity = _resolve_player_history_timeline_recovery_internal_identity(resolved_kind)
	_player_history_timeline_recovery_identity_resolved = _player_history_timeline_recovery_internal_identity.strip_edges() != ""
	_player_history_timeline_recovery_focus_payload = _resolve_player_history_timeline_recovery_focus_payload(resolved_kind)
	_apply_overlay_feedback(
		"player_history/timeline_recovery/%s" % target_surface,
		"requested",
		_player_history_timeline_recovery_host_feedback
	)
	if target_surface == "dedicated_replay":
		call_deferred("_open_player_history_timeline_recovery_surface", target_surface)
	elif target_surface == "battle_report_detail" or target_surface == "save_load" or target_surface == "civil_memory" or target_surface == "world_timeline" or target_surface == "ai_hub":
		call_deferred("_open_player_history_timeline_recovery_surface", target_surface)

func _resolve_player_history_timeline_recovery_surface(recovery_kind: String) -> String:
	match recovery_kind.strip_edges():
		"replay":
			return "dedicated_replay"
		"battle_report":
			return "battle_report_detail"
		"save":
			return "save_load"
		"civil_memory":
			return "civil_memory"
		"world_event":
			return "world_timeline"
		"ai_activity":
			return "ai_hub"
		"ai_proposal_apply":
			return "ai_hub"
		"ai_proposal_denied":
			return "ai_hub"
		"ai_execution_receipt":
			return "ai_hub"
		_:
			return "player_history"

func _resolve_player_history_timeline_recovery_feedback(target_surface: String) -> String:
	match target_surface.strip_edges():
		"dedicated_replay":
			return "已准备打开复盘"
		"battle_report_detail":
			return "已准备打开战报"
		"save_load":
			return "已准备查看存档"
		"civil_memory":
			return "已准备查看传闻"
		"world_timeline":
			return "已准备查看大事"
		"ai_hub":
			return "已准备查看 AI 行动"
		_:
			return "已定位天下纪事"

func _resolve_player_history_timeline_recovery_internal_identity(recovery_kind: String) -> String:
	var host := _resolve_mainline_visual_smoke_panel_root("player_history")
	if host == null:
		return ""
	var panel_node := _find_mainline_visual_smoke_visible_node_with_method(host, "get_timeline_recovery_internal_token")
	if panel_node == null:
		return ""
	return str(panel_node.call("get_timeline_recovery_internal_token", recovery_kind.strip_edges())).strip_edges()

func _resolve_player_history_timeline_recovery_focus_payload(recovery_kind: String) -> Dictionary:
	var host := _resolve_mainline_visual_smoke_panel_root("player_history")
	if host == null:
		return {}
	var panel_node := _find_mainline_visual_smoke_visible_node_with_method(host, "get_timeline_recovery_focus_payload")
	if panel_node == null:
		return {}
	var payload_variant: Variant = panel_node.call("get_timeline_recovery_focus_payload", recovery_kind.strip_edges())
	if payload_variant is Dictionary:
		return (payload_variant as Dictionary).duplicate(true)
	return {}

func _open_player_history_timeline_recovery_surface(target_surface: String) -> void:
	var resolved_surface := target_surface.strip_edges()
	if resolved_surface == "battle_report_detail":
		_open_overlay_panel("battle_report")
		await get_tree().process_frame
		await get_tree().process_frame
		var exact_match_opened := false
		if _active_overlay_panel != null and is_instance_valid(_active_overlay_panel) and _player_history_timeline_recovery_identity_resolved and _active_overlay_panel.has_method("open_report_detail_by_internal_id"):
			exact_match_opened = bool(_active_overlay_panel.call("open_report_detail_by_internal_id", _player_history_timeline_recovery_internal_identity))
		if not exact_match_opened and _active_overlay_panel != null and is_instance_valid(_active_overlay_panel) and _active_overlay_panel.has_method("set_active_page_id"):
			_active_overlay_panel.call("set_active_page_id", "detail")
		_player_history_timeline_recovery_surface_open_count += 1
		_player_history_timeline_recovery_surface_opened = true
		_player_history_timeline_recovery_surface_open_reason = "battle_report_detail_opened_exact_match" if exact_match_opened else ("battle_report_detail_opened_pending_match" if _player_history_timeline_recovery_identity_resolved else "battle_report_detail_opened_default")
		_apply_overlay_feedback("player_history/timeline_recovery/battle_report_detail", "opened", "战报详情")
		return
	if resolved_surface == "save_load":
		_open_overlay_panel("player_history")
		await get_tree().process_frame
		await get_tree().process_frame
		var panel_node := _find_mainline_visual_smoke_visible_node_with_method(_generated_panel_content, "open_save_restore_by_internal_id") if _generated_panel_content != null and is_instance_valid(_generated_panel_content) else null
		if panel_node == null:
			panel_node = _find_mainline_visual_smoke_visible_node_with_method(_full_screen_panel_host, "open_save_restore_by_internal_id") if _full_screen_panel_host != null and is_instance_valid(_full_screen_panel_host) else null
		var exact_slot_opened := false
		if panel_node != null and _player_history_timeline_recovery_identity_resolved:
			exact_slot_opened = bool(panel_node.call("open_save_restore_by_internal_id", _player_history_timeline_recovery_internal_identity))
		_player_history_timeline_recovery_surface_open_count += 1
		_player_history_timeline_recovery_surface_opened = true
		_player_history_timeline_recovery_surface_open_reason = "save_load_restore_opened_exact_match" if exact_slot_opened else ("save_load_restore_opened_pending_match" if _player_history_timeline_recovery_identity_resolved else "save_load_restore_opened_default")
		_apply_overlay_feedback("player_history/timeline_recovery/save_load", "opened", "存档恢复")
		return
	if resolved_surface == "civil_memory":
		_open_overlay_panel("world_event")
		await get_tree().process_frame
		await get_tree().process_frame
		var exact_civil_memory_opened := false
		if _active_overlay_panel != null and is_instance_valid(_active_overlay_panel) and _player_history_timeline_recovery_identity_resolved and _active_overlay_panel.has_method("open_civil_memory_by_internal_id"):
			exact_civil_memory_opened = bool(_active_overlay_panel.call("open_civil_memory_by_internal_id", _player_history_timeline_recovery_internal_identity, _player_history_timeline_recovery_focus_payload))
		_player_history_timeline_recovery_surface_open_count += 1
		_player_history_timeline_recovery_surface_opened = true
		_player_history_timeline_recovery_surface_open_reason = "civil_memory_opened_exact_focus" if exact_civil_memory_opened else ("civil_memory_opened_pending_focus" if _player_history_timeline_recovery_identity_resolved else "civil_memory_opened_via_world_event_activity")
		_apply_overlay_feedback("player_history/timeline_recovery/civil_memory", "opened", "传闻已定位")
		return
	if resolved_surface == "world_timeline":
		_open_overlay_panel("world_event")
		await get_tree().process_frame
		await get_tree().process_frame
		_player_history_timeline_recovery_surface_open_count += 1
		_player_history_timeline_recovery_surface_opened = true
		_player_history_timeline_recovery_surface_open_reason = "world_timeline_opened_via_world_event_activity"
		_apply_overlay_feedback("player_history/timeline_recovery/world_timeline", "opened", "天下大事")
		return
	if resolved_surface == "ai_hub":
		if _player_history_timeline_recovery_host_kind == "ai_proposal_apply":
			_seed_mainline_visual_smoke_ai_proposal_decision_surface()
			_open_overlay_panel_with_page("ai_hub", "agenda")
		else:
			_open_overlay_panel("ai_hub")
		await get_tree().process_frame
		await get_tree().process_frame
		_player_history_timeline_recovery_surface_open_count += 1
		_player_history_timeline_recovery_surface_opened = true
		_player_history_timeline_recovery_surface_open_reason = "ai_activity_opened_via_ai_hub"
		_apply_overlay_feedback("player_history/timeline_recovery/ai_activity", "opened", "AI 行动")
		return
	if target_surface.strip_edges() != "dedicated_replay":
		_player_history_timeline_recovery_surface_open_reason = "target_surface_not_opened"
		return
	_open_overlay_panel("player_history")
	await get_tree().process_frame
	await get_tree().process_frame
	var panel_node := _find_mainline_visual_smoke_visible_node_with_method(_generated_panel_content, "configure_dedicated_replay_mode") if _generated_panel_content != null and is_instance_valid(_generated_panel_content) else null
	if panel_node == null:
		panel_node = _find_mainline_visual_smoke_visible_node_with_method(_full_screen_panel_host, "configure_dedicated_replay_mode") if _full_screen_panel_host != null and is_instance_valid(_full_screen_panel_host) else null
	if panel_node == null:
		_player_history_timeline_recovery_surface_open_reason = "dedicated_replay_panel_missing"
		return
	panel_node.call("configure_dedicated_replay_mode", {
		"originSurface": "player_history_timeline",
		"closeReturnTarget": "player_history",
		"replayUnavailableCopyVisible": not _player_history_timeline_recovery_identity_resolved,
	})
	if _player_history_timeline_recovery_identity_resolved and panel_node.has_method("refresh_from_backend"):
		await panel_node.call("refresh_from_backend", 80, _player_history_timeline_recovery_internal_identity)
	_player_history_timeline_recovery_surface_open_count += 1
	_player_history_timeline_recovery_surface_opened = true
	_player_history_timeline_recovery_surface_open_reason = "dedicated_replay_identity_opened" if _player_history_timeline_recovery_identity_resolved else "dedicated_replay_unavailable_opened"
	_apply_overlay_feedback(
		"player_history/timeline_recovery/dedicated_replay",
		"opened",
		"战况回放" if _player_history_timeline_recovery_identity_resolved else "回放已不可用"
	)

func _on_shell_troop_slot_requested(troop_id: String) -> void:
	var resolved_troop_id := troop_id.strip_edges()
	if resolved_troop_id == "":
		return
	await _focus_shell_troop_slot_on_main_map(resolved_troop_id)
	_apply_overlay_runtime_state_patch(_resolve_overlay_runtime_helper().build_shell_troop_runtime_patch(resolved_troop_id))
	_open_overlay_panel("troop")

func _focus_shell_troop_slot_on_main_map(troop_id: String) -> Dictionary:
	var resolved_troop_id := troop_id.strip_edges()
	if resolved_troop_id == "":
		return {"attempted": true, "ok": false, "reason": "troop_id_missing"}
	var unit := _find_target_unit_by_id(resolved_troop_id)
	if unit.is_empty():
		return {"attempted": true, "ok": false, "reason": "troop_unit_missing", "troopId": resolved_troop_id}
	var tile_id := str(unit.get("tileId", "")).strip_edges()
	if tile_id == "":
		return {"attempted": true, "ok": false, "reason": "troop_tile_id_missing", "troopId": resolved_troop_id}
	var focus_result := await _focus_mainline_visual_smoke_map_unit_tile(tile_id)
	var ok := bool(focus_result.get("ok", false))
	if ok:
		_record_last_action("left_troop_rail/jump_to_unit/%s" % resolved_troop_id, "focused")
		_update_runtime_label("left troop rail jump focused")
	return {
		"attempted": true,
		"ok": ok,
		"reason": "left_troop_rail_jump_focus_ok" if ok else str(focus_result.get("reason", "left_troop_rail_jump_focus_failed")),
		"troopId": resolved_troop_id,
		"tileId": tile_id,
		"focusResult": focus_result,
	}

func _find_target_unit_by_id(troop_id: String) -> Dictionary:
	var resolved_troop_id := troop_id.strip_edges()
	if resolved_troop_id == "":
		return {}
	for unit_variant in _read_target_units():
		if not (unit_variant is Dictionary):
			continue
		var unit: Dictionary = unit_variant as Dictionary
		if str(unit.get("id", "")).strip_edges() == resolved_troop_id:
			return unit.duplicate(true)
	return {}

func _resolve_unit_status_copy(status_id: String) -> String:
	match status_id.strip_edges().to_lower():
		"marching", "moving":
			return "行军"
		"engaged", "battle":
			return "交战"
		"fallback", "retreat":
			return "回撤"
		"escort":
			return "护送"
		"guard", "garrison", "defend":
			return "驻守"
		"support":
			return "支援"
		"idle", "":
			return "待命"
		_:
			return status_id

func _on_snapshot_overlay_state_signal(value_id: String, signal_kind: String) -> void:
	var state_feedback := _resolve_overlay_state_feedback(signal_kind, value_id)
	if state_feedback.is_empty():
		return
	_apply_overlay_runtime_state_patch(state_feedback.get("runtime_state_patch", {}) as Dictionary)
	_apply_overlay_feedback(
		str(state_feedback.get("record_path", "")),
		str(state_feedback.get("record_state", "")),
		str(state_feedback.get("runtime_label", ""))
	)

func _resolve_overlay_state_feedback(signal_kind: String, value_id: String) -> Dictionary:
	return _resolve_overlay_runtime_helper().resolve_state_feedback_from_state(
		_resolve_active_snapshot_overlay_spec(),
		signal_kind,
		value_id
	)

func _apply_overlay_feedback(record_path: String, record_state: String, runtime_label: String) -> void:
	if record_path != "" and record_state != "":
		_record_last_action(record_path, record_state)
	if runtime_label != "":
		_update_runtime_label(runtime_label)

func _on_snapshot_overlay_extra_action_requested(arg1: String = "", arg2: String = "", adapter_method: String = "") -> void:
	var resolved_method := adapter_method.strip_edges()
	if resolved_method == "":
		return
	var adapter = _resolve_slg_domain_action_adapter()
	if not adapter.has_method(resolved_method):
		return
	var adapter_args := _build_overlay_adapter_args(resolved_method, arg1, arg2)
	if adapter_args.is_empty():
		return
	var outcome: Dictionary = await adapter.callv(resolved_method, adapter_args)
	await _apply_overlay_action_outcome(outcome)

func _build_overlay_adapter_args(adapter_method: String, arg1: String, arg2: String) -> Array:
	return _resolve_overlay_runtime_helper().build_adapter_args_from_state(
		_resolve_active_snapshot_overlay_spec(),
		adapter_method,
		arg1,
		arg2
	)

