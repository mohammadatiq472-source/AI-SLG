func _press_mainline_visual_smoke_battle_report_open_stats_scroll(panel_id: String) -> Dictionary:
	var open_result := await _press_mainline_visual_smoke_battle_report_open_detail_tab(panel_id, "StatsTabButton", "stats")
	if not bool(open_result.get("ok", false)):
		open_result["scrollAttempted"] = false
		return open_result
	var panel_control := _active_overlay_panel as Control
	if panel_control == null:
		open_result["ok"] = false
		open_result["scrollAttempted"] = true
		open_result["reason"] = "overlay_not_control_after_stats_open"
		return open_result
	var detail_scroll := _find_mainline_visual_smoke_visible_scroll_container(panel_control, "DetailPageScroll")
	if detail_scroll == null:
		open_result["ok"] = false
		open_result["scrollAttempted"] = true
		open_result["reason"] = "detail_page_scroll_missing"
		return open_result
	var before_scroll := detail_scroll.scroll_vertical
	detail_scroll.scroll_vertical = 100000
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(1.0).timeout
	var after_scroll := detail_scroll.scroll_vertical
	var below_fold_round_count := _count_mainline_visual_smoke_visible_nodes_by_name_prefix(panel_control, "SOM_D11_RoundTimeline")
	var below_fold_metric_count := _count_mainline_visual_smoke_visible_nodes_by_name_prefix(panel_control, "StatsMetric_")
	var scroll_moved := after_scroll > before_scroll
	var below_fold_ok := below_fold_round_count >= 1 and below_fold_metric_count >= 4
	open_result["ok"] = bool(open_result.get("ok", false)) and scroll_moved and below_fold_ok
	open_result["reason"] = "stats_below_fold_scrolled" if bool(open_result.get("ok", false)) else "stats_below_fold_not_verified"
	open_result["scrollAttempted"] = true
	open_result["detailScrollBefore"] = before_scroll
	open_result["detailScrollAfter"] = after_scroll
	open_result["detailScrollMoved"] = scroll_moved
	open_result["belowFoldRoundTimelineCount"] = below_fold_round_count
	open_result["belowFoldStatsMetricCount"] = below_fold_metric_count
	open_result["belowFoldOk"] = below_fold_ok
	return open_result

func _record_world_task_event_from_ui(task_id: String, kind: String, source_id: String, summary: String = "") -> Dictionary:
