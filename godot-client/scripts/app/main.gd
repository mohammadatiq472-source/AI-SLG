func _press_mainline_visual_smoke_tianxia_yutu_state_region_drilldown_jump() -> Dictionary:
	var setup: Dictionary = await _prepare_mainline_visual_smoke_tianxia_yutu_panel()
	if not bool(setup.get("ok", false)):
		return {
			"attempted": true,
			"ok": false,
			"reason": "tianxia_yutu_state_region_drilldown_setup_failed",
			"setup": setup,
		}
	if _is_tianxia_yutu_mobile_viewport():
		_tianxia_yutu_navigation_panel_expanded = true
	_refresh_tianxia_yutu_scale_selector()
	var visible_scale_catalog: Array = _tianxia_yutu_visible_scale_catalog()
	_refresh_tianxia_yutu_state_region_selectors()
	var scale_selected_ok := false
	if _tianxia_yutu_scale_selector != null:
		var preferred_index := -1
		for scale_index in range(_tianxia_yutu_scale_selector.get_item_count()):
			var scale_metadata: Variant = _tianxia_yutu_scale_selector.get_item_metadata(scale_index)
			var scale_id: String = str(scale_metadata).strip_edges().to_lower()
			if scale_id == "16k":
				preferred_index = scale_index
				break
			if preferred_index < 0 and _is_tianxia_yutu_visible_scale_preset_id(scale_id):
				preferred_index = scale_index
		if preferred_index >= 0:
			_tianxia_yutu_scale_selector.select(preferred_index)
			var selected_metadata: Variant = _tianxia_yutu_scale_selector.get_item_metadata(preferred_index)
			_tianxia_yutu_scale_preset_id = str(selected_metadata).strip_edges().to_lower()
			await _on_tianxia_yutu_scale_preset_selected(preferred_index)
			scale_selected_ok = _is_tianxia_yutu_visible_scale_preset_id(_tianxia_yutu_scale_preset_id)
	if _tianxia_yutu_scale_selector != null and not scale_selected_ok and not visible_scale_catalog.is_empty():
		var fallback_item_metadata: Variant = visible_scale_catalog[0]
		if fallback_item_metadata is Dictionary:
			var fallback_id := str((fallback_item_metadata as Dictionary).get("id", "")).strip_edges().to_lower()
			var fallback_index := -1
			for scale_index in range(_tianxia_yutu_scale_selector.get_item_count()):
				var scale_metadata: Variant = _tianxia_yutu_scale_selector.get_item_metadata(scale_index)
				if str(scale_metadata).strip_edges().to_lower() == fallback_id:
					fallback_index = scale_index
					break
			if fallback_index >= 0:
				_tianxia_yutu_scale_selector.select(fallback_index)
				_tianxia_yutu_scale_preset_id = str(_tianxia_yutu_scale_selector.get_item_metadata(fallback_index)).strip_edges().to_lower()
				await _on_tianxia_yutu_scale_preset_selected(fallback_index)
				scale_selected_ok = _is_tianxia_yutu_visible_scale_preset_id(_tianxia_yutu_scale_preset_id)
	var state_selected_ok := false
	var fallback_state_index := -1
	if _tianxia_yutu_state_selector != null:
		for state_index in range(_tianxia_yutu_state_selector.get_item_count()):
			var state_variant: Variant = _tianxia_yutu_state_selector.get_item_metadata(state_index)
			if not (state_variant is Dictionary):
				continue
			var state_entry: Dictionary = state_variant as Dictionary
			var regions: Array = state_entry.get("regions", []) as Array if state_entry.get("regions", []) is Array else []
			if regions.is_empty():
				continue
			if fallback_state_index < 0:
				fallback_state_index = state_index
			var state_id := _tianxia_yutu_state_entry_id(state_entry)
			var state_label := str(state_entry.get("state_label", state_entry.get("_state_key", ""))).strip_edges()
			if state_id != "jiaozhou" and state_label != "交州":
				continue
			_tianxia_yutu_state_selector.select(state_index)
			_on_tianxia_yutu_state_drilldown_selected(state_index)
			state_selected_ok = _tianxia_yutu_selected_state_id != ""
			break
	if not state_selected_ok and fallback_state_index >= 0 and _tianxia_yutu_state_selector != null:
		_tianxia_yutu_state_selector.select(fallback_state_index)
		_on_tianxia_yutu_state_drilldown_selected(fallback_state_index)
		state_selected_ok = _tianxia_yutu_selected_state_id != ""
	var region_selected_ok := false
	if _tianxia_yutu_region_selector != null and _tianxia_yutu_region_selector.get_item_count() > 0:
		var preferred_region_index := -1
		for region_index in range(_tianxia_yutu_region_selector.get_item_count()):
			var region_variant: Variant = _tianxia_yutu_region_selector.get_item_metadata(region_index)
			if not (region_variant is Dictionary):
				continue
			var region_entry: Dictionary = region_variant as Dictionary
			var region_id := str(region_entry.get("region_id", "")).strip_edges()
			var region_label := str(region_entry.get("region_label", region_id)).strip_edges()
			if region_id == "cmd_auto_148" or region_label == "苍梧郡":
				preferred_region_index = region_index
				break
		if preferred_region_index < 0:
			preferred_region_index = 0
		_tianxia_yutu_region_selector.select(preferred_region_index)
		_on_tianxia_yutu_region_drilldown_selected(preferred_region_index)
		region_selected_ok = _tianxia_yutu_selected_region_id != "" and not _tianxia_yutu_last_jump_target.is_empty()
	await get_tree().process_frame
	await get_tree().process_frame
	_refresh_tianxia_yutu_jump_panel()
	var panel_summary_before: Dictionary = _read_tianxia_yutu_explicit_jump_summary()
	var map_summary_before: Dictionary = _read_main_map_streaming_debug_summary()
	var before_jump_screenshot: Dictionary = _save_mainline_visual_smoke_screenshot(_mainline_visual_smoke_aux_screenshot_path("00_tianxia_yutu_state_region_drilldown_before_jump.png"))
	var before_jump_count: int = _tianxia_yutu_explicit_jump_count
	var jump_result: Dictionary = await _execute_tianxia_yutu_explicit_jump(_tianxia_yutu_last_jump_target, "state_region_drilldown")
	var gameplay_wait: Dictionary = await _wait_for_mainline_visual_smoke_main_map_mode(MAIN_MAP_VIEW_MODE_GAMEPLAY, false)
	var deadline_msec: int = Time.get_ticks_msec() + 5000
	while Time.get_ticks_msec() < deadline_msec and _tianxia_yutu_explicit_jump_count <= before_jump_count:
		await get_tree().create_timer(0.1).timeout
	var panel_summary_after: Dictionary = _read_tianxia_yutu_explicit_jump_summary()
	var last_jump: Dictionary = panel_summary_after.get("lastExplicitJump", {}) as Dictionary
	var target: Dictionary = panel_summary_before.get("jumpTarget", {}) as Dictionary
	var target_scope: String = str(target.get("target_scope", target.get("kind", ""))).strip_edges()
	var drilldown_label_density_relief_count: int = (
		int(map_summary_before.get("tianxiaYutuDuplicateLabelSuppressionCount", 0))
		+ int(map_summary_before.get("tianxiaYutuGateLabelBudgetSkipCount", 0))
		+ int(map_summary_before.get("tianxiaYutuCityLabelBudgetSkipCount", 0))
		+ int(map_summary_before.get("tianxiaYutuNormalDenseAdminLabelSuppressionCount", 0))
	)
	var ok := (
		scale_selected_ok
		and region_selected_ok
		and bool(panel_summary_before.get("panelVisible", false))
		and bool(panel_summary_before.get("drilldownRowVisible", false))
		and (panel_summary_before.get("visibleMainWorldTextControls", []) as Array).is_empty()
		and _is_tianxia_yutu_visible_scale_preset_id(str(panel_summary_before.get("scalePresetId", "")))
		and _tianxia_yutu_visible_scale_catalog().size() >= 1
		and int(panel_summary_before.get("stateDrilldownCount", 0)) >= 10
		and int(panel_summary_before.get("regionDrilldownCount", 0)) >= 1
		and str(panel_summary_before.get("selectedRegionId", "")) != ""
		and str(map_summary_before.get("tianxiaYutuSelectedRegionId", "")) == str(panel_summary_before.get("selectedRegionId", ""))
		and int(map_summary_before.get("tianxiaYutuRegionLabelDrawCount", 0)) >= 1
		and drilldown_label_density_relief_count >= 1
		and int(panel_summary_before.get("filteredJumpTargetCount", 0)) >= 1
		and (target_scope == "commandery_seat" or target_scope == "coordinate" or target_scope == "city")
		and bool(jump_result.get("ok", false))
		and bool(last_jump.get("ok", false))
		and _tianxia_yutu_explicit_jump_count > before_jump_count
		and bool(gameplay_wait.get("ok", false))
	)
	return {
		"attempted": true,
		"ok": ok,
		"reason": "tianxia_yutu_state_region_drilldown_jump" if ok else "tianxia_yutu_state_region_drilldown_jump_failed",
		"scaleSelectedOk": scale_selected_ok,
		"stateSelectedOk": state_selected_ok,
		"regionSelectedOk": region_selected_ok,
		"targetScope": target_scope,
		"drilldownLabelDensityReliefCount": drilldown_label_density_relief_count,
		"setup": setup,
		"panelSummaryBefore": panel_summary_before,
		"panelSummaryAfter": panel_summary_after,
		"mapSummaryBefore": map_summary_before,
		"beforeJumpScreenshot": before_jump_screenshot,
		"jumpResult": jump_result,
		"gameplayWait": gameplay_wait,
	}


func _press_mainline_visual_smoke_tianxia_yutu_all_state_drilldown_coverage() -> Dictionary:
	var setup: Dictionary = await _prepare_mainline_visual_smoke_tianxia_yutu_panel()
	if not bool(setup.get("ok", false)):
		return {
			"attempted": true,
			"ok": false,
			"reason": "tianxia_yutu_all_state_drilldown_setup_failed",
			"setup": setup,
		}
	if _is_tianxia_yutu_mobile_viewport():
		_tianxia_yutu_navigation_panel_expanded = true
	_refresh_tianxia_yutu_state_region_selectors()
	_refresh_tianxia_yutu_jump_panel()
	await get_tree().process_frame
	await get_tree().process_frame

	var state_count: int = _tianxia_yutu_state_selector.get_item_count() if _tianxia_yutu_state_selector != null else 0
	var checked_states: Array = []
	var failed_states: Array = []
	for state_index in range(state_count):
		if _tianxia_yutu_state_selector == null:
			break
		var state_variant: Variant = _tianxia_yutu_state_selector.get_item_metadata(state_index)
		if not (state_variant is Dictionary):
			failed_states.append({"index": state_index, "reason": "state_metadata_missing"})
			continue
		var state_entry: Dictionary = state_variant as Dictionary
		var expected_state_id: String = _tianxia_yutu_state_entry_id(state_entry)
		var state_label: String = str(state_entry.get("state_label", state_entry.get("_state_key", expected_state_id))).strip_edges()
		_tianxia_yutu_state_selector.select(state_index)
		_on_tianxia_yutu_state_drilldown_selected(state_index)
		await get_tree().process_frame
		await get_tree().process_frame
		_refresh_tianxia_yutu_jump_panel()
		var state_panel_summary: Dictionary = _read_tianxia_yutu_explicit_jump_summary()
		var state_map_summary: Dictionary = _read_main_map_streaming_debug_summary()
		var region_count: int = _tianxia_yutu_region_selector.get_item_count() if _tianxia_yutu_region_selector != null else 0
		var state_ok: bool = (
			expected_state_id != ""
			and str(state_panel_summary.get("selectedStateId", "")) == expected_state_id
			and region_count > 0
			and str(state_map_summary.get("tianxiaYutuSelectedStateId", "")) == expected_state_id
			and int(state_map_summary.get("tianxiaYutuAdminFocusAssetMaskDrawCount", 0)) >= 1
			and bool(state_map_summary.get("tianxiaYutuAdminFocusMaskHardRequired", false))
			and int(state_map_summary.get("tianxiaYutuAdminFocusMaskMissingCount", 0)) == 0
			and int(state_map_summary.get("tianxiaYutuAdminFocusMaskLoadFailedCount", 0)) == 0
			and int(state_map_summary.get("tianxiaYutuAdminFocusRuntimeHullBlockedCount", 0)) == 0
		)
		if not state_ok:
			failed_states.append({
				"index": state_index,
				"stateId": expected_state_id,
				"stateLabel": state_label,
				"reason": "state_drilldown_or_focus_failed",
				"regionCount": region_count,
				"selectedStateId": state_panel_summary.get("selectedStateId", ""),
				"mapSelectedStateId": state_map_summary.get("tianxiaYutuSelectedStateId", ""),
				"stateFocusShapeDrawCount": state_map_summary.get("tianxiaYutuStateFocusShapeDrawCount", 0),
				"adminFocusAssetMaskDrawCount": state_map_summary.get("tianxiaYutuAdminFocusAssetMaskDrawCount", 0),
				"adminFocusMaskHardRequired": state_map_summary.get("tianxiaYutuAdminFocusMaskHardRequired", false),
				"adminFocusMaskMissingCount": state_map_summary.get("tianxiaYutuAdminFocusMaskMissingCount", 0),
				"adminFocusMaskLoadFailedCount": state_map_summary.get("tianxiaYutuAdminFocusMaskLoadFailedCount", 0),
				"adminFocusRuntimeHullBlockedCount": state_map_summary.get("tianxiaYutuAdminFocusRuntimeHullBlockedCount", 0),
			})
			continue

		_tianxia_yutu_region_selector.select(0)
		_on_tianxia_yutu_region_drilldown_selected(0)
		await get_tree().process_frame
		await get_tree().process_frame
		_refresh_tianxia_yutu_jump_panel()
		var region_panel_summary: Dictionary = _read_tianxia_yutu_explicit_jump_summary()
		var region_map_summary: Dictionary = _read_main_map_streaming_debug_summary()
		var selected_region_id: String = str(region_panel_summary.get("selectedRegionId", "")).strip_edges()
		var region_ok: bool = (
			selected_region_id != ""
			and str(region_map_summary.get("tianxiaYutuSelectedRegionId", "")) == selected_region_id
			and int(region_map_summary.get("tianxiaYutuAdminFocusAssetMaskDrawCount", 0)) >= 1
			and bool(region_map_summary.get("tianxiaYutuAdminFocusMaskHardRequired", false))
			and int(region_map_summary.get("tianxiaYutuAdminFocusMaskMissingCount", 0)) == 0
			and int(region_map_summary.get("tianxiaYutuAdminFocusMaskLoadFailedCount", 0)) == 0
			and int(region_map_summary.get("tianxiaYutuAdminFocusRuntimeHullBlockedCount", 0)) == 0
			and int(region_map_summary.get("tianxiaYutuRegionFocusBoundaryDrawCount", 0)) >= 1
		)
		if not region_ok:
			failed_states.append({
				"index": state_index,
				"stateId": expected_state_id,
				"stateLabel": state_label,
				"reason": "region_drilldown_or_focus_failed",
				"regionCount": region_count,
				"selectedRegionId": selected_region_id,
				"mapSelectedRegionId": region_map_summary.get("tianxiaYutuSelectedRegionId", ""),
				"regionFocusBoundaryDrawCount": region_map_summary.get("tianxiaYutuRegionFocusBoundaryDrawCount", 0),
				"adminFocusAssetMaskDrawCount": region_map_summary.get("tianxiaYutuAdminFocusAssetMaskDrawCount", 0),
				"adminFocusMaskHardRequired": region_map_summary.get("tianxiaYutuAdminFocusMaskHardRequired", false),
				"adminFocusMaskMissingCount": region_map_summary.get("tianxiaYutuAdminFocusMaskMissingCount", 0),
				"adminFocusMaskLoadFailedCount": region_map_summary.get("tianxiaYutuAdminFocusMaskLoadFailedCount", 0),
				"adminFocusRuntimeHullBlockedCount": region_map_summary.get("tianxiaYutuAdminFocusRuntimeHullBlockedCount", 0),
				"regionLabelDrawCount": region_map_summary.get("tianxiaYutuRegionLabelDrawCount", 0),
			})
			continue
		checked_states.append({
			"index": state_index,
			"stateId": expected_state_id,
			"stateLabel": state_label,
			"regionCount": region_count,
			"selectedRegionId": selected_region_id,
		})

	var final_screenshot: Dictionary = _save_mainline_visual_smoke_screenshot(_mainline_visual_smoke_aux_screenshot_path("00_tianxia_yutu_all_state_drilldown_coverage_final.png"))
	var ok: bool = state_count > 0 and checked_states.size() == state_count and failed_states.is_empty()
	return {
		"attempted": true,
		"ok": ok,
		"reason": "tianxia_yutu_all_state_drilldown_coverage" if ok else "tianxia_yutu_all_state_drilldown_coverage_failed",
		"stateCount": state_count,
		"checkedStateCount": checked_states.size(),
		"failedStateCount": failed_states.size(),
		"checkedStateSamples": checked_states.slice(0, mini(8, checked_states.size())),
		"failedStates": failed_states,
		"setup": setup,
		"finalScreenshot": final_screenshot,
		"panelSummary": _read_tianxia_yutu_explicit_jump_summary(),
		"mapSummary": _read_main_map_streaming_debug_summary(),
	}


func _tianxia_yutu_state_detail_screenshot_case_by_id(state_id: String) -> Dictionary:
	var normalized_state_id := state_id.strip_edges()
	for case_variant in TIANXIA_YUTU_STATE_DETAIL_SCREENSHOT_CASES:
		if not (case_variant is Dictionary):
			continue
		var case_entry: Dictionary = case_variant as Dictionary
		if str(case_entry.get("stateId", "")).strip_edges() == normalized_state_id:
			return case_entry.duplicate(true)
	return {}


func _tianxia_yutu_state_detail_default_state_ids(default_all: bool) -> Array:
	var state_ids: Array = []
	for case_variant in TIANXIA_YUTU_STATE_DETAIL_SCREENSHOT_CASES:
		if not (case_variant is Dictionary):
			continue
		var case_entry: Dictionary = case_variant as Dictionary
		var state_id := str(case_entry.get("stateId", "")).strip_edges()
		if state_id == "":
			continue
		state_ids.append(state_id)
		if not default_all:
			break
	return state_ids


func _read_tianxia_yutu_state_detail_requested_ids(default_all: bool) -> Array:
	var raw_state_ids := OS.get_environment("SLG_MAINLINE_VISUAL_SMOKE_STATE_IDS").strip_edges()
	var requested: Array = []
	if raw_state_ids != "":
		for raw_part in raw_state_ids.split(",", false):
			var state_id := str(raw_part).strip_edges()
			if state_id != "" and not requested.has(state_id):
				requested.append(state_id)
	if requested.is_empty():
		requested = _tianxia_yutu_state_detail_default_state_ids(default_all)
	return requested


func _select_tianxia_yutu_state_detail_target(state_id: String) -> Dictionary:
	_refresh_tianxia_yutu_state_region_selectors()
	var selected_index := -1
	var selected_entry: Dictionary = {}
	if _tianxia_yutu_state_selector != null:
		for state_index in range(_tianxia_yutu_state_selector.get_item_count()):
			var state_variant: Variant = _tianxia_yutu_state_selector.get_item_metadata(state_index)
			if not (state_variant is Dictionary):
				continue
			var state_entry: Dictionary = state_variant as Dictionary
			var candidate_state_id := _tianxia_yutu_state_entry_id(state_entry)
			var candidate_state_key := str(state_entry.get("_state_key", "")).strip_edges()
			var candidate_state_label := str(state_entry.get("state_label", "")).strip_edges()
			if state_id == candidate_state_id or state_id == candidate_state_key or state_id == candidate_state_label:
				selected_index = state_index
				selected_entry = state_entry.duplicate(true)
				break
	if selected_index >= 0 and _tianxia_yutu_state_selector != null:
		_tianxia_yutu_state_selector.select(selected_index)
		_on_tianxia_yutu_state_drilldown_selected(selected_index)
		await get_tree().process_frame
		await get_tree().process_frame
		_refresh_tianxia_yutu_jump_panel()
	var panel_summary: Dictionary = _read_tianxia_yutu_explicit_jump_summary()
	var map_summary: Dictionary = _read_main_map_streaming_debug_summary()
	return {
		"ok": selected_index >= 0 and str(map_summary.get("tianxiaYutuSelectedStateId", panel_summary.get("selectedStateId", ""))).strip_edges() == state_id,
		"stateId": state_id,
		"selectedIndex": selected_index,
		"selectedEntry": selected_entry,
		"panelSelectedStateId": str(panel_summary.get("selectedStateId", "")).strip_edges(),
		"mapSelectedStateId": str(map_summary.get("tianxiaYutuSelectedStateId", "")).strip_edges(),
		"panelSummary": panel_summary,
		"mapSummary": map_summary,
	}


func _build_tianxia_yutu_state_detail_zoom_case_result(case_entry: Dictionary, case_index: int, action_id: String) -> Dictionary:
	var state_id := str(case_entry.get("stateId", "")).strip_edges()
	var failure_reasons: Array = []
	var select_result: Dictionary = await _select_tianxia_yutu_state_detail_target(state_id)
	if not bool(select_result.get("ok", false)):
		failure_reasons.append("state_selector_or_map_selected_state_mismatch")
	var pivot_cell: Dictionary = case_entry.get("recommendedPivotCell", {}) as Dictionary if case_entry.get("recommendedPivotCell", {}) is Dictionary else {}
	var recommended_zoom: Dictionary = case_entry.get("recommendedZoom", {}) as Dictionary if case_entry.get("recommendedZoom", {}) is Dictionary else {}
	var screenshot_zoom := float(recommended_zoom.get("screenshotZoom", recommended_zoom.get("stateFitZoomFor2k", 1.0)))
	if pivot_cell.is_empty():
		failure_reasons.append("recommended_pivot_missing")
	elif _map_grid != null and _map_grid.has_method("focus_tianxia_yutu_cell"):
		_map_grid.call(
			"focus_tianxia_yutu_cell",
			int(pivot_cell.get("x", TIANXIA_YUTU_DEFAULT_CENTER_X)),
			int(pivot_cell.get("y", TIANXIA_YUTU_DEFAULT_CENTER_Y)),
			screenshot_zoom,
			state_id
		)
	else:
		failure_reasons.append("map_grid_focus_tianxia_yutu_cell_missing")
	await get_tree().process_frame
	await get_tree().process_frame
	_refresh_tianxia_yutu_jump_panel()
	var map_summary: Dictionary = _read_main_map_streaming_debug_summary()
	var runtime_summary: Dictionary = _read_camera_zoom_focus_runtime_summary()
	var state_fill_ratio_2k := float(map_summary.get("stateFillRatio2k", runtime_summary.get("stateFillRatio2k", 0.0)))
	var expected_min := float(case_entry.get("expectedStateFillRatio2kMin", 0.62))
	if state_fill_ratio_2k < expected_min:
		failure_reasons.append("stateFillRatio2k_below_expected_min")
	var counts: Dictionary = case_entry.get("counts", {}) as Dictionary if case_entry.get("counts", {}) is Dictionary else {}
	if not bool(case_entry.get("maskOnly", false)):
		if int(counts.get("city", 0)) <= 0:
			failure_reasons.append("seed_complete_city_count_missing")
		if int(counts.get("road", 0)) <= 0:
			failure_reasons.append("seed_complete_road_count_missing")
		if int(counts.get("gate", 0)) <= 0:
			failure_reasons.append("seed_complete_gate_count_missing")
	var screenshot_file_name := "%02d_tianxia_yutu_state_detail_zoom.png" % [case_index + 1]
	var screenshot: Dictionary = _save_mainline_visual_smoke_screenshot(_mainline_visual_smoke_aux_screenshot_path(screenshot_file_name))
	if not bool(screenshot.get("ok", false)):
		failure_reasons.append("screenshot_capture_failed")
	return {
		"stateDetailZoomAction": action_id,
		"stateDetailZoomContract": TIANXIA_YUTU_STATE_DETAIL_SCREENSHOT_CONTRACT,
		"stateId": state_id,
		"riskCategories": case_entry.get("riskCategories", []),
		"stateBoundsCells": case_entry.get("stateBoundsCells", {}),
		"stateBoundsPx": case_entry.get("stateBoundsPx", {}),
		"recommendedPivotCell": pivot_cell,
		"recommendedPivotPx": case_entry.get("recommendedPivotPx", {}),
		"recommendedZoom": recommended_zoom,
		"expectedStateFillRatio2kMin": expected_min,
		"expectedStateFillRatio2k": float(case_entry.get("expectedStateFillRatio2k", 0.0)),
		"stateFillRatio2k": state_fill_ratio_2k,
		"stateFillRatio2kSource": "map_grid.get_main_map_streaming_debug_summary.stateFillRatio2k",
		"maskOnly": bool(case_entry.get("maskOnly", false)),
		"highResAssetRequired": bool(case_entry.get("highResAssetRequired", true)),
		"counts": counts,
		"cityCount": int(counts.get("city", 0)),
		"roadCount": int(counts.get("road", 0)),
		"strategicNodeCount": int(counts.get("strategicNode", 0)),
		"gateCount": int(counts.get("gate", 0)),
		"fallbackReason": str(case_entry.get("fallbackReason", "")).strip_edges(),
		"rejectionBoundary": str(case_entry.get("rejectionBoundary", "")).strip_edges(),
		"failureReasons": failure_reasons,
		"selection": select_result,
		"mapSummary": map_summary,
		"cameraZoomFocusRuntimeSummary": runtime_summary,
		"screenshot": screenshot,
	}


func _run_mainline_visual_smoke_tianxia_yutu_state_detail_zoom_cases(action_id: String, default_all: bool) -> Dictionary:
	var setup: Dictionary = await _prepare_mainline_visual_smoke_tianxia_yutu_panel()
	if not bool(setup.get("ok", false)):
		return {
			"attempted": true,
			"ok": false,
			"reason": "%s_setup_failed" % action_id,
			"stateDetailZoomAction": action_id,
			"stateDetailZoomContract": TIANXIA_YUTU_STATE_DETAIL_SCREENSHOT_CONTRACT,
			"stateDetailZoomRegisteredButNotHeavyValidated": true,
			"setup": setup,
		}
	if _is_tianxia_yutu_mobile_viewport():
		_tianxia_yutu_navigation_panel_expanded = true
	_refresh_tianxia_yutu_scale_selector()
	_refresh_tianxia_yutu_state_region_selectors()
	_refresh_tianxia_yutu_jump_panel()
	await get_tree().process_frame
	await get_tree().process_frame
	var requested_state_ids: Array = _read_tianxia_yutu_state_detail_requested_ids(default_all)
	var cases: Array = []
	var failure_reasons: Array = []
	for state_index in range(requested_state_ids.size()):
		var state_id := str(requested_state_ids[state_index]).strip_edges()
		var case_entry: Dictionary = _tianxia_yutu_state_detail_screenshot_case_by_id(state_id)
		if case_entry.is_empty():
			var missing_case := {
				"stateDetailZoomAction": action_id,
				"stateDetailZoomContract": TIANXIA_YUTU_STATE_DETAIL_SCREENSHOT_CONTRACT,
				"stateId": state_id,
				"stateBoundsCells": {},
				"stateBoundsPx": {},
				"recommendedPivotCell": {},
				"recommendedPivotPx": {},
				"recommendedZoom": {},
				"stateFillRatio2k": 0.0,
				"maskOnly": true,
				"highResAssetRequired": true,
				"counts": {},
				"fallbackReason": "state_detail_screenshot_case_missing",
				"rejectionBoundary": "case_missing_blocks_heavy_screenshot_acceptance",
				"failureReasons": ["state_detail_screenshot_case_missing"],
				"screenshot": {"ok": false, "path": ""},
			}
			cases.append(missing_case)
			failure_reasons.append("%s:state_detail_screenshot_case_missing" % state_id)
			continue
		var case_result: Dictionary = await _build_tianxia_yutu_state_detail_zoom_case_result(case_entry, state_index, action_id)
		cases.append(case_result)
		var case_failures: Array = case_result.get("failureReasons", []) as Array if case_result.get("failureReasons", []) is Array else []
		for failure_variant in case_failures:
			failure_reasons.append("%s:%s" % [state_id, str(failure_variant)])
	var ok := not cases.is_empty() and failure_reasons.is_empty()
	return {
		"attempted": true,
		"ok": ok,
		"reason": action_id if ok else "%s_failed" % action_id,
		"stateDetailZoomAction": action_id,
		"stateDetailZoomContract": TIANXIA_YUTU_STATE_DETAIL_SCREENSHOT_CONTRACT,
		"stateDetailZoomRegisteredButNotHeavyValidated": true,
		"stateDetailZoomCoverageMode": "six_state_cases" if default_all else "state_ids_or_default_first_case",
		"requestedStateIds": requested_state_ids,
		"stateDetailZoomCases": cases,
		"caseCount": cases.size(),
		"failureReasons": failure_reasons,
		"setup": setup,
