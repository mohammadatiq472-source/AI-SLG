		_tianxia_yutu_scope_filter.add_item("全部")
		_tianxia_yutu_scope_filter.set_item_metadata(0, "all")
	_tianxia_yutu_scope_filter.select(clampi(selected_index, 0, _tianxia_yutu_scope_filter.get_item_count() - 1))
	_tianxia_yutu_scope_filter.set_block_signals(false)


func _is_tianxia_yutu_visible_scale_preset_id(scale_preset_id: String) -> bool:
	var normalized_id: String = scale_preset_id.strip_edges().to_lower()
	return normalized_id == "2k" or normalized_id == "16k"


func _coerce_tianxia_yutu_scale_preset_id(scale_preset_id: String, catalog: Array, fallback_scale_preset_id: String = "16k") -> String:
	var available_ids: Array = []
	for preset_variant in catalog:
		if not (preset_variant is Dictionary):
			continue
		var preset: Dictionary = preset_variant as Dictionary
		var preset_id: String = str(preset.get("id", "")).strip_edges().to_lower()
		if _is_tianxia_yutu_visible_scale_preset_id(preset_id) and not available_ids.has(preset_id):
			available_ids.append(preset_id)
	if available_ids.is_empty():
		available_ids = ["16k", "2k"]
	var normalized_id: String = scale_preset_id.strip_edges().to_lower()
	if _is_tianxia_yutu_visible_scale_preset_id(normalized_id) and available_ids.has(normalized_id):
		return normalized_id
	for fallback_id in available_ids:
		if _is_tianxia_yutu_visible_scale_preset_id(fallback_id):
			return fallback_id
	var normalized_fallback: String = fallback_scale_preset_id.strip_edges().to_lower()
	if _is_tianxia_yutu_visible_scale_preset_id(normalized_fallback):
		return normalized_fallback
	return "16k"


func _tianxia_yutu_visible_scale_catalog() -> Array:
	var visible_presets: Array = []
	var raw_catalog: Array = _tianxia_yutu_scale_preset_catalog
	if raw_catalog.is_empty():
		raw_catalog = [
			{"id": "2k", "label": "2K"},
			{"id": "16k", "label": "16K"},
		]
	for preset_variant in raw_catalog:
		if not (preset_variant is Dictionary):
			continue
		var preset: Dictionary = preset_variant as Dictionary
		var preset_id: String = str(preset.get("id", "")).strip_edges().to_lower()
		if not _is_tianxia_yutu_visible_scale_preset_id(preset_id):
			continue
		var label: String = str(preset.get("label", preset_id.to_upper())).strip_edges()
		if label == "":
			label = preset_id.to_upper()
		visible_presets.append({
			"id": preset_id,
			"label": label,
		})
	if visible_presets.is_empty():
		return [
			{"id": "2k", "label": "2K"},
			{"id": "16k", "label": "16K"},
		]
	return visible_presets

func _refresh_tianxia_yutu_scale_selector() -> void:
	if _tianxia_yutu_scale_selector == null:
		return
	var catalog: Array = _tianxia_yutu_visible_scale_catalog()
	_tianxia_yutu_scale_preset_id = _coerce_tianxia_yutu_scale_preset_id(_tianxia_yutu_scale_preset_id, catalog, "16k")
	_tianxia_yutu_scale_selector.set_block_signals(true)
	_tianxia_yutu_scale_selector.clear()
	var selected_index: int = 0
	for preset_variant in catalog:
		if not (preset_variant is Dictionary):
			continue
		var preset: Dictionary = preset_variant as Dictionary
		var preset_id: String = str(preset.get("id", "")).strip_edges().to_lower()
		if not _is_tianxia_yutu_visible_scale_preset_id(preset_id):
			continue
		var label: String = str(preset.get("label", preset_id.to_upper())).strip_edges()
		_tianxia_yutu_scale_selector.add_item(label)
		var item_index: int = _tianxia_yutu_scale_selector.get_item_count() - 1
		_tianxia_yutu_scale_selector.set_item_metadata(item_index, preset_id)
