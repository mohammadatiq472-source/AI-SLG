func _execute_battle_report_coordinate_jump(payload: Dictionary) -> Dictionary:
	return await _execute_coordinate_jump(payload)


func _execute_coordinate_jump(payload: Dictionary) -> Dictionary:
	var normalized_payload := _normalize_coordinate_jump_payload(payload)
	var target := _build_coordinate_jump_target(normalized_payload)
	if target.is_empty():
		_last_coordinate_jump = {
			"ok": false,
			"reason": "battle_report_coordinate_payload_invalid",
			"payload": normalized_payload.duplicate(true),
		}
		_coordinate_jump_count += 1
		_battle_report_last_coordinate_jump = _last_coordinate_jump.duplicate(true)
		_battle_report_coordinate_jump_count += 1
		return _last_coordinate_jump.duplicate(true)
	if _active_panel_id != "":
		_close_active_panel("coordinate_jump")
		await get_tree().process_frame
		await get_tree().process_frame
	if _main_city_hub_overlay != null and is_instance_valid(_main_city_hub_overlay) and _main_city_hub_overlay.has_method("set_expanded"):
		_main_city_hub_overlay.call("set_expanded", false)
		await get_tree().process_frame
	var jump_reason := "battle_report_coordinate" if str(normalized_payload.get("source", "")) == "battle_report_detail" else "coordinate_jump"
	var jump_result := await _execute_tianxia_yutu_explicit_jump(target, jump_reason)
	_last_coordinate_jump = jump_result.duplicate(true)
	_last_coordinate_jump["sourcePayload"] = normalized_payload.duplicate(true)
	_coordinate_jump_count += 1
	_battle_report_last_coordinate_jump = _last_coordinate_jump.duplicate(true)
	_battle_report_coordinate_jump_count += 1
	return _last_coordinate_jump.duplicate(true)


func _build_battle_report_coordinate_jump_target(payload: Dictionary) -> Dictionary:
	return _build_coordinate_jump_target(payload)


func _normalize_coordinate_jump_payload(payload: Dictionary) -> Dictionary:
	var normalized := payload.duplicate(true)
	var source := str(normalized.get("source", "")).strip_edges()
	if source == "":
		source = "coordinate"
		normalized["source"] = source
	var coordinate_variant: Variant = normalized.get("coordinate", {})
	if coordinate_variant is Dictionary:
		var coordinate := (coordinate_variant as Dictionary).duplicate(true)
		if coordinate.has("x") and coordinate.has("y"):
			if str(coordinate.get("coordinate_space", "")).strip_edges() == "":
				coordinate["coordinate_space"] = "cell_1km"
			if str(coordinate.get("source", "")).strip_edges() == "":
				coordinate["source"] = source
			normalized["coordinate"] = coordinate
			return normalized
	var tile_id := str(normalized.get("tileId", normalized.get("targetTileId", ""))).strip_edges()
	if tile_id == "":
		return normalized
	var value_label := str(normalized.get("value", "")).strip_edges()
	var tile_payload := _build_coordinate_jump_payload_from_tile_id(tile_id, source, value_label)
	if tile_payload.is_empty():
		return normalized
	for key in tile_payload.keys():
		normalized[key] = tile_payload[key]
	return normalized


func _build_coordinate_jump_payload_from_tile_action(action_id: String) -> Dictionary:
	var raw := action_id.strip_edges().trim_prefix("coordinate_jump_tile:")
	var parts := raw.split(":", false)
	if parts.size() < 2:
		return {}
	var source := str(parts[0]).strip_edges()
	var tile_id := str(parts[1]).strip_edges()
	return _build_coordinate_jump_payload_from_tile_id(tile_id, source, tile_id)


func _build_coordinate_jump_payload_from_tile_id(tile_id: String, source: String, value_label: String = "") -> Dictionary:
	var normalized_tile_id := tile_id.strip_edges()
	if normalized_tile_id == "":
		return {}
	var resolved_source := source.strip_edges()
	if resolved_source == "":
		resolved_source = "coordinate"
	var focus_cell := _resolve_mainline_visual_smoke_world_tile_focus_cell(normalized_tile_id)
	if focus_cell.is_empty():
		focus_cell = _parse_coordinate_jump_grid_tile_id(normalized_tile_id)
	if focus_cell.is_empty():
		var tile_data := _read_tile_data(normalized_tile_id)
		if not tile_data.is_empty() and tile_data.has("x") and tile_data.has("y"):
			focus_cell = {
				"x": roundi(float(tile_data.get("x", TIANXIA_YUTU_DEFAULT_CENTER_X))),
				"y": roundi(float(tile_data.get("y", TIANXIA_YUTU_DEFAULT_CENTER_Y))),
			}
	if focus_cell.is_empty():
		return {
			"tileId": normalized_tile_id,
			"source": resolved_source,
			"value": value_label if value_label.strip_edges() != "" else normalized_tile_id,
		}
	return {
		"coordinate": {
			"x": int(focus_cell.get("x", TIANXIA_YUTU_DEFAULT_CENTER_X)),
			"y": int(focus_cell.get("y", TIANXIA_YUTU_DEFAULT_CENTER_Y)),
			"coordinate_space": "cell_1km",
			"source": resolved_source,
		},
		"value": value_label if value_label.strip_edges() != "" else normalized_tile_id,
		"source": resolved_source,
		"tileId": normalized_tile_id,
	}


func _parse_coordinate_jump_grid_tile_id(tile_id: String) -> Dictionary:
	var normalized_tile_id := tile_id.strip_edges()
	if not normalized_tile_id.begins_with("grid_"):
		return {}
	var raw := normalized_tile_id.trim_prefix("grid_")
	var parts := raw.split("_", false)
	if parts.size() < 2:
		return {}
	if not str(parts[0]).is_valid_int() or not str(parts[1]).is_valid_int():
		return {}
	return {
		"x": int(str(parts[0])),
		"y": int(str(parts[1])),
	}


func _is_coordinate_jump_tile_action(action_id: String) -> bool:
	return action_id.strip_edges().begins_with("coordinate_jump_tile:")


func _build_coordinate_jump_target(payload: Dictionary) -> Dictionary:
	var coordinate_variant: Variant = payload.get("coordinate", {})
	if not (coordinate_variant is Dictionary):
		return {}
	var coordinate := coordinate_variant as Dictionary
	if not coordinate.has("x") or not coordinate.has("y"):
		return {}
	var target_x: int = int(coordinate.get("x", TIANXIA_YUTU_DEFAULT_CENTER_X))
	var target_y: int = int(coordinate.get("y", TIANXIA_YUTU_DEFAULT_CENTER_Y))
	var value_label := str(payload.get("value", "")).strip_edges()
	var source := str(payload.get("source", "")).strip_edges()
	var label_prefix := _resolve_coordinate_jump_label_prefix(source)
	var target_scope := source if source != "" else "coordinate"
	return {
		"label": "%s %s" % [label_prefix, value_label] if value_label != "" else label_prefix,
		"kind": "coordinate_jump",
		"target_scope": target_scope,
		"source": "%s_coordinate_button" % target_scope,
		"cell_1km": {
			"x": target_x,
			"y": target_y,
		},
	}


func _resolve_coordinate_jump_label_prefix(source: String) -> String:
	match source.strip_edges():
		"main_city_hub":
			return "主城坐标"
		"battle_report_detail":
			return "战报坐标"
		"alliance_member":
			return "成员坐标"
		"ai_home_city":
			return "AI主城坐标"
		_:
			return "坐标"


