func _configure_demo_capture_window() -> void:
	if _is_headless_runtime():
		return
	var window_title: String = OS.get_environment("SLG_DEMO_CAPTURE_WINDOW_TITLE").strip_edges()
	if window_title == "":
		window_title = DEMO_CAPTURE_DEFAULT_WINDOW_TITLE
	DisplayServer.window_set_title(window_title)
	DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
	DisplayServer.window_set_size(_read_window_size_env("SLG_DEMO_CAPTURE_WINDOW_SIZE", DEMO_CAPTURE_DEFAULT_WINDOW_SIZE))
	if _is_truthy_env("SLG_DEMO_CAPTURE_BORDERLESS"):
		DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_BORDERLESS, true)
	if _is_truthy_env("SLG_DEMO_CAPTURE_ALWAYS_ON_TOP"):
		DisplayServer.window_set_flag(DisplayServer.WINDOW_FLAG_ALWAYS_ON_TOP, true)
	if _is_truthy_env("SLG_DEMO_CAPTURE_CENTER_WINDOW"):
		_center_demo_capture_window()

func _center_demo_capture_window() -> void:
	if _is_headless_runtime():
		return
	var screen_size: Vector2i = DisplayServer.screen_get_size(DisplayServer.window_get_current_screen())
	var window_size: Vector2i = DisplayServer.window_get_size()
	if screen_size.x <= 0 or screen_size.y <= 0 or window_size.x <= 0 or window_size.y <= 0:
		return
	DisplayServer.window_set_position(Vector2i(
		maxi(0, int((screen_size.x - window_size.x) * 0.5)),
		maxi(0, int((screen_size.y - window_size.y) * 0.5))
	))

func _read_window_size_env(key: String, fallback: Vector2i) -> Vector2i:
	var raw_value: String = OS.get_environment(key).strip_edges().to_lower()
	if raw_value == "":
		return fallback
	var parts: PackedStringArray = raw_value.split("x")
	if parts.size() != 2:
		return fallback
	var width := int(parts[0])
	var height := int(parts[1])
	if width <= 0 or height <= 0:
		return fallback
	return Vector2i(width, height)

func _apply_demo_capture_mode_after_bootstrap() -> void:
	_close_tianxia_yutu_overview()
	_close_active_panel("demo_capture")
	if _main_chat_overlay != null and is_instance_valid(_main_chat_overlay) and _main_chat_overlay.has_method("close_overlay"):
		_main_chat_overlay.call("close_overlay")
	if _main_city_hub_overlay != null and is_instance_valid(_main_city_hub_overlay) and _main_city_hub_overlay.has_method("set_expanded"):
		_main_city_hub_overlay.call("set_expanded", false)
	if _is_truthy_env("SLG_DEMO_CAPTURE_HIDE_SHELL") and _native_shell != null and is_instance_valid(_native_shell) and _native_shell is CanvasItem:
		(_native_shell as CanvasItem).visible = false

	var view_mode: String = OS.get_environment("SLG_DEMO_CAPTURE_VIEW").strip_edges().to_lower()
	if view_mode == "main_world" or view_mode == "world" or view_mode == "gameplay":
		_set_main_map_view_mode(MAIN_MAP_VIEW_MODE_GAMEPLAY)
		_set_display_mode(DISPLAY_MODE_WORLD)
		_focus_demo_capture_main_world_cell()
	else:
		_set_main_map_view_mode(MAIN_MAP_VIEW_MODE_TIANXIA_YUTU)
		_set_display_mode(DISPLAY_MODE_WORLD)
		_sync_tianxia_yutu_overlay_visibility_defaults()
		_refresh_tianxia_yutu_jump_panel()

	var query_params: Dictionary = _resolve_map_layout_query_params()
	var request_key: String = _build_map_layout_request_key(_active_map_scope, query_params)
	if request_key != "":
		_schedule_viewport_map_refresh(query_params, request_key)
	await get_tree().process_frame
	await get_tree().create_timer(0.20).timeout
	_refresh_main_map_cell_action_panel()
	_refresh_tianxia_yutu_jump_panel()
	_update_runtime_label("demo capture ready")

func _focus_demo_capture_main_world_cell() -> void:
	if _map_grid == null or not is_instance_valid(_map_grid):
		return
	if not _map_grid.has_method("focus_and_select_main_map_cell_for_action"):
		return
	var cell_x := _read_nonnegative_int_env("SLG_DEMO_CAPTURE_CELL_X", TIANXIA_YUTU_DEFAULT_CENTER_X)
	var cell_y := _read_nonnegative_int_env("SLG_DEMO_CAPTURE_CELL_Y", TIANXIA_YUTU_DEFAULT_CENTER_Y)
	_map_grid.call("focus_and_select_main_map_cell_for_action", cell_x, cell_y)

func _resolve_initial_main_map_view_mode() -> String:
	var env_mode: String = OS.get_environment("SLG_MAIN_MAP_VIEW_MODE").strip_edges().to_lower()
	if env_mode == MAIN_MAP_VIEW_MODE_TIANXIA_YUTU or _is_truthy_env("SLG_TIANXIA_YUTU_MAIN_MAP_MODE"):
		return MAIN_MAP_VIEW_MODE_TIANXIA_YUTU
	return MAIN_MAP_VIEW_MODE_GAMEPLAY

func _is_tianxia_yutu_main_map_mode() -> bool:
	return _main_map_view_mode == MAIN_MAP_VIEW_MODE_TIANXIA_YUTU

func _set_main_map_view_mode(next_mode: String) -> void:
	var normalized_mode: String = next_mode.strip_edges().to_lower()
	if normalized_mode != MAIN_MAP_VIEW_MODE_TIANXIA_YUTU:
		normalized_mode = MAIN_MAP_VIEW_MODE_GAMEPLAY
	if normalized_mode == MAIN_MAP_VIEW_MODE_TIANXIA_YUTU:
		_main_map_frontline_marker_start_context = {}
	if _main_map_view_mode == normalized_mode:
		_apply_main_map_view_mode_to_grid()
		return
	_main_map_view_mode = normalized_mode
	_viewport_map_pending_key = ""
	_viewport_map_inflight_key = ""
	_viewport_map_last_applied_key = ""
	_viewport_map_cache.clear()
	_viewport_map_cache_order.clear()
	_viewport_loaded_chunk_ids = []
	_viewport_unload_candidate_chunk_ids = []
	_apply_main_map_view_mode_to_grid()

func _apply_main_map_view_mode_to_grid() -> void:
	if _map_grid != null and _map_grid.has_method("set_main_map_view_mode"):
		_map_grid.call("set_main_map_view_mode", _main_map_view_mode)
	if _native_shell != null and _native_shell.has_method("set_main_map_view_mode"):
		_native_shell.call("set_main_map_view_mode", _main_map_view_mode)
	if _main_city_hub_overlay != null and _main_city_hub_overlay.has_method("set_display_mode"):
		var hub_display_mode := DISPLAY_MODE_WORLD if _display_mode == DISPLAY_MODE_WORLD and not _is_tianxia_yutu_main_map_mode() else DISPLAY_MODE_CITY
		_main_city_hub_overlay.call("set_display_mode", hub_display_mode)
	_refresh_tianxia_yutu_jump_panel()
	_refresh_main_map_cell_action_panel()

func _capture_main_world_view_transform_bookmark() -> void:
	if _map_grid == null or not _map_grid.has_method("get_view_transform_state"):
		return
	var raw_view_transform: Variant = _map_grid.call("get_view_transform_state")
	if raw_view_transform is Dictionary and not (raw_view_transform as Dictionary).is_empty():
		_main_world_view_transform_bookmark = (raw_view_transform as Dictionary).duplicate(true)

func _restore_main_world_view_transform_bookmark() -> void:
	if _main_world_view_transform_bookmark.is_empty():
		return
	if _map_grid != null and _map_grid.has_method("restore_view_transform_state"):
		_map_grid.call("restore_view_transform_state", _main_world_view_transform_bookmark.duplicate(true), false)

func _open_main_world_map() -> void:
	_close_tianxia_yutu_overview()
	_tianxia_yutu_navigation_panel_expanded = false
	_tianxia_yutu_navigation_panel_collapsed = false
	_set_main_map_view_mode(MAIN_MAP_VIEW_MODE_GAMEPLAY)
	_set_display_mode(DISPLAY_MODE_WORLD)
	_restore_main_world_view_transform_bookmark()
	_refresh_tianxia_yutu_jump_panel()
	var query_params: Dictionary = _resolve_map_layout_query_params()
	var request_key: String = _build_map_layout_request_key(_active_map_scope, query_params)
	if request_key != "":
		_schedule_viewport_map_refresh(query_params, request_key)
	_record_last_action("main_world/map", "focused")
	_update_runtime_label("main world map")

func _open_tianxia_yutu_main_map() -> void:
	_close_tianxia_yutu_overview()
	if not _is_tianxia_yutu_main_map_mode():
		_capture_main_world_view_transform_bookmark()
	_tianxia_yutu_navigation_panel_collapsed = false
	if _is_tianxia_yutu_mobile_viewport():
		_tianxia_yutu_navigation_panel_expanded = false
	_set_main_map_view_mode(MAIN_MAP_VIEW_MODE_TIANXIA_YUTU)
	_set_display_mode(DISPLAY_MODE_WORLD)
	_refresh_tianxia_yutu_jump_panel()
	var query_params: Dictionary = _resolve_map_layout_query_params()
	var request_key: String = _build_map_layout_request_key(_active_map_scope, query_params)
	if request_key != "":
		_schedule_viewport_map_refresh(query_params, request_key)
	_record_last_action("tianxia_yutu/main_map", "focused")
	_update_runtime_label("tianxia yutu main map")

func _on_shell_mode_toggle_requested(next_mode: String) -> void:
	if next_mode == DISPLAY_MODE_WORLD:
		if _display_mode == DISPLAY_MODE_WORLD and _is_tianxia_yutu_main_map_mode():
			call_deferred("_open_main_world_map")
			return
		call_deferred("_open_tianxia_yutu_main_map")
		return
	_close_tianxia_yutu_overview()
	_set_display_mode(next_mode)

func _on_shell_action_requested(action_id: String) -> void:
	if action_id == "chat":
		_open_main_chat_overlay()
		return
	if action_id == "ai_switch_home_city":
		call_deferred("_open_ai_switch_home_city_or_panel")
		return
	if action_id == "world":
		call_deferred("_open_main_world_map")
		return
	_active_city_action = action_id
	_record_last_action("city_entry/%s" % action_id, "focused")
	_update_runtime_label("city entry %s" % action_id)
	_open_fixed_panel(action_id)

func _on_shell_ai_activity_badge_requested() -> void:
	call_deferred("_open_ai_activity_card_from_execution_trace", "badge")

func _on_ai_living_activity_marker_requested(payload: Dictionary) -> void:
	call_deferred("_open_ai_activity_card_and_focus_from_marker_payload", payload.duplicate(true))

func _open_ai_switch_home_city_or_panel() -> void:
	var adapter = _resolve_slg_domain_action_adapter()
	if adapter != null and adapter.has_method("request_ai_player_home_city_open"):
		if adapter.has_method("request_ai_player_runtime_refresh"):
			var refresh_result: Dictionary = await adapter.call("request_ai_player_runtime_refresh")
			if not bool(refresh_result.get("ok", false)):
				_open_ai_switch_fallback_panel("runtime_refresh_failed")
				return
		var open_result: Dictionary = await adapter.call("request_ai_player_home_city_open")
		if bool(open_result.get("ok", false)):
			await _apply_overlay_action_outcome({
				"ok": true,
				"record_path": "shell/ai_switch/home_city_open",
				"record_state": "home_city_opened",
				"runtime_label": "AI主城已切换好了",
				"action_result": open_result,
				"post_open_ai_main_city_facility": true,
				"post_open_ai_main_city_facility_entry": open_result.get("remote_result", {}),
			})
			return
		_open_ai_switch_fallback_panel("home_city_open_failed")
		return
	_open_ai_switch_fallback_panel("adapter_unavailable")

func _open_ai_switch_fallback_panel(reason: String = "fallback") -> void:
	var normalized_reason := reason.strip_edges()
	if normalized_reason == "":
		normalized_reason = "fallback"
	_active_city_action = "ai_hub"
	_record_last_action("shell/ai_switch/fallback/%s" % normalized_reason, "needs_player_attention")
	_update_runtime_label(AI_SWITCH_LIVE_REFRESH_FAILURE_PLAYER_COPY)
	_open_fixed_panel("ai_hub")
	if _active_overlay_panel != null and is_instance_valid(_active_overlay_panel):
		_active_overlay_panel.set_meta("ai_switch_live_refresh_failure_feedback_token", AI_SWITCH_LIVE_REFRESH_FAILURE_FEEDBACK_TOKEN)
		_active_overlay_panel.set_meta("ai_switch_live_refresh_failure_reason", normalized_reason)
		_active_overlay_panel.set_meta("ai_switch_live_refresh_failure_player_copy", AI_SWITCH_LIVE_REFRESH_FAILURE_PLAYER_COPY)

func _open_tianxia_yutu_overview() -> void:
	if _tianxia_yutu_overview_root == null:
		_set_display_mode(DISPLAY_MODE_WORLD)
		return
	_tianxia_yutu_overview_root.visible = true
	if _tianxia_yutu_status_label != null:
		_tianxia_yutu_status_label.text = "正在加载天下舆图..."
	if _tianxia_yutu_layer_label != null:
		_tianxia_yutu_layer_label.text = "天下舆图加载中"
	_record_last_action("tianxia_yutu/open", "loading")
	_update_runtime_label("tianxia yutu loading")
	_request_tianxia_yutu_overview_layer()

func _request_tianxia_yutu_overview_layer() -> void:
	var query_params: Dictionary = _build_tianxia_yutu_overview_query_params()
	var result: Dictionary = await _api_client.get_map_layout("viewport", query_params)
	if not bool(result.get("ok", false)):
		if _tianxia_yutu_status_label != null:
			_tianxia_yutu_status_label.text = "天下舆图加载失败"
		if _tianxia_yutu_layer_label != null:
			_tianxia_yutu_layer_label.text = "天下舆图暂不可用"
		_record_last_action("tianxia_yutu/open", "failed")
		_update_runtime_label("tianxia yutu failed")
		return
	var payload: Dictionary = result.get("data", {}) as Dictionary
	_tianxia_yutu_overview_payload = payload.duplicate(true)
	var layer: Dictionary = _extract_tianxia_yutu_overview_layer(payload)
	_apply_tianxia_yutu_overview_layer(layer)
	_record_last_action("tianxia_yutu/open", "loaded")
	_update_runtime_label("tianxia yutu loaded")

