			"ok": false,
			"reason": "record_world_task_event_api_missing",
			"taskId": normalized_task_id,
			"kind": normalized_kind,
			"sourceId": normalized_source_id,
		}
	return await _api_client.call(
		"record_world_task_event",
		"player",
		"huangtian_dangli",
		"huangtian_dangli_v1",
		"season_run_proto_2026_04",
		normalized_task_id,
		normalized_kind,
		"player_ui",
