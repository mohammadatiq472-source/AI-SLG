func _press_mainline_visual_smoke_ai_hub_proposal_mutation_result(panel_id: String, mutation: String) -> Dictionary:
	var resolved_mutation := mutation.strip_edges()
	var expected_panel_id := "ai_hub"
	var proposal_id := OS.get_environment("SLG_MAINLINE_VISUAL_SMOKE_AI_PROPOSAL_ID").strip_edges()
	if proposal_id == "":
		proposal_id = "visual_smoke_ai_decision_proposal"
	_seed_mainline_visual_smoke_ai_proposal_decision_surface()
	if panel_id != expected_panel_id or _active_panel_id != expected_panel_id:
		_open_overlay_panel_with_page(expected_panel_id, "agenda")
		await get_tree().process_frame
		await get_tree().process_frame
	await get_tree().create_timer(0.75).timeout
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
		return {"attempted": true, "ok": false, "reason": "ai_hub_panel_missing"}
	var ai_panel_node := _find_mainline_visual_smoke_visible_node_with_method(_active_overlay_panel, "set_ai_snapshot")
	if ai_panel_node != null:
		var ai_snapshot: Dictionary = _resolve_ai_panel_presenter().build_snapshot(_build_runtime_panel_context())
		ai_panel_node.call("set_ai_snapshot", _apply_mainline_visual_smoke_ai_proposal_decision_snapshot(ai_snapshot))
	_set_active_overlay_panel_page("agenda")
	await get_tree().process_frame
	await get_tree().process_frame
	var decision_summary := _read_mainline_visual_smoke_overlay_page_summary(expected_panel_id, "agenda")
	var action_prefix := "ai_player_proposal_approve:" if resolved_mutation == "approve" else "ai_player_proposal_reject:"
	var clicked_action_id := "%s%s" % [action_prefix, proposal_id]
	await _on_snapshot_overlay_page_action_requested("agenda", clicked_action_id)
	await get_tree().create_timer(1.8).timeout
	_set_active_overlay_panel_page("agenda")
	_refresh_overlay_panel_state()
	await get_tree().process_frame
	await get_tree().process_frame
	var result_summary := _read_mainline_visual_smoke_overlay_page_summary(expected_panel_id, "agenda")
	var expected_status := "approved" if resolved_mutation == "approve" else "rejected"
	var remote_ok := bool(result_summary.get("aiPanelProposalMutationResultAccepted", false)) \
		and str(result_summary.get("aiPanelProposalMutationResultKind", "")).strip_edges() == resolved_mutation \
		and str(result_summary.get("aiPanelProposalMutationResultStatus", "")).strip_edges() == expected_status
	return {
		"attempted": true,
		"ok": remote_ok,
		"reason": "ai_hub_proposal_mutation_result_verified" if remote_ok else "ai_hub_proposal_mutation_result_not_verified",
		"activePanelId": _active_panel_id,
		"expectedPanelId": expected_panel_id,
		"aiProposalMutationResultVisualSmokeContract": "ai_proposal_mutation_result_visual_smoke_v1",
		"aiProposalMutationResultAccepted": bool(result_summary.get("aiPanelProposalMutationResultAccepted", false)),
		"aiProposalMutationResultKind": str(result_summary.get("aiPanelProposalMutationResultKind", "")).strip_edges(),
		"aiProposalMutationResultStatus": str(result_summary.get("aiPanelProposalMutationResultStatus", "")).strip_edges(),
		"aiProposalMutationResultRemoteOk": remote_ok,
		"clickedActionId": clicked_action_id,
		"aiProposalDecisionSurfaceSummary": decision_summary,
		"aiProposalMutationResultSummary": result_summary,
		"aiProposalMutationResultScreenshotPath": _mainline_visual_smoke_screenshot_path,
	}

func _seed_mainline_visual_smoke_ai_proposal_decision_surface() -> void:
	var proposal_id := OS.get_environment("SLG_MAINLINE_VISUAL_SMOKE_AI_PROPOSAL_ID").strip_edges()
	if proposal_id == "":
		proposal_id = "visual_smoke_ai_decision_proposal"
	var ai_player_id := OS.get_environment("SLG_MAINLINE_VISUAL_SMOKE_AI_PLAYER_ID").strip_edges()
	if ai_player_id == "":
		ai_player_id = "visual_smoke_ai_decision_operator"
	var governor_player_id := OS.get_environment("SLG_MAINLINE_VISUAL_SMOKE_AI_GOVERNOR_PLAYER_ID").strip_edges()
	if governor_player_id == "":
		governor_player_id = "human_alpha"
	var proposal := {
		"proposalId": proposal_id,
		"aiPlayerId": ai_player_id,
		"governorPlayerId": governor_player_id,
		"action": "tile_occupy",
		"status": "pending_approval",
		"riskLevel": "medium",
		"reason": "前线空地可占，等你拍板。",
		"proposalArgs": {
			"unitId": "先锋营",
			"targetTileId": "tile_3_4",
		},
	}
	var seeded_state_patch := {
		"playerRuntimePrimaryAiPlayerId": ai_player_id,
		"playerRuntimeList": [{
			"aiPlayerId": ai_player_id,
			"governorPlayerId": governor_player_id,
			"displayName": "青州军师",
			"status": "active",
			"listCard": {
				"displayName": "青州军师",
				"statusDot": "gold",
				"statusReason": "等你决定",
				"actionableProposalCount": 1,
			},
		}],
		"playerRuntimeProposalItems": [proposal],
		"playerRuntimeProposalMutationResult": {},
		"playerRuntimeListSummary": {
			"count": 1,
			"pendingApprovalCount": 1,
			"runtimeFailureCount": 0,
		},
		"playerRuntimeLastError": "",
		"playerRuntimeUpdatedAt": "2026-06-13T12:00:00Z",
	}
	var faction_ids: Array[String] = []
	for faction_id_variant in [_target_faction_id, SessionStore.faction_id, "player"]:
		var faction_id := str(faction_id_variant).strip_edges()
		if faction_id != "" and not faction_ids.has(faction_id):
			faction_ids.append(faction_id)
	for faction_id in faction_ids:
		var next_ai_state := WorldStore.get_ai_state(faction_id).duplicate(true)
		for key in seeded_state_patch.keys():
			var value_variant: Variant = seeded_state_patch.get(key)
			if value_variant is Array:
				next_ai_state[key] = (value_variant as Array).duplicate(true)
			elif value_variant is Dictionary:
				next_ai_state[key] = (value_variant as Dictionary).duplicate(true)
			else:
				next_ai_state[key] = value_variant
		WorldStore.set_ai_state(faction_id, next_ai_state)

