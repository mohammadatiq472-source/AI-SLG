	var anchor_summary := _read_world_tile_action_hud_anchor_summary()
	for key in anchor_summary.keys():
		merged_summary[key] = anchor_summary.get(key)
	var result := base_result.duplicate(true)
	for key in merged_summary.keys():
		result[key] = merged_summary.get(key)
	result["pageContentSummary"] = merged_summary
	result["pageContentOk"] = bool(merged_summary.get("worldTileActionHudOpenOk", false)) or bool(merged_summary.get("worldTileZeroLevelSubstrateHudOk", false))
	return result

func _read_world_tile_action_hud_anchor_summary() -> Dictionary:
	if _main_map_cell_action_panel == null:
		return {
			"tileHudAnchorMode": "panel_missing",
			"tileHudBoundToSelectedTile": false,
			"selectedTileScreenPosition": {},
			"tileHudRect": {},
			"tileHudSafeViewportClampOk": false,
			"tileHudAvoidsLeftRailAndBottomNav": false,
		}
	var panel_rect := _main_map_cell_action_panel.get_global_rect()
	var viewport_size := get_viewport().get_visible_rect().size
	var selected_position: Vector2 = _main_map_cell_action_panel.get_meta("selected_tile_screen_position", Vector2.ZERO)
	var anchor_mode := str(_main_map_cell_action_panel.get_meta("tile_hud_anchor_mode", "")).strip_edges()
	var bound := bool(_main_map_cell_action_panel.get_meta("tile_hud_bound_to_selected_tile", false))
	var left_rail_rect := Rect2()
	var bottom_nav_rect := Rect2()
	if _native_shell != null and is_instance_valid(_native_shell) and _native_shell.has_method("get_left_troop_rail_visual_summary"):
		var left_summary_variant: Variant = _native_shell.call("get_left_troop_rail_visual_summary")
		if left_summary_variant is Dictionary:
			var left_summary: Dictionary = left_summary_variant as Dictionary
			left_rail_rect = _dict_to_mainline_visual_smoke_rect(left_summary.get("leftTroopRailPanelRect", {}))
			bottom_nav_rect = _dict_to_mainline_visual_smoke_rect(left_summary.get("leftTroopRailBottomNavRect", {}))
	var clamp_ok := (
		panel_rect.position.x >= -0.5
		and panel_rect.position.y >= -0.5
		and panel_rect.position.x + panel_rect.size.x <= viewport_size.x + 0.5
		and panel_rect.position.y + panel_rect.size.y <= viewport_size.y + 0.5
	)
	var avoids_left := left_rail_rect.size == Vector2.ZERO or not _mainline_visual_smoke_rects_overlap(panel_rect, left_rail_rect)
	var avoids_bottom := bottom_nav_rect.size == Vector2.ZERO or not _mainline_visual_smoke_rects_overlap(panel_rect, bottom_nav_rect)
	return {
		"tileHudAnchorMode": anchor_mode,
		"selectedTileScreenPosition": {"x": selected_position.x, "y": selected_position.y},
		"tileHudRect": _rect_to_mainline_visual_smoke_dict(panel_rect),
		"tileHudLocalRect": _rect_to_mainline_visual_smoke_dict(_main_map_cell_action_panel.get_rect()),
		"tileHudAnchors": {
			"left": _main_map_cell_action_panel.anchor_left,
			"top": _main_map_cell_action_panel.anchor_top,
			"right": _main_map_cell_action_panel.anchor_right,
			"bottom": _main_map_cell_action_panel.anchor_bottom,
		},
		"tileHudOffsets": {
			"left": _main_map_cell_action_panel.offset_left,
			"top": _main_map_cell_action_panel.offset_top,
			"right": _main_map_cell_action_panel.offset_right,
			"bottom": _main_map_cell_action_panel.offset_bottom,
		},
		"tileHudSizeFlags": {
			"horizontal": _main_map_cell_action_panel.size_flags_horizontal,
			"vertical": _main_map_cell_action_panel.size_flags_vertical,
		},
		"tileHudCustomMinimumSize": {
			"x": _main_map_cell_action_panel.custom_minimum_size.x,
			"y": _main_map_cell_action_panel.custom_minimum_size.y,
		},
		"tileHudBoundToSelectedTile": bound,
		"tileHudSafeViewportClampOk": clamp_ok,
		"tileHudAvoidsLeftRailAndBottomNav": avoids_left and avoids_bottom,
