			"clicked": false,
			"reason": "open_chat_button_disabled",
			"activePanelId": _active_panel_id,
			"pageContentSummary": page_summary_before,
		}
	page_summary_before["aiPanelActionRowClickedActionId"] = str(open_chat_button.get_meta("ai_panel_action_id", open_chat_button.get_meta("snapshot_action_id", ""))).strip_edges()
	page_summary_before["aiPanelActionRowClickedLabel"] = str(open_chat_button.get_meta("snapshot_action_live_text_label", open_chat_button.text)).strip_edges()
