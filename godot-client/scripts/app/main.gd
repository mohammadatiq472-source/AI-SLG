	_open_overlay_panel_with_page("generals", "roster")
	await get_tree().process_frame
	await get_tree().process_frame
	await get_tree().create_timer(0.25).timeout
	var profile_result := await _press_mainline_visual_smoke_generals_roster_open_hero_profile("generals")
	if not bool(profile_result.get("ok", false)):
		profile_result["expectedPanelId"] = "generals"
		profile_result["expectedPageId"] = resolved_page_id
		profile_result["reason"] = "general_secondary_profile_open_failed"
		return profile_result
	if _active_overlay_panel == null or not is_instance_valid(_active_overlay_panel):
