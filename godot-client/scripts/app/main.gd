func _resolve_ai_activity_card_status_color(status_dot: String) -> Color:
	match status_dot.strip_edges().to_lower():
		"green":
			return Color(0.34, 0.88, 0.42, 1.0)
		"yellow":
			return Color(0.96, 0.77, 0.32, 1.0)
		"gold":
			return Color(0.95, 0.67, 0.22, 1.0)
		"red":
			return Color(0.92, 0.24, 0.18, 1.0)
		"gray", "grey":
			return Color(0.54, 0.54, 0.50, 1.0)
		_:
			return Color(0.68, 0.72, 0.62, 1.0)


func _format_ai_activity_card_status_label(status_dot: String, status_reason: String) -> String:
	var reason := status_reason.strip_edges()
	match reason:
		"execution_trace_active":
			return "状态：执行流活跃"
		"receipt_ready":
			return "状态：回执已更新"
		"pending_proposals":
			return "状态：等待执行"
		"runtime_failure":
			return "状态：执行异常"
		"receipt_failed":
			return "状态：执行失败"
		"receipt_history":
			return "状态：历史回执"
	var normalized_dot := status_dot.strip_edges().to_lower()
	if normalized_dot == "green":
		return "状态：行动中"
	if normalized_dot == "red":
		return "状态：异常"
	if reason != "":
		return "状态：%s" % reason
	return "状态：行动中"


